{
  "zh-hans": {
    "team": {
      "object_buildup": {
        "split": {
          "desc": "在准备击杀史诗野怪（元素亚龙、纳什男爵）期间，对史诗野怪另一侧的兵线施压。"
        },
        "flexible": {
          "desc": "在准备击杀史诗野怪（元素亚龙、纳什男爵）期间，根据实际情况灵活处理史诗野怪另一侧的兵线。"
        },
        "gather": {
          "desc": "在史诗野怪（元素亚龙、纳什男爵）附近集合，即使这意味着另一侧兵线会有损失。"
        }
      },
      "morgard_use": {
        "split14": {
          "desc": "一名选手在史诗野怪（元素亚龙、纳什男爵）的相反方向路线施加压力，其他四人集合对另一条线路施压。"
        }
      }
    }
  },
  "zh-hant": {
    "team": {
      "early_serpen": {
        "name": "對線期小龍嘗試",
        "must": {
          "desc": "在第一隻小龍出現前提前準備，滿足最低條件時在對線期必定嘗試一次。之後視情況判斷。"
        },
        "flexible": {
          "desc": "根據局勢判斷，如果情況允許則嘗試爭奪小龍，處於劣勢時則會放棄。"
        },
        "giveup": {
          "desc": "對線期即使對手擊殺小龍也不回應，直接放棄，專注於讓各路安全發育。"
        }
      },
      "early_serpen_top": {
        "name": "對線期上路小龍團參與",
        "must": {
          "desc": "對線期若出現吃小龍的機會，上路必定參與小龍團戰。"
        },
        "flexible": {
          "desc": "上路在情況允許時參與小龍團戰；否則會專注於上路對線。"
        },
        "giveup": {
          "desc": "對線期上路在任何情況下都不參與小龍團戰。"
        }
      },
      "object_buildup": {
        "split": {
          "desc": "準備拿下史詩野怪（元素亞龍、巴龍）時，對物件遠側的線路施壓。"
        },
        "flexible": {
          "desc": "準備拿下史詩野怪（元素亞龍、巴龍）時，根據局勢靈活處理物件遠側的兵線。"
        },
        "gather": {
          "desc": "準備拿下史詩野怪（元素亞龍、巴龍）時，即使物件遠側兵線會出現損失，也會盡可能到物件附近集結。"
        }
      },
      "morgard_use": {
        "name": "巴龍Buff運用",
        "gather": {
          "desc": "擁有巴龍Buff時，全體隊員集合一起對一條線路施壓。"
        },
        "split14": {
          "desc": "擁有巴龍Buff時，一名選手推進遠側兵線，其他四名選手則集結對另一條線路施壓。"
        },
        "split131": {
          "desc": "擁有巴龍Buff時，三名選手推進中路兵線，其餘兩名選手分別施壓剩下兩條線路。"
        }
      }
    }
  },
  "en": {
    "team": {
      "early_serpen": {
        "name": "Early Drake Attempt",
        "must": {
          "desc": "Sets up ahead of the first drake spawn and, once the minimum conditions are met, makes one committed attempt during the laning phase. Plays it by ear afterwards."
        },
        "flexible": {
          "desc": "Attempts to slay the drake if the situation allows, but gives up if disadvantageous."
        },
        "giveup": {
          "desc": "Concedes the drake during the laning phase without contesting it, even if the enemy takes it, to focus on safe growth in each lane."
        }
      },
      "early_serpen_top": {
        "name": "Top Laner Join for Early Drake",
        "must": {
          "desc": "The Top laner always joins the fight for the drake during the laning phase."
        },
        "giveup": {
          "desc": "The Top laner does not join the fight for the drake under any circumstances."
        }
      },
      "object_buildup": {
        "split": {
          "desc": "Pressures the lane opposite the objective (Elemental Drake, Baron Nashor) while preparing to take it."
        }
      },
      "morgard_use": {
        "name": "Baron Buff Usage",
        "gather": {
          "desc": "All team members group up to pressure a lane together when holding the Baron buff."
        }
      }
    }
  },
  "ko": {
    "team": {
      "early_serpen": {
        "name": "라인전 단계 드래곤 시도",
        "must": {
          "desc": "첫 드래곤 등장에 맞춰 미리 준비하고, 최소한의 조건이 되면 라인전 단계에서 한 번은 반드시 드래곤을 시도합니다. 그 뒤로는 상황에 따라 판단합니다."
        },
        "flexible": {
          "desc": "상황에 따라 드래곤을 충분히 처치할 수 있을만한 상황에 시도하고, 불리할 경우 포기합니다."
        },
        "giveup": {
          "desc": "라인전 단계의 드래곤은 상대가 치더라도 대응하지 않고 내주며, 각 라인이 안전하게 성장하는 데 집중합니다."
        }
      },
      "early_serpen_top": {
        "name": "라인전 단계 드래곤 탑 라이너 합류",
        "must": {
          "desc": "라인전 단계에서 드래곤 처치 상황이 되면 반드시 합류합니다."
        },
        "flexible": {
          "desc": "탑 라이너가 상황에 따라 드래곤에 합류할 수 있을만한 상황이면 합류하고, 그렇지 않다면 탑 라인전에 집중합니다."
        },
        "giveup": {
          "desc": "라인전 단계에서는 어떠한 상황에서도 드래곤 처치에 참여하지 않습니다."
        }
      },
      "object_buildup": {
        "split": {
          "desc": "오브젝트(원소 드래곤, 내셔 남작) 처치를 준비하는 과정에서, 오브젝트와 반대편에 있는 라인을 최대한 압박합니다."
        },
        "flexible": {
          "desc": "오브젝트(원소 드래곤, 내셔 남작) 처치를 준비하는 과정에서, 상황에 따라 유연하게 오브젝트 반대편 라인을 관리합니다."
        },
        "gather": {
          "desc": "오브젝트(원소 드래곤, 내셔 남작) 처치를 준비하는 과정에서, 오브젝트 반대편 라인에서 손해가 발생해도 최대한 오브젝트 근처에 같이 모입니다."
        }
      },
      "morgard_use": {
        "name": "내셔 남작 버프 활용",
        "gather": {
          "desc": "내셔 남작 버프가 있을 때, 모든 팀원이 다같이 모여 라인을 압박합니다."
        },
        "split14": {
          "desc": "내셔 남작 버프가 있을 때, 한 명은 오브젝트(원소 드래곤, 내셔 남작) 반대편 라인을 압박하며 다른 4명은 같이 모여서 다른 라인을 압박합니다."
        },
        "split131": {
          "desc": "내셔 남작 버프가 있을 때, 세 명은 미드 라인을 압박하며 나머지 두 라인을 각각 한 명의 선수들이 압박하여 세 개의 라인을 동시에 압박합니다."
        }
      }
    }
  },
  "ja": {
    "team": {
      "early_serpen": {
        "name": "序盤ドラゴン挑戦",
        "must": {
          "desc": "最初のドラゴン出現に合わせて事前に準備し、最低限の条件が整えばレーン戦の段階で必ず一度は討伐を試みます。その後は状況に応じて判断します。"
        },
        "flexible": {
          "desc": "状況が許せばドラゴン討伐を試み、不利な場合は諦めます。"
        },
        "giveup": {
          "desc": "レーン戦の段階では相手が討伐しても対応せずドラゴンを譲り、各レーンでの安全な成長に集中します。"
        }
      },
      "early_serpen_top": {
        "name": "序盤ドラゴンへのトップ参加",
        "must": {
          "desc": "トップレーナーはレーニングフェーズでドラゴン戦に常に参加します。"
        },
        "giveup": {
          "desc": "トップレーナーはいかなる状況でもドラゴン戦に参加しません。"
        }
      },
      "object_buildup": {
        "split": {
          "desc": "オブジェクティブ（エレメンタルドラゴン、バロンナッシャー）の奪取準備をしながら、反対側のレーンに圧力をかけます。"
        }
      },
      "morgard_use": {
        "name": "バロンバフ活用",
        "gather": {
          "desc": "バロンバフがある時、全チームメンバーが一緒にレーンに圧力をかけるために集まります。"
        }
      }
    }
  }
}
