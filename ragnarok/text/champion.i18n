{
  "zh-hans": {
    "description": {
      "ragnarok_lubu": {
        "name": "吕布奉先",
        "attack": "方天画戟重击，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>盾牌破坏者<>：无视<#ffb900ff>15%<>护甲；对护盾的伤害提高<#ffb900ff>100%<>，打碎护盾时再造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30%<>物理伤害。",
        "skill": "方天画戟横扫前方扇形，造成<#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<><#ff9028ff>物理伤害<>，并减速<#ffb900ff>40%<>，持续<#ffb900ff>1.5秒<>。",
        "skill2": "朝目标突刺冲阵，穿过路上的敌人，造成<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>并<#ef5350ff>击飞0.6秒<>。",
        "ult": "举戟蓄力<#ffb900ff>1.2秒<>（不受控制，受到的伤害降低<#ffb900ff>30%<>），随后朝目标斩出天喰：直线上的敌人受到<#ff9028ff>200<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>280%<><#ff9028ff>物理伤害<>并<#ef5350ff>眩晕0.8秒<>。"
      },
      "ragnarok_thor": {
        "name": "索尔",
        "attack": "雷槌重击，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>雷槌觉醒<>：每放<#ffb900ff>3次<>技能，雷槌觉醒<#ffb900ff>6秒<>：普攻再造成<#a974ffff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#a974ffff>3%<><#a974ffff>魔法伤害<>，雷神之锤改为<#ef5350ff>眩晕1.1秒<>。",
        "skill": "举锤砸地，<#ffb900ff>0.43秒<>后雷电在前方炸开：敌人受到<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>4%<><#ff9028ff>物理伤害<>并<#ef5350ff>眩晕0.7秒<>（觉醒时<#ef5350ff>1.1秒<>）。",
        "skill2": "朝目标方向掷出雷槌，雷槌飞回手中，来回穿过的敌人受到<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>2%<><#ff9028ff>物理伤害<>并减速<#ffb900ff>40%<>，持续<#ffb900ff>1秒<>。雷槌回手前原地等待，接住时获得<#e8d44dff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#e8d44dff>50%<><#e8d44dff>护盾<><#ffb900ff>2.5秒<>。",
        "ult": "雷槌立即觉醒<#ffb900ff>8秒<>，蓄力<#ffb900ff>1.25秒<>（不受控制，受到的伤害降低<#ffb900ff>45%<>）后砸下：前方的敌人受到<#ff9028ff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>8%<><#ff9028ff>物理伤害<>并<#ef5350ff>击飞1.5秒<>。"
      },
      "ragnarok_zeus": {
        "name": "宙斯",
        "attack": "快拳，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>肌肉膨胀<>：老人状态打出<#ffb900ff>3拳<>后，下一拳改为膨胀（<#ffb900ff>1.02秒<>，不受控制），完成时震伤周围敌人<#ff9028ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<><#ff9028ff>物理伤害<>、减速<#ffb900ff>30%<>；膨胀后攻击力+<#ffb900ff>25%<>、护甲和魔抗+<#ffb900ff>35%<>。",
        "skill": "连打两拳，每拳<#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>65%<><#ff9028ff>物理伤害<>；膨胀时第二拳减速<#ffb900ff>40%<>，持续<#ffb900ff>1秒<>，阿陀磨须时第二拳<#ef5350ff>眩晕0.6秒<>。",
        "skill2": "拳头快过时间，出拳之前伤害就已打到：<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<><#ff9028ff>物理伤害<>并<#ef5350ff>眩晕0.5秒<>（阿陀磨须时<#ef5350ff>0.9秒<>）。",
        "ult": "把膨胀的肌肉压缩<#ffb900ff>1.03秒<>（老人状态先膨胀；不受控制，受到的伤害降低<#ffb900ff>50%<>），随后震飞周围敌人：<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>并<#ef5350ff>击飞0.7秒<>，以阿陀磨须作战<#ffb900ff>10秒<>：攻击力+<#ffb900ff>45%<>、双抗+<#ffb900ff>60%<>、攻速+<#ffb900ff>30%<>、吸血<#ffb900ff>25%<>。结束后变回老人。"
      },
      "ragnarok_adam": {
        "name": "亚当",
        "attack": "快拳，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>神虚视<>读过一招就记下来（<#ffb900ff>5秒<>），有记录时<#ff9028ff>模仿反击<>会复刻那一招。",
        "skill": "睁开神虚视读出对手的动作，闪身躲开：<#ffb900ff>2.5秒<>内普攻全部落空，受到的技能伤害降低<#ffb900ff>50%<>，并记下一招。",
        "skill2": "反击一拳，造成<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。有记录时复刻那一招：再加<#ff9028ff>60<>和目标<#ffb900ff>8%<>最大生命值的物理伤害，并<#ef5350ff>眩晕1秒<>，用掉记录。",
        "ult": "从宙斯那里学来的拳：蓄势<#ffb900ff>0.43秒<>（不受控制，受到的伤害降低<#ffb900ff>50%<>），然后朝目标打出一道拳劲，路上的敌人受到<#ff9028ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150%<><#ff9028ff>物理伤害<>并被<#ef5350ff>击飞0.8秒<>。"
      },
      "ragnarok_poseidon": {
        "name": "波塞冬",
        "attack": "三叉戟水平突刺，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>神无须依赖<>：身边没有友方英雄时，攻击力<#ffb900ff>+15%<>，受到的伤害降低<#ffb900ff>10%<>。",
        "skill": "踏前一步，朝前方连刺<#ffb900ff>4次<>，每次对前方扇形里的敌人造成<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>85%<><#ff9028ff>物理伤害<>。",
        "skill2": "高举三叉戟斜刺而下，目标脚下的敌人受到<#ff9028ff>145<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>195%<><#ff9028ff>物理伤害<>并被<#ef5350ff>眩晕0.7秒<>。",
        "ult": "蓄势<#ffb900ff>0.38秒<>（受到的伤害降低<#ffb900ff>30%<>），戟影如洪水般围住目标连刺<#ffb900ff>6轮<>，每轮对周围的敌人造成<#ff9028ff>85<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>115%<><#ff9028ff>物理伤害<>，第一轮<#ef5350ff>定身0.75秒<>。"
      },
      "ragnarok_kojiro": {
        "name": "佐佐木小次郎",
        "attack": "长刀一斩，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>预判<>：每打中一个敌方英雄一次就记下他一招（每人最多<#ffb900ff>8招<>），之后对他的伤害每招<#ffb900ff>+3%<>；死后重新记。",
        "skill": "往前斩下，前方扇形里的敌人受到<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<><#ff9028ff>物理伤害<>；随即反刃上撩，再造成<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<><#ff9028ff>物理伤害<>并<#ef5350ff>减速35%<>。",
        "skill2": "预判对手的一千种走法，侧身让开：<#ffb900ff>2.5秒<>内受到的伤害降低<#ffb900ff>30%<>，攻速<#ffb900ff>+50%<>。",
        "ult": "拔出第二把刀，双刀斩下造成<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>，再交错一刀造成<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<><#ff9028ff>物理伤害<>并<#ef5350ff>眩晕0.6秒<>；之后<#ffb900ff>8秒<>双刀：攻速<#ffb900ff>+30%<>，普攻多一刀<#ffb900ff>40%<>。"
      },
      "ragnarok_heracles": {
        "name": "赫拉克勒斯",
        "attack": "巨棒一击，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>十二御业的刻印<>：每放一个技能刻印爬一格（大招两格，最多<#ffb900ff>12格<>），每格攻击力<#ffb900ff>+1%<>、护甲和魔抗<#ffb900ff>+2<>；死后消退。",
        "skill": "巨棒前顶，狮头冲出：前方扇形里的敌人受到<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>并<#ef5350ff>减速30%<>。刻耳柏洛斯形态：一拳砸地，身前的敌人受到<#ff9028ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<><#ff9028ff>物理伤害<>并被<#ef5350ff>击飞<>。",
        "skill2": "巨棒砸地，身前的敌人受到<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<><#ff9028ff>物理伤害<>并<#ef5350ff>眩晕0.75秒<>。刻耳柏洛斯形态：护势，<#ffb900ff>2.5秒<>内受到的伤害降低<#ffb900ff>35%<>并反弹<#ffb900ff>20%<>，<#ef5350ff>嘲讽<>身边的敌人<#ef5350ff>1秒<>。",
        "ult": "与冥府的看门犬订约，变成刻耳柏洛斯形态<#ffb900ff>8秒<>：攻击力<#ffb900ff>+40%<>、攻速<#ffb900ff>+50%<>、移速<#ffb900ff>+15%<>、受到的伤害降低<#ffb900ff>20%<>、吸血<#ffb900ff>15%<>；结束时一拳砸地，身边的敌人受到<#ff9028ff>140<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150%<><#ff9028ff>物理伤害<>并被<#ef5350ff>击飞<>。"
      },
      "ragnarok_jack": {
        "name": "开膛手杰克",
        "attack": "掷出飞刀，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>心之色<>：他看得见人心的颜色，恐惧藏不住：对生命低于<#ffb900ff>50%<>的敌方英雄，伤害<#ffb900ff>+30%<>。",
        "skill": "掷出一扇飞刀，前方扇形里的敌人受到<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>105%<><#ff9028ff>物理伤害<>并<#ef5350ff>减速25%<>。",
        "skill2": "撑开被手套变成神器的伞，到收伞受到的伤害降低<#ffb900ff>40%<>；往后退进雾里，<#ffb900ff>隐身1.5秒<>，之后<#ffb900ff>3秒<>攻速<#ffb900ff>+40%<>。",
        "ult": "单片镜后的眼睛看穿对方，手套碰过的刀成了神器飞出：造成<#ff9028ff>200<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>180%<><#ff9028ff>物理伤害<>，之后<#ffb900ff>4秒<>里对方受到的伤害增加<#ffb900ff>20%<>。"
