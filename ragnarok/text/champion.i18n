  "en": {
    "description": {
      "ragnarok_lubu": {
        "name": "Lu Bu",
        "attack": "Swings the Sky Piercer for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Shield Breaker<>: ignores <#ffb900ff>15%<> armor; deals <#ffb900ff>100%<> more damage to shields, and breaking a shield deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30%<> more physical damage.",
        "skill": "Sweeps the halberd through a cone in front, dealing <#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<> <#ff9028ff>physical damage<> and slowing by <#ffb900ff>40%<> for <#ffb900ff>1.5s<>.",
        "skill2": "Charges through the enemy line toward the target: enemies in his path take <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<> and are <#ef5350ff>knocked up for 0.6s<>.",
        "ult": "Gathers himself for <#ffb900ff>1.2s<> (unstoppable, taking <#ffb900ff>30%<> less damage), then cuts the sky toward the target: enemies on the line take <#ff9028ff>200<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>280%<> <#ff9028ff>physical damage<> and are <#ef5350ff>stunned for 0.8s<>."
      },
      "ragnarok_thor": {
        "name": "Thor",
        "attack": "Strikes with Mjolnir for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Mjolnir Awakening<>: every <#ffb900ff>third<> skill cast awakens Mjolnir for <#ffb900ff>6s<>: his attacks add <#a974ffff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#a974ffff>3%<> <#a974ffff>magic damage<> and Thor's Hammer <#ef5350ff>stuns for 1.1s<>.",
        "skill": "Brings the hammer down: after <#ffb900ff>0.43s<> lightning bursts through the ground ahead, dealing <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>4%<> <#ff9028ff>physical damage<> and <#ef5350ff>stunning for 0.7s<> (<#ef5350ff>1.1s<> awakened).",
        "skill2": "Throws Mjolnir toward the target and it flies back to his hand, hitting every enemy it passes both ways for <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>2%<> <#ff9028ff>physical damage<> and slowing by <#ffb900ff>40%<> for <#ffb900ff>1s<>. He waits empty-handed until it returns; the catch grants a <#e8d44dff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#e8d44dff>50%<> <#e8d44dff>shield<> for <#ffb900ff>2.5s<>.",
        "ult": "Awakens Mjolnir at once for <#ffb900ff>8s<>, gathers himself for <#ffb900ff>1.25s<> (unstoppable, taking <#ffb900ff>45%<> less damage), then smashes the ground ahead: enemies take <#ff9028ff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>8%<> <#ff9028ff>physical damage<> and are <#ef5350ff>knocked up for 1.5s<>."
      },
      "ragnarok_zeus": {
        "name": "Zeus",
        "attack": "A quick jab for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Muscle Expansion<>: after <#ffb900ff>3 punches<> as the old man, his next one swells him up instead (<#ffb900ff>1.02s<>, unstoppable), shaking nearby enemies for <#ff9028ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> <#ff9028ff>physical damage<> and slowing by <#ffb900ff>30%<>; swollen, he gains <#ffb900ff>25%<> attack and <#ffb900ff>35%<> armor and magic resistance.",
        "skill": "Two quick punches, each <#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>65%<> <#ff9028ff>physical damage<>; swollen, the second slows by <#ffb900ff>40%<> for <#ffb900ff>1s<>, as Adamas it <#ef5350ff>stuns for 0.6s<>.",
        "skill2": "A punch faster than time: the blow lands before he throws it, <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<> <#ff9028ff>physical damage<> and a <#ef5350ff>0.5s stun<> (<#ef5350ff>0.9s<> as Adamas).",
        "ult": "Presses his swollen muscles down for <#ffb900ff>1.03s<> (the old man swells first; unstoppable, taking <#ffb900ff>50%<> less damage), then blasts nearby enemies for <#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>, <#ef5350ff>knocking them up for 0.7s<>, and fights as Adamas for <#ffb900ff>10s<>: +<#ffb900ff>45%<> attack, +<#ffb900ff>60%<> armor and magic resistance, +<#ffb900ff>30%<> attack speed, <#ffb900ff>25%<> lifesteal. Then he is old again."
      },
      "ragnarok_adam": {
        "name": "Adam",
        "attack": "A quick jab for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>God Reader<> remembers a move it has read (<#ffb900ff>5s<>); with one remembered, <#ff9028ff>Mimic Counter<> copies it.",
        "skill": "Opens his God Reader eyes and slips aside: for <#ffb900ff>2.5s<> basic attacks miss him and skills deal <#ffb900ff>50%<> less damage; he remembers a move.",
        "skill2": "A counter punch for <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. With a remembered move he copies it: <#ff9028ff>60<> more plus <#ffb900ff>8%<> of the target's max health and a <#ef5350ff>1s stun<>, using the move up.",
        "ult": "The punch he copied from Zeus: winds up for <#ffb900ff>0.43s<> (unstoppable, taking <#ffb900ff>50%<> less damage), then drives a blast at the target that deals <#ff9028ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150%<> <#ff9028ff>physical damage<> to enemies in its path and <#ef5350ff>knocks them up for 0.8s<>."
      },
      "ragnarok_poseidon": {
        "name": "Poseidon",
        "attack": "A level trident thrust for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>A God Needs No One<>: with no allied champion near him he gains <#ffb900ff>15%<> attack and takes <#ffb900ff>10%<> less damage.",
        "skill": "Steps in and thrusts <#ffb900ff>4 times<>, each dealing <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>85%<> <#ff9028ff>physical damage<> to enemies in a cone ahead.",
        "skill2": "Raises the trident and drives it down at a slant: enemies at the target's feet take <#ff9028ff>145<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>195%<> <#ff9028ff>physical damage<> and are <#ef5350ff>stunned for 0.7s<>.",
        "ult": "Gathers himself for <#ffb900ff>0.38s<> (taking <#ffb900ff>30%<> less damage), then a flood of trident images rings the target for <#ffb900ff>6 rounds<> of thrusts, each dealing <#ff9028ff>85<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>115%<> <#ff9028ff>physical damage<> around it; the first <#ef5350ff>roots for 0.75s<>."
      },
      "ragnarok_kojiro": {
        "name": "Sasaki Kojiro",
        "attack": "A long-sword cut for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Prediction<>: each hit on an enemy champion learns one of his moves (up to <#ffb900ff>8<> a foe); every move learned adds <#ffb900ff>3%<> to Kojiro's damage against him. Forgotten when Kojiro dies.",
        "skill": "Cuts down through a cone ahead for <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> <#ff9028ff>physical damage<>, then turns the blade back up for <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<> <#ff9028ff>physical damage<> and a <#ef5350ff>35% slow<>.",
        "skill2": "Reads a thousand ways the fight can go and steps aside: for <#ffb900ff>2.5s<> he takes <#ffb900ff>30%<> less damage and attacks <#ffb900ff>50%<> faster.",
        "ult": "Draws a second sword: a double cut for <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>, then a cross for <#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<> <#ff9028ff>physical damage<> that <#ef5350ff>stuns for 0.6s<>. For <#ffb900ff>8s<> after, two swords: <#ffb900ff>30%<> attack speed and a second cut of <#ffb900ff>40%<> on every attack."
      },
      "ragnarok_heracles": {
        "name": "Heracles",
        "attack": "A blow of the club for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Brand of the Twelve Labors<>: every skill spreads the brand one step (the ultimate two, up to <#ffb900ff>12<>), each step <#ffb900ff>+1%<> attack and <#ffb900ff>+2<> armour and magic resistance. It fades when he dies.",
        "skill": "Thrusts the club and a lion's head charges out: enemies in a cone take <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<> and are <#ef5350ff>slowed 30%<>. Cerberus form: a fist into the ground ahead for <#ff9028ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<> <#ff9028ff>physical damage<>, <#ef5350ff>knocking up<>.",
        "skill2": "Slams the club down: enemies before him take <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> <#ff9028ff>physical damage<> and are <#ef5350ff>stunned for 0.75s<>. Cerberus form: a guard - for <#ffb900ff>2.5s<> he takes <#ffb900ff>35%<> less damage, reflects <#ffb900ff>20%<> and <#ef5350ff>taunts<> enemies around him for <#ef5350ff>1s<>.",
        "ult": "Makes his pact with the hound of Hades, Cerberus form for <#ffb900ff>8s<>: <#ffb900ff>+40%<> attack, <#ffb900ff>+50%<> attack speed, <#ffb900ff>+15%<> move speed, <#ffb900ff>20%<> less damage taken, <#ffb900ff>15%<> life steal. At its end a fist into the ground: <#ff9028ff>140<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150%<> <#ff9028ff>physical damage<> around him, <#ef5350ff>knocking up<>."
      },
      "ragnarok_jack": {
        "name": "Jack the Ripper",
        "attack": "Throws a knife for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Colours of the Heart<>: he sees the colour of every heart, and fear does not hide - <#ffb900ff>+30%<> damage to enemy champions below <#ffb900ff>50%<> health.",
        "skill": "Throws a fan of knives: enemies in a cone take <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>105%<> <#ff9028ff>physical damage<> and are <#ef5350ff>slowed 25%<>.",
        "skill2": "Opens an umbrella his gloves made divine, <#ffb900ff>40%<> less damage until it closes, then steps back into the fog: <#ffb900ff>invisible for 1.5s<>, then <#ffb900ff>+40%<> attack speed for <#ffb900ff>3s<>.",
        "ult": "The eye behind the monocle reads the target; a knife his gloves touched flies as a divine weapon for <#ff9028ff>200<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>180%<> <#ff9028ff>physical damage<>, and for <#ffb900ff>4s<> the target takes <#ffb900ff>20%<> more damage from everyone."
      },
      "ragnarok_raiden": {
        "name": "Raiden Tameemon",
        "attack": "An open-hand thrust for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Muscle Release<>: the first Yatagarasu of each life begins by unbinding the muscles he held back all his life (<#ffb900ff>0.92s<>, unstoppable, <#ffb900ff>50%<> less damage); for the rest of the life <#ffb900ff>+20%<> attack, <#ffb900ff>+20<> armour and magic resistance, <#ffb900ff>+20%<> attack speed.",
        "skill": "Two palm thrusts: the first for <#ff9028ff>55<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> <#ff9028ff>physical damage<>, the second for <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>105%<> <#ff9028ff>physical damage<> that <#ef5350ff>staggers for 0.67s<> and <#ef5350ff>slows 30%<>.",
        "skill2": "Lifts a leg and stamps: enemies around him take <#ff9028ff>65<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>65%<> <#ff9028ff>physical damage<> and are <#ef5350ff>stunned for 1s<>; the aftershock <#ef5350ff>slows 30%<> a wider ring.",
        "ult": "Gathers his strength (unstoppable, <#ffb900ff>40%<> less damage) and thrusts one palm: enemies in a cone take <#ff9028ff>200<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160%<> <#ff9028ff>physical damage<> and are <#ef5350ff>knocked up for 0.75s<> by the shockwave."
      },
      "ragnarok_shiva": {
        "name": "Shiva",
        "attack": "A four-armed sweep for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>; in Tandava Karma a whip of fire for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<>. <#ff9028ff>Rhythm<>: every skill is a beat (up to <#ffb900ff>4<>), each <#ffb900ff>+4%<> attack and <#ffb900ff>+6%<> attack speed; the beats fade after <#ffb900ff>4s<> without a skill.",
        "skill": "Two strikes of his four arms: enemies in a cone take <#ff9028ff>65<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> and <#ff9028ff>75<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>95%<> <#ff9028ff>physical damage<>, the second <#ef5350ff>slowing 25%<>; in Tandava Karma <#ffb900ff>130%<> damage.",
        "skill2": "Dances onto the target; where he lands, enemies around him take <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<> <#ff9028ff>physical damage<> and are <#ef5350ff>slowed 30%<>; in Tandava Karma a step of fire for <#ffb900ff>130%<> damage.",
        "ult": "Sets his heart alight (unstoppable, <#ffb900ff>40%<> less damage): Tandava Karma for <#ffb900ff>8s<>, <#ffb900ff>+35%<> attack, <#ffb900ff>+40%<> attack speed, <#ffb900ff>+15%<> move speed; at its end a high kick for <#ff9028ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150%<> <#ff9028ff>physical damage<> in a cone, <#ef5350ff>knocking up<>."
      },
      "ragnarok_buddha": {
        "name": "Buddha",
        "attack": "A blow of the Six Realms Staff for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Future Sight<>: on an attack or Spear Blade he reads the blows to come (once every <#ffb900ff>8s<>): for <#ffb900ff>1.5s<> basic attacks cannot hurt him.",
        "skill": "The staff becomes a spear for one thrust: enemies in front take <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<> <#ff9028ff>physical damage<> and lose <#ef5350ff>25% armour<> for <#ffb900ff>4s<>.",
        "skill2": "He sees the blow coming and raises the Kannon Shield: a <#e8d44dff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> <#e8d44dff>shield<> for <#ffb900ff>2.5s<>, unstoppable for <#ffb900ff>1s<>. When it is lowered a lotus blooms: enemies around him take <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> <#ff9028ff>physical damage<> and are <#ef5350ff>slowed 30%<>.",
        "ult": "Draws the Great Nirvana Sword Zero (unstoppable and <#ffb900ff>40%<> less damage until it lands) and cuts: enemies in a cone take <#ff9028ff>200<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150%<> plus <#ff9028ff>8%<> of their maximum health as <#ff9028ff>physical damage<> and are <#ef5350ff>stunned for 0.83s<>."
      },
      "ragnarok_zerofuku": {
        "name": "Zerofuku",
        "attack": "Zerofuku hews with the Misery Cleaver, Hajun with his arm blade: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Misfortune<>: enemies Zerofuku hits take <#ffb900ff>8%<> more damage for <#ffb900ff>4s<>. <#ff9028ff>Devour<>: Hajun has <#ffb900ff>8% life steal<>.",
        "skill": "Zerofuku: the cleaver drinks misfortune, grows and falls: enemies in front take <#ff9028ff>62<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<> <#ff9028ff>physical damage<>, are <#ef5350ff>slowed 30%<> and gain Misfortune. Hajun: his forearm turns into a drill and he charges through: enemies on the way take <#ff9028ff>55<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<> and are <#ef5350ff>knocked up<>.",
        "skill2": "Zerofuku: grudge surges from his feet: enemies on a line take <#ff9028ff>55<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>72%<> <#ff9028ff>physical damage<> and are <#ef5350ff>knocked up<>. Hajun: an arm becomes a heavy blade and crushes down: enemies in front take <#ff9028ff>62<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<> <#ff9028ff>physical damage<> and are <#ef5350ff>stunned for 0.75s<>.",
        "ult": "Zerofuku is swallowed by a dark cocoon (unstoppable, <#ffb900ff>40%<> less damage) and Hajun breaks out: heals <#ff9028ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50%<>, and for this life <#ffb900ff>+15%<> attack, <#ffb900ff>+15%<> attack speed, <#ffb900ff>+5%<> speed, <#ffb900ff>+10<> armour and magic resist. Again as Hajun, Demon Sever: enemies in a cone take <#ff9028ff>165<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>125%<> + <#ff9028ff>6%<> max health <#ff9028ff>physical damage<> and are <#ef5350ff>knocked up<>."
      },
      "ragnarok_hades": {
        "name": "Hades",
        "attack": "A thrust of the bident: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Ichor<>: for <#ffb900ff>3s<> after a skill, his next attack deals <#ff9028ff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30%<> more <#ff9028ff>physical damage<>.",
        "skill": "He sweeps the wind of Persephone with his bident: enemies in a cone take <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<> <#ff9028ff>physical damage<> and are <#ef5350ff>slowed 25%<> for <#ffb900ff>1s<>.",
        "skill2": "He smashes the bident into the ground before him: enemies in the circle take <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> <#ff9028ff>physical damage<> and are <#ef5350ff>knocked up for 0.5s<>.",
        "ult": "He forges the Desmos spearhead with his own divine blood (unstoppable, <#ffb900ff>30%<> less damage) and thrusts straight through his target: enemies on the way take <#ff9028ff>160<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<> + <#ff9028ff>8%<> max health <#ff9028ff>physical damage<> and are <#ef5350ff>stunned for 0.75s<>."
      },
      "ragnarok_qin": {
        "name": "Qin Shi Huang",
        "attack": "A strike of his golden claws: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Stars<>: enemies his skills hit show their weak points and take <#ffb900ff>10%<> more damage for <#ffb900ff>3s<>.",
        "skill": "He breathes in and blows a qi bubble that chases the target and bursts: <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> <#ff9028ff>physical damage<> and a <#ef5350ff>0.75s stun<>.",
        "skill2": "He raises the Shinra Armor Sleeves (<#ffb900ff>40%<> less damage and unstoppable for <#ffb900ff>1s<>); allied champions around him gain a <#e8d44dff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50%<> <#e8d44dff>shield<>. Then he turns the force back: enemies in front take <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> <#ff9028ff>physical damage<> and are <#ef5350ff>stunned for 0.67s<>.",
        "ult": "He draws the Goujian sword (unstoppable, <#ffb900ff>40%<> less damage) and cuts across: enemies in a wide cone take <#ff9028ff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<> <#ff9028ff>physical damage<> and are <#ef5350ff>knocked up for 0.83s<>."
      },
      "ragnarok_beelzebub": {
        "name": "Beelzebub",
        "attack": "A vibrating palm: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<> plus <#a974ffff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<> <#a974ffff>magic damage<>. <#ff9028ff>Vibration<>: enemies his skills hit lose <#ffb900ff>20%<> magic resist for <#ffb900ff>4s<>.",
        "skill": "His bone staff sends out a vibration wave: enemies on a line take <#a974ffff>85<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>90%<> <#a974ffff>magic damage<> and are <#ef5350ff>slowed 30%<> for <#ffb900ff>1s<>.",
        "skill2": "He raises a vibrating barrier: a <#e8d44dff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#e8d44dff>60%<> <#e8d44dff>shield<> for <#ffb900ff>2.5s<>, unstoppable for <#ffb900ff>1s<>. Then it shakes apart: enemies around him take <#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<> <#a974ffff>magic damage<> and are <#ef5350ff>slowed 30%<>.",
        "ult": "He compresses the black core of the False God (unstoppable, <#ffb900ff>30%<> less damage), pulls nearby enemies in and bursts: enemies around him take <#a974ffff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>110%<> <#a974ffff>magic damage<> and are <#ef5350ff>stunned for 0.83s<>."
      },
      "ragnarok_tesla": {
        "name": "Nikola Tesla",
        "attack": "A mech punch: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Plasma Pulse<>: every punch deals <#a974ffff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<> more <#a974ffff>magic damage<>.",
        "skill": "Tesla Step dashes at the target: enemies he hits take <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<> <#ff9028ff>physical damage<> and are <#ef5350ff>slowed 30%<>. While God's Prison stands he warps onto the target instead: <#ff9028ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<> <#ff9028ff>physical damage<> and a <#ef5350ff>0.5s stun<>.",
        "skill2": "He drops God's Prison where the target stands: enemies inside take <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<> <#ff9028ff>physical damage<> and are <#ef5350ff>slowed 35%<> for <#ffb900ff>3s<>; meanwhile Tesla Step is a warp.",
        "ult": "Twin plasma fists (unstoppable, <#ffb900ff>30%<> less damage): the first deals <#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<> and a <#ef5350ff>0.5s stun<>; the second fires a bolt: enemies on its line take <#ff9028ff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<> <#ff9028ff>physical damage<> and are <#ef5350ff>knocked up for 0.75s<>."
      },
      "ragnarok_leonidas": {
        "name": "Leonidas",
        "attack": "A shield bash: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Phalanx<>: each skill he casts gives allied champions near him (himself too) <#e8d44dff>+15<> armor and magic resist for <#ffb900ff>3s<>.",
        "skill": "He hurls his chained shield at the target: <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> <#ff9028ff>physical damage<>, a <#ef5350ff>0.75s stun<> and a <#ef5350ff>30% slow<>, then <#ef5350ff>drags it closer<> as he reels the chain in.",
        "skill2": "He raises his shield for <#ffb900ff>2.5s<>: allied champions near him take <#e8d44dff>20%<> less damage, he himself <#e8d44dff>15%<> less again, enemies hitting him take <#ffb900ff>25%<> back and enemies near him are <#ef5350ff>taunted for 1s<>.",
        "ult": "With the Shield of Truth he charges the target (unstoppable, <#ffb900ff>40%<> less damage): on impact enemies around him take <#ff9028ff>200<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<> <#ff9028ff>physical damage<> and are <#ef5350ff>knocked up for 0.83s<>."
      },
      "ragnarok_apollo": {
        "name": "Apollo",
        "attack": "A sun-wheel punch: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Sun Wheel<>: after each skill his next punch within <#ffb900ff>4s<> deals <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50%<> more <#ff9028ff>physical damage<>.",
        "skill": "He casts Artemis's Thread round the target: <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<> <#ff9028ff>physical damage<> and a <#ef5350ff>1s root<>.",
        "skill2": "A bow of light forms and looses a homing arrow: <#ff9028ff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<> <#ff9028ff>physical damage<>.",
        "ult": "Artemis's statue draws the cords of light and shoots him at the target as a silver arrow (unstoppable, <#ffb900ff>30%<> less damage): the enemy he strikes takes <#ff9028ff>260<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>200%<> <#ff9028ff>physical damage<> and a <#ef5350ff>0.5s stun<>."
      },
      "ragnarok_okita": {
        "name": "Okita Soji",
        "attack": "A cut: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Sword Time<>: his blade packs a life's swordsmanship into one moment; after each skill he attacks <#ffb900ff>30%<> faster for <#ffb900ff>3s<>.",
        "skill": "Sandanzuki, three godspeed thrusts, each dealing <#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>45%<> <#ff9028ff>physical damage<> in front of him, the third <#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30%<> more.",
        "skill2": "Demon Child: for <#ffb900ff>5s<> he gains <#ffb900ff>20%<> attack, <#ffb900ff>30%<> attack speed and <#ffb900ff>15%<> move speed.",
        "ult": "Tensho Sandanzuki: he lunges at blinding speed (unstoppable) and thrusts three times, each for <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%<> <#ff9028ff>physical damage<>, the third plus <#ffb900ff>10%<> of the target's max health."
      },
      "ragnarok_susanoo": {
        "name": "Susanoo",
        "attack": "A cut: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Ama no Magaeshi: Mugen<>: every third cut throws an uncharged vacuum blade, <#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40%<> <#ff9028ff>physical damage<> along a line.",
        "skill": "Ama no Magaeshi: from his strange stance he cuts the air into a crescent vacuum blade: <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%<> along a line and <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50%<> more to enemies close in front, <#ff9028ff>physical damage<> (weaker with distance).",
        "skill2": "Shinra Yaoyorozu: in a plain seigan stance basic attacks cannot hurt him and skills deal <#ffb900ff>40%<> less; then he answers: <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> <#ff9028ff>physical damage<> in front and a <#ef5350ff>0.75s stun<>.",
        "ult": "Musoken: an unseen sword swung with empty hands (unstoppable) cuts only the bones: <#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<> plus <#ffb900ff>8%<> of max health as <#ffffffff>true damage<>, slowed and weakened for <#ef5350ff>3s<>; each swing costs him <#ffb900ff>5%<> max health."
      },
      "ragnarok_simo": {
        "name": "Simo Häyhä",
        "attack": "A Mosin-Nagant shot: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Reaper's Contract<>: his skills fire his organs as god-killing rounds, each costing <#ffb900ff>3%<> of his max health (never fatal).",
        "skill": "Sniping Against the Gods, three rounds in turn: Ilmatar bursts mid-air over a wide cone for <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<>; Lemminkäinen pierces a line for <#ff9028ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>105%<>; Mielikki, a 0.5 s shot, deals <#ff9028ff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<> <#ff9028ff>physical damage<>.",
        "skill2": "He raises a veil of snow and leaps back, <#ffb900ff>invisible for 1.25s<> with <#ffb900ff>30%<> more move speed: the snow covers his tracks.",
        "ult": "His fastest, strongest round: <#ff9028ff>250<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>200%<> plus <#ffb900ff>10%<> of the target's max health as <#ff9028ff>physical damage<>."
      },
      "ragnarok_loki": {
        "name": "Loki",
        "attack": "A flicked phantom blade: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Hveðrung<>: his full-power double copies his moves; an enemy hit by his chained hook is hooked again for <#a974ffff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>25%<> <#a974ffff>magic damage<>.",
        "skill": "A hook lashes from the gate in his palm: <#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<> <#a974ffff>magic damage<> and a <#ef5350ff>30% slow<>.",
        "skill2": "Seed of Trickery: a copy rises from black mist where he stood, and Endurlífa swaps him with a copy further back: <#ffb900ff>invisible for 1.5s<>, <#ffb900ff>25%<> more move speed.",
        "ult": "Heimskringla: an army of copied gods' weapons rises round the target (unstoppable while he casts), <#ffb900ff>3 waves<> of <#a974ffff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<> <#a974ffff>magic damage<> and a <#ef5350ff>30% slow<>."
      }
    },
