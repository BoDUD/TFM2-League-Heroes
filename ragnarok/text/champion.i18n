  "ja": {
    "description": {
      "ragnarok_lubu": {
        "name": "呂布奉先",
        "attack": "方天画戟の一撃で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>シールドブレイカー<>：物理防御の<#ffb900ff>15%<>を無視、シールドへのダメージ+<#ffb900ff>100%<>、シールドを砕くと<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30%<>の物理ダメージを追加。",
        "skill": "方天画戟で前方の扇状範囲を薙ぎ払い、<#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<>の<#ff9028ff>物理ダメージ<>と<#ffb900ff>1.5秒<>間<#ffb900ff>40%<>のスロウ。",
        "skill2": "目標へ敵陣を突き破って突進：通り道の敵に<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>0.6秒のノックアップ<>。",
        "ult": "<#ffb900ff>1.2秒<>力を溜め（行動妨害無効、被ダメージ<#ffb900ff>30%<>軽減）、目標の方向へ天喰を放つ：直線上の敵に<#ff9028ff>200<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>280%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>0.8秒のスタン<>。"
      },
      "ragnarok_thor": {
        "name": "トール",
        "attack": "雷槌の一撃で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>ミョルニル覚醒<>：スキルを<#ffb900ff>3回<>使うごとにミョルニルが<#ffb900ff>6秒<>覚醒：通常攻撃に<#a974ffff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#a974ffff>3%<>の<#a974ffff>魔法ダメージ<>を追加、トールハンマーは<#ef5350ff>1.1秒のスタン<>。",
        "skill": "槌を振り下ろし、<#ffb900ff>0.43秒<>後に前方で雷が炸裂：敵に<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>4%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>0.7秒のスタン<>（覚醒時<#ef5350ff>1.1秒<>）。",
        "skill2": "目標の方向へミョルニルを投げ、手元へ戻ってくる：往復で通った敵に<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>2%<>の<#ff9028ff>物理ダメージ<>と<#ffb900ff>1秒<>間<#ffb900ff>40%<>のスロウ。戻るまでその場で待ち、受け止めると<#e8d44dff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#e8d44dff>50%<>の<#e8d44dff>シールド<>（<#ffb900ff>2.5秒<>）。",
        "ult": "ミョルニルが即座に<#ffb900ff>8秒<>覚醒、<#ffb900ff>1.25秒<>力を溜め（行動妨害無効、被ダメージ<#ffb900ff>45%<>軽減）、前方を叩き潰す：敵に<#ff9028ff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>8%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>1.5秒のノックアップ<>。"
      },
      "ragnarok_zeus": {
        "name": "ゼウス",
        "attack": "素早いジャブで<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>筋肉膨張<>：老人の姿で<#ffb900ff>3発<>打つと次の一発の代わりに膨張（<#ffb900ff>1.02秒<>、行動妨害無効）、完了時に周囲の敵へ<#ff9028ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<>の<#ff9028ff>物理ダメージ<>と<#ffb900ff>30%<>のスロウ。膨張後は攻撃力+<#ffb900ff>25%<>、防御と魔法防御+<#ffb900ff>35%<>。",
        "skill": "二連打、各<#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>65%<>の<#ff9028ff>物理ダメージ<>。膨張中は二発目が<#ffb900ff>1秒<>間<#ffb900ff>40%<>のスロウ、阿陀磨須なら<#ef5350ff>0.6秒のスタン<>。",
        "skill2": "時を超える拳：拳を振るより先に当たっている。<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>0.5秒のスタン<>（阿陀磨須なら<#ef5350ff>0.9秒<>）。",
        "ult": "膨張した筋肉を<#ffb900ff>1.03秒<>圧縮（老人なら先に膨張、行動妨害無効、被ダメージ<#ffb900ff>50%<>軽減）し、周囲の敵を吹き飛ばす：<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>0.7秒のノックアップ<>、<#ffb900ff>10秒<>阿陀磨須で戦う：攻撃力+<#ffb900ff>45%<>、両防御+<#ffb900ff>60%<>、攻撃速度+<#ffb900ff>30%<>、吸血<#ffb900ff>25%<>。終わると老人に戻る。"
      },
      "ragnarok_adam": {
        "name": "アダム",
        "attack": "素早いジャブで<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>神虚視<>で読んだ技を<#ffb900ff>5秒<>覚え、覚えていれば<#ff9028ff>模倣カウンター<>がその技を写す。",
        "skill": "神虚視で相手の動きを読みかわす：<#ffb900ff>2.5秒<>間通常攻撃はすべて外れ、受けるスキルダメージ<#ffb900ff>50%<>軽減、技をひとつ覚える。",
        "skill2": "カウンターの一撃で<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。覚えた技があれば写して<#ff9028ff>60<>と対象の最大体力<#ffb900ff>8%<>を上乗せし<#ef5350ff>1秒スタン<>、記憶を使う。",
        "ult": "ゼウスから写した拳：<#ffb900ff>0.43秒<>溜め（行動妨害無効、被ダメージ<#ffb900ff>50%<>軽減）、標的へ拳圧を放ち、通り道の敵に<#ff9028ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>0.8秒のノックアップ<>。"
      },
      "ragnarok_poseidon": {
        "name": "ポセイドン",
        "attack": "三叉槍の水平突きで<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>神は何者にも頼らず<>：近くに味方チャンピオンがいないと攻撃力<#ffb900ff>+15%<>、被ダメージ<#ffb900ff>10%<>軽減。",
        "skill": "一歩踏み込み前方へ<#ffb900ff>4回<>連続で突き、毎回前方扇形の敵に<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>85%<>の<#ff9028ff>物理ダメージ<>。",
        "skill2": "三叉槍を掲げ斜めに突き下ろし、対象の足元の敵に<#ff9028ff>145<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>195%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>0.7秒スタン<>。",
        "ult": "<#ffb900ff>0.38秒<>溜め（被ダメージ<#ffb900ff>30%<>軽減）、槍影が洪水のように対象を囲み<#ffb900ff>6回<>突く。毎回周囲の敵に<#ff9028ff>85<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>115%<>の<#ff9028ff>物理ダメージ<>、初撃で<#ef5350ff>0.75秒拘束<>。"
      },
      "ragnarok_kojiro": {
        "name": "佐々木小次郎",
        "attack": "長刀の一太刀で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>予測<>：敵チャンピオンに当てるたびにその技を一つ覚え（一人<#ffb900ff>8つ<>まで）、以後その敵へのダメージが一つごとに<#ffb900ff>+3%<>。倒れると覚え直し。",
        "skill": "前方扇形に斬り下ろし<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<>の<#ff9028ff>物理ダメージ<>、返す刃で斬り上げ<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>35%スロウ<>。",
        "skill2": "千の手を読み身をかわす：<#ffb900ff>2.5秒<>間被ダメージ<#ffb900ff>30%<>軽減、攻撃速度<#ffb900ff>+50%<>。",
        "ult": "二本目の刀を抜き、二刀で斬り<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>、交差の一太刀で<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>0.6秒スタン<>。以後<#ffb900ff>8秒<>二刀：攻撃速度<#ffb900ff>+30%<>、通常攻撃に<#ffb900ff>40%<>の追い太刀。"
      },
      "ragnarok_heracles": {
        "name": "ヘラクレス",
        "attack": "棍棒の一撃で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>十二の御業の刻印<>：スキルのたびに刻印が一つ広がり（奥義は二つ、最大<#ffb900ff>12<>）、一つごとに攻撃力<#ffb900ff>+1%<>、物理・魔法防御<#ffb900ff>+2<>。倒れると消える。",
        "skill": "棍棒を突き出し獅子の頭が飛び出す：前方扇形の敵に<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>30%スロウ<>。ケルベロス形態：地面への拳で<#ff9028ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>打ち上げ<>。",
        "skill2": "棍棒を叩きつけ前方の敵に<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>0.75秒スタン<>。ケルベロス形態：構え、<#ffb900ff>2.5秒<>間被ダメージ<#ffb900ff>35%<>軽減・<#ffb900ff>20%<>反射、周囲の敵を<#ef5350ff>1秒挑発<>。",
        "ult": "冥府の番犬と契約し<#ffb900ff>8秒<>ケルベロス形態：攻撃力<#ffb900ff>+40%<>、攻撃速度<#ffb900ff>+50%<>、移動速度<#ffb900ff>+15%<>、被ダメージ<#ffb900ff>20%<>軽減、吸血<#ffb900ff>15%<>。終わりに地面へ拳：周囲に<#ff9028ff>140<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>打ち上げ<>。"
      },
      "ragnarok_jack": {
        "name": "切り裂きジャック",
        "attack": "ナイフを投げ<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>心の色<>：人の心が色で見える。体力<#ffb900ff>50%<>未満の敵チャンピオンへのダメージ<#ffb900ff>+30%<>。",
        "skill": "ナイフを扇状に投げ、前方の敵に<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>105%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>25%スロウ<>。",
        "skill2": "手袋で神器となった傘を開き、閉じるまで被ダメージ<#ffb900ff>40%<>軽減。霧の中へ退き<#ffb900ff>1.5秒透明化<>、その後<#ffb900ff>3秒<>攻撃速度<#ffb900ff>+40%<>。",
        "ult": "片眼鏡の奥の目が相手を見抜き、手袋が触れたナイフが神器となって飛ぶ：<#ff9028ff>200<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>180%<>の<#ff9028ff>物理ダメージ<>、以後<#ffb900ff>4秒<>相手の被ダメージ<#ffb900ff>+20%<>。"
      }
    },
