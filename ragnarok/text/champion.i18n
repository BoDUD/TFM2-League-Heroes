  "ko": {
    "description": {
      "ragnarok_lubu": {
        "name": "여포 봉선",
        "attack": "방천화극으로 내리쳐 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>물리 피해<>. <#ff9028ff>방패 파괴자<>: 방어력 <#ffb900ff>15%<> 무시; 보호막에 주는 피해 <#ffb900ff>100%<> 증가, 보호막을 깨면 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30%<> 물리 피해 추가.",
        "skill": "방천화극으로 전방 부채꼴을 휩쓸어 <#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<> <#ff9028ff>물리 피해<>와 <#ffb900ff>1.5초<> 동안 <#ffb900ff>40%<> 둔화.",
        "skill2": "대상을 향해 적진을 꿰뚫고 돌격: 경로의 적에게 <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>물리 피해<>와 <#ef5350ff>0.6초 에어본<>.",
        "ult": "<#ffb900ff>1.2초<> 동안 힘을 모은 뒤(군중 제어 면역, 받는 피해 <#ffb900ff>30%<> 감소) 대상 쪽으로 하늘을 베는 천식: 직선 위의 적에게 <#ff9028ff>200<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>280%<> <#ff9028ff>물리 피해<>와 <#ef5350ff>0.8초 기절<>."
      },
      "ragnarok_thor": {
        "name": "토르",
        "attack": "묠니르로 내리쳐 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>물리 피해<>. <#ff9028ff>묠니르 각성<>: 스킬을 <#ffb900ff>3번<> 쓸 때마다 묠니르가 <#ffb900ff>6초<> 각성: 기본 공격에 <#a974ffff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#a974ffff>3%<> <#a974ffff>마법 피해<> 추가, 토르 해머 <#ef5350ff>기절 1.1초<>.",
        "skill": "망치를 내리쳐 <#ffb900ff>0.43초<> 뒤 번개가 앞쪽 땅에서 터진다: 적에게 <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>4%<> <#ff9028ff>물리 피해<>와 <#ef5350ff>0.7초 기절<>(각성 시 <#ef5350ff>1.1초<>).",
        "skill2": "대상 방향으로 묠니르를 던지면 손으로 돌아온다: 오가며 지나친 적에게 <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>2%<> <#ff9028ff>물리 피해<>와 <#ffb900ff>1초<> 동안 <#ffb900ff>40%<> 둔화. 돌아올 때까지 제자리에서 기다리고, 받아내면 <#e8d44dff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#e8d44dff>50%<> <#e8d44dff>보호막<>(<#ffb900ff>2.5초<>).",
        "ult": "묠니르가 즉시 <#ffb900ff>8초<> 각성하고 <#ffb900ff>1.25초<> 동안 힘을 모은 뒤(군중 제어 면역, 받는 피해 <#ffb900ff>45%<> 감소) 앞쪽을 내리친다: 적에게 <#ff9028ff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>8%<> <#ff9028ff>물리 피해<>와 <#ef5350ff>1.5초 에어본<>."
      },
      "ragnarok_zeus": {
        "name": "제우스",
        "attack": "빠른 잽으로 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>물리 피해<>. <#ff9028ff>근육 팽창<>: 노인 상태로 <#ffb900ff>3번<> 때리면 다음 주먹 대신 팽창(<#ffb900ff>1.02초<>, 군중 제어 면역)하고, 끝날 때 주변 적에게 <#ff9028ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> <#ff9028ff>물리 피해<>와 <#ffb900ff>30%<> 둔화; 팽창 후 공격력 +<#ffb900ff>25%<>, 방어력·마법 저항력 +<#ffb900ff>35%<>.",
        "skill": "두 번 연속 주먹, 각 <#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>65%<> <#ff9028ff>물리 피해<>; 팽창 상태면 두 번째 주먹이 <#ffb900ff>1초<> 동안 <#ffb900ff>40%<> 둔화, 아다마스 상태면 <#ef5350ff>0.6초 기절<>.",
        "skill2": "시간보다 빠른 주먹: 주먹을 뻗기 전에 이미 맞는다. <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<> <#ff9028ff>물리 피해<>와 <#ef5350ff>0.5초 기절<>(아다마스 <#ef5350ff>0.9초<>).",
        "ult": "팽창한 근육을 <#ffb900ff>1.03초<> 동안 압축(노인 상태면 먼저 팽창; 군중 제어 면역, 받는 피해 <#ffb900ff>50%<> 감소)한 뒤 주변 적을 날린다: <#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>물리 피해<>와 <#ef5350ff>0.7초 에어본<>, <#ffb900ff>10초<> 동안 아다마스: 공격력 +<#ffb900ff>45%<>, 방어·마저 +<#ffb900ff>60%<>, 공격 속도 +<#ffb900ff>30%<>, 생명력 흡수 <#ffb900ff>25%<>. 끝나면 노인으로 돌아온다."
      },
      "ragnarok_adam": {
        "name": "아담",
        "attack": "빠른 잽으로 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>물리 피해<>. <#ff9028ff>신허시<>로 읽은 기술은 <#ffb900ff>5초<> 동안 기억하며, 기억이 있으면 <#ff9028ff>모방 반격<>이 그 기술을 따라 한다.",
        "skill": "신허시로 상대의 움직임을 읽고 피한다: <#ffb900ff>2.5초<> 동안 기본 공격이 모두 빗나가고 받는 스킬 피해 <#ffb900ff>50%<> 감소, 기술 하나를 기억한다.",
        "skill2": "반격 주먹으로 <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>물리 피해<>. 기억한 기술이 있으면 따라 해서 <#ff9028ff>60<>와 대상 최대 체력의 <#ffb900ff>8%<> 피해를 더하고 <#ef5350ff>1초 기절<>시키며 기억을 쓴다.",
        "ult": "제우스에게서 배운 주먹: <#ffb900ff>0.43초<> 동안 힘을 모은 뒤(군중 제어 면역, 받는 피해 <#ffb900ff>50%<> 감소) 대상을 향해 주먹 기운을 날려 경로의 적에게 <#ff9028ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150%<> <#ff9028ff>물리 피해<>와 <#ef5350ff>0.8초 에어본<>."
      },
      "ragnarok_poseidon": {
        "name": "포세이돈",
        "attack": "삼지창 수평 찌르기로 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>물리 피해<>. <#ff9028ff>신은 기대지 않는다<>: 주변에 아군 챔피언이 없으면 공격력 <#ffb900ff>+15%<>, 받는 피해 <#ffb900ff>10%<> 감소.",
        "skill": "한 걸음 내디디며 앞쪽으로 <#ffb900ff>4번<> 연속으로 찔러, 매번 앞쪽 부채꼴의 적에게 <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>85%<> <#ff9028ff>물리 피해<>.",
        "skill2": "삼지창을 들어 비스듬히 내리찍어, 대상 발밑의 적에게 <#ff9028ff>145<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>195%<> <#ff9028ff>물리 피해<>와 <#ef5350ff>0.7초 기절<>.",
        "ult": "<#ffb900ff>0.38초<> 동안 힘을 모은 뒤(받는 피해 <#ffb900ff>30%<> 감소) 삼지창의 그림자가 홍수처럼 대상을 에워싸 <#ffb900ff>6번<> 찌르며, 매번 주변의 적에게 <#ff9028ff>85<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>115%<> <#ff9028ff>물리 피해<>, 첫 번째는 <#ef5350ff>0.75초 속박<>."
      },
      "ragnarok_kojiro": {
        "name": "사사키 코지로",
        "attack": "장검으로 베어 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>물리 피해<>. <#ff9028ff>예측<>: 적 챔피언을 맞힐 때마다 그 수를 하나 익혀(한 명당 최대 <#ffb900ff>8수<>) 그 적에게 주는 피해가 수마다 <#ffb900ff>+3%<>. 죽으면 처음부터.",
        "skill": "앞쪽 부채꼴을 내려베어 <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> <#ff9028ff>물리 피해<>, 곧바로 칼날을 되돌려 올려베어 <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<> <#ff9028ff>물리 피해<>와 <#ef5350ff>35% 둔화<>.",
        "skill2": "천 가지 수를 미리 읽고 몸을 비켜 <#ffb900ff>2.5초<> 동안 받는 피해 <#ffb900ff>30%<> 감소, 공격 속도 <#ffb900ff>+50%<>.",
        "ult": "두 번째 검을 뽑아 쌍검으로 베어 <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>물리 피해<>, 엇갈려 베어 <#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<> <#ff9028ff>물리 피해<>와 <#ef5350ff>0.6초 기절<>. 이후 <#ffb900ff>8초<> 쌍검: 공격 속도 <#ffb900ff>+30%<>, 평타마다 <#ffb900ff>40%<> 추가 베기."
      },
      "ragnarok_heracles": {
        "name": "헤라클레스",
        "attack": "곤봉으로 내려쳐 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>물리 피해<>. <#ff9028ff>열두 과업의 각인<>: 스킬을 쓸 때마다 각인이 한 칸 번진다(궁극기는 두 칸, 최대 <#ffb900ff>12칸<>). 칸마다 공격력 <#ffb900ff>+1%<>, 방어력과 마법 저항력 <#ffb900ff>+2<>. 죽으면 사라짐.",
        "skill": "곤봉을 내지르자 사자 머리가 뛰쳐나가 앞쪽 부채꼴의 적에게 <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>물리 피해<>와 <#ef5350ff>30% 둔화<>. 케르베로스 형태: 땅을 내리찍는 주먹으로 <#ff9028ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<> <#ff9028ff>물리 피해<>와 <#ef5350ff>에어본<>.",
        "skill2": "곤봉으로 땅을 내리쳐 앞의 적에게 <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> <#ff9028ff>물리 피해<>와 <#ef5350ff>0.75초 기절<>. 케르베로스 형태: 방어 자세로 <#ffb900ff>2.5초<> 동안 받는 피해 <#ffb900ff>35%<> 감소, <#ffb900ff>20%<> 반사, 주변의 적 <#ef5350ff>1초 도발<>.",
        "ult": "명계의 문지기 개와 계약해 <#ffb900ff>8초<> 동안 케르베로스 형태: 공격력 <#ffb900ff>+40%<>, 공격 속도 <#ffb900ff>+50%<>, 이동 속도 <#ffb900ff>+15%<>, 받는 피해 <#ffb900ff>20%<> 감소, 흡혈 <#ffb900ff>15%<>. 끝날 때 땅을 내리찍어 주변에 <#ff9028ff>140<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150%<> <#ff9028ff>물리 피해<>와 <#ef5350ff>에어본<>."
      },
      "ragnarok_jack": {
        "name": "잭 더 리퍼",
        "attack": "단검을 던져 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>물리 피해<>. <#ff9028ff>마음의 색<>: 사람의 마음이 색으로 보인다. 체력이 <#ffb900ff>50%<> 아래인 적 챔피언에게 피해 <#ffb900ff>+30%<>.",
        "skill": "단검을 부채꼴로 던져 앞쪽 적에게 <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>105%<> <#ff9028ff>물리 피해<>와 <#ef5350ff>25% 둔화<>.",
        "skill2": "장갑으로 신기가 된 우산을 펼쳐 접을 때까지 받는 피해 <#ffb900ff>40%<> 감소, 뒤로 물러나 안개 속으로: <#ffb900ff>1.5초 은신<>, 이후 <#ffb900ff>3초<> 동안 공격 속도 <#ffb900ff>+40%<>.",
        "ult": "외알 안경 너머의 눈이 상대를 꿰뚫어 보고, 장갑이 닿은 칼이 신기가 되어 날아가 <#ff9028ff>200<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>180%<> <#ff9028ff>물리 피해<>. 이후 <#ffb900ff>4초<> 동안 상대가 받는 피해 <#ffb900ff>+20%<>."
      }
    },
