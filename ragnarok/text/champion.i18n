      "ragnarok_okita": {
        "name": "沖田總司",
        "attack": "一刀，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>劍之刻<>：刀把他一生的劍技壓進一刻，每放一個技能，<#ffb900ff>3秒<>內攻速提高<#ffb900ff>30%<>。",
        "skill": "神速三刺，每刺對前方敵人造成<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<><#ff9028ff>物理傷害<>，第三刺再加<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40%<>。",
        "skill2": "變成鬼子：<#ffb900ff>5秒<>內攻擊力提高<#ffb900ff>25%<>、攻速提高<#ffb900ff>40%<>、移速提高<#ffb900ff>20%<>。",
        "ult": "極快地突進（不受控制），連刺三下，每刺一道真空刃飛出、刺到刀夠不到的地方：一條線上的敵人受到<#ff9028ff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50%<><#ff9028ff>物理傷害<>，第三刺再加目標<#ffb900ff>8%<>最大生命。"
      },
      "ragnarok_susanoo": {
        "name": "須佐之男",
        "attack": "一刀，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>天魔反·無間<>：每第三刀不蓄力地帶出一道真空刃，一條線上的敵人受到<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50%<><#ff9028ff>物理傷害<>。",
        "skill": "擺出天魔反的架勢揮刀，月牙真空刃飛出，一條線上的敵人受到<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<>，身前的敵人再受<#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<><#ff9028ff>物理傷害<>（越遠越弱）。",
        "skill2": "擺出正眼構：普攻打不疼他、技能傷害降低<#ffb900ff>40%<>；隨後回敬一刀，前方敵人受到<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<><#ff9028ff>物理傷害<>並<#ef5350ff>暈眩0.75秒<>。",
        "ult": "空手揮出看不見的劍（不受控制），只砍骨頭：<#ff9028ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<>加目標<#ffb900ff>8%<>最大生命的<#ffffffff>真實傷害<>，<#ef5350ff>3秒<>內緩速、攻擊力降低；每揮一次自損<#ffb900ff>5%<>最大生命。"
      },
      "ragnarok_simo": {
        "name": "西蒙·海耶",
        "attack": "莫辛-納干一槍，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>死神的契約<>：技能射出的是器官換來的弒神彈，每發先付<#ffb900ff>3%<>最大生命（不會因此陣亡）。",
        "skill": "對神狙擊術，三發輪流：萬花繚亂半空炸開，扇形內<#ff9028ff>85<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>95%<>；天穿白鳥貫穿一列，<#ff9028ff>105<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>125%<>；精靈的氣息神速一槍，<#ff9028ff>130<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160%<><#ff9028ff>物理傷害<>。",
        "skill2": "揚起雪幕往後一躍，<#ffb900ff>隱身1.25秒<>，移速提高<#ffb900ff>30%<>（落雪蓋住腳印）。",
        "ult": "最快最強的一發，造成<#ff9028ff>300<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>230%<>加目標<#ffb900ff>10%<>最大生命的<#ff9028ff>物理傷害<>。"
      },
      "ragnarok_loki": {
        "name": "洛基",
        "attack": "彈出幻刃，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>虛偽之神影<>：滿力的分身照著他出招，鎖鏈鉤打中的敵人再挨分身一鉤，<#a974ffff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<><#a974ffff>魔法傷害<>。",
        "skill": "掌心開門甩出鉤刃，造成<#a974ffff>170<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>140%<><#a974ffff>魔法傷害<>並<#ef5350ff>緩速30%<>。",
        "skill2": "黑霧裡造出複製體留在原地，自己和遠處的複製體換位，<#ffb900ff>隱身1.5秒<>，移速提高<#ffb900ff>25%<>。",
        "ult": "目標周圍冒出複製來的神兵大軍（不受控制），<#ffb900ff>4輪<>各造成<#a974ffff>280<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>130%<><#a974ffff>魔法傷害<>並<#ef5350ff>緩速30%<>。"
      },
      "ragnarok_kintoki": {
        "name": "坂田金時",
        "attack": "橫掃一斧，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>鬼之血<>：每損失1%生命，攻擊力提高<#ffb900ff>0.4%<>（最多<#ffb900ff>30%<>）。被奧丁的岡格尼爾打中時徒手接住，只受<#ffb900ff>50%<>傷害並把槍擲回去。",
        "skill": "斧刃伸出巨大的斧形光刃，一斧劈出，一路造成<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<><#ff9028ff>物理傷害<>；斧落地時身前的敵人再受<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<><#ff9028ff>物理傷害<>。",
        "skill2": "踏穩前腳，一下竄到敵方英雄身後，途中橫斬，造成<#ff9028ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<><#ff9028ff>物理傷害<>並<#ef5350ff>緩速30%<>，持續<#ffb900ff>1秒<>。",
        "ult": "右手的神性之證亮起（不受控制），金光大斧砸地：前方敵人受到<#ff9028ff>250<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>170%<><#ff9028ff>物理傷害<>並被<#ef5350ff>擊飛0.75秒<>，護盾先被擊碎（連奧丁的神環封壁）。"
      },
      "ragnarok_odin": {
        "name": "奧丁",
        "attack": "以岡格尼爾刺擊，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>加<#a974ffff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>25%<><#a974ffff>魔法傷害<>。<#ff9028ff>波命湧出<>：生命低於<#ffb900ff>35%<>時項鍊化作光藤縫合傷口，<#ffb900ff>2秒<>內回復<#ffb900ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#ffb900ff>60%<>生命（冷卻<#ffb900ff>90秒<>）。",
        "skill": "符文纏住岡格尼爾擲出，追著敵方英雄飛、一定打中：<#a974ffff>160<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>105%<><#a974ffff>魔法傷害<>，無視魔抗，護盾擋不住。",
        "skill2": "五面刻著古諾爾斯文的盾繞身旋轉<#ffb900ff>4秒<>，每面完全擋下一次傷害。",
        "ult": "叩槍齊唱（不受控制），符文掃過周圍敵人：<#a974ffff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>95%<><#a974ffff>魔法傷害<>，身體只聽奧丁的：<#ef5350ff>繳械1.25秒<>、<#ffb900ff>3秒<>內<#ef5350ff>緩速30%<>，之後三秒每秒受到越來越重的<#a974ffff>魔法傷害<>。"
      }
    },
