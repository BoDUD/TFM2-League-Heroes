  "en": {
    "description": {
      "ragnarok_lubu": {
        "name": "Lu Bu",
        "attack": "Swings the Sky Piercer for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Shield Breaker<>: ignores <#ffb900ff>15%<> armor; deals <#ffb900ff>100%<> more damage to shields, and breaking a shield deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30%<> more physical damage.",
        "skill": "Sweeps the halberd through a cone in front, dealing <#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<> <#ff9028ff>physical damage<> and slowing by <#ffb900ff>40%<> for <#ffb900ff>1.5s<>.",
        "skill2": "Charges through the enemy line toward the target: enemies in his path take <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<> and are <#ef5350ff>knocked up for 0.6s<>.",
        "ult": "Gathers himself for <#ffb900ff>1.2s<> (unstoppable, taking <#ffb900ff>30%<> less damage), then cuts the sky toward the target: enemies on the line take <#ff9028ff>200<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>280%<> <#ff9028ff>physical damage<> and are <#ef5350ff>stunned for 0.8s<>."
      },
      "ragnarok_thor": {
        "name": "Thor",
        "attack": "Strikes with Mjolnir for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Mjolnir Awakening<>: every <#ffb900ff>third<> skill cast awakens Mjolnir for <#ffb900ff>6s<>: his attacks add <#a974ffff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#a974ffff>3%<> <#a974ffff>magic damage<> and Thor's Hammer <#ef5350ff>stuns for 1.1s<>.",
        "skill": "Brings the hammer down: after <#ffb900ff>0.43s<> lightning bursts through the ground ahead, dealing <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>4%<> <#ff9028ff>physical damage<> and <#ef5350ff>stunning for 0.7s<> (<#ef5350ff>1.1s<> awakened).",
        "skill2": "Throws Mjolnir toward the target and it flies back to his hand, hitting every enemy it passes both ways for <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>2%<> <#ff9028ff>physical damage<> and slowing by <#ffb900ff>40%<> for <#ffb900ff>1s<>. He waits empty-handed until it returns; the catch grants a <#e8d44dff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#e8d44dff>50%<> <#e8d44dff>shield<> for <#ffb900ff>2.5s<>.",
        "ult": "Awakens Mjolnir at once for <#ffb900ff>8s<>, gathers himself for <#ffb900ff>1.25s<> (unstoppable, taking <#ffb900ff>45%<> less damage), then smashes the ground ahead: enemies take <#ff9028ff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>8%<> <#ff9028ff>physical damage<> and are <#ef5350ff>knocked up for 1.5s<>."
      },
      "ragnarok_zeus": {
        "name": "Zeus",
        "attack": "A quick jab for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Muscle Expansion<>: after <#ffb900ff>3 punches<> as the old man, his next one swells him up instead (<#ffb900ff>1.02s<>, unstoppable), shaking nearby enemies for <#ff9028ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> <#ff9028ff>physical damage<> and slowing by <#ffb900ff>30%<>; swollen, he gains <#ffb900ff>25%<> attack and <#ffb900ff>35%<> armor and magic resistance.",
        "skill": "Two quick punches, each <#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>65%<> <#ff9028ff>physical damage<>; swollen, the second slows by <#ffb900ff>40%<> for <#ffb900ff>1s<>, as Adamas it <#ef5350ff>stuns for 0.6s<>.",
        "skill2": "A punch faster than time: the blow lands before he throws it, <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<> <#ff9028ff>physical damage<> and a <#ef5350ff>0.5s stun<> (<#ef5350ff>0.9s<> as Adamas).",
        "ult": "Presses his swollen muscles down for <#ffb900ff>1.03s<> (the old man swells first; unstoppable, taking <#ffb900ff>50%<> less damage), then blasts nearby enemies for <#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>, <#ef5350ff>knocking them up for 0.7s<>, and fights as Adamas for <#ffb900ff>10s<>: +<#ffb900ff>45%<> attack, +<#ffb900ff>60%<> armor and magic resistance, +<#ffb900ff>30%<> attack speed, <#ffb900ff>25%<> lifesteal. Then he is old again."
      },
      "ragnarok_adam": {
        "name": "Adam",
        "attack": "A quick jab for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>God Reader<> remembers a move it has read (<#ffb900ff>5s<>); with one remembered, <#ff9028ff>Mimic Counter<> copies it.",
        "skill": "Opens his God Reader eyes and slips aside: for <#ffb900ff>2.5s<> basic attacks miss him and skills deal <#ffb900ff>50%<> less damage; he remembers a move.",
        "skill2": "A counter punch for <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. With a remembered move he copies it: <#ff9028ff>60<> more plus <#ffb900ff>8%<> of the target's max health and a <#ef5350ff>1s stun<>, using the move up.",
        "ult": "The punch he copied from Zeus: winds up for <#ffb900ff>0.43s<> (unstoppable, taking <#ffb900ff>50%<> less damage), then drives a blast at the target that deals <#ff9028ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150%<> <#ff9028ff>physical damage<> to enemies in its path and <#ef5350ff>knocks them up for 0.8s<>."
      },
      "ragnarok_poseidon": {
        "name": "Poseidon",
        "attack": "A level trident thrust for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>A God Needs No One<>: with no allied champion near him he gains <#ffb900ff>15%<> attack and takes <#ffb900ff>10%<> less damage.",
        "skill": "Steps in and thrusts <#ffb900ff>4 times<>, each dealing <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>85%<> <#ff9028ff>physical damage<> to enemies in a cone ahead.",
        "skill2": "Raises the trident and drives it down at a slant: enemies at the target's feet take <#ff9028ff>145<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>195%<> <#ff9028ff>physical damage<> and are <#ef5350ff>stunned for 0.7s<>.",
        "ult": "Gathers himself for <#ffb900ff>0.38s<> (taking <#ffb900ff>30%<> less damage), then a flood of trident images rings the target for <#ffb900ff>6 rounds<> of thrusts, each dealing <#ff9028ff>85<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>115%<> <#ff9028ff>physical damage<> around it; the first <#ef5350ff>roots for 0.75s<>."
      },
      "ragnarok_kojiro": {
        "name": "Sasaki Kojiro",
        "attack": "A long-sword cut for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Prediction<>: each hit on an enemy champion learns one of his moves (up to <#ffb900ff>8<> a foe); every move learned adds <#ffb900ff>3%<> to Kojiro's damage against him. Forgotten when Kojiro dies.",
        "skill": "Cuts down through a cone ahead for <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> <#ff9028ff>physical damage<>, then turns the blade back up for <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<> <#ff9028ff>physical damage<> and a <#ef5350ff>35% slow<>.",
        "skill2": "Reads a thousand ways the fight can go and steps aside: for <#ffb900ff>2.5s<> he takes <#ffb900ff>30%<> less damage and attacks <#ffb900ff>50%<> faster.",
        "ult": "Draws a second sword: a double cut for <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>, then a cross for <#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<> <#ff9028ff>physical damage<> that <#ef5350ff>stuns for 0.6s<>. For <#ffb900ff>8s<> after, two swords: <#ffb900ff>30%<> attack speed and a second cut of <#ffb900ff>40%<> on every attack."
      },
      "ragnarok_heracles": {
        "name": "Heracles",
        "attack": "A blow of the club for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Brand of the Twelve Labors<>: every skill spreads the brand one step (the ultimate two, up to <#ffb900ff>12<>), each step <#ffb900ff>+1%<> attack and <#ffb900ff>+2<> armour and magic resistance. It fades when he dies.",
        "skill": "Thrusts the club and a lion's head charges out: enemies in a cone take <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<> and are <#ef5350ff>slowed 30%<>. Cerberus form: a fist into the ground ahead for <#ff9028ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<> <#ff9028ff>physical damage<>, <#ef5350ff>knocking up<>.",
        "skill2": "Slams the club down: enemies before him take <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> <#ff9028ff>physical damage<> and are <#ef5350ff>stunned for 0.75s<>. Cerberus form: a guard - for <#ffb900ff>2.5s<> he takes <#ffb900ff>35%<> less damage, reflects <#ffb900ff>20%<> and <#ef5350ff>taunts<> enemies around him for <#ef5350ff>1s<>.",
        "ult": "Makes his pact with the hound of Hades, Cerberus form for <#ffb900ff>8s<>: <#ffb900ff>+40%<> attack, <#ffb900ff>+50%<> attack speed, <#ffb900ff>+15%<> move speed, <#ffb900ff>20%<> less damage taken, <#ffb900ff>15%<> life steal. At its end a fist into the ground: <#ff9028ff>140<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150%<> <#ff9028ff>physical damage<> around him, <#ef5350ff>knocking up<>."
      },
      "ragnarok_jack": {
        "name": "Jack the Ripper",
        "attack": "Throws a knife for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Colours of the Heart<>: he sees the colour of every heart, and fear does not hide - <#ffb900ff>+30%<> damage to enemy champions below <#ffb900ff>50%<> health.",
        "skill": "Throws a fan of knives: enemies in a cone take <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>105%<> <#ff9028ff>physical damage<> and are <#ef5350ff>slowed 25%<>.",
        "skill2": "Opens an umbrella his gloves made divine, <#ffb900ff>40%<> less damage until it closes, then steps back into the fog: <#ffb900ff>invisible for 1.5s<>, then <#ffb900ff>+40%<> attack speed for <#ffb900ff>3s<>.",
        "ult": "The eye behind the monocle reads the target; a knife his gloves touched flies as a divine weapon for <#ff9028ff>200<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>180%<> <#ff9028ff>physical damage<>, and for <#ffb900ff>4s<> the target takes <#ffb900ff>20%<> more damage from everyone."
      }
    },
