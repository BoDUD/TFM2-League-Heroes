  "ja": {
    "description": {
      "ragnarok_lubu": {
        "name": "呂布奉先",
        "attack": "方天画戟の一撃で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>シールドブレイカー<>：物理防御の<#ffb900ff>15%<>を無視、シールドへのダメージ+<#ffb900ff>100%<>、シールドを砕くと<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30%<>の物理ダメージを追加。",
        "skill": "方天画戟で前方の扇状範囲を薙ぎ払い、<#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<>の<#ff9028ff>物理ダメージ<>と<#ffb900ff>1.5秒<>間<#ffb900ff>40%<>のスロウ。",
        "skill2": "方天戟で相手の武器を押さえて突き抜ける：通り道の敵に<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>0.6秒スネア<>。",
        "ult": "赤兎馬に乗って目標へ駆け（行動妨害無効、被ダメージ<#ffb900ff>30%<>軽減）、馬上から天喰を放つ：直線上の敵に<#ff9028ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>200%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>0.8秒のスタン<>。"
      },
      "ragnarok_thor": {
        "name": "トール",
        "attack": "雷槌の一撃で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>ミョルニル覚醒<>：スキルを<#ffb900ff>3回<>使うごとにミョルニルが<#ffb900ff>6秒<>覚醒：通常攻撃に<#a974ffff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#a974ffff>3%<>の<#a974ffff>魔法ダメージ<>を追加、トールハンマーは<#ef5350ff>1.1秒のスタン<>。",
        "skill": "左腕に雷を溜め両手で槌を振り下ろし、<#ffb900ff>0.43秒<>後に前方で雷が炸裂：敵に<#ff9028ff>75<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>85%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>4%<>の<#ff9028ff>物理ダメージ<>と衝撃波で<#ef5350ff>0.7秒のノックアップ<>（覚醒時<#ef5350ff>1.1秒<>）。",
        "skill2": "鉄手袋ヤールングレイプル（天界最強の防御）を<#ffb900ff>0.3秒<>身の前に構える：通常攻撃を全て防ぎ、スキルの被ダメージ<#ffb900ff>70%<>軽減。構えた時に<#e8d44dff>140<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#e8d44dff>90%<>の<#e8d44dff>シールド<>（<#ffb900ff>2.5秒<>）。",
        "ult": "ミョルニルが<#ffb900ff>8秒<>覚醒、投げるとブーメランのように戻る：往復で敵に<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>2%<>の<#ff9028ff>物理ダメージ<>と<#ffb900ff>40%<>スロウ。受け止めた勢いを一撃に変え前を叩く：<#ff9028ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>8%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>1.5秒ノックアップ<>。その間行動妨害無効、被ダメージ<#ffb900ff>45%<>軽減。"
      },
      "ragnarok_zeus": {
        "name": "ゼウス",
        "attack": "素早いジャブで<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>筋肉膨張<>：老人の姿で<#ffb900ff>3発<>打つと次の一発の代わりに膨張（<#ffb900ff>1.02秒<>、行動妨害無効）、完了時に周囲の敵へ<#ff9028ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<>の<#ff9028ff>物理ダメージ<>と<#ffb900ff>30%<>のスロウ。膨張後は攻撃力+<#ffb900ff>25%<>、防御と魔法防御+<#ffb900ff>35%<>。",
        "skill": "どんどん速くなるジャブの七連打、各<#ff9028ff>9<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>19%<>の<#ff9028ff>物理ダメージ<>。膨張・阿陀磨須では重い二連打（各<#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>65%<>）、二発目は膨張なら<#ffb900ff>40%<>スロウ、阿陀磨須なら<#ef5350ff>0.6秒スタン<>。",
        "skill2": "時を超える拳：拳を振るより先に当たっている。<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>0.5秒のスタン<>（阿陀磨須なら<#ef5350ff>0.9秒<>）。",
        "ult": "膨張した筋肉を<#ffb900ff>1.03秒<>圧縮（老人なら先に膨張、行動妨害無効、被ダメージ<#ffb900ff>50%<>軽減）し、周囲の敵を吹き飛ばす：<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>0.7秒のノックアップ<>、<#ffb900ff>10秒<>阿陀磨須で戦う：攻撃力+<#ffb900ff>45%<>、両防御+<#ffb900ff>60%<>、攻撃速度+<#ffb900ff>30%<>、吸血<#ffb900ff>25%<>。終わると老人に戻る。"
      },
      "ragnarok_adam": {
        "name": "アダム",
        "attack": "素早いジャブで<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>神虚視<>で読んだ技を<#ffb900ff>5秒<>覚え、覚えていれば<#ff9028ff>模倣カウンター<>がその技を写す。",
        "skill": "神虚視で相手の動きを読みかわす：<#ffb900ff>2.5秒<>間通常攻撃はすべて外れ、受けるスキルダメージ<#ffb900ff>50%<>軽減、技をひとつ覚える。",
        "skill2": "ゼウスの黄昏流星群を写したカウンターで<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。覚えた技があれば写して<#ff9028ff>60<>と対象の最大体力<#ffb900ff>8%<>を上乗せし<#ef5350ff>1秒スタン<>、記憶を使う。",
        "ult": "ゼウスから写した拳：<#ffb900ff>0.43秒<>溜め（行動妨害無効、被ダメージ<#ffb900ff>50%<>軽減）、標的へ拳圧を放ち、通り道の敵に<#ff9028ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>0.8秒のノックアップ<>。"
      },
      "ragnarok_poseidon": {
        "name": "ポセイドン",
        "attack": "三叉槍の水平突きで<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>神は何者にも頼らず<>：近くに味方チャンピオンがいないと攻撃力<#ffb900ff>+15%<>、被ダメージ<#ffb900ff>10%<>軽減。",
        "skill": "対象を追う螺旋の連続突きで前方へ<#ffb900ff>4回<>連続で突き、毎回前方扇形の敵に<#ff9028ff>65<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<>の<#ff9028ff>物理ダメージ<>。",
        "skill2": "前へ跳び、雷雨のように上から三度突き下ろす：対象の足元の敵に毎回<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>78%<>の<#ff9028ff>物理ダメージ<>、三度目は<#ef5350ff>0.7秒スタン<>。",
        "ult": "<#ffb900ff>0.38秒<>溜め（被ダメージ<#ffb900ff>30%<>軽減）、槍影が洪水のように対象を囲み<#ffb900ff>6回<>突く。毎回周囲の敵に<#ff9028ff>85<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>115%<>の<#ff9028ff>物理ダメージ<>、初撃で<#ef5350ff>0.75秒拘束<>。"
      },
      "ragnarok_kojiro": {
        "name": "佐々木小次郎",
        "attack": "長刀の一太刀で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>千手無双<>：敵チャンピオンに当てるたびにその技を一つ覚え（一人<#ffb900ff>8つ<>まで）、以後その敵へのダメージが一つごとに<#ffb900ff>+3%<>。倒れると覚え直し。",
        "skill": "前方扇形に斬り下ろし<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<>の<#ff9028ff>物理ダメージ<>、返す刃で斬り上げ<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>35%スロウ<>。",
        "skill2": "空気の流れと地の震えで神の技まで読み身をかわす：<#ffb900ff>2.5秒<>間被ダメージ<#ffb900ff>30%<>軽減、攻撃速度<#ffb900ff>+50%<>。",
        "ult": "折れた物干し竿を長短二本に打ち直し、二刀で斬り<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>、交差の一太刀で<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>0.6秒スタン<>。以後<#ffb900ff>8秒<>二天岩流：攻撃速度<#ffb900ff>+30%<>、通常攻撃に<#ffb900ff>40%<>の追い太刀。"
      },
      "ragnarok_heracles": {
        "name": "ヘラクレス",
        "attack": "棍棒の一撃で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>十二の御業の刻印<>：スキルのたびに刻印が一つ広がり（奥義は二つ、最大<#ffb900ff>12<>）、一つごとに攻撃力<#ffb900ff>+1%<>、物理・魔法防御<#ffb900ff>+2<>。倒れると消える。",
