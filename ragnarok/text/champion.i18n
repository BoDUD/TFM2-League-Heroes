        "attack": "快拳，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>肌肉膨脹<>：老人狀態打出<#ffb900ff>3拳<>後，下一拳改為膨脹（<#ffb900ff>1.02秒<>，不受控制），完成時震傷周圍敵人<#ff9028ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<><#ff9028ff>物理傷害<>、緩速<#ffb900ff>30%<>；膨脹後攻擊力+<#ffb900ff>25%<>、護甲和魔抗+<#ffb900ff>35%<>。",
        "skill": "連打兩拳，每拳<#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>65%<><#ff9028ff>物理傷害<>；膨脹時第二拳緩速<#ffb900ff>40%<>，持續<#ffb900ff>1秒<>，阿陀磨須時第二拳<#ef5350ff>暈眩0.6秒<>。",
        "skill2": "拳頭快過時間，出拳之前傷害就已打到：<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<><#ff9028ff>物理傷害<>並<#ef5350ff>暈眩0.5秒<>（阿陀磨須時<#ef5350ff>0.9秒<>）。",
        "ult": "把膨脹的肌肉壓縮<#ffb900ff>1.03秒<>（老人狀態先膨脹；不受控制，受到的傷害降低<#ffb900ff>50%<>），隨後震飛周圍敵人：<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>並<#ef5350ff>擊飛0.7秒<>，以阿陀磨須作戰<#ffb900ff>10秒<>：攻擊力+<#ffb900ff>45%<>、雙抗+<#ffb900ff>60%<>、攻速+<#ffb900ff>30%<>、吸血<#ffb900ff>25%<>。結束後變回老人。"
      },
      "ragnarok_adam": {
        "name": "亞當",
        "attack": "快拳，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>神虛視<>讀過一招就記下來（<#ffb900ff>5秒<>），有記錄時<#ff9028ff>模仿反擊<>會複刻那一招。",
        "skill": "睜開神虛視讀出對手的動作，閃身躲開：<#ffb900ff>2.5秒<>內普攻全部落空，受到的技能傷害降低<#ffb900ff>50%<>，並記下一招。",
        "skill2": "反擊一拳，造成<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。有記錄時複刻那一招：再加<#ff9028ff>60<>和目標<#ffb900ff>8%<>最大生命值的物理傷害，並<#ef5350ff>暈眩1秒<>，用掉記錄。",
        "ult": "從宙斯那裡學來的拳：蓄勢<#ffb900ff>0.43秒<>（不受控制，受到的傷害降低<#ffb900ff>50%<>），然後朝目標打出一道拳勁，路上的敵人受到<#ff9028ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150%<><#ff9028ff>物理傷害<>並被<#ef5350ff>擊飛0.8秒<>。"
      },
      "ragnarok_poseidon": {
        "name": "波塞頓",
        "attack": "三叉戟水平突刺，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>神無須依賴<>：身邊沒有友方英雄時，攻擊力<#ffb900ff>+15%<>，受到的傷害降低<#ffb900ff>10%<>。",
        "skill": "踏前一步，朝前方連刺<#ffb900ff>4次<>，每次對前方扇形裡的敵人造成<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>85%<><#ff9028ff>物理傷害<>。",
        "skill2": "高舉三叉戟斜刺而下，目標腳下的敵人受到<#ff9028ff>145<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>195%<><#ff9028ff>物理傷害<>並被<#ef5350ff>暈眩0.7秒<>。",
        "ult": "蓄勢<#ffb900ff>0.38秒<>（受到的傷害降低<#ffb900ff>30%<>），戟影如洪水般圍住目標連刺<#ffb900ff>6輪<>，每輪對周圍的敵人造成<#ff9028ff>85<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>115%<><#ff9028ff>物理傷害<>，第一輪<#ef5350ff>定身0.75秒<>。"
      },
      "ragnarok_kojiro": {
        "name": "佐佐木小次郎",
        "attack": "長刀一斬，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>預判<>：每打中一個敵方英雄一次就記下他一招（每人最多<#ffb900ff>8招<>），之後對他的傷害每招<#ffb900ff>+3%<>；死後重新記。",
        "skill": "往前斬下，前方扇形裡的敵人受到<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<><#ff9028ff>物理傷害<>；隨即反刃上撩，再造成<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<><#ff9028ff>物理傷害<>並<#ef5350ff>減速35%<>。",
        "skill2": "預判對手的一千種走法，側身讓開：<#ffb900ff>2.5秒<>內受到的傷害降低<#ffb900ff>30%<>，攻速<#ffb900ff>+50%<>。",
        "ult": "拔出第二把刀，雙刀斬下造成<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>，再交錯一刀造成<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<><#ff9028ff>物理傷害<>並<#ef5350ff>暈眩0.6秒<>；之後<#ffb900ff>8秒<>雙刀：攻速<#ffb900ff>+30%<>，普攻多一刀<#ffb900ff>40%<>。"
      },
      "ragnarok_heracles": {
        "name": "赫拉克勒斯",
        "attack": "巨棒一擊，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>十二御業的刻印<>：每放一個技能刻印爬一格（大招兩格，最多<#ffb900ff>12格<>），每格攻擊力<#ffb900ff>+1%<>、護甲和魔抗<#ffb900ff>+2<>；死後消退。",
        "skill": "巨棒前頂，獅頭衝出：前方扇形裡的敵人受到<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>並<#ef5350ff>減速30%<>。刻耳柏洛斯形態：一拳砸地，身前的敵人受到<#ff9028ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<><#ff9028ff>物理傷害<>並被<#ef5350ff>擊飛<>。",
        "skill2": "巨棒砸地，身前的敵人受到<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<><#ff9028ff>物理傷害<>並<#ef5350ff>暈眩0.75秒<>。刻耳柏洛斯形態：護勢，<#ffb900ff>2.5秒<>內受到的傷害降低<#ffb900ff>35%<>並反彈<#ffb900ff>20%<>，<#ef5350ff>嘲諷<>身邊的敵人<#ef5350ff>1秒<>。",
        "ult": "與冥府的看門犬訂約，變成刻耳柏洛斯形態<#ffb900ff>8秒<>：攻擊力<#ffb900ff>+40%<>、攻速<#ffb900ff>+50%<>、移速<#ffb900ff>+15%<>、受到的傷害降低<#ffb900ff>20%<>、吸血<#ffb900ff>15%<>；結束時一拳砸地，身邊的敵人受到<#ff9028ff>140<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150%<><#ff9028ff>物理傷害<>並被<#ef5350ff>擊飛<>。"
      },
      "ragnarok_jack": {
        "name": "開膛手傑克",
        "attack": "擲出飛刀，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>心之色<>：他看得見人心的顏色，恐懼藏不住：對生命低於<#ffb900ff>50%<>的敵方英雄，傷害<#ffb900ff>+30%<>。",
        "skill": "擲出一扇飛刀，前方扇形裡的敵人受到<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>105%<><#ff9028ff>物理傷害<>並<#ef5350ff>減速25%<>。",
        "skill2": "撐開被手套變成神器的傘，到收傘受到的傷害降低<#ffb900ff>40%<>；往後退進霧裡，<#ffb900ff>隱身1.5秒<>，之後<#ffb900ff>3秒<>攻速<#ffb900ff>+40%<>。",
        "ult": "單片鏡後的眼睛看穿對方，手套碰過的刀成了神器飛出：造成<#ff9028ff>200<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>180%<><#ff9028ff>物理傷害<>，之後<#ffb900ff>4秒<>裡對方受到的傷害增加<#ffb900ff>20%<>。"
      }
    },
