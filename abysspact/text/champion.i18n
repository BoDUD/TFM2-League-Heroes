{
  "zh-hans": {
    "description": {
      "abysspact_oathbreaker": {
        "name": "断誓",
        "attack": "断剑劈砍造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理伤害。<#ff9028ff>血誓<>：放技能烧<#ffb900ff>6%<>当前生命，每损<#ffb900ff>10%<>生命攻击+<#ffb900ff>4%<>、攻速+<#ffb900ff>5%<>。",
        "skill": "横扫黑火月牙造成<#ff9028ff>72<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>112%<>物理伤害并<#ef5350ff>减速30%<>；命中英雄回血，斩中被链目标追加伤害。",
        "skill2": "甩出誓链勾中首个敌方英雄拽至身前，造成<#ff9028ff>60<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<>物理伤害并<#ef5350ff>定身0.5秒<>。",
        "ult": "盔甲裂开<#ffb900ff>6秒<>内不会阵亡，吸血<#ffb900ff>40%<>、普攻附带黑火；期间参与击杀回<#ffb900ff>25%<>血，否则烧<#ffb900ff>15%<>当前血。"
      },
      "abysspact_faceless": {
        "name": "无面",
        "attack": "指刃划击造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理伤害。<#ff9028ff>夺面<>：参与击杀英雄后戴上其面孔<#ffb900ff>10秒<>，化身为目标并借用其攻击方式与强化爆发。",
        "skill": "化作黑影穿过目标冲至其身后，对路径敌人造成<#ff9028ff>90<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>115%<>物理伤害并<#ef5350ff>减速30%<>。",
        "skill2": "遁入黑雾<#ffb900ff>隐身1.5秒<>并提速；现身后的首击令目标直面空脸，追加伤害并<#ef5350ff>恐惧0.9秒<>。",
        "ult": "按住敌方英雄撕下面孔造成<#ff9028ff>290<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>165%<>物理伤害；目标生命低于<#ffb900ff>25%<>时直接真实斩杀并立刻夺面。"
      },
      "abysspact_whisperer": {
        "name": "呓语",
        "attack": "弹射念珠造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理伤害。<#ff9028ff>疯狂<>：技能叠加疯狂，满<#ffb900ff>3层<>时<#ef5350ff>恐惧1.5秒<>并爆开魔法伤害波及附近友军且继续传染。",
        "skill": "推出直线穿透的紫色低语，对路径敌人造成<#a974ffff>80<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<>魔法伤害并叠加<#ffb900ff>1层<>疯狂。",
        "skill2": "在目标处睁开巨眼持续<#ffb900ff>3秒<>，每秒造成<#a974ffff>28<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>22%<>魔法伤害、<#ef5350ff>减速22%<>并叠<#ffb900ff>1层<>疯狂。",
        "ult": "令目标地面裂开众口齐诵，造成<#a974ffff>215<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>108%<>魔法伤害，范围内敌人直接叠满<#ffb900ff>3层<>疯狂当场连锁发狂。"
      },
      "abysspact_bonebow": {
        "name": "骸弦",
        "attack": "骨箭射击造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理伤害。<#ff9028ff>亡兵<>：每第<#ffb900ff>4箭<>在目标旁拉起1名骷髅兵作战<#ffb900ff>6秒<>（继承<#ffb900ff>30%<>攻击，常规上限<#ffb900ff>3名<>）。",
        "skill": "射出穿透骨箭造成<#ff9028ff>75<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>105%<>物理伤害；每命中一名敌方英雄，就在其脚下拉起1名骷髅兵。",
        "skill2": "令场上所有骷髅兵冲向目标并自爆，每名造成<#ff9028ff>40<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50%<>范围物理伤害并<#ef5350ff>减速30%<>。",
        "ult": "朝天射箭降下骨箭雨造成<#ff9028ff>132<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>88%<>物理伤害并减速，同时爬出<#ffb900ff>5名<>骷髅兵作战<#ffb900ff>8秒<>（不占上限）。"
      },
      "abysspact_corvus": {
        "name": "鸦医",
        "attack": "投掷药瓶造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理伤害。<#ff9028ff>传染<>：技能种下<#ffb900ff>4秒<>疫病（每秒<#ffb900ff>2%<>最大血伤）并在敌间传染；队友靠近病人每秒回<#ffb900ff>1%–3%<>血。",
        "skill": "砸出大瘴气瓶，对范围内敌人造成<#a974ffff>52<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>42%<>魔法伤害、<#ef5350ff>减速30%<>并全部染上疫病。",
        "skill2": "派出肩头渡鸦守护队友<#ffb900ff>4秒<>：赋予<#e8d44dff>85<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#e8d44dff>60%<>护盾，渡鸦每秒啄击附近敌人并传染疫病。",
        "ult": "划出持续<#ffb900ff>5秒<>的隔离区：落地造成<#a974ffff>92<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<>法伤并<#ef5350ff>眩晕0.67秒<>，圈内敌人持续染病减速，队友持续回血。"
      }
    },
    "skill_name": {
      "abysspact_oathbreaker": {
        "skill1": "黑焰斩",
        "skill2": "誓链",
        "ult": "断誓"
      },
