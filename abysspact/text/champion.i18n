        "ult": "亡军"
      },
      "abysspact_corvus": {
        "skill1": "瘴瓶",
        "skill2": "渡鸦",
        "ult": "隔离区"
      }
    }
  },
  "zh-hant": {
    "description": {
      "abysspact_oathbreaker": {
