  "ko": {
    "description": {
      "abysspact_oathbreaker": {
        "name": "단서",
        "attack": "부러진 대검으로 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>혈서<>: 스킬 사용 시 현재 체력 <#ffb900ff>6%<> 소모, 잃은 체력 <#ffb900ff>10%<>당 공격력+<#ffb900ff>4%<>, 공속+<#ffb900ff>5%<>.",
        "skill": "검은 불꽃을 휘둘러 <#ff9028ff>72<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>112%<> 물리 피해와 <#ef5350ff>30% 둔화<>. 챔피언 적중 시 회복, 사슬 표적 추가 피해.",
        "skill2": "서약의 사슬로 첫 적 챔피언을 끌어당겨 <#ff9028ff>60<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> 물리 피해와 <#ef5350ff>0.5초 속박<>.",
        "ult": "<#ffb900ff>6초<> 불사 및 흡혈 <#ffb900ff>40%<>, 기본 공격 흑염 추가. 처치 관여 시 최대 체력 <#ffb900ff>25%<> 회복, 실패 시 현재 체력 <#ffb900ff>15%<> 소모."
      },
      "abysspact_faceless": {
        "name": "무면",
        "attack": "손톱 칼날로 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>탈면<>: 적 챔피언 처치 관여 시 <#ffb900ff>10초<>간 대상의 얼굴과 모습을 빼앗아 변신.",
        "skill": "그림자가 되어 적을 관통하며 <#ff9028ff>90<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>115%<> 물리 피해와 <#ef5350ff>30% 둔화<>.",
        "skill2": "검은 안개에 <#ffb900ff>1.5초 은신<> 및 가속. 은신 해제 첫 타격은 추가 피해와 <#ef5350ff>0.9초 공포<>.",
        "ult": "적 챔피언의 얼굴을 찢어 <#ff9028ff>290<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>165%<> 물리 피해. 체력 <#ffb900ff>25%<> 이하는 즉시 고정 피해 처형 후 탈면."
      },
      "abysspact_whisperer": {
        "name": "잠꼬대",
        "attack": "염주를 날려 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>광기<>: 스킬 적중 시 중첩, <#ffb900ff>3중첩<> 시 <#ef5350ff>1.5초 공포<>와 함께 주변 아군에게 마법 폭발 및 연쇄 전파.",
        "skill": "관통하는 보라색 속삭임으로 <#a974ffff>80<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<> 마법 피해와 광기 <#ffb900ff>1중첩<>.",
        "skill2": "대상에 거대한 눈을 <#ffb900ff>3초<>간 열어 매초 <#a974ffff>28<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>22%<> 마법 피해, <#ef5350ff>22% 둔화<>, 광기 <#ffb900ff>1중첩<>.",
        "ult": "지면에 수많은 입을 열어 <#a974ffff>215<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>108%<> 마법 피해와 동시에 모든 적에게 광기 <#ffb900ff>3중첩<>을 채워 연쇄 폭주."
      },
      "abysspact_bonebow": {
        "name": "해현",
        "attack": "뼈화살로 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>망병<>: <#ffb900ff>4발<>마다 대상 옆에 해골병 소환(공격력 <#ffb900ff>30%<>, <#ffb900ff>6초<>, 최대 <#ffb900ff>3기<>).",
        "skill": "관통 뼈화살로 <#ff9028ff>75<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>105%<> 물리 피해. 적중한 적 챔피언마다 해골병 1기 소환.",
        "skill2": "모든 해골병을 표적으로 돌진 자폭시켜 기당 <#ff9028ff>40<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50%<> 범위 물리 피해와 <#ef5350ff>30% 둔화<>.",
        "ult": "뼈화살 비로 <#ff9028ff>132<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>88%<> 범위 물리 피해와 함께 상한 외 해골병 <#ffb900ff>5기<>를 <#ffb900ff>8초<> 소환."
      },
      "abysspact_corvus": {
        "name": "까마귀 의사",
        "attack": "약병을 던져 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>전염<>: 스킬로 <#ffb900ff>4초<> 역병(초당 최대체력 <#ffb900ff>2%<>)을 퍼뜨리며 감염된 적 근처 아군 초당 <#ffb900ff>1~3%<> 회복.",
        "skill": "독기 병을 던져 범위에 <#a974ffff>52<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>42%<> 마법 피해, <#ef5350ff>30% 둔화<> 및 역병 감염.",
        "skill2": "어깨의 까마귀를 아군에게 <#ffb900ff>4초<> 보내 <#e8d44dff>85<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#e8d44dff>60%<> 보호막 부여. 매초 주변 적을 쪼아 역병 감염.",
        "ult": "<#ffb900ff>5초<> 격리 구역 선포: <#a974ffff>92<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<> 마법 피해와 <#ef5350ff>0.67초 기절<>. 구역 내 적은 역병·둔화, 아군은 지속 회복."
      },
      "abysspact_bloodmoon": {
        "name": "혈월",
        "attack": "인간 원거리 석궁·늑대 근접 할퀴기로 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>월상<>: 늑대 형태 공속+<#ffb900ff>30%<>, 흡혈 <#ffb900ff>10%<>.",
        "skill": "인간: 관통 은화살 3연사(발당 <#ff9028ff>34<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>54%<>, <#ef5350ff>20% 둔화<>). 늑대: 덮치기 <#ff9028ff>90<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>116%<> 및 회복.",
        "skill2": "인간과 늑대 형태 전환: 늑대 변신 시 주변 <#ef5350ff>30% 둔화<>, 인간 복귀 시 뒤로 구르기.",
        "ult": "<#ffb900ff>8초<> 거대 늑대 변신: 피해 감소 <#ffb900ff>25%<>, 기본 공격 광역 베기, 포효로 <#ef5350ff>1.03초 공포<>."
      },
      "abysspact_undertaker": {
        "name": "입관",
        "attack": "관으로 들이받아 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>관 방패<>: 기본 공격 피해 -<#ffb900ff>15%<>, <#ffb900ff>8초<>마다 다음 스킬 피해 -<#ffb900ff>30%<>.",
        "skill": "관을 내려찍어 <#ff9028ff>56<>+<#ffb900ff>최대체력 6%<> 물리 피해와 <#ef5350ff>0.48초 에어본<>.",
        "skill2": "쇠사슬 관을 던져 자신을 끌어당기며, <#ffb900ff>3초<>간 꽂힌 관 주변 적 <#ef5350ff>40% 둔화<>.",
        "ult": "적 챔피언을 관에 가둬 <#ffb900ff>2초<>간 메고 이동(이속+<#ffb900ff>20%<>) 후 내려찍어 <#ff9028ff>150<>+<#ffb900ff>대상 최대체력 8%<> 피해 및 <#ef5350ff>1초 기절<>."
      },
      "abysspact_effigy": {
        "name": "대신",
        "attack": "인형이 바늘을 던져 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>바늘꽂기<>: 스킬 적중 시 최대 <#ffb900ff>3개<>(<#ffb900ff>5초<>) 꽂아 궁극기로 한 번에 뽑음.",
        "skill": "부채꼴 바늘비로 <#a974ffff>52<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>52%<> 마법 피해, <#ef5350ff>25% 둔화<> 및 바늘 부여. 중앙 관통 바늘 추가 피해.",
        "skill2": "적 챔피언 둘을 붉은 실로 <#ffb900ff>4초<> 연결해 피해 <#ffb900ff>40%<> 공유. 멀어져 끊어지면 둘 다 <#ef5350ff>1초 기절<> 및 <#a974ffff>80<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<> 마법 피해.",
        "ult": "광범위 모든 바늘을 잡아당겨 개당 <#a974ffff>90<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<> 마법 피해와 <#ef5350ff>50% 둔화<>."
      },
      "abysspact_sevenfold": {
        "name": "칠탄",
        "attack": "마탄총 사격 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>일곱 번째 탄환<>: 7발째는 무작위 적 챔피언에게 휘어져 <#ff9028ff>135<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<> 고정 피해, 현재 체력 <#ffb900ff>8%<> 소모 후 1.2초 재장전.",
        "skill": "3연발 사격(발당 <#ff9028ff>25<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>42%<> 물리), 탄환 3발 소모로 일곱 번째 탄환 가속.",
        "skill2": "뒤로 구르며 즉시 다음 한 발을 일곱 번째 심연 마탄으로 장전.",
        "ult": "전방 7연사: 앞 6발은 적을 추적해 각 <#ff9028ff>33<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>51%<> 물리 피해, 7발째는 심연 마탄 발사."
      },
      "abysspact_vesper": {
        "name": "촉령",
        "attack": "도깨비불로 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>촛불 왕관<>: 주변 챔피언 사망 시 촛불 점등(최대 <#ffb900ff>5개<>), 개당 치유·보호막 +<#ffb900ff>10%<>.",
        "skill": "아군에게 <#ffb900ff>3초<> 연결해 이속+<#ffb900ff>26%<>, 매초 <#a974ffff>35<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>23%<> 회복, 종료 시 <#e8d44dff>62<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#e8d44dff>46%<> 보호막.",
        "skill2": "비명 지르는 망령이 직선 관통하며 <#a974ffff>50<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>46%<> 마법 피해와 <#ef5350ff>0.82초 공포<>.",
        "ult": "10초 내 전사한 아군을 영혼체로 <#ffb900ff>8초<> 소환(피해 반감·치유 불가), 팀 킬 시 <#ffb900ff>완전 부활<>. 대상 없으면 주변 아군 보호막."
      },
      "abysspact_carapace": {
        "name": "탈갑",
        "attack": "벌레 칼날로 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>탈피<>: 목숨당 2회 탈피(갑→충→우), 치명타 시 체력 <#ffb900ff>40%<> 회복하며 도발 자폭 빈 껍질 생성. 최대 체력 감소 대신 공속·이속 급증.",
        "skill": "돌진해 <#ff9028ff>94<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>123%<> 물리 피해와 <#ef5350ff>30% 둔화<>. 3형태에서는 장거리 도약.",
        "skill2": "갑각을 울려 주변에 <#ff9028ff>83<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>93%<> 물리 피해 및 챔피언 적중 시 자가 치유.",
        "ult": "즉시 탈피 폭발로 <#ff9028ff>195<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>127%<> 광역 피해, <#ef5350ff>0.75초 에어본<>, 4초간 공속+<#ffb900ff>40%<>. 3형태는 원거리 강습."
      },
      "abysspact_leech": {
        "name": "부골",
        "attack": "갈고리 발톱으로 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>부골지저<>: 숙주 기생 중 대상 지정 불가 및 최대 체력 흡혈, 단 숙주 피해의 <#ffb900ff>25%<>를 함께 받음.",
        "skill": "덮쳐 <#a974ffff>98<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>75%<> 마법 피해 후 적 챔피언 등에 <#ffb900ff>3초<> 기생(둔화·흡혈). 숙주 사망 시 인접 적에게 도약.",
        "skill2": "독을 주입해 <#a974ffff>117<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>85%<> 마법 피해와 <#ef5350ff>1초 침묵<>(기생 중 <#ef5350ff>1.75초<>).",
        "ult": "<#ffb900ff>5마리<> 작은 거머리로 분열해 <#ffb900ff>3초<>간 적 챔피언들을 흡혈(숙주당 10% 피해 공유) 후 합체하며 총 흡혈량 회복."
      },
      "abysspact_noctua": {
        "name": "천아",
        "attack": "나방 공격 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>산신<>: 1초 내 최대 체력 <#ffb900ff>12%<> 초과 피해 시 대상 지정 불가로 흩어져 후퇴(12초), 재결합 후 <#ef5350ff>1.25초<> 스킬 불가.",
        "skill": "나방 <#ffb900ff>6마리<>를 날려 각 <#a974ffff>30<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26%<> 마법 피해와 인분 중첩(층당 둔화 10%, 최대 3층).",
        "skill2": "적 챔피언을 고치로 감싸 <#ef5350ff>1.12초 기절<>, 고치가 깨질 때 나방이 돌아와 회복.",
        "ult": "<#ffb900ff>3.5초<>간 대상 지정 불가 나방 폭풍이 되어 지속 마법 피해와 인분 부여, 종료 시 광역 <#ef5350ff>1.25초 침묵<>."
      },
      "abysspact_anchor": {
        "name": "침묘",
        "attack": "견인 시 사슬탄(이속+<#ffb900ff>10%<>), 투묘 시 사거리 <#ffb900ff>9만<> 포대로 전환해 주변 <#ffb900ff>60%<> 광역 폭발 및 <#ff9028ff>평형수<> 강제 이동 면역.",
        "skill": "닻 사슬을 휘둘러 주변에 <#ff9028ff>64<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>81%<> 물리 피해와 <#ef5350ff>밀쳐내기<>(투묘 중 사용 가능).",
        "skill2": "기동 견인 태세와 고정 포대 태세를 전환. 투묘 시 이동 불가 대신 사거리·광역 화력 급증.",
        "ult": "초장거리로 거포 <#ffb900ff>6연발<> 포격, 발당 <#ff9028ff>95<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>58%<> 광역 물리 피해와 <#ef5350ff>0.4초 에어본<>."
      },
      "abysspact_hourglass": {
        "name": "반조",
        "attack": "모래빛 사격 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>노화<>: 회광+1·역류+3중첩(최대 10, 층당 최대체력-2.5%·이속-2%, 백발화), 사망 부활 시 젊음 회복.",
        "skill": "아군 챔피언에게 <#ffb900ff>3초<> 회광 표식: 종료 시 표식 시점 체력으로 되돌리며(감소 없음), 치명 피해 시 즉시 되돌려 구출!",
        "skill2": "지정 구역 시간을 멈춰 <#a974ffff>80<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>56%<> 마법 피해와 <#ef5350ff>1.1초 기절<>.",
        "ult": "모래시계 등을 뒤집어 광범위 생존 아군 전원을 <#ffb900ff>3초 전<> 위치와 체력으로 되돌림(감소 없음, 노화+3)."
      },
      "abysspact_reprieve": {
        "name": "유예",
        "attack": "철구 강타 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>유예<>: 피해 절반을 형기(최대체력 60% 한도)로 4초 분할 상환, 주변 처치 관여 시 전액 탕감.",
        "skill": "철구를 던져 <#ff9028ff>94+대상 최대체력 7%<> 물리 피해와 <#ef5350ff>0.8초 기절<>, 사슬로 끌어당김.",
        "skill2": "포효해 주변 적을 <#ef5350ff>1.3초 도발<>하며 그동안 유예 비율이 <#ffb900ff>70%<>로 증가.",
        "ult": "전방 부채꼴에 거대한 칼을 던져 <#ff9028ff>180+대상 최대체력 9%<> 물리 피해와 <#ef5350ff>1.5초 기절<>."
      },
      "abysspact_debtor": {
        "name": "사명",
        "attack": "곡검 베기 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>차용증<>: 스킬 적중 시 6초 차용증을 남겨 궁극기 생명 교환 대상으로 지정.",
        "skill": "돌진 베기로 <#ff9028ff>102<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>122%<> 물리 피해와 차용증 부여. 대상 체력 <#ef5350ff>30%<> 이하 시 피해 <#ff9028ff>+50%<>.",
        "skill2": "주위를 휩쓸어 <#ff9028ff>84<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>95%<> 물리 피해, 적중마다 체력 회복 및 차용증 부여.",
        "ult": "차용증 적과 <#ef5350ff>체력 비율 즉시 맞교환<>! <#ffb900ff>6초 내<> 처치 시 생명 유지, 실패 시 그 시점 비율로 재교환."
