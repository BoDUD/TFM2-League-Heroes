  "ja": {
    "description": {
      "abysspact_oathbreaker": {
        "name": "断誓",
        "attack": "断剣で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理ダメージ。<#ff9028ff>血誓<>：スキルで現在HP<#ffb900ff>6%<>消費、減少HP<#ffb900ff>10%<>毎に攻撃+<#ffb900ff>4%<>・攻撃速度+<#ffb900ff>5%<>。",
        "skill": "黒炎の斬撃で<#ff9028ff>72<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>112%<>物理ダメージと<#ef5350ff>30%スロウ<>。英雄命中で回復、鎖対象に追加ダメージ。",
        "skill2": "誓いの鎖で最初の敵英雄を引き寄せ、<#ff9028ff>60<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<>物理ダメージと<#ef5350ff>0.5秒束縛<>。",
        "ult": "<#ffb900ff>6秒<>不死と吸血<#ffb900ff>40%<>、通常攻撃に黒炎付与。関与で終了時<#ffb900ff>25%<>回復、未達成で現在HP<#ffb900ff>15%<>消費。"
      },
      "abysspact_faceless": {
        "name": "無面",
        "attack": "指刃で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理ダメージ。<#ff9028ff>奪面<>：英雄撃破関与で<#ffb900ff>10秒<>相手の姿に変身し、攻撃特性と強化を得る。",
        "skill": "影となり敵を突き抜けて<#ff9028ff>90<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>115%<>物理ダメージと<#ef5350ff>30%スロウ<>。",
        "skill2": "黒霧に<#ffb900ff>1.5秒隠密<>し加速。初撃に追加ダメージと<#ef5350ff>0.9秒恐怖<>。",
        "ult": "敵英雄の顔を剥ぎ<#ff9028ff>290<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>165%<>物理ダメージ。HP<#ffb900ff>25%<>以下なら即座に確定処刑し奪面する。"
      },
      "abysspact_whisperer": {
        "name": "囈語",
        "attack": "数珠を飛ばし<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理ダメージ。<#ff9028ff>狂気<>：スキルで蓄積、<#ffb900ff>3層<>で<#ef5350ff>1.5秒恐怖<>し周囲の味方に魔法爆発＆狂気連鎖。",
        "skill": "貫通する紫の囁きを放ち<#a974ffff>80<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<>魔法ダメージと狂気<#ffb900ff>+1層<>。",
        "skill2": "地面に巨眼を開き<#ffb900ff>3秒<>間、毎秒<#a974ffff>28<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>22%<>魔法ダメージ、<#ef5350ff>22%スロウ<>、狂気<#ffb900ff>+1層<>。",
        "ult": "無数の口が裂け<#a974ffff>215<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>108%<>魔法ダメージを与え、範囲内の敵を即座に狂気<#ffb900ff>3層<>にして連鎖発狂させる。"
      },
      "abysspact_bonebow": {
        "name": "骸弦",
        "attack": "骨矢で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理ダメージ。<#ff9028ff>亡兵<>：<#ffb900ff>4射目<>毎に骸骨兵を召喚（攻撃<#ffb900ff>30%<>、<#ffb900ff>6秒<>、上限<#ffb900ff>3体<>）。",
        "skill": "貫通する骨矢で<#ff9028ff>75<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>105%<>物理ダメージ。命中した敵英雄ごとに足元へ骸骨兵を召喚。",
        "skill2": "全骸骨兵を目標へ突撃自爆させ、各<#ff9028ff>40<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50%<>範囲物理ダメージと<#ef5350ff>30%スロウ<>。",
        "ult": "骨矢の雨で<#ff9028ff>132<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>88%<>物理ダメージを与え、上限外の骸骨兵<#ffb900ff>5体<>を<#ffb900ff>8秒<>召喚する。"
      },
      "abysspact_corvus": {
        "name": "鴉医",
        "attack": "薬瓶を投げ<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理ダメージ。<#ff9028ff>伝染<>：スキルで<#ffb900ff>4秒<>疫病（毎秒最大HP<#ffb900ff>2%<>）を拡散し、病敵近くの味方を毎秒<#ffb900ff>1–3%<>回復。",
        "skill": "瘴気瓶を投げ範囲に<#a974ffff>52<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>42%<>魔法ダメージ、<#ef5350ff>30%スロウ<>と疫病を付与。",
        "skill2": "渡鴉を味方の肩に<#ffb900ff>4秒<>送り<#e8d44dff>85<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#e8d44dff>60%<>シールド付与。毎秒周囲の敵を啄み疫病拡散。",
        "ult": "<#ffb900ff>5秒<>の隔離区を展開：着弾で<#a974ffff>92<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<>魔法ダメージと<#ef5350ff>0.67秒スタン<>。圏内の敵を疫病減速、味方を回復。"
      },
      "abysspact_bloodmoon": {
        "name": "血月",
        "attack": "人形態は遠隔銀弩、狼形態は近接爪で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理。<#ff9028ff>月相<>：狼形態は攻撃速度+<#ffb900ff>30%<>・吸血<#ffb900ff>10%<>。",
        "skill": "人：貫通銀矢3連射（各<#ff9028ff>34<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>54%<>、<#ef5350ff>20%スロウ<>）。狼：飛び掛かり<#ff9028ff>90<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>116%<>＋回復。",
        "skill2": "人狼形態を切替：狼化で周囲を<#ef5350ff>30%スロウ<>、人化で後方へ前転離脱。",
        "ult": "<#ffb900ff>8秒<>巨狼化：被ダメ-<#ffb900ff>25%<>、通常攻撃が周囲薙ぎ払い、咆哮で<#ef5350ff>1.03秒恐怖<>。"
      },
      "abysspact_undertaker": {
        "name": "入棺",
        "attack": "棺で殴り<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理。<#ff9028ff>棺盾<>：通常攻撃被ダメ-<#ffb900ff>15%<>、<#ffb900ff>8秒<>毎に次スキル被ダメ-<#ffb900ff>30%<>。",
        "skill": "棺を叩きつけ<#ff9028ff>56<>+<#ffb900ff>最大HP6%<>物理と<#ef5350ff>0.48秒ノックアップ<>。",
        "skill2": "鎖付き棺を投げ自身を引き寄せ、<#ffb900ff>3秒<>立つ棺の周囲を<#ef5350ff>40%スロウ<>。",
        "ult": "敵英雄を棺に詰め<#ffb900ff>2秒<>担いで運び（移動+<#ffb900ff>20%<>）、叩きつけ<#ff9028ff>150<>+<#ffb900ff>対象最大HP8%<>と<#ef5350ff>1秒スタン<>。"
      },
      "abysspact_effigy": {
        "name": "身代わり",
        "attack": "人形が針を投げ<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理。<#ff9028ff>針刺し<>：スキル命中で銀針を最大<#ffb900ff>3本<>（<#ffb900ff>5秒<>）刺し、必殺で一斉引き抜き。",
        "skill": "扇状に針を放ち<#a974ffff>52<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>52%<>魔法ダメージと<#ef5350ff>25%スロウ<>・針付与。中央針は貫通追撃。",
        "skill2": "敵英雄2人を赤い糸で<#ffb900ff>4秒<>結び被ダメ<#ffb900ff>40%<>共有。離れすぎると切れ両者<#ef5350ff>1秒スタン<>＋<#a974ffff>80<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<>魔法。",
        "ult": "広範囲の針を一気に引き抜き、1本につき<#a974ffff>90<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<>魔法ダメージと<#ef5350ff>50%スロウ<>。"
      },
      "abysspact_sevenfold": {
        "name": "七弾",
        "attack": "魔弾銃で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理。<#ff9028ff>七発目<>：7発毎の最終弾がランダムな敵英雄へ曲がり必中し<#ff9028ff>135<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<>確定ダメージ、現在HP<#ffb900ff>8%<>消費後1.2秒装填。",
        "skill": "3連射（各<#ff9028ff>25<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>42%<>物理）。弾を3発消費し七発目を早める。",
        "skill2": "後方へ前転離脱し、次の一発を即座に七発目の深淵魔弾へ装填する。",
        "ult": "前方へ7連射：6発が敵を追尾（各<#ff9028ff>33<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>51%<>物理）、7発目は必ず深淵魔弾となる。"
      },
      "abysspact_vesper": {
        "name": "燭霊",
        "attack": "鬼火を飛ばし<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理。<#ff9028ff>燭冠<>：周囲の英雄死亡毎に蝋燭を点灯（最大<#ffb900ff>5本<>）、1本につき回復・シールド+<#ffb900ff>10%<>。",
        "skill": "鬼火で味方を<#ffb900ff>3秒<>結び移動+<#ffb900ff>26%<>、毎秒<#a974ffff>35<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>23%<>回復、終了時<#e8d44dff>62<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#e8d44dff>46%<>シールド。",
        "skill2": "叫ぶ亡霊が直線貫通し<#a974ffff>50<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>46%<>魔法ダメージと<#ef5350ff>0.82秒恐怖<>。",
        "ult": "10秒内に倒れた味方を魂体で<#ffb900ff>8秒<>蘇生（被ダメ半減・回復不可）、味方の撃破で<#ffb900ff>真復活<>。該当なし時は周囲の味方へシールド。"
      },
      "abysspact_carapace": {
        "name": "蛻甲",
        "attack": "虫刃で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理。<#ff9028ff>脱皮<>：1命で2回脱皮（甲→虫→羽）、致死時にHP<#ffb900ff>40%<>回復し挑発自爆する空殻を残す。最大HP低下の代償に速度激増。",
        "skill": "突進し<#ff9028ff>94<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>123%<>物理と<#ef5350ff>30%スロウ<>。第3形態では長距離飛び掛かりへ変化。",
        "skill2": "甲殻を鳴らし周囲へ<#ff9028ff>83<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>93%<>物理、英雄命中で自己回復。",
        "ult": "即座に脱皮爆発し周囲に<#ff9028ff>195<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>127%<>物理と<#ef5350ff>0.75秒ノックアップ<>、4秒間攻撃速度+<#ffb900ff>40%<>。第3形態は遠距離急襲。"
      },
      "abysspact_leech": {
        "name": "附骨",
        "attack": "鉤爪で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理。<#ff9028ff>附骨の疽<>：宿主に寄生中は対象指定不可で最大HPを吸収回復するが、宿主の被ダメ<#ffb900ff>25%<>を自身も受ける。",
        "skill": "飛び付き<#a974ffff>98<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>75%<>魔法＋敵英雄の背中へ<#ffb900ff>3秒<>寄生し減速吸収。宿主撃破で次の敵へ跳躍。",
        "skill2": "毒を注入し<#a974ffff>117<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>85%<>魔法と<#ef5350ff>1秒沈黙<>（寄生中は<#ef5350ff>1.75秒<>）。",
        "ult": "<#ffb900ff>5匹<>の小蛭に分裂し敵英雄へ<#ffb900ff>3秒<>群がり吸収（各被ダメ10%共有）、合体時に吸収量を全回復。"
      },
      "abysspact_noctua": {
        "name": "千蛾",
        "attack": "飛蛾で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理。<#ff9028ff>散身<>：1秒で最大HP<#ffb900ff>12%<>超の被弾時、対象指定不可の蛾群となり離脱（CD12秒）、再集結後<#ef5350ff>1.25秒<>スキル不可。",
        "skill": "<#ffb900ff>6匹<>の蛾を放ち各<#a974ffff>30<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26%<>魔法と鱗粉を蓄積（最大3層、1層10%スロウ）。",
        "skill2": "敵英雄を繭で包み<#ef5350ff>1.12秒スタン<>。破繭時に蛾が戻り自己回復。",
        "ult": "<#ffb900ff>3.5秒<>対象指定不可の蛾嵐となり周囲を継続魔法攻撃＆鱗粉付与、終了時に衝撃波で周囲を<#ef5350ff>1.25秒沈黙<>。"
      },
      "abysspact_anchor": {
        "name": "沈錨",
        "attack": "牽引時は鎖弾（移動+<#ffb900ff>10%<>）、投錨時は射程<#ffb900ff>9万<>の砲台となり周囲<#ffb900ff>60%<>範囲爆風＋<#ff9028ff>バラスト<>で強制移動無効。",
        "skill": "鎖を振り回し周囲へ<#ff9028ff>64<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>81%<>物理と<#ef5350ff>ノックバック<>（投錨中も使用可）。",
        "skill2": "牽引形態と投錨砲台形態を切替。投錨中は移動不可だが射程と範囲火力が劇的に上昇。",
        "ult": "遠距離へ巨砲を<#ffb900ff>6連射<>し、各弾<#ff9028ff>95<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>58%<>範囲物理と<#ef5350ff>0.4秒ノックアップ<>。"
      },
      "abysspact_hourglass": {
        "name": "返照",
        "attack": "流砂で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理。<#ff9028ff>老い<>：回光+1・倒流+3層（最大10、1層毎に最大HP-2.5%・移動-2%・白髪化）、倒れて復活すると若返る。",
        "skill": "味方英雄に<#ffb900ff>3秒<>の回光印を付与：終了時に印付与時のHPへ巻き戻し（減少なし）、致死時は即座に巻き戻し救命！",
        "skill2": "指定範囲の時を止め<#a974ffff>80<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>56%<>魔法と<#ef5350ff>1.1秒スタン<>。",
        "ult": "砂時計灯を反転し、広範囲の生存味方全員を<#ffb900ff>3秒前<>の位置とHPへ巻き戻す（減少なし、老い+3層）。"
      },
      "abysspact_reprieve": {
        "name": "緩刑",
        "attack": "鉄球で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理。<#ff9028ff>緩刑<>：被ダメの半分を刑期（最大HP60%上限）として4秒で返済；周囲のキル・アシストで全額帳消し。",
        "skill": "鉄球を投げ<#ff9028ff>94+対象最大HP7%<>物理と<#ef5350ff>0.8秒スタン<>、鎖で引き寄せる。",
        "skill2": "咆哮して周囲を<#ef5350ff>1.3秒タウント<>、その間は刑期への先送り率が<#ffb900ff>70%<>に上昇。",
        "ult": "前方扇状に巨大な枷を投げ、<#ff9028ff>180+対象最大HP9%<>物理と<#ef5350ff>1.5秒スタン<>。"
      },
      "abysspact_debtor": {
        "name": "赊命",
        "attack": "曲剣で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理。<#ff9028ff>借用書<>：スキル命中で6秒の借用書を刻み、ウルトの命交換対象にする。",
        "skill": "突進斬りで<#ff9028ff>102<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>122%<>物理＋借用書。対象HP<#ef5350ff>30%<>以下ならダメージ<#ff9028ff>+50%<>。",
        "skill2": "周囲を薙ぎ払い<#ff9028ff>84<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>95%<>物理、命中ごとに回復し借用書を付与。",
        "ult": "借用書付きの敵と<#ef5350ff>HP割合を即座に交換<>！<#ffb900ff>6秒以内<>に倒せば自分の命に、倒せねばその時点の割合で再交換。"
      },
      "abysspact_traceless": {
        "name": "無痕",
        "attack": "速刺し<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理。<#ff9028ff>無痕<>：無傷命中で鋒を重ね（最大8層・各攻撃+7%）、1.5秒非戦闘で隠密し初撃+50%。1でもHPが減ると全消滅。",
        "skill": "一直線に貫き<#ff9028ff>110<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>117%<>物理。<#ffb900ff>キルで即クールダウン解消<>。",
        "skill2": "残像を残し<#ffb900ff>0.75秒対象指定不可<>の後に1秒隠密、鋒を維持する。",
        "ult": "<#ffb900ff>1.5秒消失<>し、範囲内の敵英雄全員を斬り裂き（<#ff9028ff>138<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>104%<>）鋒を重ねる。"
      },
      "abysspact_starfall": {
        "name": "隕夜",
        "attack": "0.5秒遅れて黒い星を落とし<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>20%<>範囲ダメ（周囲60%）。<#ef5350ff>代償<>：近距離3万以内の通常攻撃は空振り。",
        "skill": "直線上に5発の黒星を順に落とし各<#a974ffff>38<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<>魔法、2発以上当たると<#ef5350ff>30%スロウ<>。",
        "skill2": "星光となって後方へ跳び、元の位置に黒星を落として<#a974ffff>45<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>32%<>魔法と<#ef5350ff>ノックバック<>。",
        "ult": "夜空を裂き<#ffb900ff>4秒間の黒星雨<>を降らせ、継続して<#a974ffff>38<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<>魔法ダメージ。"
      },
      "abysspact_knell": {
        "name": "喪鐘",
        "attack": "鐘槌で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理。<#ff9028ff>鐘殻<>：鐘を背負う間は全被ダメ<#ffb900ff>-15%<>（ウルト中は無効）。",
        "skill": "背中の鐘を打ち鳴らし前方扇状に<#a974ffff>86+自身最大HP7%<>魔法と<#ef5350ff>0.87秒スタン<>。",
        "skill2": "鐘縁を鳴らし周囲味方全員に<#e8d44dff>180シールド<>と<#ffb900ff>移動+24%<>。",
        "ult": "巨鐘を被せ自身と周囲の敵を<#ffb900ff>2.5秒間隔離<>（0.5秒毎に<#a974ffff>53+HP4%<>魔法）、開鐘時に全員を<#ef5350ff>ノックアップ<>！"
      }
    },
