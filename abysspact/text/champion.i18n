  "zh-hant": {
    "description": {
      "abysspact_oathbreaker": {
        "name": "斷誓",
        "attack": "斷劍劈砍造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理傷害。<#ff9028ff>血誓<>：放技能燒<#ffb900ff>6%<>當前生命，每損<#ffb900ff>10%<>生命攻擊+<#ffb900ff>4%<>、攻速+<#ffb900ff>5%<>。",
        "skill": "橫掃黑火月牙造成<#ff9028ff>72<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>112%<>物理傷害並<#ef5350ff>減速30%<>；命中英雄回血，斬中被鏈目標追加傷害。",
        "skill2": "甩出誓鏈勾中首個敵方英雄拽至身前，造成<#ff9028ff>60<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<>物理傷害並<#ef5350ff>定身0.5秒<>。",
        "ult": "盔甲裂開<#ffb900ff>6秒<>內不會陣亡，吸血<#ffb900ff>40%<>、普攻附帶黑火；期間參與擊殺回<#ffb900ff>25%<>血，否則燒<#ffb900ff>15%<>當前血。"
      },
      "abysspact_faceless": {
        "name": "無面",
        "attack": "指刃劃擊造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理傷害。<#ff9028ff>奪面<>：參與擊殺英雄後戴上其面孔<#ffb900ff>10秒<>，化身為目標並借用其攻擊方式與強化爆發。",
        "skill": "化作黑影穿過目標衝至其身後，對路徑敵人造成<#ff9028ff>90<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>115%<>物理傷害並<#ef5350ff>減速30%<>。",
        "skill2": "遁入黑霧<#ffb900ff>隱身1.5秒<>並提速；現身後的首擊令目標直面空臉，追加傷害並<#ef5350ff>恐懼0.9秒<>。",
        "ult": "按住敵方英雄撕下面孔造成<#ff9028ff>290<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>165%<>物理傷害；目標生命低於<#ffb900ff>25%<>時直接真實斬殺並立刻奪面。"
      },
      "abysspact_whisperer": {
        "name": "囈語",
        "attack": "彈射念珠造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理傷害。<#ff9028ff>瘋狂<>：技能疊加瘋狂，滿<#ffb900ff>3層<>時<#ef5350ff>恐懼1.5秒<>並爆開魔法傷害波及附近友軍且繼續傳染。",
        "skill": "推出直線穿透的紫色低語，對路徑敵人造成<#a974ffff>80<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<>魔法傷害並疊加<#ffb900ff>1層<>瘋狂。",
        "skill2": "在目標處睜開巨眼持續<#ffb900ff>3秒<>，每秒造成<#a974ffff>28<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>22%<>魔法傷害、<#ef5350ff>減速22%<>並疊<#ffb900ff>1層<>瘋狂。",
        "ult": "令目標地面裂開眾口齊誦，造成<#a974ffff>215<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>108%<>魔法傷害，範圍內敵人直接疊滿<#ffb900ff>3層<>瘋狂當場連鎖發狂。"
      },
      "abysspact_bonebow": {
        "name": "骸弦",
        "attack": "骨箭射擊造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理傷害。<#ff9028ff>亡兵<>：每第<#ffb900ff>4箭<>在目標旁拉起1名骷髏兵作戰<#ffb900ff>6秒<>（繼承<#ffb900ff>30%<>攻擊，常規上限<#ffb900ff>3名<>）。",
        "skill": "射出穿透骨箭造成<#ff9028ff>75<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>105%<>物理傷害；每命中一名敵方英雄，就在其腳下拉起1名骷髏兵。",
        "skill2": "令場上所有骷髏兵衝向目標並自爆，每名造成<#ff9028ff>40<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50%<>範圍物理傷害並<#ef5350ff>減速30%<>。",
        "ult": "朝天射箭降下骨箭雨造成<#ff9028ff>132<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>88%<>物理傷害並減速，同時爬出<#ffb900ff>5名<>骷髏兵作戰<#ffb900ff>8秒<>（不佔上限）。"
      },
      "abysspact_corvus": {
        "name": "鴉醫",
        "attack": "投擲藥瓶造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理傷害。<#ff9028ff>傳染<>：技能種下<#ffb900ff>4秒<>疫病（每秒<#ffb900ff>2%<>最大血傷）並在敵間傳染；隊友靠近病人每秒回<#ffb900ff>1%–3%<>血。",
        "skill": "砸出大瘴氣瓶，對範圍內敵人造成<#a974ffff>52<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>42%<>魔法傷害、<#ef5350ff>減速30%<>並全部染上疫病。",
        "skill2": "派出肩頭渡鴉守護隊友<#ffb900ff>4秒<>：賦予<#e8d44dff>85<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#e8d44dff>60%<>護盾，渡鴉每秒啄擊附近敵人並傳染疫病。",
        "ult": "劃出持續<#ffb900ff>5秒<>的隔離區：落地造成<#a974ffff>92<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<>法傷並<#ef5350ff>眩暈0.67秒<>，圈內敵人持續染病減速，隊友持續回血。"
      },
      "abysspact_bloodmoon": {
        "name": "血月",
        "attack": "人形遠程銀弩、狼形近戰撕咬造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理傷害。<#ff9028ff>月相<>：狼形攻速+<#ffb900ff>30%<>、吸血+<#ffb900ff>10%<>。",
        "skill": "人形連射3支穿透銀箭各<#ff9028ff>34<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>54%<>並<#ef5350ff>減速20%<>；狼形撲殺造成<#ff9028ff>90<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>116%<>並回血。",
        "skill2": "隨時切換人狼形態：人變狼長嚎令周圍<#ef5350ff>減速30%<>；狼變人向後翻滾拉開距離。",
        "ult": "血月升起化身巨狼<#ffb900ff>8秒<>：減傷<#ffb900ff>25%<>、普攻順劈周圍敵人，長嚎<#ef5350ff>恐懼1.03秒<>。"
      },
      "abysspact_undertaker": {
        "name": "入殮",
        "attack": "揮棺撞擊造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理傷害。<#ff9028ff>棺盾<>：常駐普攻減傷<#ffb900ff>15%<>；每<#ffb900ff>8秒<>獲得一層令下次技能傷害-<#ffb900ff>30%<>的護盾。",
        "skill": "掄棺前砸造成<#ff9028ff>56<>+<#ffb900ff>6%最大生命<>物理傷害並<#ef5350ff>擊飛0.48秒<>。",
        "skill2": "鐵鏈甩出棺材釘地並將自己拽至目標身旁；棺材矗立<#ffb900ff>3秒<>，周圍敵人<#ef5350ff>減速40%<>。",
        "ult": "將敵方英雄裝進棺材扛走<#ffb900ff>2秒<>（自身移速+<#ffb900ff>20%<>），隨後猛摔造成<#ff9028ff>150<>+<#ffb900ff>8%目標最大生命<>傷害並<#ef5350ff>眩暈1秒<>。"
      },
      "abysspact_effigy": {
        "name": "替身",
        "attack": "布偶甩出飛針造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理傷害。<#ff9028ff>扎針<>：技能命中插入1根銀針（最多<#ffb900ff>3根<>，留<#ffb900ff>5秒<>），供大招一次拔出。",
        "skill": "扇形甩出銀針雨造成<#a974ffff>52<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>52%<>魔法傷害、<#ef5350ff>減速25%<>並扎針；中心穿刺針追加傷害與針數。",
        "skill2": "紅線連接目標與附近另一名敵方英雄<#ffb900ff>4秒<>：任一受傷另一人同受<#ffb900ff>40%<>；拉開過遠崩斷雙雙<#ef5350ff>眩暈1秒<>並受<#a974ffff>80<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<>法傷。",
        "ult": "猛扯大範圍內所有敵人身上的銀針，每根造成<#a974ffff>90<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<>魔法傷害並<#ef5350ff>減速50%<>（3根滿針爆發極高）。"
      },
      "abysspact_sevenfold": {
        "name": "七彈",
        "attack": "魔彈槍射擊造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理傷害。<#ff9028ff>第七顆<>：7發一輪，第7發拐彎必中隨機敵方英雄造成<#ff9028ff>135<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<>真實傷害，自損<#ffb900ff>8%<>當前血並裝彈1.2秒。",
        "skill": "連開三槍每發<#ff9028ff>25<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>42%<>物理傷害，消耗3發彈倉更快逼出第七顆魔彈。",
        "skill2": "向後翻滾拉開距離，立刻裝滿彈倉並將下一發直接置為第七顆深淵魔彈。",
        "ult": "前方扇形連開七槍：前6發各自尋敵造成<#ff9028ff>33<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>51%<>物理傷害，第7發必為深淵拐彎真傷魔彈。"
      },
      "abysspact_vesper": {
        "name": "燭靈",
        "attack": "放出鬼火造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理傷害。<#ff9028ff>燭冠<>：周圍每陣亡1名英雄點亮1支蠟燭（上限<#ffb900ff>5支<>），每支使治療與護盾+<#ffb900ff>10%<>。",
        "skill": "鬼火連結友軍<#ffb900ff>3秒<>：移速+<#ffb900ff>26%<>、每秒回復<#a974ffff>35<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>23%<>，結束賦予<#e8d44dff>62<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#e8d44dff>46%<>護盾。",
        "skill2": "放出尖叫亡魂直線穿透，造成<#a974ffff>50<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>46%<>魔法傷害並<#ef5350ff>恐懼0.82秒<>。",
        "ult": "喚回10秒內陣亡隊友化身魂體再戰<#ffb900ff>8秒<>（減傷50%禁療），期間己方拿到擊殺即<#ffb900ff>真復活<>；無陣亡隊友則全體加盾。"
      },
      "abysspact_carapace": {
        "name": "蛻甲",
        "attack": "蟲刃交叉斬擊造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理傷害。<#ff9028ff>蛻殼<>：每條命可蛻兩次（甲→蟲→羽），瀕死回<#ffb900ff>40%<>血並留空殼嘲諷自爆，最大血漸減而攻速移速大漲。",
        "skill": "前衝刺螯造成<#ff9028ff>94<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>123%<>物理傷害並<#ef5350ff>減速30%<>；第三形態「羽」變為遠距離飛撲。",
        "skill2": "敲響甲殼震傷周圍敵人<#ff9028ff>83<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>93%<>，命中敵方英雄時回復自身生命。",
        "ult": "立即主動蛻殼炸開舊甲，對周圍造成<#ff9028ff>195<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>127%<>傷害並<#ef5350ff>擊飛0.75秒<>、獲得<#ffb900ff>4秒+40%<>攻速；第三形態改為長距飛撲擊飛。"
      },
      "abysspact_leech": {
        "name": "附骨",
        "attack": "鉤爪撕撓造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理傷害。<#ff9028ff>附骨之疽<>：寄生宿主期間不可選中並持續吸取最大生命治己，但宿主挨打時自身同步承受<#ffb900ff>25%<>傷害。",
        "skill": "撲向目標造成<#a974ffff>98<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>75%<>法傷並附著敵方英雄背上<#ffb900ff>3秒<>減速吸血；宿主陣亡自動跳向下一名敵方英雄。",
        "skill2": "向目標注入深淵毒液造成<#a974ffff>117<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>85%<>法傷並<#ef5350ff>沉默1秒<>；附著期間對宿主沉默延長至<#ef5350ff>1.75秒<>。",
        "ult": "裂成<#ffb900ff>5隻<>小水蛭撲向周圍敵方英雄群吸<#ffb900ff>3秒<>（不可選中、每宿主分擔10%傷害），結束後聚回本體並回復全部所吸血量。"
      },
      "abysspact_noctua": {
        "name": "千蛾",
        "attack": "飛蛾撲火造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理傷害。<#ff9028ff>散身<>：1秒受創超<#ffb900ff>12%<>最大血時碎成蛾群不可選中並瞬移撤離，聚身後<#ef5350ff>1.25秒<>無法放技能。",
        "skill": "放出<#ffb900ff>6隻<>飛蛾自動尋敵各造成<#a974ffff>30<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26%<>魔法傷害並疊加鱗粉（每層減速10%，上限3層）。",
        "skill2": "飛蛾裹住敵方英雄結繭<#ef5350ff>眩暈1.12秒<>並造成法傷；破繭飛回時治療自身。",
        "ult": "整個人化作<#ffb900ff>3.5秒<>不可選中蛾群風暴持續灼燒並疊鱗粉，結束聚身時爆開鱗粉令周圍敵人<#ef5350ff>沉默1.25秒<>。"
      },
      "abysspact_anchor": {
        "name": "沉錨",
        "attack": "拖錨發射錨鏈彈（移速+<#ffb900ff>10%<>）；下錨變砲台射程暴漲至<#ffb900ff>9萬<>、每砲濺射周圍<#ffb900ff>60%<>傷害且<#ff9028ff>壓艙<>免疫擊退擊飛拉拽。",
        "skill": "掄起鐵錨鏈橫掃周圍敵人，造成<#ff9028ff>64<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>81%<>物理傷害並將近身敵人<#ef5350ff>擊退<>（下錨期間也可施放）。",
        "skill2": "在拖錨機動與下錨砲台姿態間切換：下錨無法移動但射程與濺射巨幅強化，遇險隨時起錨撤離。",
        "ult": "立刻架砲向超遠區域連轟<#ffb900ff>6發<>沉船巨砲，每發造成<#ff9028ff>95<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>58%<>範圍物理傷害並<#ef5350ff>擊飛0.4秒<>。"
      },
      "abysspact_hourglass": {
        "name": "返照",
        "attack": "彈出流沙光粒造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理傷害。<#ff9028ff>老去<>：放回光+1層、倒流+3層（上限10層，每層最大血-2.5%移速-2%且白髮遞增），陣亡復活重返年少。",
        "skill": "為友方英雄打上<#ffb900ff>3秒<>回光印記：到期將血量倒回打印記瞬間（只增不減），期間受致命傷則立刻倒血免死！",
        "skill2": "停擺目標區域時間，對範圍內敵人造成<#a974ffff>80<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>56%<>魔法傷害並<#ef5350ff>眩暈1.1秒<>。",
        "ult": "翻轉沙漏燈，令大範圍內所有存活友方英雄瞬間倒回<#ffb900ff>3秒前<>的位置與血量（只增不減，老去+3層）。"
      },
      "abysspact_reprieve": {
        "name": "緩刑",
        "attack": "掄鐵球砸擊造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理傷害。<#ff9028ff>緩刑<>：受擊一半記入刑期（上限60%最大生命）4秒緩扣；身邊拿到人頭立刻全額勾銷。",
        "skill": "甩出鐵球命中敵方造成<#ff9028ff>94+7%目標最大生命<>物理傷害、<#ef5350ff>0.8秒暈眩<>並以鐵鏈拽回。",
        "skill2": "仰頭怒吼嘲諷周圍敵人<#ef5350ff>1.3秒<>，期間緩刑記帳比例提升至<#ffb900ff>70%<>。",
        "ult": "扇形甩出三副巨枷扣住敵方英雄，造成<#ff9028ff>180+9%目標最大生命<>物理傷害並<#ef5350ff>暈眩1.5秒<>。"
      },
      "abysspact_debtor": {
        "name": "賒命",
        "attack": "彎劍斬擊造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理傷害。<#ff9028ff>欠條<>：技能命中敵方英雄留下6秒欠條，大招可對欠條目標強行換命。",
        "skill": "突刺斬向敵方造成<#ff9028ff>102<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>122%<>物理傷害並留欠條；目標生命低於<#ef5350ff>30%<>時傷害<#ff9028ff>+50%<>。",
        "skill2": "原地橫掃周圍造成<#ff9028ff>84<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>95%<>物理傷害，每命中目標回復生命並留下欠條。",
        "ult": "與帶欠條的敵方英雄<#ef5350ff>當場對調血量比例<>；<#ffb900ff>6秒內<>擊殺對方永久保留此命，否則按屆時比例換回！"
      },
      "abysspact_traceless": {
        "name": "無痕",
        "attack": "快劍刺擊造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理傷害。<#ff9028ff>無痕<>：無傷命中疊鋒（最高8層各+7%攻），脫戰1.5秒隱身首擊+50%，掉一滴血鋒全散。",
        "skill": "直線衝刺穿透敵方造成<#ff9028ff>110<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>117%<>物理傷害；<#ffb900ff>擊殺敵方英雄立刻刷新冷卻<>。",
        "skill2": "原地留殘影，自身<#ffb900ff>0.75秒不可選中<>後隱身1秒，保住全部鋒層並強化下擊。",
        "ult": "消失<#ffb900ff>1.5秒不可選中<>，對大範圍內每個敵方英雄各劃一劍（<#ff9028ff>138<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>104%<>）並疊鋒，落於殘血身後。"
      },
      "abysspact_starfall": {
        "name": "隕夜",
        "attack": "喚落延遲0.5秒黑星，砸中範圍造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>20%<>傷害（濺射60%）。<#ef5350ff>代價<>：3萬內貼臉普攻落空。",
        "skill": "沿直線由近到遠落下5顆黑星，每顆造成<#a974ffff>38<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<>魔法傷害；被砸中兩顆以上者<#ef5350ff>減速30%<>。",
        "skill2": "化作星光向後閃退拉開身位，原地落下黑星造成<#a974ffff>45<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>32%<>魔法傷害並<#ef5350ff>擊退<>近身敵人。",
        "ult": "撕裂夜空在目標大範圍傾瀉<#ffb900ff>4秒黑星雨<>，持續造成<#a974ffff>38<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<>魔法傷害，期間可自由移動。"
      },
      "abysspact_knell": {
        "name": "喪鐘",
        "attack": "掄鐘錘砸擊造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理傷害。<#ff9028ff>鐘殼<>：巨鐘背在背上時受到的所有傷害<#ffb900ff>-15%<>；開大扣鐘期間無減傷。",
        "skill": "掄錘撞響背上巨鐘，前方扇形造成<#a974ffff>86+7%自身最大生命<>魔法傷害並<#ef5350ff>暈眩0.87秒<>。",
        "skill2": "輕敲鐘沿為大範圍友軍提供<#e8d44dff>180護盾<>（3.33秒）與<#ffb900ff>+24%移速<>。",
        "ult": "跳進敵陣扣下巨鐘，將自己與周圍敵人關在鐘內<#ffb900ff>2.5秒<>（鐘內外隔絕、每0.5秒震響造成<#a974ffff>53+4%生命<>法傷），掀鐘時全員<#ef5350ff>擊飛<>！"
      }
    },
