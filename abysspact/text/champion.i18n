        "ult": "隔離区"
      }
    }
  },
  "ko": {
    "description": {
      "abysspact_oathbreaker": {
        "name": "단서",
        "attack": "부러진 대검으로 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>혈서<>: 스킬 사용 시 현재 체력 <#ffb900ff>6%<> 소모, 잃은 체력 <#ffb900ff>10%<>당 공격력+<#ffb900ff>4%<>, 공속+<#ffb900ff>5%<>.",
        "skill": "검은 불꽃을 휘둘러 <#ff9028ff>72<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>112%<> 물리 피해와 <#ef5350ff>30% 둔화<>. 챔피언 적중 시 회복, 사슬 표적 추가 피해.",
        "skill2": "서약의 사슬로 첫 적 챔피언을 끌어당겨 <#ff9028ff>60<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> 물리 피해와 <#ef5350ff>0.5초 속박<>.",
        "ult": "<#ffb900ff>6초<> 불사 및 흡혈 <#ffb900ff>40%<>, 기본 공격 흑염 추가. 처치 관여 시 최대 체력 <#ffb900ff>25%<> 회복, 실패 시 현재 체력 <#ffb900ff>15%<> 소모."
      },
      "abysspact_faceless": {
        "name": "무면",
        "attack": "손톱 칼날로 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>탈면<>: 적 챔피언 처치 관여 시 <#ffb900ff>10초<>간 대상의 얼굴과 모습을 빼앗아 변신.",
        "skill": "그림자가 되어 적을 관통하며 <#ff9028ff>90<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>115%<> 물리 피해와 <#ef5350ff>30% 둔화<>.",
        "skill2": "검은 안개에 <#ffb900ff>1.5초 은신<> 및 가속. 은신 해제 첫 타격은 추가 피해와 <#ef5350ff>0.9초 공포<>.",
        "ult": "적 챔피언의 얼굴을 찢어 <#ff9028ff>290<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>165%<> 물리 피해. 체력 <#ffb900ff>25%<> 이하는 즉시 고정 피해 처형 후 탈면."
      },
      "abysspact_whisperer": {
        "name": "잠꼬대",
        "attack": "염주를 날려 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>광기<>: 스킬 적중 시 중첩, <#ffb900ff>3중첩<> 시 <#ef5350ff>1.5초 공포<>와 함께 주변 아군에게 마법 폭발 및 연쇄 전파.",
        "skill": "관통하는 보라색 속삭임으로 <#a974ffff>80<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<> 마법 피해와 광기 <#ffb900ff>1중첩<>.",
        "skill2": "대상에 거대한 눈을 <#ffb900ff>3초<>간 열어 매초 <#a974ffff>28<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>22%<> 마법 피해, <#ef5350ff>22% 둔화<>, 광기 <#ffb900ff>1중첩<>.",
        "ult": "지면에 수많은 입을 열어 <#a974ffff>215<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>108%<> 마법 피해와 동시에 모든 적에게 광기 <#ffb900ff>3중첩<>을 채워 연쇄 폭주."
      },
      "abysspact_bonebow": {
        "name": "해현",
        "attack": "뼈화살로 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>망병<>: <#ffb900ff>4발<>마다 대상 옆에 해골병 소환(공격력 <#ffb900ff>30%<>, <#ffb900ff>6초<>, 최대 <#ffb900ff>3기<>).",
        "skill": "관통 뼈화살로 <#ff9028ff>75<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>105%<> 물리 피해. 적중한 적 챔피언마다 해골병 1기 소환.",
        "skill2": "모든 해골병을 표적으로 돌진 자폭시켜 기당 <#ff9028ff>40<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50%<> 범위 물리 피해와 <#ef5350ff>30% 둔화<>.",
        "ult": "뼈화살 비로 <#ff9028ff>132<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>88%<> 범위 물리 피해와 함께 상한 외 해골병 <#ffb900ff>5기<>를 <#ffb900ff>8초<> 소환."
      },
      "abysspact_corvus": {
        "name": "까마귀 의사",
        "attack": "약병을 던져 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>전염<>: 스킬로 <#ffb900ff>4초<> 역병(초당 최대체력 <#ffb900ff>2%<>)을 퍼뜨리며 감염된 적 근처 아군 초당 <#ffb900ff>1~3%<> 회복.",
        "skill": "독기 병을 던져 범위에 <#a974ffff>52<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>42%<> 마법 피해, <#ef5350ff>30% 둔화<> 및 역병 감염.",
        "skill2": "어깨의 까마귀를 아군에게 <#ffb900ff>4초<> 보내 <#e8d44dff>85<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#e8d44dff>60%<> 보호막 부여. 매초 주변 적을 쪼아 역병 감염.",
        "ult": "<#ffb900ff>5초<> 격리 구역 선포: <#a974ffff>92<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<> 마법 피해와 <#ef5350ff>0.67초 기절<>. 구역 내 적은 역병·둔화, 아군은 지속 회복."
      }
    },
    "skill_name": {
