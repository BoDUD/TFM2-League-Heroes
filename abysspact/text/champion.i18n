        "attack": "弯剑斩击造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理伤害。<#ff9028ff>欠条<>：技能命中敌方英雄留下6秒欠条，大招可对欠条目标强行换命。",
        "skill": "突刺斩向敌方造成<#ff9028ff>102<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>122%<>物理伤害并留欠条；目标生命低于<#ef5350ff>30%<>时伤害<#ff9028ff>+50%<>。",
        "skill2": "原地横扫周围造成<#ff9028ff>84<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>95%<>物理伤害，每命中目标回复生命并留下欠条。",
        "ult": "与带欠条的敌方英雄<#ef5350ff>当场对调血量比例<>；<#ffb900ff>6秒内<>击杀对方永久保留此命，否则按届时比例换回！"
      },
      "abysspact_traceless": {
        "name": "无痕",
        "attack": "快剑刺击造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理伤害。<#ff9028ff>无痕<>：无伤命中叠锋（最高8层各+7%攻），脱战1.5秒隐身首击+50%，掉一滴血锋全散。",
        "skill": "直线冲刺穿透敌方造成<#ff9028ff>110<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>117%<>物理伤害；<#ffb900ff>击杀敌方英雄立刻刷新冷却<>。",
        "skill2": "原地留残影，自身<#ffb900ff>0.75秒不可选中<>后隐身1秒，保住全部锋层并强化下击。",
        "ult": "消失<#ffb900ff>1.5秒不可选中<>，对大范围内每个敌方英雄各划一剑（<#ff9028ff>138<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>104%<>）并叠锋，落于残血身后。"
      },
      "abysspact_starfall": {
        "name": "陨夜",
        "attack": "唤落延迟0.5秒黑星，砸中范围造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>20%<>伤害（溅射60%）。<#ef5350ff>代价<>：3万内贴脸普攻落空。",
        "skill": "沿直线由近到远落下5颗黑星，每颗造成<#a974ffff>38<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<>魔法伤害；被砸中两颗以上的人<#ef5350ff>减速30%<>。",
        "skill2": "化作星光向后闪退拉开身位，原地落下黑星造成<#a974ffff>45<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>32%<>魔法伤害并<#ef5350ff>击退<>近身敌人。",
        "ult": "撕裂夜空在目标大范围倾泻<#ffb900ff>4秒黑星雨<>，持续造成<#a974ffff>38<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<>魔法伤害，期间可自由移动。"
      },
      "abysspact_knell": {
        "name": "丧钟",
        "attack": "抡钟锤砸击造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理伤害。<#ff9028ff>钟壳<>：巨钟背在背上时受到的所有伤害<#ffb900ff>-15%<>；开大扣钟期间无减伤。",
        "skill": "抡锤撞响背上巨钟，前方扇形造成<#a974ffff>86+7%自身最大生命<>魔法伤害并<#ef5350ff>眩晕0.87秒<>。",
        "skill2": "轻敲钟沿为大范围友军提供<#e8d44dff>180护盾<>（3.33秒）与<#ffb900ff>+24%移速<>。",
        "ult": "跳进敌阵扣下巨钟，将自己与周围敌人关在钟内<#ffb900ff>2.5秒<>（钟内外隔绝、每0.5秒震响造成<#a974ffff>53+4%生命<>法伤），掀钟时全员<#ef5350ff>击飞<>！"
      }
    },
