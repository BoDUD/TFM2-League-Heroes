  "en": {
    "description": {
      "abysspact_oathbreaker": {
        "name": "Oathbreaker",
        "attack": "Broken greatsword strike for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> physical damage. <#ff9028ff>Blood Oath<>: skills burn <#ffb900ff>6%<> current HP; gain <#ffb900ff>+4%<> AD and <#ffb900ff>+5%<> AS per <#ffb900ff>10%<> missing HP.",
        "skill": "Sweep a black-flame crescent for <#ff9028ff>72<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>112%<> physical damage and <#ef5350ff>30% slow<>; heals on champion hits and deals bonus damage to chained foes.",
        "skill2": "Hurl a broken oath chain that hooks the first enemy champion, pulling them in for <#ff9028ff>60<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> physical damage and <#ef5350ff>0.5s bind<>.",
        "ult": "Refuse death for <#ffb900ff>6s<> with <#ffb900ff>40%<> vamp and bonus black-flame hits. Takedown heals <#ffb900ff>25%<> max HP at end; otherwise burn <#ffb900ff>15%<> current HP."
      },
      "abysspact_faceless": {
        "name": "Faceless",
        "attack": "Claw slash for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> physical damage. <#ff9028ff>Face Steal<>: takedowns let him wear the victim's face for <#ffb900ff>10s<>, assuming their form with boosted combat power.",
        "skill": "Turn to shadow and dash through enemies for <#ff9028ff>90<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>115%<> physical damage and a <#ef5350ff>30% slow<>.",
        "skill2": "Fade into dark mist, gaining <#ffb900ff>1.5s stealth<> and speed. His first strike out of stealth deals bonus damage and <#ef5350ff>fears for 0.9s<>.",
        "ult": "Grasp an enemy champion and rip off their face for <#ff9028ff>290<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>165%<> physical damage; targets at or below <#ffb900ff>25%<> HP are executed immediately and stolen."
      },
      "abysspact_whisperer": {
        "name": "Whisperer",
        "attack": "Flick a prayer bead for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> physical damage. <#ff9028ff>Madness<>: skills stack Madness; at <#ffb900ff>3 stacks<> foes suffer <#ef5350ff>1.5s fear<>, blast nearby allies for magic damage, and spread +1 stack.",
        "skill": "Send a piercing purple whisper dealing <#a974ffff>80<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<> magic damage and adding <#ffb900ff>1 Madness<> stack.",
        "skill2": "Open a giant eye on the ground for <#ffb900ff>3s<>, dealing <#a974ffff>28<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>22%<> magic damage/s, <#ef5350ff>22% slow<>, and <#ffb900ff>+1 Madness/s<>.",
        "ult": "Split the earth with chanting mouths for <#a974ffff>215<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>108%<> magic damage, instantly filling <#ffb900ff>3 Madness<> on all foes inside to trigger chain eruptions."
      },
      "abysspact_bonebow": {
        "name": "Bonebow",
        "attack": "Bone arrow for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> physical damage. <#ff9028ff>Risen Dead<>: every <#ffb900ff>4th arrow<> raises a skeleton (<#ffb900ff>30%<> AD, <#ffb900ff>6s<>, cap <#ffb900ff>3<>) beside the target.",
        "skill": "Fire a piercing bone arrow for <#ff9028ff>75<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>105%<> physical damage, raising a skeleton beside every enemy champion hit.",
        "skill2": "Command all living skeletons to rush her target and detonate for <#ff9028ff>40<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50%<> AoE physical damage each plus <#ef5350ff>30% slow<>.",
        "ult": "Rain bone arrows for <#ff9028ff>132<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>88%<> AoE physical damage and raise <#ffb900ff>5 uncapped skeletons<> for <#ffb900ff>8s<>."
      },
      "abysspact_corvus": {
        "name": "Corvus",
        "attack": "Toss a vial for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> physical damage. <#ff9028ff>Contagion<>: skills inflict <#ffb900ff>4s Plague<> (<#ffb900ff>2%<> max HP/s) that jumps between foes; allies near sick foes heal <#ffb900ff>1–3%<> max HP/s.",
        "skill": "Lob a miasma flask for <#a974ffff>52<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>42%<> AoE magic damage, <#ef5350ff>30% slow<>, and Plague on all foes hit.",
        "skill2": "Send his raven to perch on an ally for <#ffb900ff>4s<>, granting a <#e8d44dff>85<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#e8d44dff>60%<> shield while pecking nearby enemies to spread Plague.",
        "ult": "Draw a <#ffb900ff>5s<> Quarantine zone: bursts for <#a974ffff>92<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<> magic damage with <#ef5350ff>0.67s stun<>, plaguing & slowing foes while healing allies inside."
      },
      "abysspact_bloodmoon": {
        "name": "Bloodmoon",
        "attack": "Ranged silver crossbow as human, melee claws as wolf for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> physical damage. <#ff9028ff>Moon Phase<>: wolf gains <#ffb900ff>+30%<> AS and <#ffb900ff>10%<> vamp.",
        "skill": "Human: 3 piercing silver bolts (<#ff9028ff>34<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>54%<>, <#ef5350ff>20% slow<>). Wolf: pounce for <#ff9028ff>90<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>116%<> and heal.",
        "skill2": "Shift between human and wolf: wolf shift slows nearby foes by <#ef5350ff>30%<>; human shift tumbles backward.",
        "ult": "Rise as a giant wolf for <#ffb900ff>8s<>: <#ffb900ff>25%<> damage reduction, cleaving autos, and a howl that <#ef5350ff>fears for 1.03s<>."
      },
      "abysspact_undertaker": {
        "name": "Undertaker",
        "attack": "Coffin slam for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> physical damage. <#ff9028ff>Coffin Shield<>: <#ffb900ff>-15%<> basic attack damage; every <#ffb900ff>8s<>, reduce the next skill hit by <#ffb900ff>30%<>.",
        "skill": "Smash his coffin forward for <#ff9028ff>56<>+<#ffb900ff>6% max HP<> physical damage and <#ef5350ff>0.48s knockup<>.",
        "skill2": "Hurl his chained coffin and pull himself to the target; the planted coffin stands <#ffb900ff>3s<>, <#ef5350ff>slowing by 40%<>.",
        "ult": "Stuff an enemy champion into his coffin and haul them <#ffb900ff>2s<> (<#ffb900ff>+20%<> MS), then slam for <#ff9028ff>150<>+<#ffb900ff>8% target max HP<> and <#ef5350ff>1s stun<>."
      },
      "abysspact_effigy": {
        "name": "Effigy",
        "attack": "Doll tosses a silver needle for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> physical damage. <#ff9028ff>Pinned<>: skills embed up to <#ffb900ff>3 needles<> (<#ffb900ff>5s<>) for her ult to rip out.",
        "skill": "Fan silver needles for <#a974ffff>52<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>52%<> magic damage, <#ef5350ff>25% slow<>, and a needle; center needle pierces for extra damage.",
        "skill2": "Bind two enemy champions with red thread for <#ffb900ff>4s<>: <#ffb900ff>40%<> damage is shared; pulling apart snaps it for <#ef5350ff>1s double stun<> and <#a974ffff>80<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<> magic damage.",
        "ult": "Yank all embedded needles in range, dealing <#a974ffff>90<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<> magic damage per needle and a <#ef5350ff>50% slow<>."
      },
      "abysspact_sevenfold": {
        "name": "Sevenfold",
        "attack": "Freeshooter rifle for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> physical damage. <#ff9028ff>7th Bullet<>: every 7th round curves into a random enemy champion for <#ff9028ff>135<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<> true damage, burning <#ffb900ff>8%<> current HP then reloading 1.2s.",
        "skill": "Fire three rapid shots (<#ff9028ff>25<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>42%<> physical each), spending 3 rounds toward the 7th bullet.",
        "skill2": "Tumble backward and immediately chamber the 7th Abyss Bullet as his very next shot.",
        "ult": "Unleash a 7-shot salvo: 6 tracking rounds (<#ff9028ff>33<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>51%<> physical each) capped by a guaranteed 7th Abyss Bullet."
      },
      "abysspact_vesper": {
        "name": "Vesper",
        "attack": "Launch a spirit wisp for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> physical damage. <#ff9028ff>Candle Crown<>: each nearby champion death lights a candle (max <#ffb900ff>5<>), boosting heals & shields by <#ffb900ff>+10%<> each.",
        "skill": "Link a wisp to an ally for <#ffb900ff>3s<>: <#ffb900ff>+26%<> MS, <#a974ffff>35<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>23%<> heal/s, ending with a <#e8d44dff>62<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#e8d44dff>46%<> shield.",
        "skill2": "Send a screaming wraith forward in a line for <#a974ffff>50<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>46%<> magic damage and <#ef5350ff>0.82s fear<>.",
        "ult": "Recall a recently fallen ally in Spirit Form for <#ffb900ff>8s<> (50% DR, no healing); any team kill grants <#ffb900ff>true revival<>. Otherwise shields all nearby allies."
      },
      "abysspact_carapace": {
        "name": "Carapace",
        "attack": "Scythe slash for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> physical damage. <#ff9028ff>Molt<>: cheats death twice per life (Armor -> Bug -> Winged), healing to <#ffb900ff>40%<> HP while leaving a taunting bomb shell; loses max HP for AS & MS.",
        "skill": "Lunge forward for <#ff9028ff>94<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>123%<> physical damage and <#ef5350ff>30% slow<>; becomes a long winged dive in Form 3.",
        "skill2": "Strike his shell to shock nearby foes for <#ff9028ff>83<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>93%<> physical damage, healing on champion hits.",
        "ult": "Actively molt to shatter his shell for <#ff9028ff>195<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>127%<> AoE damage, <#ef5350ff>0.75s knockup<>, and <#ffb900ff>+40% AS<> for 4s; Form 3 dives from afar."
      },
      "abysspact_leech": {
        "name": "Leech",
        "attack": "Hook claw for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> physical damage. <#ff9028ff>Bone Parasite<>: while clinging to an enemy he is untargetable and drains max HP to heal, but suffers <#ffb900ff>25%<> of damage dealt to his host.",
        "skill": "Pounce for <#a974ffff>98<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>75%<> magic damage and cling to an enemy champion for <#ffb900ff>3s<>, slowing & draining; jumps to a nearby foe if host dies.",
        "skill2": "Inject marrow venom for <#a974ffff>117<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>85%<> magic damage and <#ef5350ff>1s silence<> (<#ef5350ff>1.75s<> while attached).",
        "ult": "Split into <#ffb900ff>5 mini-leeches<> draining enemy champions for <#ffb900ff>3s<> while untargetable (10% shared pain each), then reform and heal for all drained HP."
      },
      "abysspact_noctua": {
        "name": "Noctua",
        "attack": "Send a fluttering moth for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> physical damage. <#ff9028ff>Scatter<>: taking ><#ffb900ff>12%<> max HP in 1s scatters her untargetably away (12s CD), silencing her skills for <#ef5350ff>1.25s<> on reform.",
        "skill": "Release <#ffb900ff>6 homing moths<> for <#a974ffff>30<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26%<> magic damage each, stacking Scales (-10% MS per stack, up to 3).",
        "skill2": "Wrap an enemy champion in a moth cocoon for <#ef5350ff>1.12s stun<>; moths return on break to heal her.",
        "ult": "Become an untargetable moth storm for <#ffb900ff>3.5s<> scorching and scaling foes, then reform in a dust shockwave that <#ef5350ff>silences for 1.25s<>."
      },
      "abysspact_anchor": {
        "name": "Anchor",
        "attack": "Drag mode shoots chain bolts (<#ffb900ff>+10%<> MS); Siege mode anchors for <#ffb900ff>90k range<>, <#ffb900ff>60%<> splash shells, and <#ff9028ff>Ballast<> immunity to displacement.",
        "skill": "Swing her iron anchor chain around herself for <#ff9028ff>64<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>81%<> physical damage and <#ef5350ff>knockback<> (castable while anchored).",
        "skill2": "Switch between Drag mobility and Siege turret mode (massive range & splash, immobile until raised).",
        "ult": "Plant anchor and fire <#ffb900ff>6 sunken cannon shells<> across long range, each dealing <#ff9028ff>95<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>58%<> AoE physical damage and <#ef5350ff>0.4s knockup<>."
      },
      "abysspact_hourglass": {
        "name": "Hourglass",
        "attack": "Flick glowing sand for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> physical damage. <#ff9028ff>Aging<>: Q adds 1 stack, R adds 3 (cap 10, -2.5% max HP & -2% MS each, graying/whitening her hair); death restores her youth.",
        "skill": "Mark an ally for <#ffb900ff>3s<>: rewinds their HP upward to when marked, triggering immediately to save them from lethal damage.",
        "skill2": "Halt time in an area for <#a974ffff>80<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>56%<> magic damage and <#ef5350ff>1.1s stun<>.",
        "ult": "Invert her hourglass lantern to rewind every living ally in wide range back to their position and HP from <#ffb900ff>3s ago<> (never reducing HP; +3 Age)."
      },
      "abysspact_reprieve": {
        "name": "Reprieve",
        "attack": "Swing an iron ball for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> AD. <#ff9028ff>Reprieve<>: 50% of damage taken is deferred over 4s (cap 60% max HP); any nearby takedown absolves all deferred debt.",
        "skill": "Hurl the iron ball for <#ff9028ff>94+7% target max HP<> physical damage, <#ef5350ff>0.8s stun<>, and chain pull.",
        "skill2": "Roar to <#ef5350ff>taunt<> nearby foes for 1.3s, raising deferred damage to <#ffb900ff>70%<>.",
        "ult": "Hurl three giant cangues in a cone for <#ff9028ff>180+9% target max HP<> physical damage and <#ef5350ff>1.5s stun<>."
      },
      "abysspact_debtor": {
        "name": "Debtor",
        "attack": "Slash for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> AD. <#ff9028ff>IOU<>: ability hits stamp a 6s IOU on enemy champions, marking them for Life Swap.",
        "skill": "Lunge to slash for <#ff9028ff>102<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>122%<> physical damage and stamp an IOU; deals <#ff9028ff>+50%<> damage below <#ef5350ff>30% HP<>.",
        "skill2": "Spin-sweep nearby foes for <#ff9028ff>84<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>95%<> physical damage, healing per hit and stamping IOUs.",
        "ult": "<#ef5350ff>Swap HP percentages<> with an IOU-marked foe for <#ffb900ff>6s<>: kill them to keep the life, or swap current ratios back!"
      },
      "abysspact_traceless": {
        "name": "Traceless",
        "attack": "Swift thrust for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> AD. <#ff9028ff>Unstained<>: unhit strikes stack Edge (up to 8x +7% AD); 1.5s out-of-combat stealth adds +50% on opener. Losing any HP clears all Edge.",
        "skill": "Dash through a foe for <#ff9028ff>110<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>117%<> physical damage; <#ffb900ff>resets immediately on kill<>.",
        "skill2": "Leave a pale afterimage, turning <#ffb900ff>untargetable 0.75s<> then invisible 1s to preserve Edge.",
        "ult": "Vanish <#ffb900ff>untargetable for 1.5s<>, slashing every nearby enemy champion (<#ff9028ff>138<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>104%<>) and stacking Edge."
      },
      "abysspact_starfall": {
        "name": "Starfall",
        "attack": "Call down a 0.5s-delayed Black Star dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>20%<> AoE damage (60% splash). <#ef5350ff>Cost<>: attacks miss foes inside 30k range.",
        "skill": "Drop 5 Black Stars one by one along a line for <#a974ffff>38<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<> magic damage each; foes hit by two or more are <#ef5350ff>30% slowed<>.",
        "skill2": "Flash backward as starlight, dropping a Black Star for <#a974ffff>45<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>32%<> magic damage and <#ef5350ff>knockback<>.",
        "ult": "Tear open the night sky to rain Black Stars for <#ffb900ff>4s<>, repeatedly dealing <#a974ffff>38<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<> magic damage while moving."
      },
      "abysspact_knell": {
        "name": "Knell",
        "attack": "Smash with a bell hammer for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> AD. <#ff9028ff>Bell Shell<>: takes <#ffb900ff>15% less damage<> while carrying the bell (disabled while Bell Toll is dropped).",
        "skill": "Strike the bell for a forward wave dealing <#a974ffff>86+7% max HP<> magic damage and <#ef5350ff>0.87s stun<>.",
        "skill2": "Ring a soothing chime granting nearby allies a <#e8d44dff>180 shield<> and <#ffb900ff>+24% MS<>.",
        "ult": "Leap and drop the giant bell, isolating himself and nearby foes inside for <#ffb900ff>2.5s<> (chimes deal <#a974ffff>53+4% HP<> magic damage every 0.5s, <#ef5350ff>knocking up<> on lift)."
      }
    },
