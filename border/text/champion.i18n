{
  "zh-hans": {
    "description": {
      "border_cenlei": {
        "name": "岑垒",
        "attack": "盾击，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>1%<><#ff9028ff>物理伤害<>。<#ff9028ff>背压<>：接肩替队友挨的伤害攒成背压（最多最大生命的<#ffb900ff>25%<>），每攒十分之一护甲和魔抗<#ffb900ff>+2<>，卸城时全部放出。",
        "skill": "朝前方扇形扫击，造成<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>4%<><#ff9028ff>物理伤害<>并<#ef5350ff>减速35%<>，扇形里的人<#ef5350ff>眩晕0.67秒<>；优先扫向正在施法的敌方英雄，<#ef5350ff>打断<>施法（<#ef5350ff>眩晕1秒<>）。",
        "skill2": "给身边最受威胁的队友贴上盾板（<#ffb900ff>4秒<>）：他接下来<#ffb900ff>2<>次受到的伤害降低<#ffb900ff>40%<>，少挨的部分由岑垒承受（不会因此倒下）并攒成背压。没人受威胁时自己减伤<#ffb900ff>20%<>。",
        "ult": "起手不受控制、减伤<#ffb900ff>30%<>，随后放出背压：前方扇形的敌人受到<#ff9028ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> + 背压<#ffb900ff>60%<>的<#ff9028ff>物理伤害<>，被<#ef5350ff>推开<>并<#ef5350ff>减速30%<>；放出背压的<#ffb900ff>50%<>化为<#e8d44dff>护盾<>。"
      },
      "border_xiaolun": {
        "name": "绡轮",
        "attack": "弩箭造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>走弦<>：按实际走过的路上弦，走满十层后弦绷紧，下一箭额外造成<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<><#ff9028ff>物理伤害<>并<#ef5350ff>减速20%<>。",
        "skill": "朝目标侧面短移（只走得通的路，撞墙即停），随后射出一箭，造成<#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<><#ff9028ff>物理伤害<>。侧移的路也会上弦。",
        "skill2": "放掉全部张力：<#ffb900ff>3秒<>内攻速<#ffb900ff>+35%<>，每层张力再<#ffb900ff>+5%<>（满弦<#ffb900ff>+85%<>）。",
        "ult": "分三次射出星弧箭，每支在射出时重新选择目标（原目标优先，其次生命比例最低的敌方英雄），各造成<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<><#ff9028ff>物理伤害<>。被控制时停射。"
      },
      "border_dengmi": {
        "name": "灯弥",
        "attack": "灯火造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>和<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<><#a974ffff>魔法伤害<>。<#ff9028ff>存光<>：身边的友军（含自己）受到技能伤害时攒灯火，每损失<#ffb900ff>1%<>生命攒<#ffb900ff>1<>点，最多<#ffb900ff>100<>点，强化收灯。",
        "skill": "把灯递给身边最承压的友军，给予<#e8d44dff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<> + 对方<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#e8d44dff>6%<>的<#e8d44dff>护盾<>，持续<#ffb900ff>2.5秒<>；灯一亮，他身边的敌人被晃眼<#ef5350ff>减速50%<><#ffb900ff>1.5秒<>。",
        "skill2": "为生命比例最低的友军引路：移速<#7ee08aff>+35%<>，持续<#ffb900ff>2.5秒<>；对方生命低于<#ffb900ff>50%<>时再<#7ee08aff>+20%<>。灯弥自己移速<#7ee08aff>+15%<>。",
        "ult": "收回灯火化作两道脉冲：第一道<#7ee08aff>治疗<>选中的友军<#7ee08aff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>，第二道<#7ee08aff>治疗<>他身边生命比例最低的友军同样多；每点灯火使治疗<#ffb900ff>+1%<>（满灯火翻倍）。每道脉冲在受治疗的人身边炸开光：周围敌人受到<#a974ffff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<><#a974ffff>魔法伤害<>并<#ef5350ff>减速30%<>。"
      },
      "border_zhumo": {
        "name": "铸沫",
        "attack": "锤击造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>余温<>：每次普攻命中积攒热量（最多<#ffb900ff>10<>层），每层攻速<#ffb900ff>+3%<>；<#ffb900ff>3秒<>没打中东西后逐渐散热。",
        "skill": "落锤重击，造成<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<><#ff9028ff>物理伤害<>，每层热量再加<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>10%<>，并<#ef5350ff>减速30%<>；热量<#ffb900ff>5<>层以上时<#ef5350ff>眩晕0.4秒<>。周围敌人受到<#ffb900ff>50%<>伤害。",
        "skill2": "用掉全部热量回火：<#ffb900ff>2.5秒<>内受到的伤害降低<#ffb900ff>25%<>，每层热量再降低<#ffb900ff>4%<>（满热<#ffb900ff>65%<>）。",
        "ult": "开炉：脚下的敌人受到<#ff9028ff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<><#ff9028ff>物理伤害<>；<#ffb900ff>5秒<>内攻速<#ffb900ff>+60%<>，每秒热量<#ffb900ff>+2<>层；危险时加快回火冷却，热量够且有敌人在旁时加快压坯冷却。"
      },
      "border_fusuo": {
        "name": "伏梭",
        "attack": "一刀造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>数步<>：离开队友、越走越远的敌方英雄会被盯上（<#ffb900ff>3秒<>），伏梭对其伤害<#ffb900ff>+15%<>。",
        "skill": "冲向目标（附近有被盯上的敌方英雄时改冲向他），随后斩击，造成<#ff9028ff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160%<><#ff9028ff>物理伤害<>，对被盯上的目标再<#ffb900ff>+30%<>。",
        "skill2": "在原地留下回撤点，移速<#7ee08aff>+35%<>；<#ffb900ff>4秒<>内陷入危险时自动闪回回撤点，短暂减伤<#ffb900ff>30%<>。",
        "ult": "在自己和目标之间拉出一道延伸到目标身后的预告斩线，随即穿过目标；片刻后斩线结算：仍在线上的敌人受到<#ff9028ff>380<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>210%<><#ff9028ff>物理伤害<>。及时离开斩线就能躲开。"
      },
      "border_yanxi": {
        "name": "盐汐",
        "attack": "盐晶造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>析晶<>：留在盐带里的敌人<#ef5350ff>减速25%<>，每<#ffb900ff>0.75秒<>叠一层结晶（最多<#ffb900ff>5<>层）。",
        "skill": "以目标为中心铺下一条盐带（<#ffb900ff>4秒<>），带上的敌人受到<#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<><#a974ffff>魔法伤害<>并叠一层结晶。",
        "skill2": "引爆附近敌人的结晶：造成<#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>40%<><#a974ffff>魔法伤害<>，每层再加<#a974ffff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<>；结晶最多的敌方英雄被<#ef5350ff>定身1秒<>。",
        "ult": "让盐带朝自己退潮：晶浪扫过的敌人受到<#a974ffff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>90%<><#a974ffff>魔法伤害<>，叠<#ffb900ff>2<>层结晶并被<#ef5350ff>卷向盐汐<>。没有盐带时先在目标处铺一条。"
      },
      "border_yindu": {
        "name": "殷渡",
        "attack": "一拳造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>迎汐<>：朝敌方英雄推进时攒潮势（最多<#ffb900ff>8<>层），下一次扣舷每层多<#ef5350ff>减速5%<>。",
        "skill": "朝目标短冲，被路上第一个敌人挡住就停下撞他：<#ff9028ff>95<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>4%<><#ff9028ff>物理伤害<>，<#ef5350ff>眩晕0.43秒<>并<#ef5350ff>减速25%<>。",
        "skill2": "在目标那一群敌人中间插下航标（<#ffb900ff>6秒<>），落下时身边的敌人受到<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>4%<><#ff9028ff>物理伤害<>并<#ef5350ff>减速20%<>。",
        "ult": "从航标（没有就在目标脚下）两侧掀起潮墙往中间合拢：圈里的敌人被卷到汇合点，受到<#ff9028ff>190<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>7%<><#ff9028ff>物理伤害<>并<#ef5350ff>眩晕0.95秒<>，每人只卷一次。"
      },
      "border_lanti": {
        "name": "澜缇",
        "attack": "一拳造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>折纹<>：只标记最近一个用技能伤到她的敌方英雄（<#ffb900ff>5秒<>）。",
        "skill": "连出两拳：<#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<>，再<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<><#ff9028ff>物理伤害<>；第二拳打到带折纹的人时用掉折纹，这一拳<#ffb900ff>+60%<>并<#ef5350ff>减速20%<>。",
        "skill2": "起架<#ffb900ff>2.5秒<>：受到的技能伤害降低<#ffb900ff>50%<>；架着挨了一下技能就算成功，双棱冷却刷新，挡下的伤害记进还响。",
        "ult": "推出一道玻璃波：路上的敌人受到<#ff9028ff>260<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160%<><#ff9028ff>物理伤害<>，加上最近挡下伤害的<#ffb900ff>60%<>（最多<#ffb900ff>+300<>），并<#ef5350ff>减速30%<>。"
      },
      "border_luxin": {
        "name": "鹭芯",
        "attack": "一刀造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>追羽<>：被她打过的敌方英雄继续逃远时，脚下留下羽迹（最多两段，<#ffb900ff>4秒<>）。",
        "skill": "顺着目标逃的方向追过去，贴近后切击，造成<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<><#ff9028ff>物理伤害<>。",
        "skill2": "在目标脚下拉一道风线（<#ffb900ff>4秒<>），之后穿过风线的敌人受到<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<><#ff9028ff>物理伤害<>并<#ef5350ff>减速40%<>。",
        "ult": "顺着目标的两段羽迹各穿过他切一刀，每刀<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>，每段羽迹再<#ffb900ff>+20%<>；第二刀按他已损失的生命最多<#ffb900ff>+60%<>。"
      },
      "border_jiyan": {
        "name": "霁砚",
        "attack": "星针造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>定标<>：长刻打中的地方、照盘放的地方留下坐标（<#ffb900ff>4秒<>，最多<#ffb900ff>3<>个）。",
        "skill": "射出细长星束，线上的敌人受到<#a974ffff>95<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<><#a974ffff>魔法伤害<>；星束经过她的坐标时坐标炸开，周围受到<#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>40%<><#a974ffff>魔法伤害<>。",
        "skill2": "在远处目标脚下放坐标，片刻后照亮：周围敌人受到<#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<><#a974ffff>魔法伤害<>并<#ef5350ff>减速25%<>。",
        "ult": "沿目标方向挑三处错开的落点（有坐标就落在坐标上），各自先亮预警圈，再落下星刻：受到<#a974ffff>200<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>85%<><#a974ffff>魔法伤害<>并<#ef5350ff>减速30%<>。"
      },
      "border_zhongli": {
        "name": "钟砾",
        "attack": "弹丸造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>定脚<>：站稳<#ffb900ff>0.75秒<>后攻速逐渐提高（最多<#ffb900ff>+48%<>），明显走开就解除。",
        "skill": "压上弹簧：下一发普攻额外造成<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<><#ff9028ff>物理伤害<>，定脚时还无视<#ffb900ff>35%<>护甲。",
        "skill2": "架起支架：获得<#e8d44dff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#e8d44dff>8%<>的<#e8d44dff>护盾<>（<#ffb900ff>2.5秒<>），定脚直接满档；走开时支架收起。",
        "ult": "朝出手方向连放四发，每发<#ff9028ff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>85%<><#ff9028ff>物理伤害<>，最后一发<#ffb900ff>200%<>；被控制或离开原地就停。"
      },
      "border_wuling": {
        "name": "雾绫",
        "attack": "铃音造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>和<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>25%<><#a974ffff>魔法伤害<>。<#ff9028ff>闻铃<>：碰到她技能区域的敌人被挂铃（<#ffb900ff>5秒<>），他掉血时身边的友军移速<#7ee08aff>+15%<>。",
        "skill": "在目标脚下放地铃（<#ffb900ff>5秒<>），敌人靠近就响：周围敌人受到<#a974ffff>75<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<><#a974ffff>魔法伤害<>并<#ef5350ff>减速50%<>。",
        "skill2": "在她与目标之间竖起短幕（<#ffb900ff>4秒<>）：友军穿过移速<#7ee08aff>+30%<>，敌人穿过被挂铃并<#ef5350ff>减速30%<>。",
        "ult": "在目标脚下两侧拉起纱幕往中间合拢：圈里的敌人受到<#a974ffff>160<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<><#a974ffff>魔法伤害<>、<#ef5350ff>减速45%<>再<#ef5350ff>定身1.25秒<>，每人只触发一次。"
      }
    },
