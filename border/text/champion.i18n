  "en": {
    "description": {
      "border_cenlei": {
        "name": "Cen Lei",
        "attack": "Shield bash: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>1%<> <#ff9028ff>physical damage<>. <#ff9028ff>Back Pressure<>: what he takes for an ally through Shoulder the Load is stored (up to <#ffb900ff>25%<> of his max health); every tenth gives <#ffb900ff>+2<> armor and magic resist. Unload the Walls lets it all out.",
        "skill": "Sweeps a cone ahead: <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>4%<> <#ff9028ff>physical damage<> and <#ef5350ff>35% slow<>, <#ef5350ff>stunning<> everyone in it <#ef5350ff>0.67s<>. Turns toward an enemy champion who is casting and <#ef5350ff>interrupts<> it (<#ef5350ff>stun 1s<>).",
        "skill2": "Plates the most threatened nearby ally (<#ffb900ff>4s<>): the next <#ffb900ff>2<> hits deal <#ffb900ff>40%<> less, and Cen Lei takes that part himself (it cannot down him), storing it as Back Pressure. With nobody threatened he braces: <#ffb900ff>20%<> less damage.",
        "ult": "Unstoppable and <#ffb900ff>30%<> damage reduction while winding up, then releases Back Pressure: enemies in a cone take <#ff9028ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> + <#ffb900ff>60%<> of the pressure as <#ff9028ff>physical damage<>, are <#ef5350ff>pushed away<> and <#ef5350ff>slowed 30%<>; <#ffb900ff>50%<> of the pressure becomes a <#e8d44dff>shield<>."
      },
      "border_xiaolun": {
        "name": "Xiao Lun",
        "attack": "Crossbow bolt: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Walking String<>: the distance she actually moves winds her string; at ten notches it is taut and her next bolt deals <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> extra <#ff9028ff>physical damage<> and <#ef5350ff>slows 20%<>.",
        "skill": "Slides sideways from the target (only where she can walk; walls stop her), then shoots: <#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<> <#ff9028ff>physical damage<>. The slide winds the string too.",
        "skill2": "Releases all tension: <#ffb900ff>+35%<> attack speed for <#ffb900ff>3s<>, <#ffb900ff>+5%<> more per notch (<#ffb900ff>+85%<> when taut).",
        "ult": "Looses three comet arrows, choosing a new target for each as it flies (her target first, else the weakest enemy champion): <#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<> <#ff9028ff>physical damage<> each. Crowd control stops the volley."
      },
      "border_dengmi": {
        "name": "Deng Mi",
        "attack": "Lantern mote: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<> and <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<> <#a974ffff>magic damage<>. <#ff9028ff>Stored Light<>: when nearby allies (herself included) take spell damage she gathers light, <#ffb900ff>1<> per <#ffb900ff>1%<> health lost, up to <#ffb900ff>100<>; it strengthens Gather the Lamps.",
        "skill": "Hands a lamp to the ally under the most pressure: a <#e8d44dff>shield<> of <#e8d44dff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#e8d44dff>6%<> of their max health for <#ffb900ff>2.5s<>; the flash <#ef5350ff>slows<> enemies around them by <#ef5350ff>50%<> for <#ffb900ff>1.5s<>.",
        "skill2": "Lights the way for the ally lowest on health: <#7ee08aff>+35%<> move speed for <#ffb900ff>2.5s<>, <#7ee08aff>+20%<> more below <#ffb900ff>50%<> health. Deng Mi gains <#7ee08aff>+15%<>.",
        "ult": "Gathers her lamps into two pulses: the first <#7ee08aff>heals<> the chosen ally <#7ee08aff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>, the second heals the ally lowest on health near them as much. Each point of light adds <#ffb900ff>1%<> (full light doubles it). Each pulse bursts around the healed ally: <#a974ffff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<> <#a974ffff>magic damage<> and a <#ef5350ff>30% slow<>."
      },
      "border_zhumo": {
        "name": "Zhu Mo",
        "attack": "Hammer blow: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Afterheat<>: every basic attack that lands builds heat (up to <#ffb900ff>10<> levels), <#ffb900ff>+3%<> attack speed each; after <#ffb900ff>3s<> without a hit the heat fades.",
        "skill": "Brings the hammer down: <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<> <#ff9028ff>physical damage<>, <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>+10%<> per heat level, <#ef5350ff>30% slow<>; at <#ffb900ff>5<>+ heat it also <#ef5350ff>stuns 0.4s<>. Nearby enemies take <#ffb900ff>50%<>.",
        "skill2": "Spends all heat to temper: <#ffb900ff>25%<> less damage taken for <#ffb900ff>2.5s<>, <#ffb900ff>4%<> more per heat level (<#ffb900ff>65%<> at full heat).",
        "ult": "Opens the furnace: enemies round his feet take <#ff9028ff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<> <#ff9028ff>physical damage<>; for <#ffb900ff>5s<> <#ffb900ff>+60%<> attack speed and <#ffb900ff>+2<> heat each second; in danger Temper comes back sooner, and when hot with an enemy close Press the Blank does."
      },
      "border_fusuo": {
        "name": "Fu Suo",
        "attack": "Blade: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Counting Steps<>: an enemy champion who keeps walking away from their allies is tracked (<#ffb900ff>3s<>); Fu Suo deals <#ffb900ff>+15%<> to them.",
        "skill": "Dashes at the target (or at a tracked enemy champion close by instead) and cuts: <#ff9028ff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160%<> <#ff9028ff>physical damage<>, <#ffb900ff>+30%<> against a tracked target.",
        "skill2": "Leaves a recall clasp where he stands and gains <#7ee08aff>+35%<> move speed; if he gets in danger within <#ffb900ff>4s<> he snaps back to it with <#ffb900ff>30%<> damage reduction for a moment.",
        "ult": "Marks a slash line from himself through the target and beyond, then dashes through; a beat later the line strikes: enemies still on it take <#ff9028ff>380<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>210%<> <#ff9028ff>physical damage<>. Step off the line in time to dodge it."
      },
      "border_yanxi": {
        "name": "Yan Xi",
        "attack": "Salt shard: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Crystallize<>: enemies who stay on her salt band are <#ef5350ff>slowed 25%<> and gain a crystal every <#ffb900ff>0.75s<> (up to <#ffb900ff>5<>).",
        "skill": "Lays a salt band centred on the target for <#ffb900ff>4s<>; enemies on it take <#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<> <#a974ffff>magic damage<> and gain a crystal.",
        "skill2": "Shatters the crystals on nearby enemies: <#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>40%<> <#a974ffff>magic damage<>, <#a974ffff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<> more per crystal; the enemy champion with the most is <#ef5350ff>rooted 1s<>.",
        "ult": "Her band ebbs back toward her: the crystal wave deals <#a974ffff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>90%<> <#a974ffff>magic damage<>, adds <#ffb900ff>2<> crystals and <#ef5350ff>drags enemies toward her<>. Without a band she first lays one at the target."
      },
      "border_yindu": {
        "name": "Yin Du",
        "attack": "Punch: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Meeting Tide<>: pushing toward enemy champions builds tide (up to <#ffb900ff>8<>); each stack adds <#ef5350ff>5% slow<> to his next Bump the Gunwale.",
        "skill": "Rams toward the target and stops at the first enemy in the way: <#ff9028ff>95<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>4%<> <#ff9028ff>physical damage<>, <#ef5350ff>stun 0.43s<> and <#ef5350ff>25% slow<>.",
        "skill2": "Plants a beacon amid the target's group (<#ffb900ff>6s<>); as it lands, nearby enemies take <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>4%<> <#ff9028ff>physical damage<> and are <#ef5350ff>slowed 20%<>.",
        "ult": "Two tide walls close in from either side of his beacon (or the target): enemies inside are swept to the meeting point, take <#ff9028ff>190<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>7%<> <#ff9028ff>physical damage<> and are <#ef5350ff>stunned 0.95s<> - each swept once."
      },
      "border_lanti": {
        "name": "Lan Ti",
        "attack": "Punch: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Fracture Mark<>: marks only the latest enemy champion who hurt her with a spell (<#ffb900ff>5s<>).",
        "skill": "Two punches: <#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<>, then <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<> <#ff9028ff>physical damage<>; the second breaks a Fracture Mark for <#ffb900ff>+60%<> and <#ef5350ff>20% slow<>.",
        "skill2": "Guards for <#ffb900ff>2.5s<>: <#ffb900ff>50%<> less spell damage. A spell caught in the guard resets Double Prism and the blocked damage feeds Returning Echo.",
        "ult": "Sends a glass wave forward: <#ff9028ff>260<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160%<> <#ff9028ff>physical damage<> plus <#ffb900ff>60%<> of the damage she recently blocked (up to <#ffb900ff>+300<>), and <#ef5350ff>30% slow<>."
      },
      "border_luxin": {
        "name": "Lu Xin",
        "attack": "Slash: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Chasing Feather<>: an enemy champion she hit who keeps running leaves feather trails behind (<#ffb900ff>4s<>, two at most).",
        "skill": "Chases along the way the target flees and cuts when close: <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<> <#ff9028ff>physical damage<>.",
        "skill2": "Draws a wind line at the target's feet (<#ffb900ff>4s<>); enemies who cross it take <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> <#ff9028ff>physical damage<> and are <#ef5350ff>slowed 40%<>.",
        "ult": "Cuts through the target along each of his two feather trails: <#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<> per cut, <#ffb900ff>+20%<> per trail; the second cut deals up to <#ffb900ff>+60%<> by his missing health."
      },
      "border_jiyan": {
        "name": "Ji Yan",
        "attack": "Star needle: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Set the Mark<>: where Long Engraving hits and where Light the Chart lands she leaves a coordinate (<#ffb900ff>4s<>, up to <#ffb900ff>3<>).",
        "skill": "Fires a long thin star beam: <#a974ffff>95<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<> <#a974ffff>magic damage<> along it; a coordinate it crosses bursts for <#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>40%<> <#a974ffff>magic damage<> around it.",
        "skill2": "Places a coordinate at a distant target's feet; a moment later it lights up: <#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<> <#a974ffff>magic damage<> and <#ef5350ff>25% slow<> nearby.",
        "ult": "Picks three staggered landings along the aim (on her coordinates when close), each with its own warning ring, then drops a star on each: <#a974ffff>200<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>85%<> <#a974ffff>magic damage<> and <#ef5350ff>30% slow<>."
      },
      "border_zhongli": {
        "name": "Zhong Li",
        "attack": "Pellet: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Planted Feet<>: after standing still for <#ffb900ff>0.75s<> his attack speed climbs (up to <#ffb900ff>+48%<>); walking off ends it.",
        "skill": "Compresses the spring: his next attack deals <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<> extra <#ff9028ff>physical damage<>, ignoring <#ffb900ff>35%<> armor while planted.",
        "skill2": "Deploys a stand: a <#e8d44dff>shield<> of <#e8d44dff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#e8d44dff>8%<> for <#ffb900ff>2.5s<> and Planted Feet at full; stepping away packs it up.",
        "ult": "Fires four shots in the direction he aimed, <#ff9028ff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>85%<> <#ff9028ff>physical damage<> each, the last <#ffb900ff>200%<>; crowd control or leaving his spot stops the rest."
      },
      "border_wuling": {
        "name": "Wu Ling",
        "attack": "Bell chime: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<> and <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>25%<> <#a974ffff>magic damage<>. <#ff9028ff>Hear the Bell<>: enemies who touch her areas are belled (<#ffb900ff>5s<>); when a belled enemy is hurt, nearby allies gain <#7ee08aff>+15%<> move speed.",
        "skill": "Places a ground bell at the target (<#ffb900ff>5s<>) that rings when an enemy comes close: <#a974ffff>75<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<> <#a974ffff>magic damage<> and <#ef5350ff>50% slow<> around it.",
        "skill2": "Raises a short curtain between her and the target (<#ffb900ff>4s<>): allies passing through gain <#7ee08aff>+30%<> move speed, enemies passing through are belled and <#ef5350ff>slowed 30%<>.",
        "ult": "Two curtains close in round the target: enemies inside take <#a974ffff>160<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<> <#a974ffff>magic damage<>, are <#ef5350ff>slowed 45%<> and <#ef5350ff>rooted 1.25s<> - once each."
      }
    },
    "skill_name": {
      "border_cenlei": {
        "skill1": "Cross Wedge",
