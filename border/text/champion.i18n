  "ja": {
    "description": {
      "border_cenlei": {
        "name": "岑塁",
        "attack": "盾打ち：<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>1%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>背圧<>：肩代わりで受けたダメージを背圧として溜める（最大HPの<#ffb900ff>25%<>まで）。1割ごとに物防・魔防<#ffb900ff>+2<>。城崩しで全て放つ。",
        "skill": "前方扇形を薙ぎ払い<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>4%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>35%鈍足<>、範囲内の敵を<#ef5350ff>スタン0.67秒<>。詠唱中の敵チャンピオンを優先して狙い、<#ef5350ff>詠唱を中断<>させる（<#ef5350ff>スタン1秒<>）。",
        "skill2": "最も危険な味方に盾板を貼る（<#ffb900ff>4秒<>）：次の<#ffb900ff>2<>回の被ダメージを<#ffb900ff>40%<>軽減し、その分を岑塁が受けて背圧にする（これでは倒れない）。誰もいなければ自身が<#ffb900ff>20%<>軽減。",
        "ult": "構え中はCC無効・被ダメージ<#ffb900ff>30%<>軽減。背圧を解放し前方扇形に<#ff9028ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> + 背圧の<#ffb900ff>60%<>の<#ff9028ff>物理ダメージ<>、<#ef5350ff>ノックバック<>と<#ef5350ff>30%鈍足<>。背圧の<#ffb900ff>50%<>が<#e8d44dff>シールド<>に。"
      },
      "border_xiaolun": {
        "name": "綃輪",
        "attack": "弩の矢：<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>走弦<>：実際に動いた距離で弦を巻き、10段で張り詰める。次の矢が<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<>の追加<#ff9028ff>物理ダメージ<>と<#ef5350ff>20%鈍足<>。",
        "skill": "対象の横へ滑る（歩ける所だけ、壁で止まる）。その後に射撃し<#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<>の<#ff9028ff>物理ダメージ<>。横移動でも弦が巻かれる。",
        "skill2": "張力をすべて放つ：<#ffb900ff>3秒<>間攻撃速度<#ffb900ff>+35%<>、1段ごとに<#ffb900ff>+5%<>（最大<#ffb900ff>+85%<>）。",
        "ult": "星弧の矢を3回放つ。1本ごとに放つ瞬間に対象を選び直す（元の対象優先、次にHP割合が最も低い敵）。各<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<>の<#ff9028ff>物理ダメージ<>。CC中は撃たない。"
      },
      "border_dengmi": {
        "name": "灯弥",
        "attack": "灯火：<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>と<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<>の<#a974ffff>魔法ダメージ<>。<#ff9028ff>灯溜め<>：周囲の味方（自身含む）がスキルダメージを受けると、HP<#ffb900ff>1%<>ごとに灯火を<#ffb900ff>1<>溜める（最大<#ffb900ff>100<>）。灯収めを強化する。",
        "skill": "最も追い詰められた味方に灯を渡し、<#e8d44dff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<> + 相手の<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#e8d44dff>6%<>の<#e8d44dff>シールド<>（<#ffb900ff>2.5秒<>）。灯の光で周囲の敵を<#ef5350ff>50%鈍足<>（<#ffb900ff>1.5秒<>）。",
        "skill2": "HP割合が最も低い味方を導く：移動速度<#7ee08aff>+35%<>（<#ffb900ff>2.5秒<>）、HP<#ffb900ff>50%<>未満ならさらに<#7ee08aff>+20%<>。灯弥自身も<#7ee08aff>+15%<>。",
        "ult": "灯を二つの脈動に変える：一つ目は選んだ味方を<#7ee08aff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<><#7ee08aff>回復<>、二つ目はその近くでHP割合が最も低い味方を同量回復。灯火1点ごとに回復<#ffb900ff>+1%<>（満タンで2倍）。脈動は回復した味方の周りで弾け、敵に<#a974ffff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<>の<#a974ffff>魔法ダメージ<>と<#ef5350ff>30%鈍足<>。"
      },
      "border_zhumo": {
        "name": "鋳沫",
        "attack": "槌打ち：<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>余熱<>：通常攻撃が当たるたびに熱を溜める（最大<#ffb900ff>10<>段）。1段ごとに攻撃速度<#ffb900ff>+3%<>。<#ffb900ff>3秒<>当てないと冷めていく。",
        "skill": "槌を振り下ろし<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<>の<#ff9028ff>物理ダメージ<>、熱1段ごとに<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>+10%<>、<#ef5350ff>30%鈍足<>。熱<#ffb900ff>5<>段以上で<#ef5350ff>スタン0.4秒<>。周囲の敵は<#ffb900ff>50%<>。",
        "skill2": "熱をすべて使い焼き戻す：<#ffb900ff>2.5秒<>間被ダメージ<#ffb900ff>25%<>軽減、熱1段ごとにさらに<#ffb900ff>4%<>（最大<#ffb900ff>65%<>）。",
        "ult": "炉を開き足元の敵に<#ff9028ff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<>の<#ff9028ff>物理ダメージ<>。<#ffb900ff>5秒<>間攻撃速度<#ffb900ff>+60%<>、毎秒熱<#ffb900ff>+2<>段。危険なら焼き戻し、熱が十分で敵が近ければ鍛圧のCTを短縮。"
      },
      "border_fusuo": {
        "name": "伏梭",
        "attack": "一太刀：<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>歩数読み<>：味方から離れ続ける敵チャンピオンを追跡する（<#ffb900ff>3秒<>）。追跡中の敵へのダメージ<#ffb900ff>+15%<>。",
        "skill": "対象へ突進（近くに追跡中の敵がいればそちらへ）して斬り、<#ff9028ff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160%<>の<#ff9028ff>物理ダメージ<>。追跡中の対象には<#ffb900ff>+30%<>。",
        "skill2": "その場に戻り点を残し移動速度<#7ee08aff>+35%<>。<#ffb900ff>4秒<>以内に危険になると自動で戻り点へ跳び、少しの間被ダメージ<#ffb900ff>30%<>軽減。",
        "ult": "自分から対象の背後まで斬線を予告し、対象を突き抜ける。一拍遅れて同じ線で斬撃：線上に残った敵に<#ff9028ff>380<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>210%<>の<#ff9028ff>物理ダメージ<>。線から離れれば避けられる。"
      },
      "border_yanxi": {
        "name": "塩汐",
        "attack": "塩晶：<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>析晶<>：塩の帯に留まる敵を<#ef5350ff>25%鈍足<>にし、<#ffb900ff>0.75秒<>ごとに結晶を1つ重ねる（最大<#ffb900ff>5<>）。",
        "skill": "対象を中心に塩の帯を敷く（<#ffb900ff>4秒<>）。帯の上の敵に<#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<>の<#a974ffff>魔法ダメージ<>と結晶1つ。",
        "skill2": "周囲の敵の結晶を砕き<#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>40%<>の<#a974ffff>魔法ダメージ<>、1つごとに<#a974ffff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<>追加。最も多い敵チャンピオンを<#ef5350ff>1秒スネア<>。",
        "ult": "塩の帯を自分の方へ引かせる：結晶の波が当たった敵に<#a974ffff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>90%<>の<#a974ffff>魔法ダメージ<>、結晶<#ffb900ff>2<>つ、<#ef5350ff>塩汐の方へ押し流す<>。帯がなければ先に対象へ敷く。"
      },
      "border_yindu": {
        "name": "殷渡",
        "attack": "拳：<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>迎え潮<>：敵チャンピオンへ押し進むと潮勢が溜まり（最大<#ffb900ff>8<>）、次の舷打ちの鈍足が1つごとに<#ef5350ff>+5%<>。",
        "skill": "対象へ突進し、途中の最初の敵で止まってぶつかる：<#ff9028ff>95<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>4%<>の<#ff9028ff>物理ダメージ<>、<#ef5350ff>スタン0.43秒<>、<#ef5350ff>25%鈍足<>。",
        "skill2": "対象の群れの中心に航標を立てる（<#ffb900ff>6秒<>）。着地時に周囲の敵へ<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>4%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>20%鈍足<>。",
        "ult": "航標（なければ対象）の両側から潮の壁が合わさる：中の敵を合流点へ巻き込み<#ff9028ff>190<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>7%<>の<#ff9028ff>物理ダメージ<>、<#ef5350ff>スタン0.95秒<>。1人1回だけ。"
      },
      "border_lanti": {
        "name": "瀾緹",
        "attack": "拳：<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>折れ紋<>：最後にスキルで彼女を傷つけた敵チャンピオン1人だけに紋を刻む（<#ffb900ff>5秒<>）。",
        "skill": "2連打：<#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<>、続けて<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<>の<#ff9028ff>物理ダメージ<>。2発目が紋を割ると<#ffb900ff>+60%<>と<#ef5350ff>20%鈍足<>。",
        "skill2": "<#ffb900ff>2.5秒<>構える：受けるスキルダメージ<#ffb900ff>50%<>軽減。構え中にスキルを受けると成功、双稜のCTが戻り、防いだ分が返し響きに溜まる。",
        "ult": "ガラスの波を放ち<#ff9028ff>260<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160%<>の<#ff9028ff>物理ダメージ<>、さらに最近防いだダメージの<#ffb900ff>60%<>（最大<#ffb900ff>+300<>）と<#ef5350ff>30%鈍足<>。"
      },
      "border_luxin": {
        "name": "鷺芯",
        "attack": "斬撃：<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>追い羽<>：彼女が斬った敵チャンピオンが逃げ続けると羽の跡が残る（<#ffb900ff>4秒<>、最大2つ）。",
        "skill": "対象の逃げる方向へ追いすがり、近づいて斬る：<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<>の<#ff9028ff>物理ダメージ<>。",
        "skill2": "対象の足元に風の線を張る（<#ffb900ff>4秒<>）。線を越えた敵に<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>40%鈍足<>。",
        "ult": "対象の2つの羽の跡に沿って貫き1太刀ずつ：各<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>、跡1つごとに<#ffb900ff>+20%<>。2太刀目は失ったHPに応じ最大<#ffb900ff>+60%<>。"
      },
      "border_jiyan": {
        "name": "霽硯",
        "attack": "星針：<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>定標<>：長刻の命中点と照盤の設置点に座標を残す（<#ffb900ff>4秒<>、最大<#ffb900ff>3<>）。",
        "skill": "細長い星の光線：線上の敵に<#a974ffff>95<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<>の<#a974ffff>魔法ダメージ<>。通った座標は弾け、周囲に<#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>40%<>。",
        "skill2": "遠くの対象の足元に座標を置き、少し後に照らす：周囲の敵に<#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<>の<#a974ffff>魔法ダメージ<>と<#ef5350ff>25%鈍足<>。",
        "ult": "狙う方向にずらした3か所（近くに座標があればそこ）へ、それぞれ予告円を出してから星刻を落とす：<#a974ffff>200<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>85%<>の<#a974ffff>魔法ダメージ<>と<#ef5350ff>30%鈍足<>。"
      },
      "border_zhongli": {
        "name": "鐘礫",
        "attack": "弾丸：<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>。<#ff9028ff>足固め<>：<#ffb900ff>0.75秒<>立ち止まると攻撃速度が上がっていく（最大<#ffb900ff>+48%<>）。大きく動くと解除。",
        "skill": "発条を込める：次の通常攻撃が<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<>の追加<#ff9028ff>物理ダメージ<>、足固め中は物防<#ffb900ff>35%<>貫通。",
        "skill2": "架台を展開：<#e8d44dff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#e8d44dff>8%<>の<#e8d44dff>シールド<>（<#ffb900ff>2.5秒<>）、足固めが即最大。離れると架台をたたむ。",
        "ult": "狙った方向へ4連射、各<#ff9028ff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>85%<>の<#ff9028ff>物理ダメージ<>、最後の1発は<#ffb900ff>200%<>。CCを受けるかその場を離れると止まる。"
      },
      "border_wuling": {
        "name": "霧綾",
        "attack": "鈴の音：<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の<#ff9028ff>物理ダメージ<>と<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>25%<>の<#a974ffff>魔法ダメージ<>。<#ff9028ff>鈴聞き<>：技の範囲に触れた敵に鈴を付け（<#ffb900ff>5秒<>）、その敵が傷つくと近くの味方の移動速度<#7ee08aff>+15%<>。",
        "skill": "対象の足元に地鈴を置く（<#ffb900ff>5秒<>）。敵が近づくと鳴り、周囲に<#a974ffff>75<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<>の<#a974ffff>魔法ダメージ<>と<#ef5350ff>50%鈍足<>。",
        "skill2": "自分と対象の間に短い幕を立てる（<#ffb900ff>4秒<>）：くぐった味方は移動速度<#7ee08aff>+30%<>、くぐった敵は鈴付きで<#ef5350ff>30%鈍足<>。",
        "ult": "対象の両側から幕を閉じる：中の敵に<#a974ffff>160<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>の<#a974ffff>魔法ダメージ<>、<#ef5350ff>45%鈍足<>のあと<#ef5350ff>1.25秒スネア<>。1人1回だけ。"
      }
    },
