  "zh-hant": {
    "description": {
      "border_cenlei": {
        "name": "岑壘",
        "attack": "盾擊，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>1%<><#ff9028ff>物理傷害<>。<#ff9028ff>背壓<>：接肩替隊友挨的傷害攢成背壓（最多最大生命的<#ffb900ff>25%<>），每攢十分之一護甲和魔抗<#ffb900ff>+2<>，卸城時全部放出。",
        "skill": "朝前方扇形掃擊，造成<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>4%<><#ff9028ff>物理傷害<>並<#ef5350ff>緩速35%<>，扇形裡的人<#ef5350ff>暈眩0.67秒<>；優先掃向正在施法的敵方英雄，<#ef5350ff>打斷<>施法（<#ef5350ff>暈眩1秒<>）。",
        "skill2": "給身邊最受威脅的隊友貼上盾板（<#ffb900ff>4秒<>）：他接下來<#ffb900ff>2<>次受到的傷害降低<#ffb900ff>40%<>，少挨的部分由岑壘承受（不會因此倒下）並攢成背壓。沒人受威脅時自己減傷<#ffb900ff>20%<>。",
        "ult": "起手不受控制、減傷<#ffb900ff>30%<>，隨後放出背壓：前方扇形的敵人受到<#ff9028ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> + 背壓<#ffb900ff>60%<>的<#ff9028ff>物理傷害<>，被<#ef5350ff>推開<>並<#ef5350ff>緩速30%<>；放出背壓的<#ffb900ff>50%<>化為<#e8d44dff>護盾<>。"
      },
      "border_xiaolun": {
        "name": "綃輪",
        "attack": "弩箭造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>走弦<>：按實際走過的路上弦，走滿十層後弦繃緊，下一箭額外造成<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<><#ff9028ff>物理傷害<>並<#ef5350ff>緩速20%<>。",
        "skill": "朝目標側面短移（只走得通的路，撞牆即停），隨後射出一箭，造成<#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<><#ff9028ff>物理傷害<>。側移的路也會上弦。",
        "skill2": "放掉全部張力：<#ffb900ff>3秒<>內攻速<#ffb900ff>+35%<>，每層張力再<#ffb900ff>+5%<>（滿弦<#ffb900ff>+85%<>）。",
        "ult": "分三次射出星弧箭，每支在射出時重新選擇目標（原目標優先，其次生命比例最低的敵方英雄），各造成<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<><#ff9028ff>物理傷害<>。被控制時停射。"
      },
      "border_dengmi": {
        "name": "燈彌",
        "attack": "燈火造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>和<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<><#a974ffff>魔法傷害<>。<#ff9028ff>存光<>：身邊的友軍（含自己）受到技能傷害時攢燈火，每損失<#ffb900ff>1%<>生命攢<#ffb900ff>1<>點，最多<#ffb900ff>100<>點，強化收燈。",
        "skill": "把燈遞給身邊最承壓的友軍，給予<#e8d44dff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<> + 對方<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#e8d44dff>6%<>的<#e8d44dff>護盾<>，持續<#ffb900ff>2.5秒<>；燈一亮，他身邊的敵人被晃眼<#ef5350ff>減速50%<><#ffb900ff>1.5秒<>。",
        "skill2": "為生命比例最低的友軍引路：移速<#7ee08aff>+35%<>，持續<#ffb900ff>2.5秒<>；對方生命低於<#ffb900ff>50%<>時再<#7ee08aff>+20%<>。燈彌自己移速<#7ee08aff>+15%<>。",
        "ult": "收回燈火化作兩道脈衝：第一道<#7ee08aff>治療<>選中的友軍<#7ee08aff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>，第二道<#7ee08aff>治療<>他身邊生命比例最低的友軍同樣多；每點燈火使治療<#ffb900ff>+1%<>（滿燈火翻倍）。每道脈衝在受治療的人身邊炸開光：周圍敵人受到<#a974ffff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<><#a974ffff>魔法傷害<>並<#ef5350ff>減速30%<>。"
