        "attack": "巨拳砸下，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>蓝霸符<>：每放一个技能，身边友军的技能剩余冷却立刻降到最多<#ffb900ff>67%<>。",
        "skill": "双拳砸地，对周围敌人造成<#a974ffff>85<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>105%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#a974ffff>4%<><#a974ffff>魔法伤害<>并减速<#ef5350ff>30%<>（<#ffb900ff>2秒<>）。",
        "skill2": "符文亮起，获得<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>120%<>护盾（<#ffb900ff>4秒<>），<#ef5350ff>嘲讽<>周围敌人<#ffb900ff>1.2秒<>。",
        "ult": "获得<#ff9028ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>120%<>护盾，猛砸地面，朝敌方英雄最多的方向裂开裂隙：<#ef5350ff>击飞<>、<#a974ffff>170<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>170%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#a974ffff>4%<><#a974ffff>魔法伤害<>，<#ef5350ff>破法<>（下一个技能晚<#ffb900ff>2秒<>）。"
      },
      "tft_brambleback": {
        "name": "绯红印记树怪",
        "attack": "大爪横扫，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>红霸符<>：普攻灼烧目标<#ffb900ff>3秒<>（每秒<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ef5350ff>1.2%<>真实伤害），回复<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>1.5%<>生命；击杀后扑向下一个敌人，造成<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<><#ff9028ff>物理伤害<>。",
        "skill": "跃起扑向目标，造成<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150%<><#ff9028ff>物理伤害<>并减速<#ef5350ff>30%<>（<#ffb900ff>1秒<>）。",
        "skill2": "人立怒吼：周围敌人减速<#ef5350ff>30%<>、攻击力降低<#ef5350ff>20%<>，自己受到的伤害降低<#ff9028ff>25%<>，持续<#ffb900ff>3秒<>。",
        "ult": "狂暴<#ffb900ff>6秒<>：攻击力<#ff9028ff>+55%<>、攻速<#ff9028ff>+35%<>，无视目标<#ff9028ff>40%<>护甲。"
      },
      "tft_raptor": {
        "name": "深红锋喙鸟",
        "attack": "甩出一根锋羽，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>橙霸符<>：它的物理伤害使目标护甲<#ef5350ff>-6<>（<#ffb900ff>3秒<>，最多<#ffb900ff>5层<>）。",
        "skill": "张开翅膀，扇形甩出<#ffb900ff>5根<>羽刃，每根命中第一个敌人，造成<#ff9028ff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>55%<><#ff9028ff>物理伤害<>。",
        "skill2": "受惊尖叫，往后一跳，之后<#ffb900ff>3秒<>攻速<#ffb900ff>+70%<>。",
        "ult": "召唤<#ffb900ff>4只<>不可选中的小锋喙鸟（<#ffb900ff>7秒<>）：它每次普攻，小鸟们一起啄同一目标，各造成<#ff9028ff>18<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30%<><#ff9028ff>物理伤害<>。"
      },
      "tft_elderdragon": {
        "name": "远古巨龙",
        "attack": "撕咬目标，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>，目标身边的敌人受到<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>35%<>溅射。<#ff9028ff>远古巨龙霸符<>：被它伤害后生命低于<#ef5350ff>15%<>的敌方英雄直接被处决。",
        "skill": "朝穿过目标、敌人最多的直线喷吐龙焰，造成<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<><#ff9028ff>物理伤害<>，每烧过一人伤害<#ef5350ff>-20%<>（最低<#ffb900ff>40%<>），并<#ff9028ff>引燃<>：<#ffb900ff>3秒<>内每秒受到<#ef5350ff>2.5%<>最大生命的物理伤害。",
        "skill2": "立起身猛拍双翼，身边的敌人受到<#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<><#ff9028ff>物理伤害<>、被击退并减速<#ffb900ff>35%<>（<#ffb900ff>2秒<>），自己受到的伤害<#ef5350ff>-25%<>。",
        "ult": "无敌飞上天空，<#ffb900ff>1.5秒<>后砸落：大范围敌人受到<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<><#ff9028ff>物理伤害<>、晕眩<#ffb900ff>1.25秒<>并被<#ff9028ff>引燃<>；获得<#ffb900ff>30%<>全能吸血（<#ffb900ff>5秒<>），立刻喷一次<#ff9028ff>烈焰吐息<>。"
      },
      "tft_murkwolf": {
        "name": "暗影狼",
        "attack": "两个头一起撕咬，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>灰霸符<>：暴击率<#ffb900ff>25%<>，随已损失生命值最多再<#ffb900ff>+30%<>，技能也能暴击。",
        "skill": "跃向附近生命值最低的敌人，造成<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<><#ff9028ff>物理伤害<>。接下来<#ffb900ff>3次<>攻击攻速<#ffb900ff>+60%<>，额外造成<#ff9028ff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30%<><#ff9028ff>物理伤害<>。",
        "skill2": "仰头长嚎，<#ffb900ff>5秒<>内吸血<#ffb900ff>20%<>，伤害提高<#ffb900ff>15%<>，对生命低于<#ffb900ff>50%<>的敌人翻倍。",
        "ult": "叫来<#ffb900ff>2只<>小暗影狼扑向目标，造成<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<><#ff9028ff>物理伤害<>。<#ffb900ff>6秒<>内它每次攻击，小狼咬<#ffb900ff>2口<>，每口<#ff9028ff>12<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>25%<><#ff9028ff>物理伤害<>。"
      },
      "tft_meepsie": {
        "name": "小木灵",
        "attack": "挥出月岩重拳，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>木灵驾驶员<>：每一拳额外造成<#a974ffff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>25%<><#a974ffff>魔法伤害<>。",
        "skill": "一拳砸向前方地面，扇形范围内的敌人受到<#a974ffff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<><#a974ffff>魔法伤害<>并减速<#ef5350ff>40%<>（<#ffb900ff>2秒<>）。",
        "skill2": "驾驶员一招手，<#ffb900ff>4只<>小木灵飞向身边生命比例最低的队友（名额有剩时也治疗自己），每<#ffb900ff>0.5秒<>回复<#a974ffff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>10%<>生命，持续<#ffb900ff>3秒<>。",
        "ult": "跳向附近敌方英雄最多的地方砸地，周围的敌人受到<#a974ffff>160<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>90%<><#a974ffff>魔法伤害<>，离中心每远一格少<#ef5350ff>35%<>；离落点最近的<#ffb900ff>3个<>敌方英雄被<#ef5350ff>击飞<><#ffb900ff>1.25秒<>。"
      },
      "tft_scuttlecrab": {
        "name": "迅捷蟹",
        "attack": "跳一段螃蟹舞，踩中身边所有敌人，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>绿霸符<>：附近的友方英雄生命低于<#ffb900ff>40%<>时回复<#ffb900ff>12%<>最大生命（每人<#ffb900ff>10秒<>一次）。",
        "skill": "在脚下放下神龛（<#ffb900ff>4秒<>），水花使周围敌人受到<#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<><#a974ffff>魔法伤害<>并减速<#ef5350ff>40%<>；神龛里的友方英雄移速<#ffb900ff>+30%<>、攻速<#ffb900ff>+25%<>。",
        "skill2": "缩进壳里，获得<#a974ffff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<>护盾（<#ffb900ff>2秒<>）。护盾打光或到时间时蟹壳碎裂：周围敌人受到<#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<><#a974ffff>魔法伤害<>、<#ef5350ff>眩晕<><#ffb900ff>0.5秒<>并减速<#ef5350ff>40%<>。",
        "ult": "钻入地下<#ffb900ff>2.5秒<>：受到的伤害降低<#ffb900ff>50%<>、免疫控制，持续回复<#a974ffff>250<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>生命；然后钻出地面，周围敌人受到<#ff9028ff>160<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<><#ff9028ff>物理伤害<>并被<#ef5350ff>击飞<><#ffb900ff>1.5秒<>。"
      }
    },
