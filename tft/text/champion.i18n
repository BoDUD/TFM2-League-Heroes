  "en": {
    "description": {
      "tft_powder": {
        "name": "Powder",
        "attack": "Throws a homemade firecracker for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Ambusher<>: her skill bombs can crit (<#ffb900ff>25%<> chance, double damage).",
        "skill": "Lobs her wind-up monkey bomb at the target's feet: enemies in the blast take <#a974ffff>36<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<> <#a974ffff>magic damage<>, those in the middle take it twice. Everyone hit <#ef5350ff>burns<> for <#ffb900ff>3s<> and is <#ef5350ff>wounded<> for <#ffb900ff>4s<> (healing -40%).",
        "skill2": "When an enemy champion comes close, smashes a flash-smoke bomb: enemies around her take <#a974ffff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<> <#a974ffff>magic damage<> and are <#ef5350ff>blinded<> for <#ffb900ff>1s<> (no basic attacks), and she hops back.",
        "ult": "Lobs the bag with the hex crystal at an enemy champion. After a <#ffb900ff>0.9s<> fuse it bursts in blue: enemies in the blast take <#a974ffff>170<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<> <#a974ffff>magic damage<> and are <#ef5350ff>knocked up<> for <#ffb900ff>0.75s<>."
      },
      "tft_norra": {
        "name": "Norra",
        "attack": "Star bolt: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Beloved Trinkets<>: every <#ffb900ff>10s<> the next ability drops 3 trinkets (<#ffb900ff>4s<>), each flying to the champion stepping on it: <#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>20%<> <#a974ffff>magic damage<> + <#ff9028ff>Threads<>; ability hits on champions cut it 20%. <#ff9028ff>Journey to Nowhere<>: a close enemy champion takes <#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>, is <#ef5350ff>banished<> <#ffb900ff>1.5s<>, then <#ef5350ff>slowed<> 80% <#ffb900ff>0.75s<>.",
        "skill": "Charges, then flings a bolt of memories and hops back: enemies around where it lands take <#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<> <#a974ffff>magic damage<>, champions already in the <#ff9028ff>Threads<> 2% of their max health more, then get them. Hitting a champion primes her trinkets: they fly to any enemy champion coming near.",
        "skill2": "Opens two portals beside the target; <#ffb900ff>0.3s<> later threads shoot between them: enemies there take <#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26%<> <#a974ffff>magic damage<> and get the <#ff9028ff>Threads<>: 15% bigger (easier to hit) for <#ffb900ff>4s<> and <#ef5350ff>slowed<> 20% for <#ffb900ff>2s<>.",
        "ult": "Opens a great rift under an enemy champion: 4 recasts <#ffb900ff>0.5s<> apart, each sending a yarn ball from both ends along a line through an enemy champion: <#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<> <#a974ffff>magic damage<> to every enemy on it, the first champion each ball meets <#ef5350ff>slowed<> 80% for <#ffb900ff>0.5s<>; the 4th deals 40% more."
      },
      "tft_alune": {
        "name": "Alune",
        "attack": "Flings her spiral ring like a disc for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>; it flies back to her, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30%<> physical damage to enemies on the way. <#ff9028ff>Moon Phase<>: each skill she casts grows the moon a phase, up to <#ffb900ff>3<>; her ultimate deals <#ffb900ff>20%<> more a phase, and the moon wanes to new.",
        "skill": "Moonshards rain on the <#ffb900ff>3<> enemies nearest her, each dealing <#a974ffff>42<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>32%<> <#a974ffff>magic damage<> and lowering magic resistance by <#ffb900ff>20%<> for <#ffb900ff>6s<>.",
        "skill2": "Moonlight falls on her and the allied champions near her: <#ffb900ff>36%<> attack speed for <#ffb900ff>5s<>.",
        "ult": "The moon's shadow spreads under an enemy champion; <#ffb900ff>0.75s<> later the full moon crashes down: <#ffb900ff>220%<> of <#a974ffff>165<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>72%<> <#a974ffff>magic damage<> split among the enemies in the area (at most <#ffb900ff>180%<> each), those in the middle <#ef5350ff>stunned<> for <#ffb900ff>0.83s<>."
      },
      "tft_silco": {
        "name": "Silco",
        "attack": "Flings a Shimmer vial for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Dominator<>: each time he spawns he gains a <#a974ffff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>40%<> shield for <#ffb900ff>15s<>; each skill he casts grants <#ffb900ff>10%<> ability power, up to <#ffb900ff>5<> times, lost on death.",
        "skill": "Throws a canister for <#a974ffff>65<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<> <#a974ffff>magic damage<> and lets out <#ffb900ff>2<> monstrosities that pounce on nearby enemies and bite <#ffb900ff>5<> times each for <#a974ffff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>11%<> <#a974ffff>magic damage<>; when their victim falls they leap to the next.",
        "skill2": "Tosses Shimmer to the allied champion with the most attack near him (himself if none): <#ffb900ff>50%<> attack speed and <#ffb900ff>20%<> move speed for <#ffb900ff>4s<>; the comedown then takes <#ffb900ff>8%<> of their current health.",
        "ult": "Throws a giant canister at an enemy champion for <#a974ffff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<> <#a974ffff>magic damage<>, letting out <#ffb900ff>4<> monstrosities and leaving a Shimmer fog for <#ffb900ff>4s<>: enemies in it are <#ef5350ff>slowed<> by <#ffb900ff>30%<> and take <#a974ffff>6<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>4%<> <#a974ffff>magic damage<> a second."
      },
      "tft_maddie": {
        "name": "Maddie",
        "attack": "Fires her rifle for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Sniper<>: she deals more damage the farther the target, up to <#ffb900ff>25%<>; when a Wanted enemy dies she collects a bounty: <#ffb900ff>15%<> attack speed, up to <#ffb900ff>4<> bounties.",
        "skill": "Crouches and fires <#ffb900ff>6<> shots at the farthest enemy in range (champions first); each hits the first enemy in its way for <#ff9028ff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40%<> <#ff9028ff>physical damage<>.",
        "skill2": "Marks the nearby enemy champion with the most health as Wanted for <#ffb900ff>8s<>: it takes <#ffb900ff>15%<> more damage.",
        "ult": "Takes aim, then fires a piercing round at the enemy champion with the lowest share of health: every enemy in its line takes <#ff9028ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<> <#ff9028ff>physical damage<>, up to <#ffb900ff>60%<> more by the share of health it is missing."
      },
      "tft_loris": {
        "name": "Loris",
        "attack": "Bashes with his shield for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Warden<>: the first time each life his health falls under <#ffb900ff>75%<> and under <#ffb900ff>25%<> he gains a shield of <#ffb900ff>12%<> of his maximum health (<#ffb900ff>4s<>).",
        "skill": "Gains a <#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<> shield (<#ffb900ff>4s<>) and charges behind his shield: enemies he runs into take <#a974ffff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<> magic damage and are <#ef5350ff>stunned for 1.5s<>.",
        "skill2": "Leaps to the nearby allied champion with the lowest share of health: both gain a <#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<> shield (<#ffb900ff>4s<>) and he takes <#ffb900ff>30%<> of the damage meant for it.",
        "ult": "Slams his shield into the ground: nearby enemies take <#a974ffff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<> magic damage, are <#ef5350ff>knocked up for 1s<> and <#ef5350ff>taunted for 2s<>; he takes <#ffb900ff>50%<> less damage (<#ffb900ff>4s<>)."
      },
      "tft_kobuko": {
        "name": "Kobuko",
        "attack": "A paw strike for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Second Phase<>: the first time each life his health falls under <#ffb900ff>50%<> he is enraged until he dies: <#ffb900ff>+40%<> attack speed and <#ffb900ff>20%<> life steal.",
        "skill": "Gains a <#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<> shield (<#ffb900ff>4s<>); within <#ffb900ff>4s<> his next attack is a Golden Claw: <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>105%<> + <#ff9028ff>2%<> max health <#ff9028ff>physical damage<> and a <#ef5350ff>1s stun<>.",
        "skill2": "Pounces on the target: on landing, nearby enemies take <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%<> + <#ff9028ff>2%<> max health <#ff9028ff>physical damage<> and are <#ef5350ff>knocked up for 0.4s<>.",
        "ult": "Springs out of sight (untargetable, unstoppable) and crashes down on an enemy champion: it takes <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> + <#ff9028ff>6%<> max health <#ff9028ff>physical damage<>, and nearby enemies (it too) <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> + <#ff9028ff>3%<> max health and are <#ef5350ff>knocked up for 0.8s<>."
      },
      "tft_vander": {
        "name": "Vander",
        "attack": "Punches for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Watcher<>: takes <#ffb900ff>10%<> less damage, <#ffb900ff>20%<> while his health is above <#ffb900ff>50%<>.",
        "skill": "Drops into a guard: nearby enemies are <#ef5350ff>taunted for 0.75s<>, he gains <#ffb900ff>40<> armour and <#ffb900ff>30<> magic resist (<#ffb900ff>2.5s<>). His next punch deals <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<> physical damage, <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40%<> more for each <#ff9028ff>Family<> ally on his team.",
        "skill2": "Rushes an enemy and uppercuts it for <#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<> physical damage, <#ef5350ff>stunning it for 0.5s<>; enemies next to him take <#ffb900ff>35%<> of the blow.",
        "ult": "Leaps into the enemies and slams the ground: nearby enemies take <#ff9028ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150%<> physical damage and are <#ef5350ff>knocked up for 1s<>. For <#ffb900ff>4s<> he takes <#ffb900ff>15%<> less damage, <#ffb900ff>8%<> more for each enemy champion near him (up to <#ffb900ff>4<>)."
      },
      "tft_violet": {
        "name": "Violet",
        "attack": "Punches for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Pit Fighter<>: every hit deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>5%<> more as true damage, <#ffb900ff>10%<> omnivamp; the first time a life drops under <#ffb900ff>50%<> health she heals <#ffb900ff>15%<> of her max health over <#ffb900ff>2s<>.",
        "skill": "Two jabs of <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50%<> <#ff9028ff>physical damage<>, then an uppercut for <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<> physical damage that <#ef5350ff>knocks the target up for 0.5s<>.",
        "skill2": "Rushes an enemy and punches it back for <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> physical damage.",
        "ult": "Leaps into the enemies and smashes the ground: nearby enemies take <#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<> physical damage and are <#ef5350ff>knocked up for 0.8s<>. For <#ffb900ff>5s<> she gains <#ffb900ff>40%<> attack speed and <#ffb900ff>5%<> omnivamp, <#ffb900ff>10%<> more attack speed for each <#ff9028ff>Family<> ally."
      },
      "tft_krug": {
        "name": "Krug",
        "attack": "A rock-fist slam for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Shattered Rebirth<>: the first lethal blow each life shatters him to rubble for <#ffb900ff>0.75s<>; he stands up again as a Mini Krug with <#ffb900ff>35%<> health and <#ffb900ff>+30%<> attack speed, <#ef5350ff>taunting<> nearby enemies for <#ffb900ff>1s<> (at most every <#ffb900ff>60s<>).",
        "skill": "Gains a <#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<> shield (<#ffb900ff>4s<>), curls into a boulder and rolls into the target: <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<> + <#ff9028ff>6%<> max health <#ff9028ff>physical damage<> and a <#ef5350ff>knock-back<>.",
        "skill2": "Pulls into his boulder for <#ffb900ff>2.5s<>: <#ffb900ff>+40<> armor, <#ffb900ff>+30<> magic resist; nearby enemies are <#ef5350ff>taunted for 0.75s<>.",
        "ult": "Springs up (untargetable, unstoppable) and crashes down by an enemy champion: nearby enemies take <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> + <#ff9028ff>6%<> max health <#ff9028ff>physical damage<> and are <#ef5350ff>knocked up for 0.8s<>; then falling rocks deal <#ff9028ff>40<> + <#ff9028ff>4%<> max health <#ff9028ff>physical damage<>."
      },
      "tft_aoshin": {
        "name": "Ao Shin",
        "attack": "Spits ball lightning for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Tempest Might<>: <#ffb900ff>3s<> into a fight, lightning strikes every nearby enemy champion for <#f5f5f5ff>12% max health true damage<> and <#ef5350ff>stuns for 0.83s<>; then he deals <#ffb900ff>+30%<> ability power for <#ffb900ff>6s<> (every <#ffb900ff>20s<>).",
        "skill": "Breathes a bolt of lightning: enemies in the line take <#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<> <#a974ffff>magic damage<> and are <#ef5350ff>silenced for 0.67s<>.",
        "skill2": "Rides a cloud away from a nearby enemy champion and gains a <#a974ffff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>40%<> storm shield for <#ffb900ff>3s<>.",
        "ult": "Calls the storm: <#ffb900ff>12<> bolts strike random nearby enemy champions one after another, each for <#a974ffff>55<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>32%<> <#a974ffff>magic damage<> and a <#ef5350ff>0.3s silence<>."
      },
      "tft_scar": {
        "name": "Scar",
        "attack": "Thrusts his spear for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Firelight Dash<>: every <#ffb900ff>6s<> his next hit is a hoverboard dash for <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>, healing <#ffb900ff>25%<> of the damage taken since the last dash. <#ff9028ff>Watcher<>: <#ffb900ff>20%<> damage reduction at <#ffb900ff>50%<> health or more, <#ffb900ff>10%<> below.",
        "skill": "Throws a bomb at each of the <#ffb900ff>3<> nearest enemies for <#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<> <#a974ffff>magic damage<>, <#ef5350ff>stunning for 1s<>. Heals himself <#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<>.",
        "skill2": "Sweeps his spear in front of him for <#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>2%<> physical damage, <#ef5350ff>knocking enemies back<>.",
        "ult": "Rides his hoverboard at an enemy, dropping two fire bombs (<#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>40%<> magic damage each); landing, a blast deals <#a974ffff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>100%<> magic damage around him and <#ef5350ff>knocks up for 0.5s<>, then he takes <#ffb900ff>40%<> less damage for <#ffb900ff>4s<>."
      },
      "tft_renni": {
        "name": "Renni",
        "attack": "Her saw bites <#ffb900ff>3<> times, each for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>42%<> <#ff9028ff>physical damage<>. <#ff9028ff>Shimmer Frenzy<>: below <#ffb900ff>40%<> health (once every <#ffb900ff>30s<>) she shoots up Shimmer: <#ffb900ff>+40%<> attack speed for <#ffb900ff>4s<>, healing <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>20%<> max health.",
        "skill": "Charges the target and grinds the cone in front of her <#ffb900ff>3<> times, each for <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> <#ff9028ff>physical damage<>, <#ef5350ff>slowing by 30%<> for <#ffb900ff>1.5s<>.",
        "skill2": "Raises her saw as a guard: a <#ff9028ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> shield for <#ffb900ff>2.5s<> and <#ffb900ff>20%<> less damage taken meanwhile.",
        "ult": "Hooks the target up overhead for <#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>190%<> <#ff9028ff>physical damage<>, <#ef5350ff>airborne for 1.1s<>, healing <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>15%<> max health; then slams it down for <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<> <#ff9028ff>physical damage<> to the enemies there."
      },
      "tft_smeech": {
        "name": "Smeech",
        "attack": "Rakes with each claw in turn for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Ambusher<>: <#ffb900ff>25%<> crit chance; his abilities can crit too, for <#ffb900ff>220%<> damage.",
        "skill": "Leaps at the <#ffb900ff>lowest-health<> enemy in range and slashes it <#ffb900ff>3<> times for <#ff9028ff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%<> <#ff9028ff>physical damage<> each. If it dies, he leaps again for <#ffb900ff>70%<> damage.",
        "skill2": "Rips the target with both claws for <#ff9028ff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<> <#ff9028ff>physical damage<>, <#ef5350ff>shredding 30% of its armor<> for <#ffb900ff>4s<>.",
        "ult": "For <#ffb900ff>1.2s<> he is <#ef5350ff>unstoppable<> and takes <#ffb900ff>30%<> less damage, leaping at up to <#ffb900ff>5<> enemies he has not yet hit, each for <#ff9028ff>55<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>, gaining <#ffb900ff>10%<> crit chance for <#ffb900ff>5s<> per leap."
      },
      "tft_sevika": {
        "name": "Sevika",
        "attack": "Punches for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>; every <#ffb900ff>3rd<> the claws clamp for <#ff9028ff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150%<>. <#ff9028ff>High Roller<>: each skill rolls one of Jinx's mods - rockets, a shield or <#ffb900ff>35%<> attack speed; a <#ffb900ff>12%<> jackpot empowers the cast.",
        "skill": "Flames for <#ffb900ff>1.2s<>: <#ffb900ff>5<> waves into the cone ahead, each <#ff9028ff>12<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>32%<> <#ff9028ff>physical damage<>; she takes <#ffb900ff>30%<> less damage meanwhile.",
        "skill2": "Fires her fist for <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<> <#ff9028ff>physical damage<>, knocking the target back; knocked into an enemy, both are <#ef5350ff>stunned for 1.2s<>.",
        "ult": "Dashes in and bites <#ffb900ff>2<> times, each <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>135%<> <#ff9028ff>physical damage<>, <#ef5350ff>stunning for 1.1s<> and bleeding; under <#ffb900ff>15%<> health the target is executed and she dashes to the next champion."
      },
      "tft_steb": {
        "name": "Steb",
        "attack": "Strikes with his batons in turn for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Field Medicine<>: whenever he is healed, the <#ffb900ff>2<> nearest allied champions heal <#ffb900ff>25%<> of it too.",
        "skill": "Doses himself for <#ffb900ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#ffb900ff>60%<> health, then strikes the target for <#a974ffff>170<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>120%<> <#a974ffff>magic damage<>, <#ef5350ff>stunning for 0.75s<>.",
        "skill2": "Marks the enemy champion with the most health nearby as Wanted for <#ffb900ff>5s<>: it takes <#ffb900ff>25%<> more damage; if it dies while Wanted, he and nearby allies gain <#ffb900ff>30%<> attack speed for <#ffb900ff>5s<>.",
        "ult": "Opens his medic's pack: he and nearby allied champions gain a <#a974ffff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<> shield for <#ffb900ff>4s<> and he takes <#ffb900ff>30%<> less damage; then every <#ffb900ff>0.5s<>, <#ffb900ff>6<> times, nearby allies heal <#ffb900ff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#ffb900ff>12%<>."
      },
      "tft_nomsy": {
        "name": "Nomsy",
        "attack": "Spits a fire bolt for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Dragon Body<>: under <#ffb900ff>40%<> health she heals <#ffb900ff>3%<> of her max health each second.",
        "skill": "Lobs a fireball that explodes for <#a974ffff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>63%<> <#a974ffff>magic damage<> and bounces <#ffb900ff>2<> small fireballs on to nearby enemies for <#ffb900ff>55%<> of it each.",
        "skill2": "Breathes a cone of fire for <#a974ffff>55<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>36%<> <#a974ffff>magic damage<>, burning for <#ffb900ff>2s<> and cutting magic resist by <#ffb900ff>20%<> for <#ffb900ff>4s<>.",
        "ult": "Flies up (<#ffb900ff>50%<> less damage, immune to crowd control) and rains <#ffb900ff>10<> fireballs, each <#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>35%<> <#a974ffff>magic damage<>; landing, she gains <#ffb900ff>30%<> attack speed and <#ffb900ff>25%<> ability power for <#ffb900ff>5s<>."
      },
      "tft_idas": {
        "name": "Idas",
        "attack": "Claws for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Guardian's Vow<>: under <#ffb900ff>50%<> health she and the nearest ally each get a shield of <#ffb900ff>18%<> of her max health for <#ffb900ff>5s<>, once every <#ffb900ff>30s<>.",
        "skill": "Breathes a cone of molten gold for <#a974ffff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<> <#a974ffff>magic damage<>, cutting armor by <#ffb900ff>35%<> for <#ffb900ff>4s<>.",
        "skill2": "Beats her wings and roars: nearby enemies are <#ef5350ff>stunned<> for <#ffb900ff>0.75s<> and slowed <#ffb900ff>50%<> for <#ffb900ff>2s<>; she and nearby allies get a <#a974ffff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<> shield for <#ffb900ff>3s<>.",
        "ult": "Wraps herself in her wings for <#ffb900ff>2s<>, taking <#ffb900ff>60%<> less damage; then heals <#a974ffff>200<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<> and gives nearby allies a <#a974ffff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<> shield for <#ffb900ff>5s<> and <#ffb900ff>30%<> attack speed while it holds."
      },
      "tft_daeja": {
        "name": "Daeja",
        "attack": "Punches out a wind bolt for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Barrage<>: each attack sends <#ffb900ff>3<> small wind bolts after it, each <#a974ffff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<> <#a974ffff>magic damage<> and <#ffb900ff>-4<> magic resist for <#ffb900ff>3s<> (stacks).",
        "skill": "Sweeps his wings forward: a wind wave runs down the line with the most enemies, <#a974ffff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<> <#a974ffff>magic damage<> to each.",
        "skill2": "Beats his wings at a nearby enemy: a gust for <#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<> <#a974ffff>magic damage<> and a <#ffb900ff>40%<> slow for <#ffb900ff>1.5s<>, and he hops back on the wind.",
        "ult": "Flies up (<#ffb900ff>30%<> less damage, immune to crowd control) and blasts <#ffb900ff>3<> big waves down the line with the most enemies, each <#a974ffff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<> <#a974ffff>magic damage<>."
      },
      "tft_shiohyu": {
        "name": "Shi Oh Yu",
        "attack": "Swipes with alternating claws; every third deals <#ff9028ff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<> <#ff9028ff>physical damage<>. <#ff9028ff>Jade Skin<>: under <#ffb900ff>50%<> health his skin turns to jade, <#ffb900ff>40%<> less damage for <#ffb900ff>3s<> (<#ffb900ff>30s<> cooldown).",
        "skill": "Rushes at the target and lands <#ffb900ff>4<> punches, each <#ff9028ff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>45%<> <#ff9028ff>physical damage<>.",
        "skill2": "Smashes the ground: nearby enemies take <#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<> <#ff9028ff>physical damage<>, are <#ef5350ff>knocked up for 0.75s<> and slowed <#ffb900ff>35%<>.",
        "ult": "Takes <#ffb900ff>35%<> less damage and is immune to crowd control; his next 3 attacks deal <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>175%<> each: the 1st <#ef5350ff>stuns for 1s<>, the 2nd is <#f5f5f5ff>true damage<>, the 3rd sends a wave down a line that <#ef5350ff>stuns<> every enemy in it."
      },
      "tft_syfen": {
        "name": "Sy'fen",
        "attack": "Wing claws and tail lashes in turn for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Whispers<>: his damage shrinks enemies for <#ffb900ff>4s<> (<#ffb900ff>-20%<> armor and magic resist); hitting a shrunk enemy stacks <#ffb900ff>+5<> attack (up to <#ffb900ff>5<>).",
        "skill": "Lunges and bites the target for <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160%<> <#ff9028ff>physical damage<>, ignoring <#ffb900ff>33%<> armor, healing <#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30%<>.",
        "skill2": "Sweeps his wings around him: <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<> and a <#ffb900ff>30%<> slow for <#ffb900ff>1.5s<>.",
        "ult": "Roars and charges the farthest enemy champion (immune to crowd control): enemies in his path take <#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<> <#ff9028ff>physical damage<> and are stunned <#ffb900ff>1.25s<>; then a bite for <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>235%<>, ignoring <#ffb900ff>33%<> armor."
      },
      "tft_sohm": {
        "name": "Sohm",
        "attack": "Spits a water bolt for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Lagoon Power<>: every cast adds a tide stack (<#ffb900ff>6s<>, up to <#ffb900ff>5<>): <#ffb900ff>+9%<> ability power and <#ffb900ff>+9%<> attack speed each.",
        "skill": "Sends a wave at an enemy without a flower: <#a974ffff>95<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<> <#a974ffff>magic damage<> to every enemy on its way, and a water flower blooms over the target (<#ffb900ff>15s<>). When a flowered enemy falls, the flower jumps to a nearby enemy.",
        "skill2": "Wraps the nearby ally lowest on health in a <#a974ffff>95<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<> water shield (<#ffb900ff>3s<>) and <#ffb900ff>+25%<> attack speed.",
        "ult": "Every water flower bursts at once: <#a974ffff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>90%<> <#a974ffff>magic damage<> to enemies around each, and the flowers fade. With no flower out, one bursts on the target."
      },
      "tft_terra": {
        "name": "Terra",
        "attack": "A rock claw swipe for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Monolith Hide<>: she always takes <#ffb900ff>18%<> less damage.",
        "skill": "Lunges low and bites the target for <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<> + <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ff9028ff>50%<> <#ff9028ff>physical damage<> (<i#asset/base/ui/banpick/champion_stat_icon:armor_0> = armor + magic resist), slowing it <#ef5350ff>30%<> for <#ffb900ff>1.5s<>.",
        "skill2": "Roars, <#ef5350ff>taunting<> nearby enemies for <#ffb900ff>1.5s<>, and gains a <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> rock shield for <#ffb900ff>3s<>.",
        "ult": "Stomps three times (<#ef5350ff>unstoppable<> while casting), each dealing <#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%<> + <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ff9028ff>32%<> <#ff9028ff>physical damage<> around her; then <#ffb900ff>+60<> armor and magic resist for <#ffb900ff>8s<>."
      },
      "tft_zippy": {
        "name": "Zippy",
        "attack": "A claw kick for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Adventurer's Spirit<>: <#ffb900ff>+10<> armor and magic resist for each allied champion nearby (up to <#ffb900ff>4<>).",
        "skill": "Backflips and kicks the target for <#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<> <#ff9028ff>physical damage<>, knocking it up for <#ffb900ff>0.67s<>.",
        "skill2": "Curls into a ball and rolls at an enemy: <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> <#ff9028ff>physical damage<> to enemies rolled over; nearby allied champions gain <#ffb900ff>20%<> move speed for <#ffb900ff>2.5s<>.",
        "ult": "Gains a <#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> shield for <#ffb900ff>2s<>, then leaps at the enemy champion with the highest percent health (immune to crowd control): <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>220%<> <#ff9028ff>physical damage<>, a <#ffb900ff>1.5s<> stun and a short knockback."
      },
      "tft_sentinel": {
        "name": "Sentinel",
        "attack": "A stone fist slam for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Blue Buff<>: each of its spells drops nearby allies' spell cooldowns at once to at most <#ffb900ff>67%<>.",
        "skill": "Slams both fists down, dealing <#a974ffff>85<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>105%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#a974ffff>4%<> <#a974ffff>magic damage<> to nearby enemies and slowing them <#ef5350ff>30%<> for <#ffb900ff>2s<>.",
        "skill2": "Its runes flare: gains a <#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>120%<> shield for <#ffb900ff>4s<> and <#ef5350ff>taunts<> nearby enemies for <#ffb900ff>1.2s<>.",
        "ult": "Gains a <#ff9028ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>120%<> shield and slams a fissure toward the most enemy champions: <#ef5350ff>knock-up<>, <#a974ffff>170<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>170%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#a974ffff>4%<> <#a974ffff>magic damage<> and <#ef5350ff>Mana Reave<> (their next spell <#ffb900ff>2s<> late)."
      },
      "tft_brambleback": {
        "name": "Brambleback",
        "attack": "A claw rake for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Red Buff<>: attacks Burn for <#ffb900ff>3s<> (<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ef5350ff>1.2%<> true damage a second) and heal <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#ff9028ff>1.5%<>; after a kill it leaps at the next enemy for <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<> <#ff9028ff>physical damage<>.",
        "skill": "Pounces on its target for <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150%<> <#ff9028ff>physical damage<>, slowing it <#ef5350ff>30%<> for <#ffb900ff>1s<>.",
        "skill2": "Rears up and roars: nearby enemies are slowed <#ef5350ff>30%<> and lose <#ef5350ff>20%<> attack, it takes <#ff9028ff>25%<> less damage, for <#ffb900ff>3s<>.",
        "ult": "Frenzied for <#ffb900ff>6s<>: <#ff9028ff>+55%<> attack, <#ff9028ff>+35%<> attack speed, ignores <#ff9028ff>40%<> of its target's armor."
      },
      "tft_raptor": {
        "name": "Mama Beak",
        "attack": "Flings a sharp feather for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Orange Buff<>: its physical damage takes <#ef5350ff>6<> armour off the target for <#ffb900ff>3s<> (up to <#ffb900ff>5<> stacks).",
        "skill": "Spreads its wings and flings <#ffb900ff>5<> blade feathers in a fan, each hitting the first enemy for <#ff9028ff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>55%<> <#ff9028ff>physical damage<>.",
        "skill2": "Startled, it screeches and hops back, then gains <#ffb900ff>+70%<> attack speed for <#ffb900ff>3s<>.",
        "ult": "Calls <#ffb900ff>4<> untargetable Tiny Beaks for <#ffb900ff>7s<>: each of its attacks, they peck the same enemy for <#ff9028ff>18<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30%<> <#ff9028ff>physical damage<> each."
      },
      "tft_elderdragon": {
        "name": "Elder Dragon",
        "attack": "Bites for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>; enemies next to the target take <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>35%<>. <#ff9028ff>Elder buff<>: enemy champions it leaves under <#ef5350ff>15%<> health are executed.",
        "skill": "Breathes fire along the line through the target with the most enemies: <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<> <#ff9028ff>physical damage<>, <#ef5350ff>20%<> less per enemy passed (min <#ffb900ff>40%<>), and <#ff9028ff>Ignites<> them: <#ef5350ff>2.5%<> max health physical a second for <#ffb900ff>3s<>.",
        "skill2": "Rears up and beats its wings: nearby enemies take <#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> <#ff9028ff>physical damage<>, are knocked back and slowed <#ffb900ff>35%<> (<#ffb900ff>2s<>); it takes <#ef5350ff>25%<> less damage.",
        "ult": "Invulnerable, it flies up and lands after <#ffb900ff>1.5s<>: enemies in a wide area take <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<> <#ff9028ff>physical damage<>, are stunned <#ffb900ff>1.25s<> and <#ff9028ff>Ignited<>; it gains <#ffb900ff>30%<> omnivamp (<#ffb900ff>5s<>) and casts <#ff9028ff>Flame Breath<> at once."
      },
      "tft_murkwolf": {
        "name": "Murkwolf",
        "attack": "Both heads bite for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Grey Buff<>: <#ffb900ff>25%<> critical strike chance, up to <#ffb900ff>+30%<> more with its missing Health; its skills can critically strike.",
        "skill": "Leaps to the nearby enemy with the lowest Health for <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<> <#ff9028ff>physical damage<>. Its next <#ffb900ff>3<> attacks gain <#ffb900ff>+60%<> attack speed and deal <#ff9028ff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30%<> bonus <#ff9028ff>physical damage<>.",
        "skill2": "Howls: for <#ffb900ff>5s<> it gains <#ffb900ff>20%<> omnivamp and deals <#ffb900ff>15%<> more damage, doubled against enemies below <#ffb900ff>50%<> Health.",
        "ult": "Calls <#ffb900ff>2<> murk wolf pups that pounce on its target for <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> <#ff9028ff>physical damage<>. For <#ffb900ff>6s<>, each of its attacks the pups bite <#ffb900ff>2<> times for <#ff9028ff>12<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>25%<> <#ff9028ff>physical damage<> each."
      },
      "tft_meepsie": {
        "name": "Meepsie",
        "attack": "Punches for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Meep Pilot<>: every punch deals <#a974ffff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>25%<> bonus <#a974ffff>magic damage<>.",
        "skill": "Punches the ground ahead: enemies in a cone take <#a974ffff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<> <#a974ffff>magic damage<> and are slowed <#ef5350ff>40%<> (<#ffb900ff>2s<>).",
        "skill2": "The pilot waves and <#ffb900ff>4<> meeps fly to the nearby allies with the lowest health share (itself with one to spare), each healing <#a974ffff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>10%<> every <#ffb900ff>0.5s<> for <#ffb900ff>3s<>.",
        "ult": "Leaps to the spot with the most enemy champions and slams: enemies around take <#a974ffff>160<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>90%<> <#a974ffff>magic damage<>, <#ef5350ff>35%<> less a hex out; the <#ffb900ff>3<> enemy champions nearest are <#ef5350ff>knocked up<> <#ffb900ff>1.25s<>."
      },
      "tft_scuttlecrab": {
        "name": "Scuttle Crab",
        "attack": "Dances, stomping every enemy beside it for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Green Buff<>: a nearby allied champion falling under <#ffb900ff>40%<> health restores <#ffb900ff>12%<> of its max health (once every <#ffb900ff>10s<> each).",
        "skill": "Raises a speed shrine at its feet for <#ffb900ff>4s<>: its splash deals <#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<> <#a974ffff>magic damage<> to enemies around and slows them <#ef5350ff>40%<>; allied champions in it gain <#ffb900ff>30%<> move speed and <#ffb900ff>25%<> attack speed.",
        "skill2": "Pulls into its shell for a <#a974ffff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<> shield (<#ffb900ff>2s<>). When the shield breaks or runs out, the shell bursts: enemies around take <#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<> <#a974ffff>magic damage<>, are <#ef5350ff>stunned<> <#ffb900ff>0.5s<> and slowed <#ef5350ff>40%<>.",
        "ult": "Burrows for <#ffb900ff>2.5s<>, taking <#ffb900ff>50%<> less damage, immune to crowd control and healing <#a974ffff>250<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>; then bursts out: enemies around take <#ff9028ff>160<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> <#ff9028ff>physical damage<> and are <#ef5350ff>knocked up<> <#ffb900ff>1.5s<>."
      }
    },
