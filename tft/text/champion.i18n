{
  "zh-hans": {
    "description": {
      "tft_powder": {
        "name": "爆爆",
        "attack": "扔出自制小鞭炮，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>伏击者<>：技能炸弹可以暴击（<#ffb900ff>25%<>几率，伤害翻倍）。",
        "skill": "把上了发条的猴子炸弹丢到目标脚下，范围内敌人受到<#a974ffff>36<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<>魔法伤害，中心再受一次；被炸到的敌人<#ef5350ff>灼烧<><#ffb900ff>3秒<>，并<#ef5350ff>重伤<><#ffb900ff>4秒<>（受到治疗-40%）。",
        "skill2": "敌方英雄靠近时摔下闪光烟雾弹：周围敌人受到<#a974ffff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>魔法伤害并<#ef5350ff>致盲<><#ffb900ff>1秒<>（无法普攻），自己向后跳开。",
        "ult": "把装着海克斯水晶的包丢向敌方英雄，引线烧完<#ffb900ff>0.9秒<>后蓝光大爆炸：范围内敌人受到<#a974ffff>170<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<>魔法伤害并<#ef5350ff>击飞<><#ffb900ff>0.75秒<>。"
      },
      "tft_norra": {
        "name": "诺拉",
        "attack": "星光弹造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>寄情琐物<>：每<#ffb900ff>10秒<>，下个技能落点留下琐物<#ffb900ff>4秒<>，走进的敌方英雄受到<#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>20%<>魔法伤害并挂<#ff9028ff>线缕<>。<#ff9028ff>奇异旅程<>：普攻时敌方英雄贴身，开门造成<#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>魔法伤害，<#ef5350ff>放逐<><#ffb900ff>1.5秒<>后<#ef5350ff>减速<>80%<#ffb900ff>0.75秒<>（每<#ffb900ff>25秒<>）。",
        "skill": "蓄力后射出回忆魔法弹，自己后退一步：落点周围敌人受到<#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<>魔法伤害，英雄挂上<#ff9028ff>线缕<>；那里有琐物时一并引爆，附近的敌方英雄再受琐物伤害。",
        "skill2": "在目标两侧打开两扇门，<#ffb900ff>0.3秒<>后线缕穿过：范围内敌人受到<#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26%<>魔法伤害并挂上<#ff9028ff>线缕<>：<#ffb900ff>4秒<>内体型变大15%（更容易被命中），<#ef5350ff>减速<>20%<#ffb900ff>2秒<>。",
        "ult": "在敌方英雄脚下展开大裂隙，每<#ffb900ff>0.5秒<>一波毛线球横穿，共4波：裂隙里的敌方英雄每波受到<#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<>魔法伤害并<#ef5350ff>减速<>80%<#ffb900ff>0.5秒<>，第4波伤害+40%。"
      }
    },
    "skill_name": {
      "tft_powder": {
        "skill1": "猴子炸弹",
        "skill2": "快跑，爆爆！",
        "ult": "海克斯水晶炸弹"
      },
      "tft_norra": {
        "skill1": "回忆涌现",
        "skill2": "思乡线缕",
        "ult": "传送门欢腾！"
      }
    }
  },
  "zh-hant": {
    "description": {
      "tft_powder": {
        "name": "爆爆",
        "attack": "扔出自製小鞭炮，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>伏擊者<>：技能炸彈可以暴擊（<#ffb900ff>25%<>機率，傷害加倍）。",
        "skill": "把上了發條的猴子炸彈丟到目標腳下，範圍內敵人受到<#a974ffff>36<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<>魔法傷害，中心再受一次；被炸到的敵人<#ef5350ff>燃燒<><#ffb900ff>3秒<>，並<#ef5350ff>重傷<><#ffb900ff>4秒<>（受到治療-40%）。",
        "skill2": "敵方英雄靠近時摔下閃光煙霧彈：周圍敵人受到<#a974ffff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>魔法傷害並<#ef5350ff>致盲<><#ffb900ff>1秒<>（無法普攻），自己向後跳開。",
        "ult": "把裝著海克斯水晶的包丟向敵方英雄，引線燒完<#ffb900ff>0.9秒<>後藍光大爆炸：範圍內敵人受到<#a974ffff>170<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<>魔法傷害並<#ef5350ff>擊飛<><#ffb900ff>0.75秒<>。"
      },
      "tft_norra": {
        "name": "諾拉",
        "attack": "星光彈造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>心愛飾品<>：每<#ffb900ff>10秒<>，下個技能落點留下飾品<#ffb900ff>4秒<>，走進的敵方英雄受到<#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>20%<>魔法傷害並掛<#ff9028ff>絲線<>。<#ff9028ff>茫然旅程<>：普攻時敵方英雄貼身，開門造成<#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>魔法傷害，<#ef5350ff>放逐<><#ffb900ff>1.5秒<>後<#ef5350ff>緩速<>80%<#ffb900ff>0.75秒<>（每<#ffb900ff>25秒<>）。",
        "skill": "蓄力後射出記憶魔法彈，自己後退一步：落點周圍敵人受到<#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<>魔法傷害，英雄掛上<#ff9028ff>絲線<>；那裡有飾品時一併引爆，附近的敵方英雄再受飾品傷害。",
        "skill2": "在目標兩側打開兩扇門，<#ffb900ff>0.3秒<>後絲線穿過：範圍內敵人受到<#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26%<>魔法傷害並掛上<#ff9028ff>絲線<>：<#ffb900ff>4秒<>內體型變大15%（更容易被命中），<#ef5350ff>緩速<>20%<#ffb900ff>2秒<>。",
        "ult": "在敵方英雄腳下展開大裂隙，每<#ffb900ff>0.5秒<>一波毛線球橫穿，共4波：裂隙裡的敵方英雄每波受到<#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<>魔法傷害並<#ef5350ff>緩速<>80%<#ffb900ff>0.5秒<>，第4波傷害+40%。"
      }
    },
    "skill_name": {
      "tft_powder": {
        "skill1": "猴子炸彈",
        "skill2": "快跑，爆爆！",
        "ult": "海克斯水晶炸彈"
      },
      "tft_norra": {
        "skill1": "記憶湧現",
        "skill2": "返家絲線",
        "ult": "傳送門嘉年華！"
      }
    }
  },
  "en": {
    "description": {
      "tft_powder": {
        "name": "Powder",
        "attack": "Throws a homemade firecracker for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Ambusher<>: her skill bombs can crit (<#ffb900ff>25%<> chance, double damage).",
        "skill": "Lobs her wind-up monkey bomb at the target's feet: enemies in the blast take <#a974ffff>36<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<> <#a974ffff>magic damage<>, those in the middle take it twice. Everyone hit <#ef5350ff>burns<> for <#ffb900ff>3s<> and is <#ef5350ff>wounded<> for <#ffb900ff>4s<> (healing -40%).",
        "skill2": "When an enemy champion comes close, smashes a flash-smoke bomb: enemies around her take <#a974ffff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<> <#a974ffff>magic damage<> and are <#ef5350ff>blinded<> for <#ffb900ff>1s<> (no basic attacks), and she hops back.",
        "ult": "Lobs the bag with the hex crystal at an enemy champion. After a <#ffb900ff>0.9s<> fuse it bursts in blue: enemies in the blast take <#a974ffff>170<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<> <#a974ffff>magic damage<> and are <#ef5350ff>knocked up<> for <#ffb900ff>0.75s<>."
      },
      "tft_norra": {
        "name": "Norra",
        "attack": "Star bolt: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Beloved Trinkets<>: every <#ffb900ff>10s<> her next ability leaves trinkets where it lands (<#ffb900ff>4s<>): enemy champions walking in take <#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>20%<> <#a974ffff>magic damage<> and the <#ff9028ff>Threads<>. <#ff9028ff>Journey to Nowhere<>: an enemy champion close as she attacks takes <#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<> <#a974ffff>magic damage<>, <#ef5350ff>banished<> <#ffb900ff>1.5s<>, then <#ef5350ff>slowed<> 80% <#ffb900ff>0.75s<> (every <#ffb900ff>25s<>).",
        "skill": "Charges, then flings a bolt of memories and hops back: enemies around where it lands take <#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<> <#a974ffff>magic damage<>, champions get the <#ff9028ff>Threads<>. Trinkets lying there burst too: enemy champions near the blast take their damage.",
        "skill2": "Opens two portals beside the target; <#ffb900ff>0.3s<> later threads shoot between them: enemies there take <#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26%<> <#a974ffff>magic damage<> and get the <#ff9028ff>Threads<>: 15% bigger (easier to hit) for <#ffb900ff>4s<> and <#ef5350ff>slowed<> 20% for <#ffb900ff>2s<>.",
        "ult": "Opens a great rift under an enemy champion: 4 volleys of yarn balls cross it <#ffb900ff>0.5s<> apart, each hitting the enemy champions inside for <#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<> <#a974ffff>magic damage<> and <#ef5350ff>slowing<> them 80% for <#ffb900ff>0.5s<>; the 4th deals 40% more."
      }
    },
    "skill_name": {
      "tft_powder": {
        "skill1": "Monkey Bomb",
        "skill2": "Run, Powder!",
        "ult": "Hex Crystal Bomb"
      },
      "tft_norra": {
        "skill1": "Memory Surge",
        "skill2": "Threads of Homecoming",
        "ult": "Portalpalooza!"
      }
    }
  },
  "ko": {
    "description": {
      "tft_powder": {
        "name": "파우더",
        "attack": "직접 만든 폭죽을 던져 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>매복자<>: 스킬 폭탄이 치명타로 터질 수 있다(<#ffb900ff>25%<>, 피해 2배).",
        "skill": "태엽 원숭이 폭탄을 대상의 발밑에 던져 폭발 범위의 적에게 <#a974ffff>36<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<> 마법 피해, 중심은 한 번 더. 맞은 적은 <#ffb900ff>3초<> <#ef5350ff>불태움<>, <#ffb900ff>4초<> <#ef5350ff>상처<>(받는 회복 -40%).",
        "skill2": "적 챔피언이 다가오면 섬광 연막탄을 터뜨려 주변 적에게 <#a974ffff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<> 마법 피해와 <#ffb900ff>1초<> <#ef5350ff>실명<>(기본 공격 불가), 자신은 뒤로 뛴다.",
        "ult": "마법공학 수정이 든 가방을 적 챔피언에게 던진다. <#ffb900ff>0.9초<> 뒤 푸른 폭발: 범위의 적에게 <#a974ffff>170<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<> 마법 피해와 <#ffb900ff>0.75초<> <#ef5350ff>공중에 띄움<>."
      },
      "tft_norra": {
        "name": "노라",
        "attack": "별빛 탄환으로 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>소중한 장신구<>: <#ffb900ff>10초<>마다 다음 스킬이 떨어진 곳에 장신구를 <#ffb900ff>4초<> 남김: 들어온 적 챔피언은 <#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>20%<> 마법 피해와 <#ff9028ff>실타래<>. <#ff9028ff>미지로의 여정<>: 공격 시 적 챔피언이 붙어 있으면 차원문: <#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<> 마법 피해, <#ffb900ff>1.5초<> <#ef5350ff>추방<> 뒤 <#ffb900ff>0.75초<> 80% <#ef5350ff>둔화<>(<#ffb900ff>25초<>마다).",
        "skill": "충전 후 기억의 탄환을 날리고 뒤로 물러난다: 떨어진 곳 주변 적에게 <#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<> 마법 피해, 챔피언에게 <#ff9028ff>실타래<>. 그곳의 장신구도 터져 근처 적 챔피언이 장신구 피해를 받는다.",
        "skill2": "대상 양옆에 차원문 두 개를 열고 <#ffb900ff>0.3초<> 뒤 실타래가 지나간다: 범위의 적에게 <#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26%<> 마법 피해와 <#ff9028ff>실타래<>: <#ffb900ff>4초<> 동안 15% 커지고(맞히기 쉬움) <#ffb900ff>2초<> 동안 20% <#ef5350ff>둔화<>.",
        "ult": "적 챔피언 발밑에 큰 균열을 열고 <#ffb900ff>0.5초<>마다 털실 뭉치가 4번 가로지른다: 매번 안의 적 챔피언에게 <#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<> 마법 피해와 <#ffb900ff>0.5초<> 80% <#ef5350ff>둔화<>, 4번째는 피해 +40%."
      }
    },
    "skill_name": {
      "tft_powder": {
        "skill1": "원숭이 폭탄",
        "skill2": "도망쳐, 파우더!",
        "ult": "마법공학 수정 폭탄"
      },
      "tft_norra": {
        "skill1": "밀려드는 기억",
        "skill2": "귀향의 실타래",
        "ult": "차원문 대소동!"
      }
    }
  },
  "ja": {
    "description": {
      "tft_powder": {
        "name": "パウダー",
        "attack": "手作りの爆竹を投げ、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の物理ダメージ。<#ff9028ff>アンブッシャー<>：スキルの爆弾がクリティカルする（<#ffb900ff>25%<>、ダメージ2倍）。",
        "skill": "ぜんまい仕掛けのモンキーボムを対象の足元に投げ、範囲の敵に<#a974ffff>36<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<>の魔法ダメージ、中心はもう一度。当たった敵は<#ffb900ff>3秒<><#ef5350ff>炎上<>、<#ffb900ff>4秒<><#ef5350ff>重傷<>（回復-40%）。",
        "skill2": "敵チャンピオンが近づくと閃光煙幕弾を叩きつけ、周りの敵に<#a974ffff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>の魔法ダメージと<#ffb900ff>1秒<><#ef5350ff>ブラインド<>（通常攻撃不可）、自分は後ろへ跳ぶ。",
        "ult": "ヘクスクリスタル入りの鞄を敵チャンピオンへ投げる。<#ffb900ff>0.9秒<>後に青く大爆発：範囲の敵に<#a974ffff>170<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<>の魔法ダメージと<#ffb900ff>0.75秒<><#ef5350ff>ノックアップ<>。"
      },
      "tft_norra": {
        "name": "ノラ",
        "attack": "星の弾で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の物理ダメージ。<#ff9028ff>愛用のトリンケット<>：<#ffb900ff>10秒<>毎、次スキルの着弾点に<#ffb900ff>4秒<>残り、入った敵チャンピオンに<#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>20%<>魔法ダメージと<#ff9028ff>スレッド<>。<#ff9028ff>どこでもない場所へ<>：攻撃時に密着した敵に<#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>魔法ダメージ、<#ffb900ff>1.5秒<><#ef5350ff>追放<>後<#ffb900ff>0.75秒<>80%<#ef5350ff>スロウ<>（<#ffb900ff>25秒<>毎）。",
        "skill": "溜めてから記憶の弾を放ち、後ろへ跳ぶ：着弾点の周りの敵に<#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<>の魔法ダメージ、チャンピオンに<#ff9028ff>スレッド<>。そこのトリンケットも弾け、近くの敵チャンピオンにそのダメージ。",
        "skill2": "対象の両脇に2つのポータルを開き、<#ffb900ff>0.3秒<>後にスレッドが走る：範囲の敵に<#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26%<>の魔法ダメージと<#ff9028ff>スレッド<>：<#ffb900ff>4秒<>間15%大きく（当たりやすい）、<#ffb900ff>2秒<>間20%<#ef5350ff>スロウ<>。",
        "ult": "敵チャンピオンの足元に大きな裂け目を開き、<#ffb900ff>0.5秒<>毎に毛糸玉が4回横切る：毎回中の敵チャンピオンに<#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<>の魔法ダメージと<#ffb900ff>0.5秒<>80%<#ef5350ff>スロウ<>、4回目は+40%。"
