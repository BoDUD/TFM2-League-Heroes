{
  "zh-hans": {
    "description": {
      "tft_powder": {
        "name": "爆爆",
        "attack": "扔出自制小鞭炮，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>伏击者<>：技能炸弹可以暴击（<#ffb900ff>25%<>几率，伤害翻倍）。",
        "skill": "把上了发条的猴子炸弹丢到目标脚下，范围内敌人受到<#a974ffff>36<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<>魔法伤害，中心再受一次；被炸到的敌人<#ef5350ff>灼烧<><#ffb900ff>3秒<>，并<#ef5350ff>重伤<><#ffb900ff>4秒<>（受到治疗-40%）。",
        "skill2": "敌方英雄靠近时摔下闪光烟雾弹：周围敌人受到<#a974ffff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>魔法伤害并<#ef5350ff>致盲<><#ffb900ff>1秒<>（无法普攻），自己向后跳开。",
        "ult": "把装着海克斯水晶的包丢向敌方英雄，引线烧完<#ffb900ff>0.9秒<>后蓝光大爆炸：范围内敌人受到<#a974ffff>170<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<>魔法伤害并<#ef5350ff>击飞<><#ffb900ff>0.75秒<>。"
      },
      "tft_norra": {
        "name": "诺拉",
        "attack": "普攻<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>寄情琐物<>：每<#ffb900ff>10秒<>技能落点撒3个琐物<#ffb900ff>4秒<>，飞向踩到的敌方英雄：<#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>20%<>魔法伤害并挂<#ff9028ff>线缕<>；技能命中英雄冷却-20%。<#ff9028ff>奇异旅程<>：贴身的敌人受<#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>魔法伤害，<#ef5350ff>放逐<><#ffb900ff>1.5秒<>后<#ef5350ff>减速<>80%<#ffb900ff>0.75秒<>。",
        "skill": "蓄力后射出回忆魔法弹，自己后退一步：落点周围敌人受到<#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<>魔法伤害，已有<#ff9028ff>线缕<>的英雄再受最大生命2%，随后挂上线缕；打中英雄时地上的琐物待爆：敌方英雄靠近就飞向他。",
        "skill2": "在目标两侧打开两扇门，<#ffb900ff>0.3秒<>后线缕穿过：范围内敌人受到<#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26%<>魔法伤害并挂上<#ff9028ff>线缕<>：<#ffb900ff>4秒<>内体型变大15%（更容易被命中），<#ef5350ff>减速<>20%<#ffb900ff>2秒<>。",
        "ult": "在敌方英雄脚下展开大裂隙，每<#ffb900ff>0.5秒<>一波共4波：两个毛线球沿一条穿过敌方英雄的线从两头对飞，路上敌人各受<#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<>魔法伤害，每个球碰到的第一个英雄<#ef5350ff>减速<>80%<#ffb900ff>0.5秒<>；第4波+40%。"
      },
      "tft_alune": {
        "name": "拉露恩",
        "attack": "把螺旋月环像飞盘一样甩出去，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>，月环飞回她手里，回程路上的敌人受到<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30%<>物理伤害。<#ff9028ff>月相<>：每放一次技能月亮长一档，最多<#ffb900ff>3<>档；大招每档伤害+<#ffb900ff>20%<>，砸完回到新月。",
        "skill": "月光碎片从天而降，落在离她最近的<#ffb900ff>3<>个敌人身上，每枚造成<#a974ffff>42<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>32%<>魔法伤害，并使魔抗降低<#ffb900ff>20%<>，持续<#ffb900ff>6秒<>。",
        "skill2": "月光洒在她和身边的友方英雄身上，攻击速度提高<#ffb900ff>36%<>，持续<#ffb900ff>5秒<>。",
        "ult": "敌方英雄脚下浮现月影，<#ffb900ff>0.75秒<>后满月砸下：<#a974ffff>165<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>72%<>魔法伤害×<#ffb900ff>220%<>由范围内的敌人平分（每人最多<#ffb900ff>180%<>），中心的敌人<#ef5350ff>眩晕<><#ffb900ff>0.83秒<>。"
      },
      "tft_silco": {
        "name": "希尔科",
        "attack": "甩出一支微光药剂，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>统领<>：每次出生获得<#a974ffff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>40%<>护盾（<#ffb900ff>15秒<>）；每放一次技能法强+<#ffb900ff>10%<>，最多<#ffb900ff>5<>层，阵亡清空。",
        "skill": "扔出储罐，造成<#a974ffff>65<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<>魔法伤害，放出<#ffb900ff>2<>只畸变体扑向附近的敌人，各咬<#ffb900ff>5<>口，每口<#a974ffff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>11%<>魔法伤害；被咬的人倒下就跳到下一个。",
        "skill2": "把微光抛给身边攻击力最高的友方英雄（没有就自己）：攻速+<#ffb900ff>50%<>、移速+<#ffb900ff>20%<>，<#ffb900ff>4秒<>；药效过去扣当前生命的<#ffb900ff>8%<>。",
        "ult": "向敌方英雄扔出巨型储罐，造成<#a974ffff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>魔法伤害，放出<#ffb900ff>4<>只畸变体，留下<#ffb900ff>4秒<>毒雾：敌人<#ef5350ff>减速<><#ffb900ff>30%<>，每秒受到<#a974ffff>6<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>4%<>魔法伤害。"
      },
      "tft_maddie": {
        "name": "麦迪",
        "attack": "步枪射击，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>狙神<>：目标离得越远，她造成的伤害越高，最多+<#ffb900ff>25%<>；被通缉的敌人阵亡时她领一份赏金：攻速+<#ffb900ff>15%<>，最多<#ffb900ff>4<>份。",
        "skill": "半蹲朝范围内最远的敌人连开<#ffb900ff>6<>枪（先打英雄），每枪打中路上第一个敌人，造成<#ff9028ff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40%<><#ff9028ff>物理伤害<>。",
        "skill2": "通缉附近当前生命最高的敌方英雄<#ffb900ff>8秒<>：它受到的伤害+<#ffb900ff>15%<>。",
        "ult": "瞄准后向生命比例最低的敌方英雄射出一发穿透子弹，路上每个敌人受到<#ff9028ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<><#ff9028ff>物理伤害<>，按其已损失生命比例最多再加<#ffb900ff>60%<>。"
      },
      "tft_loris": {
        "name": "洛里斯",
        "attack": "举盾猛砸，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>神盾使<>：每条命第一次生命低于<#ffb900ff>75%<>和<#ffb900ff>25%<>时，各获得最大生命<#ffb900ff>12%<>的护盾（<#ffb900ff>4秒<>）。",
        "skill": "获得<#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<>的护盾（<#ffb900ff>4秒<>），举盾冲锋，撞到的敌人受到<#a974ffff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<>魔法伤害并<#ef5350ff>晕眩1.5秒<>。",
        "skill2": "冲到附近生命比例最低的友方英雄身边，两人各获得<#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<>的护盾（<#ffb900ff>4秒<>），期间替他承受<#ffb900ff>30%<>的伤害。",
        "ult": "把巨盾砸进地里，周围的敌人受到<#a974ffff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>魔法伤害、被<#ef5350ff>击飞1秒<>并<#ef5350ff>嘲讽2秒<>；自己受到的伤害降低<#ffb900ff>50%<>（<#ffb900ff>4秒<>）。"
      },
      "tft_kobuko": {
        "name": "可酷伯",
        "attack": "猫爪掌，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>第二阶段<>：每条命第一次生命低于<#ffb900ff>50%<>时进入狂怒，直到阵亡：攻击速度<#ffb900ff>+40%<>、生命偷取<#ffb900ff>20%<>。",
        "skill": "获得<#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<>的护盾（<#ffb900ff>4秒<>）；<#ffb900ff>4秒<>内下一次普攻变为金爪重掌，造成<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>105%<> + <#ff9028ff>2%<>最大生命<#ff9028ff>物理伤害<>并<#ef5350ff>晕眩1秒<>。",
        "skill2": "扑向目标，落地时周围的敌人受到<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%<> + <#ff9028ff>2%<>最大生命<#ff9028ff>物理伤害<>并被<#ef5350ff>击飞0.4秒<>。",
        "ult": "一跃冲天（期间不可选中、免疫控制），砸落在敌方英雄身上：目标受到<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> + <#ff9028ff>6%<>最大生命<#ff9028ff>物理伤害<>，周围的敌人（含目标）再受到<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> + <#ff9028ff>3%<>最大生命<#ff9028ff>物理伤害<>并被<#ef5350ff>击飞0.8秒<>。"
