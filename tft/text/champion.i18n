      },
      "tft_raptor": {
        "name": "巨喙鳥媽媽",
        "attack": "甩出一根鋒羽，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>橘色增益<>：牠的物理傷害使目標物防<#ef5350ff>-6<>（<#ffb900ff>3秒<>，最多<#ffb900ff>5層<>）。",
        "skill": "張開翅膀，扇形甩出<#ffb900ff>5根<>羽刃，每根命中第一個敵人，造成<#ff9028ff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>55%<><#ff9028ff>物理傷害<>。",
        "skill2": "受驚尖叫，往後一跳，之後<#ffb900ff>3秒<>攻速<#ffb900ff>+70%<>。",
        "ult": "召喚<#ffb900ff>4隻<>無法被指定的小巨喙鳥（<#ffb900ff>7秒<>）：牠每次普攻，小鳥們一起啄同一目標，各造成<#ff9028ff>18<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30%<><#ff9028ff>物理傷害<>。"
      },
      "tft_elderdragon": {
        "name": "遠古巨龍",
        "attack": "撕咬目標，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>，目標身邊的敵軍受到<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>35%<>濺射。<#ff9028ff>遠古巨龍增益<>：被牠傷害後生命低於<#ef5350ff>15%<>的敵方英雄直接被處決。",
        "skill": "朝穿過目標、敵軍最多的直線噴火，造成<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130%<><#ff9028ff>物理傷害<>，每穿過一人傷害<#ef5350ff>-20%<>（最低<#ffb900ff>40%<>），並<#ff9028ff>點燃<>：<#ffb900ff>3秒<>內每秒受到<#ef5350ff>2.5%<>最大生命的物理傷害。",
        "skill2": "挺身猛拍雙翼，身邊的敵軍受到<#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<><#ff9028ff>物理傷害<>、被擊退並緩速<#ffb900ff>35%<>（<#ffb900ff>2秒<>），自身受到的傷害<#ef5350ff>-25%<>。",
        "ult": "進入無敵飛上天空，<#ffb900ff>1.5秒<>後落下：大範圍敵軍受到<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<><#ff9028ff>物理傷害<>、暈眩<#ffb900ff>1.25秒<>並被<#ff9028ff>點燃<>；獲得<#ffb900ff>30%<>全能吸血（<#ffb900ff>5秒<>），立即施放<#ff9028ff>龍之吐息<>。"
      },
      "tft_murkwolf": {
        "name": "魔狼",
        "attack": "兩個頭一起撕咬，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>灰色增益<>：暴擊率<#ffb900ff>25%<>，隨已損失生命最多再<#ffb900ff>+30%<>，技能也能暴擊。",
        "skill": "躍向附近生命最低的敵軍，造成<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<><#ff9028ff>物理傷害<>。接下來<#ffb900ff>3次<>普攻攻速<#ffb900ff>+60%<>，額外造成<#ff9028ff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30%<><#ff9028ff>物理傷害<>。",
        "skill2": "仰頭長嚎，<#ffb900ff>5秒<>內吸血<#ffb900ff>20%<>，傷害提高<#ffb900ff>15%<>，對生命低於<#ffb900ff>50%<>的敵軍加倍。",
        "ult": "叫來<#ffb900ff>2隻<>小魔狼撲向目標，造成<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<><#ff9028ff>物理傷害<>。<#ffb900ff>6秒<>內牠每次普攻，小狼咬<#ffb900ff>2口<>，每口<#ff9028ff>12<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>25%<><#ff9028ff>物理傷害<>。"
      },
      "tft_meepsie": {
        "name": "小米普",
        "attack": "揮出月岩重拳，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>米普駕駛員<>：每一拳額外造成<#a974ffff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>25%<><#a974ffff>魔法傷害<>。",
        "skill": "一拳砸向前方地面，扇形範圍內的敵軍受到<#a974ffff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<><#a974ffff>魔法傷害<>並緩速<#ef5350ff>40%<>（<#ffb900ff>2秒<>）。",
        "skill2": "駕駛員一招手，<#ffb900ff>4隻<>米普飛向身邊生命比例最低的隊友（名額有剩時也治療自身），每<#ffb900ff>0.5秒<>回復<#a974ffff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>10%<>生命，持續<#ffb900ff>3秒<>。",
        "ult": "跳向附近敵方英雄最多的地方砸地，周圍的敵軍受到<#a974ffff>160<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>90%<><#a974ffff>魔法傷害<>，離中心每遠一格減少<#ef5350ff>35%<>；離落點最近的<#ffb900ff>3名<>敵方英雄被<#ef5350ff>擊飛<><#ffb900ff>1.25秒<>。"
      },
      "tft_scuttlecrab": {
        "name": "河蟹",
        "attack": "跳一段螃蟹舞，踩中身邊所有敵軍，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>綠色增益<>：附近的友方英雄生命低於<#ffb900ff>40%<>時回復<#ffb900ff>12%<>最大生命（每人<#ffb900ff>10秒<>一次）。",
        "skill": "在腳下放下神龕（<#ffb900ff>4秒<>），水花使周圍敵軍受到<#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<><#a974ffff>魔法傷害<>並緩速<#ef5350ff>40%<>；神龕裡的友方英雄移速<#ffb900ff>+30%<>、攻速<#ffb900ff>+25%<>。",
        "skill2": "縮進殼裡，獲得<#a974ffff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<>護盾（<#ffb900ff>2秒<>）。護盾被打破或時間到時蟹殼碎裂：周圍敵軍受到<#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<><#a974ffff>魔法傷害<>、<#ef5350ff>暈眩<><#ffb900ff>0.5秒<>並緩速<#ef5350ff>40%<>。",
        "ult": "鑽入地下<#ffb900ff>2.5秒<>：受到的傷害降低<#ffb900ff>50%<>、免疫控場，持續回復<#a974ffff>250<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>生命；接著鑽出地面，周圍敵軍受到<#ff9028ff>160<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<><#ff9028ff>物理傷害<>並被<#ef5350ff>擊飛<><#ffb900ff>1.5秒<>。"
      }
    },
