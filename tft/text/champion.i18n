        "skill": "扔出儲罐，造成<#a974ffff>65<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<>魔法傷害，放出<#ffb900ff>2<>隻怪物撲向附近的敵人，各咬<#ffb900ff>5<>口，每口<#a974ffff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>11%<>魔法傷害；被咬的人倒下就跳到下一個。",
        "skill2": "把微光拋給身邊攻擊力最高的友方英雄（沒有就自己）：攻速+<#ffb900ff>50%<>、移速+<#ffb900ff>20%<>，<#ffb900ff>4秒<>；藥效過去扣除目前生命的<#ffb900ff>8%<>。",
        "ult": "向敵方英雄扔出巨型儲罐，造成<#a974ffff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>魔法傷害，放出<#ffb900ff>4<>隻怪物，留下<#ffb900ff>4秒<>毒霧：敵人<#ef5350ff>緩速<><#ffb900ff>30%<>，每秒受到<#a974ffff>6<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>4%<>魔法傷害。"
      },
      "tft_maddie": {
        "name": "梅狄",
        "attack": "步槍射擊，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>狙擊專家<>：目標離得越遠，她造成的傷害越高，最多+<#ffb900ff>25%<>；被通緝的敵人陣亡時她領一份賞金：攻速+<#ffb900ff>15%<>，最多<#ffb900ff>4<>份。",
        "skill": "半蹲朝範圍內最遠的敵人連開<#ffb900ff>6<>槍（優先英雄），每槍擊中路上第一個敵人，造成<#ff9028ff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40%<><#ff9028ff>物理傷害<>。",
        "skill2": "通緝附近目前生命最高的敵方英雄<#ffb900ff>8秒<>：它受到的傷害+<#ffb900ff>15%<>。",
        "ult": "瞄準後向生命比例最低的敵方英雄射出一發穿透子彈，路上每個敵人受到<#ff9028ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<><#ff9028ff>物理傷害<>，依其已損失生命比例最多再加<#ffb900ff>60%<>。"
      },
      "tft_loris": {
        "name": "洛里斯",
        "attack": "舉盾猛砸，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>守護者<>：每條命第一次生命低於<#ffb900ff>75%<>和<#ffb900ff>25%<>時，各獲得最大生命<#ffb900ff>12%<>的護盾（<#ffb900ff>4秒<>）。",
        "skill": "獲得<#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<>的護盾（<#ffb900ff>4秒<>），舉盾衝鋒，撞到的敵人受到<#a974ffff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<>魔法傷害並<#ef5350ff>暈眩1.5秒<>。",
        "skill2": "衝到附近生命比例最低的友方英雄身邊，兩人各獲得<#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<>的護盾（<#ffb900ff>4秒<>），期間替他承受<#ffb900ff>30%<>的傷害。",
        "ult": "把巨盾砸進地裡，周圍的敵人受到<#a974ffff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>魔法傷害、被<#ef5350ff>擊飛1秒<>並<#ef5350ff>嘲諷2秒<>；自己受到的傷害降低<#ffb900ff>50%<>（<#ffb900ff>4秒<>）。"
      },
      "tft_kobuko": {
        "name": "可酷伯",
        "attack": "貓爪掌，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>第二階段<>：每條命第一次生命低於<#ffb900ff>50%<>時進入狂怒，直到陣亡：攻擊速度<#ffb900ff>+40%<>、生命偷取<#ffb900ff>20%<>。",
        "skill": "獲得<#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<>的護盾（<#ffb900ff>4秒<>）；<#ffb900ff>4秒<>內下一次普攻變為金爪重掌，造成<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>105%<> + <#ff9028ff>2%<>最大生命<#ff9028ff>物理傷害<>並<#ef5350ff>暈眩1秒<>。",
        "skill2": "撲向目標，落地時周圍的敵人受到<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%<> + <#ff9028ff>2%<>最大生命<#ff9028ff>物理傷害<>並被<#ef5350ff>擊飛0.4秒<>。",
        "ult": "一躍沖天（期間無法被選取、免疫控制），砸落在敵方英雄身上：目標受到<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> + <#ff9028ff>6%<>最大生命<#ff9028ff>物理傷害<>，周圍的敵人（含目標）再受到<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> + <#ff9028ff>3%<>最大生命<#ff9028ff>物理傷害<>並被<#ef5350ff>擊飛0.8秒<>。"
      }
    },
