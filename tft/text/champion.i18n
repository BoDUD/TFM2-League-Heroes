  "en": {
    "description": {
      "tft_powder": {
        "name": "Powder",
        "attack": "Throws a homemade firecracker for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Ambusher<>: her skill bombs can crit (<#ffb900ff>25%<> chance, double damage).",
        "skill": "Lobs her wind-up monkey bomb at the target's feet: enemies in the blast take <#a974ffff>36<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<> <#a974ffff>magic damage<>, those in the middle take it twice. Everyone hit <#ef5350ff>burns<> for <#ffb900ff>3s<> and is <#ef5350ff>wounded<> for <#ffb900ff>4s<> (healing -40%).",
        "skill2": "When an enemy champion comes close, smashes a flash-smoke bomb: enemies around her take <#a974ffff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<> <#a974ffff>magic damage<> and are <#ef5350ff>blinded<> for <#ffb900ff>1s<> (no basic attacks), and she hops back.",
        "ult": "Lobs the bag with the hex crystal at an enemy champion. After a <#ffb900ff>0.9s<> fuse it bursts in blue: enemies in the blast take <#a974ffff>170<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<> <#a974ffff>magic damage<> and are <#ef5350ff>knocked up<> for <#ffb900ff>0.75s<>."
      },
      "tft_norra": {
        "name": "Norra",
        "attack": "Star bolt: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Beloved Trinkets<>: every <#ffb900ff>10s<> the next ability drops 3 trinkets (<#ffb900ff>4s<>), each flying to the champion stepping on it: <#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>20%<> <#a974ffff>magic damage<> + <#ff9028ff>Threads<>; ability hits on champions cut it 20%. <#ff9028ff>Journey to Nowhere<>: a close enemy champion takes <#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>, is <#ef5350ff>banished<> <#ffb900ff>1.5s<>, then <#ef5350ff>slowed<> 80% <#ffb900ff>0.75s<>.",
        "skill": "Charges, then flings a bolt of memories and hops back: enemies around where it lands take <#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<> <#a974ffff>magic damage<>, champions already in the <#ff9028ff>Threads<> 2% of their max health more, then get them. Hitting a champion primes her trinkets: they fly to any enemy champion coming near.",
        "skill2": "Opens two portals beside the target; <#ffb900ff>0.3s<> later threads shoot between them: enemies there take <#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26%<> <#a974ffff>magic damage<> and get the <#ff9028ff>Threads<>: 15% bigger (easier to hit) for <#ffb900ff>4s<> and <#ef5350ff>slowed<> 20% for <#ffb900ff>2s<>.",
        "ult": "Opens a great rift under an enemy champion: 4 recasts <#ffb900ff>0.5s<> apart, each sending a yarn ball from both ends along a line through an enemy champion: <#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<> <#a974ffff>magic damage<> to every enemy on it, the first champion each ball meets <#ef5350ff>slowed<> 80% for <#ffb900ff>0.5s<>; the 4th deals 40% more."
      },
      "tft_alune": {
        "name": "Alune",
        "attack": "Flings her spiral ring like a disc for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>; it flies back to her, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30%<> physical damage to enemies on the way. <#ff9028ff>Moon Phase<>: each skill she casts grows the moon a phase, up to <#ffb900ff>3<>; her ultimate deals <#ffb900ff>20%<> more a phase, and the moon wanes to new.",
        "skill": "Moonshards rain on the <#ffb900ff>3<> enemies nearest her, each dealing <#a974ffff>42<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>32%<> <#a974ffff>magic damage<> and lowering magic resistance by <#ffb900ff>20%<> for <#ffb900ff>6s<>.",
        "skill2": "Moonlight falls on her and the allied champions near her: <#ffb900ff>36%<> attack speed for <#ffb900ff>5s<>.",
        "ult": "The moon's shadow spreads under an enemy champion; <#ffb900ff>0.75s<> later the full moon crashes down: <#ffb900ff>220%<> of <#a974ffff>165<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>72%<> <#a974ffff>magic damage<> split among the enemies in the area (at most <#ffb900ff>180%<> each), those in the middle <#ef5350ff>stunned<> for <#ffb900ff>0.83s<>."
      },
      "tft_silco": {
        "name": "Silco",
        "attack": "Flings a Shimmer vial for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Dominator<>: each time he spawns he gains a <#a974ffff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>40%<> shield for <#ffb900ff>15s<>; each skill he casts grants <#ffb900ff>10%<> ability power, up to <#ffb900ff>5<> times, lost on death.",
        "skill": "Throws a canister for <#a974ffff>65<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<> <#a974ffff>magic damage<> and lets out <#ffb900ff>2<> monstrosities that pounce on nearby enemies and bite <#ffb900ff>5<> times each for <#a974ffff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>11%<> <#a974ffff>magic damage<>; when their victim falls they leap to the next.",
        "skill2": "Tosses Shimmer to the allied champion with the most attack near him (himself if none): <#ffb900ff>50%<> attack speed and <#ffb900ff>20%<> move speed for <#ffb900ff>4s<>; the comedown then takes <#ffb900ff>8%<> of their current health.",
        "ult": "Throws a giant canister at an enemy champion for <#a974ffff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<> <#a974ffff>magic damage<>, letting out <#ffb900ff>4<> monstrosities and leaving a Shimmer fog for <#ffb900ff>4s<>: enemies in it are <#ef5350ff>slowed<> by <#ffb900ff>30%<> and take <#a974ffff>6<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>4%<> <#a974ffff>magic damage<> a second."
      },
      "tft_maddie": {
        "name": "Maddie",
        "attack": "Fires her rifle for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Sniper<>: she deals more damage the farther the target, up to <#ffb900ff>25%<>; when a Wanted enemy dies she collects a bounty: <#ffb900ff>15%<> attack speed, up to <#ffb900ff>4<> bounties.",
        "skill": "Crouches and fires <#ffb900ff>6<> shots at the farthest enemy in range (champions first); each hits the first enemy in its way for <#ff9028ff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40%<> <#ff9028ff>physical damage<>.",
        "skill2": "Marks the nearby enemy champion with the most health as Wanted for <#ffb900ff>8s<>: it takes <#ffb900ff>15%<> more damage.",
        "ult": "Takes aim, then fires a piercing round at the enemy champion with the lowest share of health: every enemy in its line takes <#ff9028ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<> <#ff9028ff>physical damage<>, up to <#ffb900ff>60%<> more by the share of health it is missing."
      },
      "tft_loris": {
        "name": "Loris",
        "attack": "Bashes with his shield for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Warden<>: the first time each life his health falls under <#ffb900ff>75%<> and under <#ffb900ff>25%<> he gains a shield of <#ffb900ff>12%<> of his maximum health (<#ffb900ff>4s<>).",
        "skill": "Gains a <#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<> shield (<#ffb900ff>4s<>) and charges behind his shield: enemies he runs into take <#a974ffff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<> magic damage and are <#ef5350ff>stunned for 1.5s<>.",
        "skill2": "Leaps to the nearby allied champion with the lowest share of health: both gain a <#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<> shield (<#ffb900ff>4s<>) and he takes <#ffb900ff>30%<> of the damage meant for it.",
        "ult": "Slams his shield into the ground: nearby enemies take <#a974ffff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<> magic damage, are <#ef5350ff>knocked up for 1s<> and <#ef5350ff>taunted for 2s<>; he takes <#ffb900ff>50%<> less damage (<#ffb900ff>4s<>)."
      },
      "tft_kobuko": {
        "name": "Kobuko",
        "attack": "A paw strike for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Second Phase<>: the first time each life his health falls under <#ffb900ff>50%<> he is enraged until he dies: <#ffb900ff>+40%<> attack speed and <#ffb900ff>20%<> life steal.",
        "skill": "Gains a <#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<> shield (<#ffb900ff>4s<>); within <#ffb900ff>4s<> his next attack is a Golden Claw: <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>105%<> + <#ff9028ff>2%<> max health <#ff9028ff>physical damage<> and a <#ef5350ff>1s stun<>.",
        "skill2": "Pounces on the target: on landing, nearby enemies take <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%<> + <#ff9028ff>2%<> max health <#ff9028ff>physical damage<> and are <#ef5350ff>knocked up for 0.4s<>.",
        "ult": "Springs out of sight (untargetable, unstoppable) and crashes down on an enemy champion: it takes <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> + <#ff9028ff>6%<> max health <#ff9028ff>physical damage<>, and nearby enemies (it too) <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> + <#ff9028ff>3%<> max health and are <#ef5350ff>knocked up for 0.8s<>."
      }
    },
