  "ja": {
    "description": {
      "tft_powder": {
        "name": "パウダー",
        "attack": "手作りの爆竹を投げ、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の物理ダメージ。<#ff9028ff>アンブッシャー<>：スキルの爆弾がクリティカルする（<#ffb900ff>25%<>、ダメージ2倍）。",
        "skill": "ぜんまい仕掛けのモンキーボムを対象の足元に投げ、範囲の敵に<#a974ffff>36<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<>の魔法ダメージ、中心はもう一度。当たった敵は<#ffb900ff>3秒<><#ef5350ff>炎上<>、<#ffb900ff>4秒<><#ef5350ff>重傷<>（回復-40%）。",
        "skill2": "敵チャンピオンが近づくと閃光煙幕弾を叩きつけ、周りの敵に<#a974ffff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>の魔法ダメージと<#ffb900ff>1秒<><#ef5350ff>ブラインド<>（通常攻撃不可）、自分は後ろへ跳ぶ。",
        "ult": "ヘクスクリスタル入りの鞄を敵チャンピオンへ投げる。<#ffb900ff>0.9秒<>後に青く大爆発：範囲の敵に<#a974ffff>170<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<>の魔法ダメージと<#ffb900ff>0.75秒<><#ef5350ff>ノックアップ<>。"
      },
      "tft_norra": {
        "name": "ノラ",
        "attack": "星の弾で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>物理ダメージ。<#ff9028ff>愛用のトリンケット<>：<#ffb900ff>10秒<>毎、スキル着弾点に3つ<#ffb900ff>4秒<>、踏んだ敵チャンピオンへ飛び<#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>20%<>魔法ダメージと<#ff9028ff>スレッド<>。スキル命中でCD-20%。<#ff9028ff>どこでもない場所へ<>：密着した敵に<#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>、<#ffb900ff>1.5秒<><#ef5350ff>追放<>後<#ffb900ff>0.75秒<>80%<#ef5350ff>スロウ<>。",
        "skill": "溜めてから記憶の弾を放ち、後ろへ跳ぶ：着弾点の周りの敵に<#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<>魔法ダメージ、<#ff9028ff>スレッド<>付きのチャンピオンには最大体力2%追加、その後スレッド。チャンピオンに当たるとトリンケットが近づく敵へ飛ぶ。",
        "skill2": "対象の両脇に2つのポータルを開き、<#ffb900ff>0.3秒<>後にスレッドが走る：範囲の敵に<#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26%<>の魔法ダメージと<#ff9028ff>スレッド<>：<#ffb900ff>4秒<>間15%大きく（当たりやすい）、<#ffb900ff>2秒<>間20%<#ef5350ff>スロウ<>。",
        "ult": "敵チャンピオンの足元に大きな裂け目を開き、<#ffb900ff>0.5秒<>毎に4回、両端から毛糸玉が敵チャンピオンを通る線を飛ぶ：線上の敵に<#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<>魔法ダメージ、各玉が最初に当たったチャンピオンに<#ffb900ff>0.5秒<>80%<#ef5350ff>スロウ<>、4回目は+40%。"
      },
      "tft_alune": {
        "name": "アルーン",
        "attack": "螺旋の輪を円盤のように投げ、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の物理ダメージ。輪は戻ってきて途中の敵に<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30%<>の物理ダメージ。<#ff9028ff>月相<>：スキルを使うたびに月が満ちる（最大<#ffb900ff>3<>段階）。アルティメットは1段階ごとにダメージ+<#ffb900ff>20%<>、使うと新月に戻る。",
        "skill": "最も近い敵<#ffb900ff>3<>体に月の破片が降り、それぞれ<#a974ffff>42<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>32%<>の魔法ダメージと<#ffb900ff>6秒<>の魔法防御-<#ffb900ff>20%<>。",
        "skill2": "自分と周りの味方チャンピオンに月光が降り、<#ffb900ff>5秒<>間攻撃速度+<#ffb900ff>36%<>。",
        "ult": "敵チャンピオンの足元に月の影が広がり、<#ffb900ff>0.75秒<>後に満月が落ちる：<#a974ffff>165<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>72%<>の魔法ダメージの<#ffb900ff>220%<>を範囲の敵で分け合い（1体あたり最大<#ffb900ff>180%<>）、中心の敵は<#ffb900ff>0.83秒<><#ef5350ff>スタン<>。"
      },
      "tft_silco": {
        "name": "シルコ",
        "attack": "シマーの薬瓶を投げ、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の物理ダメージ。<#ff9028ff>ドミネーター<>：出現するたびに<#a974ffff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>40%<>のシールド（<#ffb900ff>15秒<>）。スキルを使うたびに魔力+<#ffb900ff>10%<>（最大<#ffb900ff>5<>回、倒れると消える）。",
        "skill": "缶を投げて<#a974ffff>65<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<>の魔法ダメージ、怪物<#ffb900ff>2<>体を放つ。怪物は近くの敵に飛びかかり<#ffb900ff>5<>回噛みつき、1回<#a974ffff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>11%<>の魔法ダメージ。噛んだ敵が倒れると次の敵へ跳ぶ。",
        "skill2": "近くで攻撃力が最も高い味方チャンピオン（いなければ自分）にシマーを投げる：<#ffb900ff>4秒<>間攻撃速度+<#ffb900ff>50%<>、移動速度+<#ffb900ff>20%<>。効き目が切れると現在体力の<#ffb900ff>8%<>を失う。",
        "ult": "敵チャンピオンに巨大な缶を投げ、<#a974ffff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>の魔法ダメージ、怪物<#ffb900ff>4<>体と<#ffb900ff>4秒<>のシマーの霧を残す：霧の中の敵は<#ffb900ff>30%<><#ef5350ff>スロウ<>、毎秒<#a974ffff>6<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>4%<>の魔法ダメージ。"
      },
      "tft_maddie": {
        "name": "マディー",
        "attack": "ライフルを撃ち、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の物理ダメージ。<#ff9028ff>スナイパー<>：対象が遠いほどダメージが増える（最大+<#ffb900ff>25%<>）。指名手配の敵が倒れると賞金：攻撃速度+<#ffb900ff>15%<>（最大<#ffb900ff>4<>回）。",
        "skill": "身をかがめ、射程内で最も遠い敵（チャンピオン優先）に<#ffb900ff>6<>発撃つ。1発ごとに射線上の最初の敵に<#ff9028ff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40%<>の物理ダメージ。",
        "skill2": "近くで現在体力が最も高い敵チャンピオンを<#ffb900ff>8秒<>間指名手配：受けるダメージ+<#ffb900ff>15%<>。",
        "ult": "狙いを定め、体力の割合が最も低い敵チャンピオンに貫通弾を撃つ：射線上の全ての敵に<#ff9028ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<>の物理ダメージ、失った体力の割合に応じて最大<#ffb900ff>60%<>増加。"
      },
      "tft_loris": {
        "name": "ロリス",
        "attack": "盾で殴り、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の物理ダメージ。<#ff9028ff>ワーデン<>：ライフごとに初めて体力が<#ffb900ff>75%<>と<#ffb900ff>25%<>を下回ると、それぞれ最大体力の<#ffb900ff>12%<>のシールド（<#ffb900ff>4秒<>）。",
        "skill": "<#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<>のシールド（<#ffb900ff>4秒<>）を得て盾を構えて突進：ぶつかった敵に<#a974ffff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<>の魔法ダメージと<#ef5350ff>1.5秒のスタン<>。",
        "skill2": "近くで体力の割合が最も低い味方チャンピオンへ跳び、2人とも<#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<>のシールド（<#ffb900ff>4秒<>）。その間、その味方が受けるダメージの<#ffb900ff>30%<>を肩代わりする。",
        "ult": "盾を地面に叩きつける：周囲の敵に<#a974ffff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>の魔法ダメージ、<#ef5350ff>1秒のノックアップ<>と<#ef5350ff>2秒の挑発<>。自身の被ダメージ<#ffb900ff>50%<>軽減（<#ffb900ff>4秒<>）。"
      },
      "tft_kobuko": {
        "name": "コブコ",
        "attack": "猫パンチで<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の物理ダメージ。<#ff9028ff>第二形態<>：ライフごとに初めて体力が<#ffb900ff>50%<>を下回ると、倒れるまで激昂：攻撃速度<#ffb900ff>+40%<>、ライフスティール<#ffb900ff>20%<>。",
        "skill": "<#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<>のシールド（<#ffb900ff>4秒<>）。<#ffb900ff>4秒<>以内の次の通常攻撃が金爪の一撃に：<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>105%<> + <#ff9028ff>2%<>最大体力の物理ダメージと<#ef5350ff>1秒のスタン<>。",
        "skill2": "対象に飛びかかり、着地時に周囲の敵へ<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%<> + <#ff9028ff>2%<>最大体力の物理ダメージと<#ef5350ff>0.4秒のノックアップ<>。",
        "ult": "空高く跳び（対象指定不可・CC無効）、敵チャンピオンの上に落下：対象に<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> + <#ff9028ff>6%<>最大体力の物理ダメージ、周囲の敵（対象も）に<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<> + <#ff9028ff>3%<>最大体力の物理ダメージと<#ef5350ff>0.8秒のノックアップ<>。"
      },
      "tft_vander": {
        "name": "ヴァンダー",
        "attack": "拳で殴り、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の物理ダメージ。<#ff9028ff>ウォッチャー<>：被ダメージ<#ffb900ff>10%<>軽減、体力が<#ffb900ff>50%<>より多いと<#ffb900ff>20%<>軽減。",
        "skill": "防御の構え：周囲の敵を<#ef5350ff>0.75秒挑発<>し、物理防御<#ffb900ff>40<>と魔法防御<#ffb900ff>30<>（<#ffb900ff>2.5秒<>）。次の拳は<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>140%<>の物理ダメージ、味方の<#ff9028ff>ファミリー<>1人ごとに<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40%<>追加。",
        "skill2": "敵に突進してアッパー：<#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90%<>の物理ダメージと<#ef5350ff>0.5秒のスタン<>、近くの敵には<#ffb900ff>35%<>のダメージ。",
        "ult": "敵の中へ跳び込み地面を殴る：周囲の敵に<#ff9028ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150%<>の物理ダメージと<#ef5350ff>1秒のノックアップ<>。<#ffb900ff>4秒<>間、被ダメージ<#ffb900ff>15%<>軽減、近くの敵チャンピオン1体ごとに<#ffb900ff>8%<>追加（最大<#ffb900ff>4<>体）。"
      },
      "tft_violet": {
        "name": "ヴァイオレット",
        "attack": "拳で殴り、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の物理ダメージ。<#ff9028ff>ピットファイター<>：命中ごとに<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>5%<>の確定ダメージ追加、オムニヴァンプ<#ffb900ff>10%<>。1回の命につき最初に体力が<#ffb900ff>50%<>を下回ると、<#ffb900ff>2秒<>で最大体力の<#ffb900ff>15%<>回復。",
        "skill": "ジャブ2発でそれぞれ<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50%<>の<#ff9028ff>物理ダメージ<>、続くアッパーで<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<>の物理ダメージと<#ef5350ff>0.5秒のノックアップ<>。",
        "skill2": "敵に突進して殴り飛ばし、<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>の物理ダメージ。",
