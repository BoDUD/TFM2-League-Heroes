{
  "zh-hans": {
    "description": {
      "tft_powder": {
        "name": "爆爆",
        "attack": "扔出自制小鞭炮，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>伏击者<>：技能炸弹可以暴击（<#ffb900ff>25%<>几率，伤害翻倍）。",
        "skill": "把上了发条的猴子炸弹丢到目标脚下，范围内敌人受到<#a974ffff>36<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<>魔法伤害，中心再受一次；被炸到的敌人<#ef5350ff>灼烧<><#ffb900ff>3秒<>，并<#ef5350ff>重伤<><#ffb900ff>4秒<>（受到治疗-40%）。",
        "skill2": "敌方英雄靠近时摔下闪光烟雾弹：周围敌人受到<#a974ffff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>魔法伤害并<#ef5350ff>致盲<><#ffb900ff>1秒<>（无法普攻），自己向后跳开。",
        "ult": "把装着海克斯水晶的包丢向敌方英雄，引线烧完<#ffb900ff>0.9秒<>后蓝光大爆炸：范围内敌人受到<#a974ffff>170<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<>魔法伤害并<#ef5350ff>击飞<><#ffb900ff>0.75秒<>。"
      },
      "tft_norra": {
        "name": "诺拉",
        "attack": "普攻<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>寄情琐物<>：每<#ffb900ff>10秒<>技能落点撒3个琐物<#ffb900ff>4秒<>，飞向踩到的敌方英雄：<#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>20%<>魔法伤害并挂<#ff9028ff>线缕<>；技能命中英雄冷却-20%。<#ff9028ff>奇异旅程<>：贴身的敌人受<#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>魔法伤害，<#ef5350ff>放逐<><#ffb900ff>1.5秒<>后<#ef5350ff>减速<>80%<#ffb900ff>0.75秒<>。",
        "skill": "蓄力后射出回忆魔法弹，自己后退一步：落点周围敌人受到<#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<>魔法伤害，已有<#ff9028ff>线缕<>的英雄再受最大生命2%，随后挂上线缕；打中英雄时地上的琐物待爆：敌方英雄靠近就飞向他。",
        "skill2": "在目标两侧打开两扇门，<#ffb900ff>0.3秒<>后线缕穿过：范围内敌人受到<#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26%<>魔法伤害并挂上<#ff9028ff>线缕<>：<#ffb900ff>4秒<>内体型变大15%（更容易被命中），<#ef5350ff>减速<>20%<#ffb900ff>2秒<>。",
        "ult": "在敌方英雄脚下展开大裂隙，每<#ffb900ff>0.5秒<>一波共4波：两个毛线球沿一条穿过敌方英雄的线从两头对飞，路上敌人各受<#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<>魔法伤害，每个球碰到的第一个英雄<#ef5350ff>减速<>80%<#ffb900ff>0.5秒<>；第4波+40%。"
      },
      "tft_alune": {
        "name": "拉露恩",
        "attack": "把螺旋月环像飞盘一样甩出去，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>。<#ff9028ff>月相<>：每放一次技能月亮长一档，最多<#ffb900ff>3<>档；大招每档伤害+<#ffb900ff>20%<>，砸完回到新月。",
        "skill": "月光碎片从天而降，落在<#ffb900ff>3<>个敌人身上（一个是目标），每枚造成<#a974ffff>42<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>32%<>魔法伤害，并使魔抗降低<#ffb900ff>20%<>，持续<#ffb900ff>6秒<>。",
        "skill2": "月光洒在她和身边的友方英雄身上，攻击速度提高<#ffb900ff>36%<>，持续<#ffb900ff>5秒<>。",
        "ult": "敌方英雄脚下浮现月影，<#ffb900ff>0.75秒<>后满月砸下：范围内的敌人受到<#a974ffff>165<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>72%<>魔法伤害，中心的敌人<#ef5350ff>眩晕<><#ffb900ff>0.83秒<>。"
      }
    },
    "skill_name": {
      "tft_powder": {
        "skill1": "猴子炸弹",
        "skill2": "快跑，爆爆！",
        "ult": "海克斯水晶炸弹"
      },
      "tft_norra": {
        "skill1": "回忆涌现",
        "skill2": "思乡线缕",
        "ult": "传送门欢腾！"
      },
      "tft_alune": {
        "skill1": "月之降临",
        "skill2": "月华",
        "ult": "月曜降临"
      }
    }
  },
  "zh-hant": {
    "description": {
      "tft_powder": {
        "name": "爆爆",
        "attack": "扔出自製小鞭炮，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>伏擊者<>：技能炸彈可以暴擊（<#ffb900ff>25%<>機率，傷害加倍）。",
        "skill": "把上了發條的猴子炸彈丟到目標腳下，範圍內敵人受到<#a974ffff>36<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<>魔法傷害，中心再受一次；被炸到的敵人<#ef5350ff>燃燒<><#ffb900ff>3秒<>，並<#ef5350ff>重傷<><#ffb900ff>4秒<>（受到治療-40%）。",
        "skill2": "敵方英雄靠近時摔下閃光煙霧彈：周圍敵人受到<#a974ffff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>魔法傷害並<#ef5350ff>致盲<><#ffb900ff>1秒<>（無法普攻），自己向後跳開。",
        "ult": "把裝著海克斯水晶的包丟向敵方英雄，引線燒完<#ffb900ff>0.9秒<>後藍光大爆炸：範圍內敵人受到<#a974ffff>170<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<>魔法傷害並<#ef5350ff>擊飛<><#ffb900ff>0.75秒<>。"
      },
      "tft_norra": {
        "name": "諾拉",
        "attack": "普攻<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>心愛飾品<>：每<#ffb900ff>10秒<>技能落點撒3個飾品<#ffb900ff>4秒<>，飛向踩到的敵方英雄：<#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>20%<>魔法傷害並掛<#ff9028ff>絲線<>；技能命中英雄冷卻-20%。<#ff9028ff>茫然旅程<>：貼身的敵人受<#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>魔法傷害，<#ef5350ff>放逐<><#ffb900ff>1.5秒<>後<#ef5350ff>緩速<>80%<#ffb900ff>0.75秒<>。",
        "skill": "蓄力後射出記憶魔法彈，自己後退一步：落點周圍敵人受到<#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<>魔法傷害，已有<#ff9028ff>絲線<>的英雄再受最大生命2%，隨後掛上絲線；打中英雄時地上的飾品待爆：敵方英雄靠近就飛向他。",
        "skill2": "在目標兩側打開兩扇門，<#ffb900ff>0.3秒<>後絲線穿過：範圍內敵人受到<#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26%<>魔法傷害並掛上<#ff9028ff>絲線<>：<#ffb900ff>4秒<>內體型變大15%（更容易被命中），<#ef5350ff>緩速<>20%<#ffb900ff>2秒<>。",
        "ult": "在敵方英雄腳下展開大裂隙，每<#ffb900ff>0.5秒<>一波共4波：兩個毛線球沿一條穿過敵方英雄的線從兩頭對飛，路上敵人各受<#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<>魔法傷害，每個球碰到的第一個英雄<#ef5350ff>緩速<>80%<#ffb900ff>0.5秒<>；第4波+40%。"
      },
      "tft_alune": {
        "name": "亞盧妮",
        "attack": "把螺旋月環像飛盤一樣甩出去，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>。<#ff9028ff>月相<>：每施放一次技能月亮長一階，最多<#ffb900ff>3<>階；大招每階傷害+<#ffb900ff>20%<>，砸完回到新月。",
        "skill": "月華碎片從天而降，落在<#ffb900ff>3<>名敵人身上（一名是目標），每塊造成<#a974ffff>42<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>32%<>魔法傷害，並使魔抗降低<#ffb900ff>20%<>，持續<#ffb900ff>6秒<>。",
        "skill2": "月光灑在她和身邊的友方英雄身上，攻擊速度提高<#ffb900ff>36%<>，持續<#ffb900ff>5秒<>。",
        "ult": "敵方英雄腳下浮現月影，<#ffb900ff>0.75秒<>後滿月砸下：範圍內的敵人受到<#a974ffff>165<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>72%<>魔法傷害，中心的敵人<#ef5350ff>暈眩<><#ffb900ff>0.83秒<>。"
      }
    },
    "skill_name": {
      "tft_powder": {
        "skill1": "猴子炸彈",
        "skill2": "快跑，爆爆！",
        "ult": "海克斯水晶炸彈"
      },
      "tft_norra": {
        "skill1": "記憶湧現",
        "skill2": "返家絲線",
        "ult": "傳送門嘉年華！"
      },
      "tft_alune": {
        "skill1": "月隕",
        "skill2": "月華",
        "ult": "月曜降臨"
      }
    }
  },
  "en": {
    "description": {
      "tft_powder": {
        "name": "Powder",
        "attack": "Throws a homemade firecracker for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Ambusher<>: her skill bombs can crit (<#ffb900ff>25%<> chance, double damage).",
        "skill": "Lobs her wind-up monkey bomb at the target's feet: enemies in the blast take <#a974ffff>36<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<> <#a974ffff>magic damage<>, those in the middle take it twice. Everyone hit <#ef5350ff>burns<> for <#ffb900ff>3s<> and is <#ef5350ff>wounded<> for <#ffb900ff>4s<> (healing -40%).",
        "skill2": "When an enemy champion comes close, smashes a flash-smoke bomb: enemies around her take <#a974ffff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<> <#a974ffff>magic damage<> and are <#ef5350ff>blinded<> for <#ffb900ff>1s<> (no basic attacks), and she hops back.",
        "ult": "Lobs the bag with the hex crystal at an enemy champion. After a <#ffb900ff>0.9s<> fuse it bursts in blue: enemies in the blast take <#a974ffff>170<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<> <#a974ffff>magic damage<> and are <#ef5350ff>knocked up<> for <#ffb900ff>0.75s<>."
      },
      "tft_norra": {
        "name": "Norra",
        "attack": "Star bolt: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Beloved Trinkets<>: every <#ffb900ff>10s<> the next ability drops 3 trinkets (<#ffb900ff>4s<>), each flying to the champion stepping on it: <#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>20%<> <#a974ffff>magic damage<> + <#ff9028ff>Threads<>; ability hits on champions cut it 20%. <#ff9028ff>Journey to Nowhere<>: a close enemy champion takes <#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>, is <#ef5350ff>banished<> <#ffb900ff>1.5s<>, then <#ef5350ff>slowed<> 80% <#ffb900ff>0.75s<>.",
        "skill": "Charges, then flings a bolt of memories and hops back: enemies around where it lands take <#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<> <#a974ffff>magic damage<>, champions already in the <#ff9028ff>Threads<> 2% of their max health more, then get them. Hitting a champion primes her trinkets: they fly to any enemy champion coming near.",
        "skill2": "Opens two portals beside the target; <#ffb900ff>0.3s<> later threads shoot between them: enemies there take <#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26%<> <#a974ffff>magic damage<> and get the <#ff9028ff>Threads<>: 15% bigger (easier to hit) for <#ffb900ff>4s<> and <#ef5350ff>slowed<> 20% for <#ffb900ff>2s<>.",
        "ult": "Opens a great rift under an enemy champion: 4 recasts <#ffb900ff>0.5s<> apart, each sending a yarn ball from both ends along a line through an enemy champion: <#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<> <#a974ffff>magic damage<> to every enemy on it, the first champion each ball meets <#ef5350ff>slowed<> 80% for <#ffb900ff>0.5s<>; the 4th deals 40% more."
      },
      "tft_alune": {
        "name": "Alune",
        "attack": "Flings her spiral ring like a disc for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> <#ff9028ff>physical damage<>. <#ff9028ff>Moon Phase<>: each skill she casts grows the moon a phase, up to <#ffb900ff>3<>; her ultimate deals <#ffb900ff>20%<> more a phase, and the moon wanes to new.",
        "skill": "Moonshards rain on <#ffb900ff>3<> enemies (one of them the target), each dealing <#a974ffff>42<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>32%<> <#a974ffff>magic damage<> and lowering magic resistance by <#ffb900ff>20%<> for <#ffb900ff>6s<>.",
        "skill2": "Moonlight falls on her and the allied champions near her: <#ffb900ff>36%<> attack speed for <#ffb900ff>5s<>.",
        "ult": "The moon's shadow spreads under an enemy champion; <#ffb900ff>0.75s<> later the full moon crashes down: enemies in the area take <#a974ffff>165<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>72%<> <#a974ffff>magic damage<>, those in the middle are <#ef5350ff>stunned<> for <#ffb900ff>0.83s<>."
      }
    },
    "skill_name": {
      "tft_powder": {
        "skill1": "Monkey Bomb",
        "skill2": "Run, Powder!",
        "ult": "Hex Crystal Bomb"
      },
      "tft_norra": {
        "skill1": "Memory Surge",
        "skill2": "Threads of Homecoming",
        "ult": "Portalpalooza!"
      },
      "tft_alune": {
        "skill1": "Moonfall",
        "skill2": "Moonlight",
        "ult": "Moon Descends"
      }
    }
  },
  "ko": {
    "description": {
      "tft_powder": {
        "name": "파우더",
        "attack": "직접 만든 폭죽을 던져 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>매복자<>: 스킬 폭탄이 치명타로 터질 수 있다(<#ffb900ff>25%<>, 피해 2배).",
        "skill": "태엽 원숭이 폭탄을 대상의 발밑에 던져 폭발 범위의 적에게 <#a974ffff>36<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<> 마법 피해, 중심은 한 번 더. 맞은 적은 <#ffb900ff>3초<> <#ef5350ff>불태움<>, <#ffb900ff>4초<> <#ef5350ff>상처<>(받는 회복 -40%).",
        "skill2": "적 챔피언이 다가오면 섬광 연막탄을 터뜨려 주변 적에게 <#a974ffff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<> 마법 피해와 <#ffb900ff>1초<> <#ef5350ff>실명<>(기본 공격 불가), 자신은 뒤로 뛴다.",
        "ult": "마법공학 수정이 든 가방을 적 챔피언에게 던진다. <#ffb900ff>0.9초<> 뒤 푸른 폭발: 범위의 적에게 <#a974ffff>170<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<> 마법 피해와 <#ffb900ff>0.75초<> <#ef5350ff>공중에 띄움<>."
      },
      "tft_norra": {
        "name": "노라",
        "attack": "별빛 탄환 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>소중한 장신구<>: <#ffb900ff>10초<>마다 스킬 착지점에 장신구 3개(<#ffb900ff>4초<>), 밟은 적에게 날아가 <#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>20%<> 마법 피해와 <#ff9028ff>실타래<>. 스킬이 챔피언 적중 시 대기시간 -20%. <#ff9028ff>미지로의 여정<>: 붙은 적 챔피언에게 <#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<> 마법 피해, <#ffb900ff>1.5초<> <#ef5350ff>추방<> 뒤 <#ffb900ff>0.75초<> 80% <#ef5350ff>둔화<>.",
        "skill": "충전 후 기억의 탄환을 날리고 뒤로 물러난다: 떨어진 곳 주변 적에게 <#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>28%<> 마법 피해, <#ff9028ff>실타래<>가 있던 챔피언은 최대 체력 2% 추가 후 실타래. 챔피언에게 맞으면 장신구가 가까이 온 적 챔피언에게 날아간다.",
        "skill2": "대상 양옆에 차원문 두 개를 열고 <#ffb900ff>0.3초<> 뒤 실타래가 지나간다: 범위의 적에게 <#a974ffff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26%<> 마법 피해와 <#ff9028ff>실타래<>: <#ffb900ff>4초<> 동안 15% 커지고(맞히기 쉬움) <#ffb900ff>2초<> 동안 20% <#ef5350ff>둔화<>.",
        "ult": "적 챔피언 발밑에 큰 균열을 열고 <#ffb900ff>0.5초<>마다 4번: 양 끝에서 털실 뭉치가 적 챔피언을 지나는 선을 따라 날아가 선 위의 적에게 <#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<> 마법 피해, 각 뭉치에 처음 맞은 챔피언은 <#ffb900ff>0.5초<> 80% <#ef5350ff>둔화<>, 4번째는 +40%."
      },
      "tft_alune": {
        "name": "알룬",
        "attack": "나선 고리를 원반처럼 던져 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> 물리 피해. <#ff9028ff>달의 위상<>: 스킬을 쓸 때마다 달이 한 단계 차오른다(최대 <#ffb900ff>3<>단계). 궁극기는 단계마다 피해 +<#ffb900ff>20%<>, 쓴 뒤 다시 초승달.",
        "skill": "달조각이 적 <#ffb900ff>3<>명(하나는 대상)에게 떨어져 각각 <#a974ffff>42<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>32%<> 마법 피해를 입히고 <#ffb900ff>6초<> 동안 마법 저항력을 <#ffb900ff>20%<> 낮춘다.",
        "skill2": "자신과 주변 아군 챔피언에게 달빛이 내려 <#ffb900ff>5초<> 동안 공격 속도 +<#ffb900ff>36%<>.",
        "ult": "적 챔피언의 발밑에 달그림자가 드리우고 <#ffb900ff>0.75초<> 뒤 보름달이 떨어진다: 범위의 적에게 <#a974ffff>165<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>72%<> 마법 피해, 중심의 적은 <#ffb900ff>0.83초<> <#ef5350ff>기절<>."
      }
    },
    "skill_name": {
