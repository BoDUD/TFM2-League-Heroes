{
  "zh-hans": {
    "description": {
      "league_garen": {
        "name": "盖伦",
        "attack": "普攻造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻击力<>的<#ff9028ff>物理伤害<>。",
        "skill": "<#ff9028ff>致命打击<>：盖伦获得<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>35% 移动速度<>，持续<#ffb900ff>1.5秒<>。<#ffb900ff>4.5秒<>内的下一次普攻变为跃起重击，造成<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150% 攻击力<>的<#ff9028ff>物理伤害<>并<#ef5350ff>沉默<>目标<#ffb900ff>1.5秒<>。同时获得<#ff9028ff>勇气<>：<#ffb900ff>2秒<>内受到的伤害降低<#ffb900ff>30%<>、韧性提高<#ffb900ff>60%<>，并获得<#e8d44dff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50% 攻击力<>的<#e8d44dff>护盾<>。",
        "skill2": "<#ff9028ff>审判<>：盖伦挥剑旋转<#ffb900ff>3秒<>，边转边走向身边的敌人（贴身的英雄优先，不会远距离扑人），共转<#ffb900ff>7<>圈，每圈对周围敌人造成<#ff9028ff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>55% 攻击力<>的<#ff9028ff>物理伤害<>，他走向的那个敌人每圈多受<#ffb900ff>25%<>。第<#ffb900ff>7<>圈命中的敌人<i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>护甲<>降低<#ffb900ff>25%<>，持续<#ffb900ff>6秒<>。被动 <#ff9028ff>坚韧<>：盖伦拥有很高的<#6aff55ff>生命回复<>。",
        "ult": "<#ff9028ff>德玛西亚正义<>：召唤巨剑从天而降，对目标敌方英雄造成<#f5f5f5ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120% 攻击力<> + <#f5f5f5ff>12% 目标最大生命值<>的<#f5f5f5ff>真实伤害<>。"
      },
      "league_ashe": {
        "name": "艾希",
        "attack": "普攻射出冰霜箭，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻击力<>的<#ff9028ff>物理伤害<>。被动 <#ff9028ff>冰霜射击<>：普攻使目标<#ef5350ff>减速<><#ffb900ff>20%<>，持续<#ffb900ff>1秒<>。",
        "skill": "<#ff9028ff>射手的专注<>：艾希获得<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>30% 攻击速度<>，持续<#ffb900ff>4秒<>。期间普攻变为连射，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130% 攻击力<>的<#ff9028ff>物理伤害<>，并使目标<#ef5350ff>减速<><#ffb900ff>30%<>。",
        "skill2": "<#ff9028ff>万箭齐发<>：向前方扇形射出<#ffb900ff>13<>支冰霜箭，对扇形内每个敌人造成<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻击力<>的<#ff9028ff>物理伤害<>（每个敌人只会被命中一次），并使其<#ef5350ff>减速<><#ffb900ff>25%<>，持续<#ffb900ff>1.5秒<>。",
        "ult": "<#ff9028ff>魔法水晶箭<>：向目标方向射出一支飞得很远的水晶箭，命中第一个敌方英雄，造成<#ff9028ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻击力<>的<#ff9028ff>物理伤害<>并<#ef5350ff>眩晕<><#ffb900ff>1.75秒<>。水晶箭在命中处炸开，对周围敌人造成<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50% 攻击力<>的<#ff9028ff>物理伤害<>并<#ef5350ff>减速<><#ffb900ff>50%<>，持续<#ffb900ff>2秒<>。"
      },
      "league_lux": {
        "name": "拉克丝",
        "attack": "普攻从法杖射出光弹，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻击力<>的<#ff9028ff>物理伤害<>。被动 <#ff9028ff>光芒四射<>：技能命中敌人后<#ffb900ff>5秒<>内，下一次普攻引爆光芒，额外造成<#a974ffff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>35% 法术强度<>的<#a974ffff>魔法伤害<>。",
        "skill": "<#ff9028ff>光之束缚<>：向前方射出一颗光球，对路径上的每个敌人造成<#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>75% 法术强度<>的<#a974ffff>魔法伤害<>并<#ef5350ff>禁锢<><#ffb900ff>1.5秒<>。同时施放 <#ff9028ff>曲光屏障<>：拉克丝和身边的友方英雄获得<#e8d44dff>55<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>40% 法术强度<>的<#e8d44dff>护盾<>，持续<#ffb900ff>2.5秒<>。",
        "skill2": "<#ff9028ff>透光奇点<>：向目标位置抛出光球，落地后形成光圈，使圈内敌人<#ef5350ff>减速<><#ffb900ff>20%<>。<#ffb900ff>1秒<>后光圈引爆，对圈内敌人造成<#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80% 法术强度<>的<#a974ffff>魔法伤害<>。",
        "ult": "<#ff9028ff>终极闪光<>：拉克丝跃起蓄力，<#ffb900ff>0.5秒<>后向目标方向发射一道极长的激光，对直线上所有敌人造成<#a974ffff>250<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>115% 法术强度<>的<#a974ffff>魔法伤害<>。"
      },
      "league_leesin": {
        "name": "李青",
        "attack": "普攻出拳，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻击力<>的<#ff9028ff>物理伤害<>。被动 <#ff9028ff>疾风骤雨<>：每次施放技能后，<#ffb900ff>3秒<>内的接下来<#ffb900ff>2<>次普攻获得<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>40% 攻击速度<>。<#ff9028ff>金钟罩<>：友方英雄被控制或被敌方英雄近身时，李青冲到他身边，两人各获得<#e8d44dff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80% 攻击力<>的<#e8d44dff>护盾<>，持续<#ffb900ff>2秒<>，每<#ffb900ff>12秒<>一次。",
        "skill": "<#ff9028ff>天音波<>：向前方打出一道音波，对第一个命中的敌人造成<#ff9028ff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>65% 攻击力<>的<#ff9028ff>物理伤害<>并留下印记。<#ff9028ff>回音击<>：<#ffb900ff>0.2秒<>后李青自动飞踢冲到被印记的敌人身边，再造成<#ff9028ff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70% 攻击力<>的<#ff9028ff>物理伤害<>。",
        "skill2": "<#ff9028ff>天雷破<>：李青跃起重击地面，对周围敌人造成<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80% 攻击力<>的<#ff9028ff>物理伤害<>；<#ff9028ff>摧筋断骨<>：命中的敌人被<#ef5350ff>减速<><#ffb900ff>40%<>，持续<#ffb900ff>2秒<>。<#ff9028ff>铁布衫<>：李青获得<#6aff55ff>20% 吸血<>，持续<#ffb900ff>3秒<>。<#ff9028ff>连招<>：回音击落到英雄身边后<#ffb900ff>2.5秒<>内施放，先出一拳（<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻击力<>）。",
        "ult": "<#ff9028ff>猛龙摆尾<>：把目标正面踢进身后的敌方英雄，身后没人则绕后<#ef5350ff>踢回<>己方：<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130% 攻击力<>的<#ff9028ff>物理伤害<>，它撞到的敌人受到<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<>伤害并<#ef5350ff>击飞<><#ffb900ff>0.75秒<>。<#ff9028ff>连招<>：天音波冷却中则飞踢追击（<#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<>），否则接追踪的天音波和回音击。"
      },
      "league_soraka": {
        "name": "索拉卡",
        "attack": "普攻用法杖射出星光弹，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻击力<>的<#ff9028ff>物理伤害<>。",
        "skill": "造成<#a974ffff>70<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%法术强度<>的<#a974ffff>魔法伤害<>并<#ef5350ff>减速30%<>，命中敌方英雄时获得<#ff9028ff>活力焕发<>：<#ffb900ff>2.5秒<>内回复<#6aff55ff>75<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%法术强度<>的<#6aff55ff>生命值<>并加速20%。每<#ffb900ff>16秒<>一次附带<#ff9028ff>星体结界<>：<#ef5350ff>沉默<>圈内敌人，<#ffb900ff>1.5秒<>后仍在圈内的<#ef5350ff>禁锢1秒<>并受到<#a974ffff>40<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%法术强度<>的<#a974ffff>魔法伤害<>。",
        "skill2": "消耗自身<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>6%最大生命值<>（不会致死），为一名其他友方英雄回复<#6aff55ff>200<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%法术强度<>的<#6aff55ff>生命值<>。带<#ff9028ff>活力焕发<>时不消耗生命值，目标也获得<#ff9028ff>活力焕发<>。被动<#ff9028ff>拯救<>：施放后<#ffb900ff>2秒<>内<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移动速度提高30%<>。",
        "ult": "<#ff9028ff>祈愿<>：为全图所有友方英雄（包括自己）回复<#6aff55ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60% 法术强度<>的<#6aff55ff>生命值<>。"
      },
      "league_darius": {
        "name": "德莱厄斯",
        "attack": "普攻挥斧劈砍，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻击力<>的<#ff9028ff>物理伤害<>。被动 <#ff9028ff>出血<>：普攻和<#ff9028ff>大杀四方<>命中的敌人流血<#ffb900ff>5秒<>，共受到<#ff9028ff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>20% 攻击力<>的<#ff9028ff>物理伤害<>，可叠加。德莱厄斯<#ffb900ff>5秒<>内命中敌方英雄<#ffb900ff>5<>次后获得<#ff9028ff>诺克萨斯之力<>：<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻击力<>提高<#ffb900ff>40%<>，持续<#ffb900ff>5秒<>。",
        "skill": "<#ff9028ff>大杀四方<>：德莱厄斯举斧蓄力后挥舞一圈，对周围敌人造成<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110% 攻击力<>的<#ff9028ff>物理伤害<>并施加<#ff9028ff>出血<>。每命中一名敌方英雄，回复<#6aff55ff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30% 攻击力<>的<#6aff55ff>生命值<>。",
        "skill2": "<#ff9028ff>无情铁手<>：德莱厄斯用斧钩扫过前方扇形区域，把其中的敌人全部<#ef5350ff>拉<>到身边并<#ef5350ff>减速<><#ffb900ff>40%<>，持续<#ffb900ff>1秒<>。之后<#ffb900ff>4秒<>内的下一次普攻变为<#ff9028ff>致残打击<>：造成<#ff9028ff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150% 攻击力<>的<#ff9028ff>物理伤害<>并<#ef5350ff>减速<><#ffb900ff>90%<>，持续<#ffb900ff>1秒<>。",
        "ult": "<#ff9028ff>诺克萨斯断头台<>：德莱厄斯跃向一名敌方英雄猛力劈下，造成<#f5f5f5ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻击力<>的<#f5f5f5ff>真实伤害<>。<#ffb900ff>5秒<>内每命中敌方英雄一次，伤害提高<#ffb900ff>20%<>；处于<#ff9028ff>诺克萨斯之力<>时伤害翻倍。"
      },
