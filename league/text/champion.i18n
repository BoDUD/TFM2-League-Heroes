      "league_olaf": {
        "name": "奥拉夫",
        "attack": "<#ff9028ff>狂战之怒<>：越挨打攻速越高（每层+20%，共4层），最高两层吸血12%。<#ff9028ff>挺过去<>（自动，<#ffb900ff>13秒<>）：交战时攻速+40%并获得护盾。<#ff9028ff>诸神黄昏<>被动：护甲、魔抗+12。",
        "skill": "向目标所在处掷斧，沿途造成<#ff9028ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>伤害，<#ef5350ff>减速30%<>、护甲-20%。斧头插地<#ffb900ff>5秒<>，走过去捡起则冷却大幅缩短。",
        "skill2": "鲁莽挥击，造成<#f5f5f5ff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#f5f5f5ff>90%<><#f5f5f5ff>真实伤害<>，自己承受其中30%；击杀则返还。",
        "ult": "<#ef5350ff>免疫控制<>，攻击力+30%、移速+20%，持续<#ffb900ff>3秒<>；攻击英雄时延续（最多<#ffb900ff>10秒<>）。"
      },
      "league_karma": {
        "name": "卡尔玛",
        "attack": "射出灵能飞弹。<#ff9028ff>聚能之炎<>：技能命中英雄，梵咒冷却最多缩短<#ffb900ff>60%<>。<#ff9028ff>鼓舞<>（自动，<#ffb900ff>9秒<>）：给被控或交战中的队友（或自己）<#9fd8ffff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#9fd8ffff>50%<><#9fd8ffff>护盾<>，移速+<#ffb900ff>35%<>。",
        "skill": "射出灵火，命中首个敌人爆炸，周围敌人受到<#a974ffff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<><#a974ffff>魔法伤害<>并<#ef5350ff>减速35%<>。<#ff9028ff>灵光闪耀<>（梵咒）：额外<#a974ffff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>伤害并留下火环，<#ffb900ff>1.5秒<>后爆发造成<#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<>伤害、<#ef5350ff>减速50%<>。",
        "skill2": "连住敌方英雄，造成<#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>40%<><#a974ffff>魔法伤害<>；<#ffb900ff>1.33秒<>未挣脱则再次受伤并<#ef5350ff>禁锢1.67秒<>。<#ff9028ff>焕发<>（梵咒，被围攻时）：回复<#7cfc00ff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#7cfc00ff>40%<>生命，<#ef5350ff>禁锢2.33秒<>。<#ff9028ff>连招<>：禁锢时梵咒Q随即跟上。",
        "ult": "强化<#ffb900ff>6秒<>内的下一个技能：队友危险时立即<#ff9028ff>蔑视<>（附近队友都获得<#9fd8ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#9fd8ffff>30%<><#9fd8ffff>护盾<>和加速），否则强化Q或被围攻时的W。未使用则返还冷却。"
      },
      "league_hecarim": {
        "name": "赫卡里姆",
        "attack": "挥戟攻击。<#ff9028ff>征战之路<>：冲锋时攻击力提升。<#ff9028ff>恐惧之灵<>（自动，<#ffb900ff>14秒<>）：放Q、E、R时身边有敌方英雄就开启，<#ffb900ff>4秒<>内双抗+20，每秒对周围敌人造成<#a974ffff>14魔法伤害<>，每命中一个回复<#66bb6aff>12<>生命。",
        "skill": "回旋横扫，周围敌人受到<#ff9028ff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>85%<>伤害。命中后获得一层<#ff9028ff>暴走<>（最多2层，<#ffb900ff>8秒<>），每层伤害+20%。刷野叠的层数可以带进团战。",
        "skill2": "冲向目标，冲得越久伤害越高（最多200%），造成<#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<>伤害并<#ef5350ff>击退<>，之后移速+25%。",
        "ult": "带幽灵骑兵冲向敌方英雄，沿途敌人受到<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>伤害；落地使周围敌人<#ef5350ff>恐惧0.75秒<>（冲得远<#ef5350ff>1.33秒<>），顺势<#ff9028ff>暴走<>一圈并开启<#ff9028ff>恐惧之灵<>。"
      },
      "league_talon": {
        "name": "泰隆",
        "attack": "腕刃攻击。<#ff9028ff>刀锋之末<>：技能命中英雄叠一层伤口，叠满3层后下次普攻使其<#ff9028ff>流血<>，<#ffb900ff>2秒<>内受到<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<>伤害。<#ff9028ff>刺客之道<>（自动，<#ffb900ff>10秒<>）：收刀或Q击杀时身边有2名敌方英雄，就翻身跃开并加速。",
        "skill": "扇形掷出飞刀造成<#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40%<>伤害，随后飞刀收回，造成<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%<>伤害并<#ef5350ff>减速40%<>。",
        "skill2": "跃向目标造成<#ff9028ff>48<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>伤害；目标就在身边时改为原地捅刺，造成150%暴击伤害。击杀目标回复<#66bb6aff>60<>生命并返还冷却。",
        "ult": "向四周甩出一圈飞刀造成<#ff9028ff>55<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>75%<>伤害，随后<#ff9028ff>隐身<><#ffb900ff>2.5秒<>、移速+40%；隐身结束或攻击时飞刀收回，再次造成同样伤害。"
      },
      "league_draven": {
        "name": "德莱文",
        "attack": "<#ff9028ff>德莱文联盟<>：每接住一把斧头+1层崇拜（最多6层，每层攻击+4），用斧头击杀英雄时兑现：每层回复25生命，攻速+30%<#ffb900ff>4秒<>。<#ff9028ff>血性冲刺<>（自动，<#ffb900ff>12秒<>）：对英雄出手时移速+40%、攻速+35%，接住斧头即刷新。",
        "skill": "手中转起一把飞斧（最多2把），下次攻击额外造成<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>55%<>伤害。斧头弹回空中，<#ffb900ff>0.4秒<>后落在他身边随机一处，他会跑进落点圈接住，继续旋转。",
        "skill2": "掷出一对贯穿的斧刃，造成<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50%<>伤害，<#ef5350ff>击退<>敌人并<#ef5350ff>减速30%<><#ffb900ff>2秒<>。",
        "ult": "向远处交战中的英雄掷出两把宽大的巨斧，飞得很远，贯穿路上的敌人造成<#ff9028ff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<>伤害；碰到第一个英雄（或飞到尽头）后折返，回程再造成一次伤害。"
      },
      "league_senna": {
        "name": "赛娜",
        "attack": "<#ff9028ff>赦除<>：技能和普攻标记敌方英雄，下次普攻吸走：额外3%最大生命伤害+1层黑雾；每<#ffb900ff>6秒<>一次普攻和击杀英雄也+1层。每层攻击+1、射程略增，每2层暴击+1%（死亡清空）。<#ff9028ff>黑雾咒附<>（自动）：英雄贴近时，她和身边队友隐身<#ffb900ff>4秒<>、移速+20%。",
        "skill": "遗物炮射出穿透目标的暗影光束：直线上的敌人受到<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50%<>物理伤害并<#ef5350ff>减速20%<><#ffb900ff>1.25秒<>，队友英雄回复<#7cfc00ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#7cfc00ff>35%<>生命。",
        "skill2": "射出黑雾，附着在首个命中的敌人身上并造成<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<>物理伤害；<#ffb900ff>1秒<>后黑雾扩散，<#ef5350ff>禁锢<>它和周围的敌人<#ffb900ff>1.5秒<>。",
        "ult": "蓄力后朝远方交战中的英雄射出横贯战场的光束：中心对敌方英雄造成<#ff9028ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>75%<>物理伤害，两侧宽阔的光芒给她和沿途队友英雄<#9fd8ffff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#9fd8ffff>40%护盾<><#ffb900ff>3秒<>。"
      },
      "league_shen": {
        "name": "慎",
        "attack": "<#ff9028ff>忍法！气合盾<>：施放技能后获得<#ffb900ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ffb900ff>40%<>护盾<#ffb900ff>2秒<>（<#ffb900ff>8秒<>一次，技能命中英雄则缩短）。强化普攻额外25伤害，对英雄再加其最大生命4%（刀穿过英雄则6%、攻速+50%）。",
        "skill": "召回灵魂之刃，从目标身后飞回，沿途造成<#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<>伤害并<#ef5350ff>减速25%<>，之后3次普攻强化。刀回手时附近有敌方英雄则施放<#ff9028ff>奥义！魂佑<>：<#ffb900ff>1.75秒<>内区域中的友方英雄不受普攻伤害（<#ffb900ff>15秒<>冷却）。",
        "skill2": "向前突进，沿途敌人受到<#ff9028ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<>伤害并被<#ef5350ff>嘲讽1.17秒<>。嘲讽到英雄且暮临就绪时，灵魂之刃从突进起点飞回、穿过他们。",
        "ult": "全图有友方英雄被控，或与敌方英雄缠斗且离慎较远时：给他<#ffb900ff>260<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ffb900ff>60%<>护盾<#ffb900ff>5秒<>，慎引导<#ffb900ff>2.5秒<>后传送到他身边（被控则中断）。"
      },
      "league_syndra": {
        "name": "辛德拉",
        "attack": "被动<#ff9028ff>卓尔不凡<>：<#ffb900ff>3<>级Q对英雄伤害+25%，<#ffb900ff>5<>级W附带<#ffffffff>20%真实伤害<>，<#ffb900ff>7<>级E范围更大，<#ffb900ff>9<>级R的法球无视魔抗。",
        "skill": "召唤暗黑法球，对周围敌人造成<#a974ffff>62<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>52%<><#a974ffff>魔法伤害<>。法球留在原地<#ffb900ff>6秒<>。",
        "skill2": "先用<#ff9028ff>驱使念力<>把法球掷向敌方英雄，造成<#a974ffff>55<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>55%<><#a974ffff>魔法伤害<>并<#ef5350ff>减速30%<>。再锥形击退敌人，造成<#a974ffff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<><#a974ffff>魔法伤害<>，被推开的法球使附近敌人<#ef5350ff>晕眩1.25秒<>。",
        "ult": "向一名敌方英雄发射<#ffb900ff>3颗+场上法球数<>（最多7颗），每颗造成<#a974ffff>52<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>18%<><#a974ffff>魔法伤害<>。"
      },
      "league_viego": {
        "name": "佛耶戈",
        "attack": "<#ff9028ff>君命已决<>：他伤过的敌方英雄3秒内阵亡则附身其灵魂<#ffb900ff>10秒<>：<#ef5350ff>1秒无敌<>，回复<#ffb900ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ffb900ff>50%<>，攻击+20%、攻速+30%、移速+15%，Q、W冷却减半。普攻附加英雄最大生命2%。",
        "skill": "向前刺出，造成<#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%<>伤害。刺中的英雄被标记<#ffb900ff>4秒<>，下次普攻对其斩两下：再造成<#ff9028ff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<>伤害并回复<#ffb900ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ffb900ff>30%<>。",
        "skill2": "<#ff9028ff>茫茫焦土<>：黑雾升起，<#ffb900ff>5秒<>内移速+30%、攻速+40%，站在黑雾里（留2.5秒）时隐身。随后冲刺并吐出亡魂，第一个被击中的敌人受到<#ff9028ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%<>伤害并<#ef5350ff>眩晕1.1秒<>。",
        "ult": "跃向队伍正在交手的敌方英雄并<#ef5350ff>减速99%<>，落地刺穿它，造成<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<>+其最大生命12%伤害，击退周围其他敌人。结束附身。"
      },
      "league_zeri": {
        "name": "泽丽",
        "attack": "普攻<#ff9028ff>电火迸射<>：7发连射打第一个敌人。被动<#ff9028ff>内能迁转<>：每<#ffb900ff>5<>次攻击充满电，下一击为电击弹，额外造成<#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>100%<><#a974ffff>魔法伤害<>并<#ef5350ff>减速<>，命中英雄再造成<#ffffffff>4%最大生命真实伤害<>，自己获得护盾和移速。",
        "skill": "发射电脉冲，对第一个敌人造成<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<><#ff9028ff>物理伤害<>并<#ef5350ff>减速35%<>。先打中小兵或野怪时，从那里化为长激光，伤害并减速身后所有敌人。",
        "skill2": "短距冲刺（被贴身时后撤），之后<#ffb900ff>5秒<>普攻贯穿：后面的敌人受到80%伤害，并额外造成<#a974ffff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<><#a974ffff>魔法伤害<>。命中英雄缩短冷却。",
        "ult": "电新星对周围敌人造成<#a974ffff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>100%<><#a974ffff>魔法伤害<>，超载<#ffb900ff>5秒<>：攻速+30%、移速+20%，命中英雄叠加移速并延长；普攻变为三连发，在敌人间连锁闪电。"
