      "league_qiyana": {
        "name": "キヤナ",
        "attack": "リングで攻撃。<#ff9028ff>女帝の威風<>：<#ffb900ff>4秒<>ごとの最初の命中が<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50%<>の物理ダメージを追加。武器にエレメントがある間、攻撃速度+25%、攻撃が<#a974ffff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#a974ffff>25%<>の魔法ダメージを追加。",
        "skill": "リングで前方を薙ぎ<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<>の物理ダメージ。エレメントを消費：川は<#ffb900ff>0.5秒<><#ef5350ff>スネア<>後25%スロウ、岩は<#ff9028ff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40%<>追加、草むらは<#ffb900ff>2.5秒<>迷彩と移動速度+25%。",
        "skill2": "敵へ突進し<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%<>の物理ダメージ。<#ff9028ff>大地の力<>：武器にエレメントを宿し（草むら・川・岩の順）、イシュタルの切先を再使用可能に。",
        "ult": "リングを振るって衝撃波を放ち、道中の敵に<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<>の物理ダメージと<#ef5350ff>ノックバック<>、<#ffb900ff>0.9秒<>の<#ef5350ff>スタン<>。"
      },
      "league_hwei": {
        "name": "フェイ",
        "attack": "筆で墨を飛ばす。<#ff9028ff>夢想家の銘<>：スキルが当たった英雄に<#ffb900ff>4秒<>以内に再び当てると爆発し<#a974ffff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>35%<>の魔法ダメージ。<#ff9028ff>題材: 静謐<>：厄災で移動速度+25%、苦悩で自身と周囲の味方に<#66bb6aff>シールド<><#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>35%<>。",
        "skill": "状況で描き分ける：行動妨害中の英雄に<#ff9028ff>断ち切る稲妻<><#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<>＋<#a974ffff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<>、なければ英雄へ<#ff9028ff>荒廃の炎<><#a974ffff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<>＋最大体力の3%、英雄がいなければ<#ff9028ff>沸き立つ大地<>で燃やし35%スロウ。すべて魔法ダメージ。",
        "skill2": "状況で描き分ける：密着した英雄を<#ff9028ff>恐怖の形相<>で<#ffb900ff>1秒<><#ef5350ff>恐怖<>、それ以外は<#ff9028ff>深淵の眼差し<>（<#ffb900ff>1.3秒<><#ef5350ff>スネア<>）と<#ff9028ff>粉砕の牙<>（噛みつき45%スロウ）を交互に。各<#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<>の魔法ダメージ。",
        "ult": "英雄へ絵の具を放ち、足元に絵画を<#ffb900ff>3秒<>広げて燃やし25%スロウ、最後に爆発して<#a974ffff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>100%<>の魔法ダメージ。"
      },
      "league_ivern": {
        "name": "アイバーン",
        "attack": "種を投げる。<#ff9028ff>シゲミヅクリ<>：タネバクダンのたびに足元へ茂みが<#ffb900ff>4秒<>生え、中の味方は攻撃力+15%、自身の通常攻撃は<#a974ffff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<>の魔法ダメージを追加。",
        "skill": "そばの味方（いなければ自身）に種を植える：<#66bb6aff>シールド<><#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<>、<#ffb900ff>2秒<>後に弾けて周囲の敵に<#a974ffff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<>の魔法ダメージと50%スロウ。",
        "skill2": "ツタを振るい<#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<>の魔法ダメージと<#ffb900ff>1.25秒<><#ef5350ff>スネア<>。そばの味方は移動速度+35%で駆けつける。",
        "ult": "<#ff9028ff>デイジー<>を敵英雄の上に呼び<#ef5350ff>ノックアップ<>と<#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>40%<>の魔法ダメージ、その後<#ffb900ff>8秒<>毎秒パンチ<#a974ffff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>20%<>、3発ごとに叩きつけて<#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>追加と<#ef5350ff>ノックアップ<>。"
      },
      "league_illaoi": {
        "name": "イラオイ",
        "attack": "神像を振り下ろす。<#ff9028ff>旧神の預言者<>：通常攻撃時<#ffb900ff>6秒<>ごとに前へ触手が<#ffb900ff>6秒<>生え、<#ffb900ff>1.5秒<>ごとに近くの敵へ<#ff9028ff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>35%<>の物理ダメージ、英雄に当たると<#ff9028ff>6<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>6%<><#66bb6aff>回復<>。",
        "skill": "対象へ跳び<#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50%<> + 対象の最大体力の2%の物理ダメージ、彼女の触手すべてが対象を打つ。",
        "skill2": "敵英雄の魂を<#ffb900ff>5秒<>引き出す：受けるダメージ+15%、50%<#ef5350ff>スロウ<>。その後<#ffb900ff>4秒<>器となり、そばに触手が生える。",
        "ult": "跳んで神像を地面に叩きつけ周囲の敵に<#ff9028ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<>の物理ダメージ、当たった英雄ごとに触手1本。<#ffb900ff>8秒<>間触手は<#ffb900ff>1秒<>ごとに打ち、過酷なる教訓のクールダウン<#ffb900ff>2秒<>。"
      },
      "league_aurora": {
        "name": "オーロラ",
        "attack": "杖から霊光を放つ。<#ff9028ff>精霊の解放<>：英雄への命中が重なり、3回目で精霊を引き出し<#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>＋最大体力の2%のダメージ、<#a974ffff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<><#66bb6aff>回復<>し加速。<#ff9028ff>ベールを越えて<>：敵英雄に詰められると後ろへ跳び<#ffb900ff>1.25秒<>透明、移動速度+30%（<#ffb900ff>20秒<>ごと）。",
        "skill": "呪弾が敵を貫き<#a974ffff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>55%<>の魔法ダメージと呪い、<#ffb900ff>0.67秒<>後に呪いを引き戻し帰り道で<#a974ffff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>55%<>の魔法ダメージ。",
        "skill2": "前方へ霊の衝撃を放ち<#a974ffff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>の魔法ダメージと弱まっていく60%<#ef5350ff>スロウ<>、その後後ろへ跳ぶ。",
        "ult": "敵英雄へ跳び衝撃波で<#a974ffff>260<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>の魔法ダメージと40%<#ef5350ff>スロウ<>。<#ffb900ff>3.5秒<>間領域を開き中の敵を30%<#ef5350ff>スロウ<>、対象が離れると領域を越えて追う。"
      },
      "league_nunu": {
        "name": "ヌヌ＆ウィルンプ",
        "attack": "爪で攻撃。3回目ごとの通常攻撃は<#ff9028ff>丸かじり<>：<#a974ffff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<>の魔法ダメージ追加（ミニオン・モンスターはさらに120の確定ダメージ）、<#a974ffff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>25%<><#66bb6aff>回復<>。その後<#ffb900ff>4秒<>自身と味方1体の攻撃速度+30%・移動速度+15%、通常攻撃が周囲に20%拡散。",
        "skill": "雪玉を転がして対象にぶつけ<#a974ffff>55<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>42%<>の魔法ダメージと<#ffb900ff>0.5秒<><#ef5350ff>ノックアップ<>。長く転がすほど大きくなり最大170%ダメージ・<#ffb900ff>1秒<><#ef5350ff>ノックアップ<>。",
        "skill2": "雪玉を6個投げ、それぞれ<#a974ffff>11<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>7%<>の魔法ダメージと30%<#ef5350ff>スロウ<>。投げ終わると当たった英雄を<#ffb900ff>0.75秒<><#ef5350ff>スネア<>し<#a974ffff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>の魔法ダメージ。",
        "ult": "<#ffb900ff>2.5秒<>吹雪を詠唱し<#a974ffff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>の<#66bb6aff>シールド<>、周囲の敵を40%から80%<#ef5350ff>スロウ<>。終わると爆発し<#a974ffff>190<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>105%<>の魔法ダメージ（中断時は詠唱した分）。"
      },
      "league_azir": {
        "name": "アジール",
        "attack": "<#ff9028ff>目覚めよ！<>：通常攻撃が<#ffb900ff>2.5秒<>ごとに対象の所に砂兵を呼ぶ（最大<#ffb900ff>3<>体、<#ffb900ff>8秒<>）。砂兵が代わりに突き<#a974ffff>75<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>100%<>の魔法ダメージ、届く砂兵がいないと自ら砂光を放つ。",
        "skill": "全砂兵が対象へ突撃し、道中<#a974ffff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<>の魔法ダメージと25%<#ef5350ff>スロウ<>、着くとすぐ突く。砂兵がいなければそこに1体呼ぶ。",
        "skill2": "砂兵がいる時だけ：<#66bb6aff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#66bb6aff>60%<>のシールド、アルティメット準備時は敵英雄へ突進し<#a974ffff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>55%<>の魔法ダメージと砂兵1体。詰められると後ろへ跳ぶ。",
        "ult": "近衛兵の壁が突撃し<#a974ffff>260<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>90%<>の魔法ダメージと<#ef5350ff>ノックバック<>。流砂の衝撃で英雄に寄った直後なら、背後へ回り味方側へ押し返す。"
      },
      "league_zac": {
        "name": "ザック",
        "attack": "スライムの拳。<#ff9028ff>スライムクラッシュ<>：使用可能なとき通常攻撃が弾け、周囲の敵に<#a974ffff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>の魔法ダメージ、英雄にはさらに<#e0e0e0ff>最大体力の4%<>の確定ダメージ（クールダウン<#ffb900ff>5秒<>）。<#ff9028ff>はぐれスライム<>：スキルが英雄に当たるとスライムが落ち、拾うと<#a974ffff>55<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<><#66bb6aff>回復<>（復活は拡張パック）。",
        "skill": "腕を伸ばして対象をつかみ<#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>+自身の最大体力の2%の魔法ダメージと40%<#ef5350ff>スロウ<>。つかんだ英雄は<#ffb900ff>0.4秒<>後に引き寄せて叩きつけ、同じダメージを再び与え周囲の敵を<#ffb900ff>0.5秒<><#ef5350ff>ノックアップ<>。",
        "skill2": "<#ffb900ff>0.6秒<>力をためて対象へ飛び、着地で<#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<>+自身の最大体力の3%の魔法ダメージと周囲の敵を<#ffb900ff>0.5秒<><#ef5350ff>ノックアップ<>。",
        "ult": "阻止不能で4回跳ね、着地ごとに<#a974ffff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<>の魔法ダメージ（2回目以降50%）、<#ffb900ff>0.33秒<><#ef5350ff>ノックアップ<>と25%<#ef5350ff>スロウ<>。"
      },
      "league_singed": {
        "name": "シンジド",
        "attack": "盾板で殴る。<#ff9028ff>毒の軌跡<>：通った跡に毒の雲を残し（<#ffb900ff>3秒<>）、中の敵に<#ffb900ff>0.5秒<>ごと<#a974ffff>18<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>18%<>の魔法ダメージ。<#ff9028ff>スリップストリーム<>：敵英雄のそばを通ると<#ffb900ff>1.5秒<>移動速度+25%。",
        "skill": "対象を肩越しに背後へ投げ、<#a974ffff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<>の魔法ダメージと<#e0e0e0ff>最大体力の5%<>の確定ダメージ。<#ff9028ff>強力粘着剤<>が地面にあるとき対象を<#ffb900ff>1秒<><#ef5350ff>スネア<>。",
        "skill2": "粘着剤の瓶を投げる：<#ffb900ff>3秒<>間、中の敵を50%<#ef5350ff>スロウ<>し<#ef5350ff>移動スキル封じ<>。",
        "ult": "ポーションを飲み、<#ffb900ff>25秒<>間魔力+60、物防・魔防+30、移動速度+15%、毎秒<#66bb6aff>体力12回復<>。<#ff9028ff>毒の軌跡<>が広がり150%のダメージと<#ef5350ff>重傷<>（回復-40%）。"
      }
