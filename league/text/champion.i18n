      "league_corki": {
        "name": "庫奇",
        "attack": "<#ff9028ff>海克斯軍火<>：普攻<#ffffffff>20%<>傷害轉為<#ffffffff>真實傷害<>。<#ff9028ff>特別快遞<>：開局、復活後及每<#ffb900ff>45秒<>，下次女武神特攻變成彈藥包：起飛時<#ef5350ff>擊退<>附近英雄並造成<#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<><#a974ffff>魔法傷害<>，飛得更遠、火焰更寬更久，加速30%。",
        "skill": "向目標位置扔出磷光炸彈，範圍內敵人受到<#a974ffff>95<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<><#a974ffff>魔法傷害<>和<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>55%<><#ff9028ff>物理傷害<>。",
        "skill2": "<#ff9028ff>格林機槍<>：<#ffb900ff>4秒<>內向前方錐形掃射，每次造成<#ff9028ff>9<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>16%<><#ff9028ff>物理<>和<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>9%魔法傷害<>，疊加降低護甲和魔抗。冷卻中被英雄貼近時改為<#ff9028ff>女武神特攻<>：向後俯衝，沿途留下火焰，每<#ffb900ff>0.5秒<>造成<#a974ffff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>12%<><#a974ffff>魔法傷害<>。",
        "ult": "儲存<#ffb900ff>4發<>火箭（每<#ffb900ff>10秒<>補一發），命中第一個敵人後爆炸，範圍內造成<#a974ffff>75<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>42%<><#a974ffff>魔法傷害<>和<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>52%<><#ff9028ff>物理傷害<>；每第3發是大火箭：範圍更大，傷害200%。"
      },
      "league_braum": {
        "name": "布郎姆",
        "attack": "<#ff9028ff>震盪冰封<>：普攻和凜冬衝擊命中英雄疊一層，第<#ffb900ff>4層<><#ef5350ff>暈眩1.25秒<>並造成<#a974ffff>85<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<><#a974ffff>魔法傷害<>；之後<#ffb900ff>8秒<>不再疊層，普攻額外造成<#a974ffff>12<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>10%<><#a974ffff>魔法傷害<>。",
        "skill": "從盾中甩出寒冰，造成<#a974ffff>105<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<>+最大生命2%<#a974ffff>魔法傷害<>，<#ef5350ff>緩速70%<>，<#ffb900ff>2秒<>內漸弱到35%。",
        "skill2": "舉盾<#ffb900ff>3.5秒<>：受到傷害降低50%，獲得60 + <i#asset/base/ui/banpick/champion_stat_icon:ap_0>40%護盾，身邊友方英雄傷害降低20%。<#ff9028ff>壁壘守護<>：衝到友方英雄身邊，兩人護甲和魔抗+30，持續<#ffb900ff>3秒<>。",
        "ult": "猛砸地面，冰河裂隙衝向目標，造成<#a974ffff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<><#a974ffff>魔法傷害<>並<#ef5350ff>擊飛0.6秒<>（第一個英雄1.25秒），留下<#ffb900ff>4秒<>的裂隙，<#ef5350ff>緩速40%<>。"
      },
      "league_mordekaiser": {
        "name": "魔鬥凱薩",
        "attack": "<#ff9028ff>暗崛<>：普攻附帶<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>40%魔法傷害<>。普攻、Q、E命中英雄疊層，3層時移速+3%，每<#ffb900ff>0.5秒<>對周圍敵人造成<#a974ffff>4<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#a974ffff>1%<><#a974ffff>魔法傷害<>。",
        "skill": "揮錘砸向前方一條直線，造成<#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<><#a974ffff>魔法傷害<>；只砸中一個敵人時改為<#a974ffff>112<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>98%<>。",
        "skill2": "甩出死之爪，造成<#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<><#a974ffff>魔法傷害<>並把敵人<#ef5350ff>拉到身前<>。冷卻中被英雄貼近時改為<#ff9028ff>不滅之軀<>：獲得<#7ee87eff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#7ee87eff>60%護盾<>，護盾仍在時回復<#7ee87eff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#7ee87eff>40%生命<>。",
        "ult": "詛咒一名敵方英雄<#ffb900ff>7秒<>：偷取其10%攻擊、法強、護甲、魔抗和生命，逃遠會被<#ef5350ff>拉回<>；期間將其擊殺則回復<#7ee87eff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#7ee87eff>50%生命<>。"
      },
      "league_nidalee": {
        "name": "奈德麗",
        "attack": "<#ff9028ff>穿梭<>：標槍或陷阱命中英雄將其狩獵<#ffb900ff>4秒<>，期間跑速+20%。出手前依戰況切換人形（遠程）和美洲獅（近戰）形態，切換冷卻<#ffb900ff>3秒<>。",
        "skill": "人形：擲出標槍造成<#a974ffff>88<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<><#a974ffff>魔法傷害<>，飛得越遠越高（最多220%）。<#ff9028ff>擊倒<>：下次攻擊額外造成<#ff8a65ff>40<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff8a65ff>50%<><#ff8a65ff>物理<>和<#a974ffff>52<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>62%<><#a974ffff>魔法傷害<>，對狩獵目標+40%。",
        "skill2": "人形：治療友方英雄<#7dd87dff>45<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#7dd87dff>45%<>，攻速+40%持續<#ffb900ff>7秒<>；冷卻時放<#ff9028ff>叢林伏擊<>，持續造成<#a974ffff>18<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>16%<><#a974ffff>魔法傷害<>。<#ff9028ff>猛撲<>：撲向敵人造成<#a974ffff>70<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>48%<><#a974ffff>魔法傷害<>；<#ff9028ff>揮擊<>造成<#a974ffff>98<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<><#a974ffff>魔法傷害<>。",
        "ult": "化身美洲獅，重置美洲獅技能，撲向英雄造成<#a974ffff>160<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>90%<><#a974ffff>魔法傷害<>，落地揮擊並準備擊倒。"
      },
      "league_galio": {
        "name": "加里歐",
        "attack": "<#ff9028ff>護國意志<>：每<#ffb900ff>4秒<>下一次普攻對周圍敵人造成<#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<><#a974ffff>魔法傷害<>。<#ff9028ff>杜蘭德之盾<>被動：普攻時獲得<#7dd87dff>90 + <i#asset/base/ui/banpick/champion_stat_icon:ap_0>30%<>護盾，每<#ffb900ff>12秒<>一次。",
        "skill": "射出兩道風刃，落點造成<#a974ffff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<><#a974ffff>魔法傷害<>，並留下<#ffb900ff>2秒<>龍捲風，每<#ffb900ff>0.5秒<>造成<#a974ffff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>18%<><#a974ffff>魔法傷害<>。",
        "skill2": "衝向敵方英雄，撞到第一個英雄造成<#a974ffff>130<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>90%<><#a974ffff>魔法傷害<>並<#ef5350ff>擊飛0.75秒<>。<#ff9028ff>杜蘭德之盾<>：蓄力<#ffb900ff>0.83秒<>，傷害降低40%，隨後<#ef5350ff>嘲諷1.17秒<>周圍敵人，造成<#a974ffff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<><#a974ffff>魔法傷害<>。",
        "ult": "給陷入苦戰的友方英雄<#7dd87dff>150 + <i#asset/base/ui/banpick/champion_stat_icon:ap_0>50%<>護盾，引導<#ffb900ff>2秒<>後飛到其身邊，落地造成<#a974ffff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>90%<><#a974ffff>魔法傷害<>並<#ef5350ff>擊飛0.75秒<>，周圍友方英雄也獲得護盾。"
