      "league_aurora": {
        "name": "阿萝拉",
        "attack": "魔杖点出灵光。<#ff9028ff>驱灵奇术<>：命中英雄叠层，第三层抽出灵物，造成<#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>+2%最大生命值的伤害，<#66bb6aff>回复<><#a974ffff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<>生命并加速。<#ff9028ff>灵纱洞开<>：被敌方英雄贴身时后跳，隐身<#ffb900ff>1.25秒<>、加速30%（<#ffb900ff>20秒<>一次）。",
        "skill": "放出咒弹穿过敌人，造成<#a974ffff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>55%<>魔法伤害并留下诅咒；<#ffb900ff>0.67秒<>后把诅咒抽回，回程再造成<#a974ffff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>55%<>魔法伤害。",
        "skill2": "向前喷出灵魂冲击，造成<#a974ffff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>魔法伤害并<#ef5350ff>减速<>60%（逐渐减弱），随后向后跳开。",
        "ult": "跳到敌方英雄身上，冲击波造成<#a974ffff>260<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>魔法伤害并<#ef5350ff>减速<>40%；张开领域<#ffb900ff>3.5秒<>，<#ef5350ff>减速<>其中敌人30%，目标走开时她穿过领域追上去。"
      },
      "league_nunu": {
        "name": "努努和威朗普",
        "attack": "爪击。每第3次普攻是<#ff9028ff>吞噬<>：额外<#a974ffff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<>魔法伤害（小兵野怪再受120真实伤害），<#66bb6aff>回复<><#a974ffff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>25%<>生命；随后<#ffb900ff>4秒<>内自己和一名队友攻速+30%、移速+15%，普攻溅射周围20%。",
        "skill": "推着雪球冲向目标，撞上造成<#a974ffff>55<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>42%<>魔法伤害并<#ef5350ff>击飞<><#ffb900ff>0.5秒<>；滚得越久越大，最多170%伤害、<#ef5350ff>击飞<><#ffb900ff>1秒<>。",
        "skill2": "连扔6个雪球，每个<#a974ffff>11<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>7%<>魔法伤害并<#ef5350ff>减速<>30%；扔完<#ef5350ff>禁锢<>被打中的英雄<#ffb900ff>0.75秒<>，造成<#a974ffff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>魔法伤害。",
        "ult": "引导暴风雪<#ffb900ff>2.5秒<>，获得<#66bb6aff>护盾<><#a974ffff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>，周围敌人<#ef5350ff>减速<>40%到80%；结束时爆发造成<#a974ffff>190<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>105%<>魔法伤害（被打断按已引导的时间计算）。"
      },
      "league_azir": {
        "name": "阿兹尔",
        "attack": "<#ff9028ff>沙兵现身<>：普攻每<#ffb900ff>2.5秒<>在目标处召出一个黄沙士兵（最多<#ffb900ff>3<>个，存在<#ffb900ff>8秒<>），士兵代他刺击，造成<#a974ffff>75<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>100%<>魔法伤害；士兵都够不着时他自己射出沙光。",
        "skill": "所有黄沙士兵冲向目标，沿途造成<#a974ffff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%<>魔法伤害并<#ef5350ff>减速<>25%，落地马上刺击；没有士兵时在目标处召出一个。",
        "skill2": "身边有士兵才能施放：获得<#66bb6aff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#66bb6aff>60%<>护盾，大招就绪时冲向敌方英雄，造成<#a974ffff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>55%<>魔法伤害并召出一个士兵；被敌方英雄贴身时改为后跳。",
        "ult": "一排禁军举盾冲锋，造成<#a974ffff>260<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>90%<>魔法伤害并<#ef5350ff>击退<>敌人；刚用流沙移形冲到英雄身上时，先绕到他身后，再把他推回己方。"
      },
      "league_zac": {
        "name": "扎克",
        "attack": "拳击。<#ff9028ff>不稳定物质<>：冷却好时普攻炸开，周围敌人受<#a974ffff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>魔法伤害，英雄再受<#e0e0e0ff>最大生命4%<>真实伤害（冷却<#ffb900ff>5秒<>）。<#ff9028ff>细胞分裂<>：技能打中英雄掉下黏液，吃掉<#66bb6aff>回复<><#a974ffff>55<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<>生命（复活需扩展包）。",
        "skill": "伸长手臂抓向目标，造成<#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<> + 自身最大生命2%魔法伤害并<#ef5350ff>减速<>40%；抓住的英雄<#ffb900ff>0.4秒<>后被甩到身边砸地，再受同样伤害，周围敌人<#ef5350ff>击飞<><#ffb900ff>0.5秒<>。",
        "skill2": "蓄力<#ffb900ff>0.6秒<>后把自己弹向目标，落地造成<#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<> + 自身最大生命3%魔法伤害并<#ef5350ff>击飞<>周围敌人<#ffb900ff>0.5秒<>。",
        "ult": "不可阻挡地连跳4次，每次落地造成<#a974ffff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<>魔法伤害（之后每次50%），<#ef5350ff>击飞<><#ffb900ff>0.33秒<>并<#ef5350ff>减速<>25%。"
      },
      "league_singed": {
        "name": "辛吉德",
        "attack": "用盾板砸。<#ff9028ff>剧毒踪迹<>：一路在身后留下毒雾（<#ffb900ff>3秒<>），雾里的敌人每<#ffb900ff>0.5秒<>受<#a974ffff>18<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>18%<>魔法伤害。<#ff9028ff>剧毒冲流<>：经过敌方英雄身边时移速+25%（<#ffb900ff>1.5秒<>）。",
        "skill": "抓住目标从肩膀上扔到身后，造成<#a974ffff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<>魔法伤害和<#e0e0e0ff>最大生命5%<>真实伤害；地上有<#ff9028ff>强力粘胶<>时，被扔的敌人<#ef5350ff>禁锢<><#ffb900ff>1秒<>。",
        "skill2": "扔出一瓶粘胶，地上留下<#ffb900ff>3秒<>的一摊胶，里面的敌人<#ef5350ff>减速<>50%并<#ef5350ff>无法位移<>。",
        "ult": "喝下药剂，<#ffb900ff>25秒<>内法强+60、双抗+30、移速+15%、每秒<#66bb6aff>回复12<>生命；<#ff9028ff>剧毒踪迹<>更大、伤害150%并附带<#ef5350ff>重伤<>（治疗-40%）。"
      }
    },
