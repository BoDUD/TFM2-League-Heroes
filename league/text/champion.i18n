  "zh-hant": {
    "description": {
      "league_garen": {
        "name": "蓋倫",
        "attack": "普攻造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻擊力<>的<#ff9028ff>物理傷害<>。",
        "skill": "<#ff9028ff>致命打擊<>：蓋倫獲得<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>35% 移動速度<>，持續<#ffb900ff>1.5秒<>。<#ffb900ff>4.5秒<>內的下一次普攻變為躍起重擊，造成<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150% 攻擊力<>的<#ff9028ff>物理傷害<>並<#ef5350ff>沉默<>目標<#ffb900ff>1.5秒<>。同時獲得<#ff9028ff>勇氣<>：<#ffb900ff>2秒<>內受到的傷害降低<#ffb900ff>30%<>、韌性提高<#ffb900ff>60%<>，並獲得<#e8d44dff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50% 攻擊力<>的<#e8d44dff>護盾<>。",
        "skill2": "<#ff9028ff>審判<>：蓋倫揮劍旋轉<#ffb900ff>3秒<>，邊轉邊追著目標移動，共轉<#ffb900ff>7<>圈，每圈對周圍敵人造成<#ff9028ff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>55% 攻擊力<>的<#ff9028ff>物理傷害<>，追擊的目標每圈多受<#ffb900ff>25%<>。第<#ffb900ff>7<>圈命中的敵人<i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>護甲<>降低<#ffb900ff>25%<>，持續<#ffb900ff>6秒<>。被動 <#ff9028ff>堅韌<>：蓋倫擁有很高的<#6aff55ff>生命回復<>。",
        "ult": "<#ff9028ff>德瑪西亞正義<>：召喚巨劍從天而降，對目標敵方英雄造成<#f5f5f5ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120% 攻擊力<> + <#f5f5f5ff>12% 目標最大生命值<>的<#f5f5f5ff>真實傷害<>。"
      },
      "league_ashe": {
        "name": "艾希",
        "attack": "普攻射出冰霜箭，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻擊力<>的<#ff9028ff>物理傷害<>。被動 <#ff9028ff>冰霜射擊<>：普攻使目標<#ef5350ff>緩速<><#ffb900ff>20%<>，持續<#ffb900ff>1秒<>。",
        "skill": "<#ff9028ff>專注射擊<>：艾希獲得<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>30% 攻擊速度<>，持續<#ffb900ff>4秒<>。期間普攻變為連射，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130% 攻擊力<>的<#ff9028ff>物理傷害<>，並使目標<#ef5350ff>緩速<><#ffb900ff>30%<>。",
        "skill2": "<#ff9028ff>萬箭齊發<>：向前方扇形射出<#ffb900ff>9<>支冰霜箭，對扇形內每個敵人造成<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻擊力<>的<#ff9028ff>物理傷害<>（每個敵人只會被命中一次），並使其<#ef5350ff>緩速<><#ffb900ff>25%<>，持續<#ffb900ff>1.5秒<>。",
        "ult": "<#ff9028ff>魔法水晶箭<>：向目標方向射出一支飛得很遠的水晶箭，命中第一個敵方英雄，造成<#ff9028ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻擊力<>的<#ff9028ff>物理傷害<>並<#ef5350ff>暈眩<><#ffb900ff>1.75秒<>。水晶箭在命中處炸開，對周圍敵人造成<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50% 攻擊力<>的<#ff9028ff>物理傷害<>並<#ef5350ff>緩速<><#ffb900ff>50%<>，持續<#ffb900ff>2秒<>。"
      },
      "league_lux": {
        "name": "拉克絲",
        "attack": "普攻從法杖射出光彈，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻擊力<>的<#ff9028ff>物理傷害<>。被動 <#ff9028ff>光芒四射<>：技能命中敵人後<#ffb900ff>5秒<>內，下一次普攻引爆光芒，額外造成<#a974ffff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>35% 魔法強度<>的<#a974ffff>魔法傷害<>。",
        "skill": "<#ff9028ff>光明束縛<>：向前方射出一顆光球，對路徑上的每個敵人造成<#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>75% 魔法強度<>的<#a974ffff>魔法傷害<>並<#ef5350ff>束縛<><#ffb900ff>1.5秒<>。同時施放 <#ff9028ff>稜光障壁<>：拉克絲和身邊的友方英雄獲得<#e8d44dff>55<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>40% 魔法強度<>的<#e8d44dff>護盾<>，持續<#ffb900ff>2.5秒<>。",
        "skill2": "<#ff9028ff>光明異點<>：向目標位置拋出光球，落地後形成光圈，使圈內敵人<#ef5350ff>緩速<><#ffb900ff>20%<>。<#ffb900ff>1秒<>後光圈引爆，對圈內敵人造成<#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80% 魔法強度<>的<#a974ffff>魔法傷害<>。",
        "ult": "<#ff9028ff>終極閃光<>：拉克絲躍起蓄力，<#ffb900ff>0.5秒<>後向目標方向發射一道極長的雷射，對直線上所有敵人造成<#a974ffff>250<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>115% 魔法強度<>的<#a974ffff>魔法傷害<>。"
      },
      "league_leesin": {
        "name": "李星",
        "attack": "普攻出拳，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻擊力<>的<#ff9028ff>物理傷害<>。被動 <#ff9028ff>亂舞<>：每次施放技能後，<#ffb900ff>3秒<>內的接下來<#ffb900ff>2<>次普攻獲得<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>40% 攻擊速度<>。",
        "skill": "<#ff9028ff>虎嘯龍吟<>：向前方發出梵音，對第一個命中的敵人造成<#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90% 攻擊力<>的<#ff9028ff>物理傷害<>並留下印記。<#ff9028ff>震驚百里<>：<#ffb900ff>0.2秒<>後李星自動飛踢衝向被印記的敵人，再造成<#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻擊力<>的<#ff9028ff>物理傷害<>。",
        "skill2": "<#ff9028ff>狂風暴雨<>：李星躍起重擊地面，對周圍敵人造成<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80% 攻擊力<>的<#ff9028ff>物理傷害<>；<#ff9028ff>分筋錯骨<>：命中的敵人被<#ef5350ff>緩速<><#ffb900ff>40%<>，持續<#ffb900ff>2秒<>。同時施放 <#ff9028ff>鐵璧金身<>：李星和身邊的友方英雄獲得<#e8d44dff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60% 攻擊力<>的<#e8d44dff>護盾<>，持續<#ffb900ff>2秒<>；<#ff9028ff>易筋洗髓<>：李星獲得<#6aff55ff>20% 吸血<>，持續<#ffb900ff>3秒<>。",
        "ult": "<#ff9028ff>神龍擺尾<>：李星使出迴旋踢，對目標英雄造成<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130% 攻擊力<>的<#ff9028ff>物理傷害<>並把它<#ef5350ff>往後踢<>。被踢飛的敵人撞到路線上的其他敵人，對他們造成<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80% 攻擊力<>的<#ff9028ff>物理傷害<>並<#ef5350ff>擊飛<><#ffb900ff>0.75秒<>。"
      },
      "league_soraka": {
        "name": "索拉卡",
        "attack": "普攻用法杖射出星光彈，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻擊力<>的<#ff9028ff>物理傷害<>。",
        "skill": "造成<#a974ffff>70<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%魔法強度<>的<#a974ffff>魔法傷害<>並<#ef5350ff>緩速30%<>，命中敵方英雄時獲得<#ff9028ff>回春<>：<#ffb900ff>2.5秒<>內回復<#6aff55ff>75<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%魔法強度<>的<#6aff55ff>生命<>並加速20%。每<#ffb900ff>16秒<>一次附帶<#ff9028ff>寂靜星河<>：<#ef5350ff>沉默<>圈內敵人，<#ffb900ff>1.5秒<>後仍在圈內的<#ef5350ff>定身1秒<>並承受<#a974ffff>40<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%魔法強度<>的<#a974ffff>魔法傷害<>。",
        "skill2": "消耗自身<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>6%最大生命<>（不會致死），為一名其他友方英雄回復<#6aff55ff>200<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%魔法強度<>的<#6aff55ff>生命<>。帶<#ff9028ff>回春<>時不消耗生命，目標也獲得<#ff9028ff>回春<>。被動<#ff9028ff>群星指路<>：施放後<#ffb900ff>2秒<>內<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>跑速提高30%<>。",
        "ult": "<#ff9028ff>祈願<>：為全圖所有友方英雄（包括自己）回復<#6aff55ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60% 魔法強度<>的<#6aff55ff>生命<>。"
      },
      "league_darius": {
        "name": "達瑞斯",
        "attack": "普攻揮斧劈砍，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻擊力<>的<#ff9028ff>物理傷害<>。被動 <#ff9028ff>絞喉<>：普攻和<#ff9028ff>毀滅風暴<>命中的敵人流血<#ffb900ff>5秒<>，共承受<#ff9028ff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>20% 攻擊力<>的<#ff9028ff>物理傷害<>，可累加。達瑞斯<#ffb900ff>5秒<>內命中<#ffb900ff>5<>次後獲得<#ff9028ff>諾克薩斯威能<>：<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻擊力<>提高<#ffb900ff>40%<>，持續<#ffb900ff>5秒<>。",
        "skill": "<#ff9028ff>毀滅風暴<>：達瑞斯舉斧蓄力後揮舞一圈，對周圍敵人造成<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110% 攻擊力<>的<#ff9028ff>物理傷害<>並附加<#ff9028ff>絞喉<>。每命中一位敵方英雄，回復<#6aff55ff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30% 攻擊力<>的<#6aff55ff>生命<>。",
        "skill2": "<#ff9028ff>索魂奪命<>：達瑞斯用斧鉤掃過前方扇形區域，把其中的敵人全部<#ef5350ff>拉<>到身邊。之後<#ffb900ff>4秒<>內的下一次普攻變為<#ff9028ff>殘廢打擊<>：造成<#ff9028ff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150% 攻擊力<>的<#ff9028ff>物理傷害<>並<#ef5350ff>緩速<><#ffb900ff>90%<>，持續<#ffb900ff>1秒<>。",
        "ult": "<#ff9028ff>諾克薩斯斷頭台<>：達瑞斯躍向一位敵方英雄猛力劈下，造成<#f5f5f5ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻擊力<>的<#f5f5f5ff>真實傷害<>。<#ffb900ff>5秒<>內每命中一次，傷害提高<#ffb900ff>20%<>；處於<#ff9028ff>諾克薩斯威能<>時傷害加倍。"
      },
      "league_amumu": {
        "name": "阿姆姆",
        "attack": "普攻造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻擊力<>的<#ff9028ff>物理傷害<>。被動 <#ff9028ff>詛咒之觸<>、<#ff9028ff>絕望<>：普攻或施放技能後哭泣<#ffb900ff>4秒<>，每秒對周圍敵人造成<#a974ffff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>10% 魔法強度<>的<#a974ffff>魔法傷害<>（英雄另受<#f5f5f5ff>1% 最大生命<>的<#f5f5f5ff>真實傷害<>）並施加<#ef5350ff>詛咒<>：<#ef5350ff>受到傷害提高10%<>。",
        "skill": "擲出繃帶，穿過小兵和野怪，黏住第一個敵方英雄，造成<#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70% 魔法強度<>的<#a974ffff>魔法傷害<>並<#ef5350ff>暈眩<><#ffb900ff>1秒<>，隨後阿姆姆把自己拉過去。",
        "skill2": "對周圍敵人造成<#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50% 魔法強度<>的<#a974ffff>魔法傷害<>。被動：受到的普攻傷害降低<#ffb900ff>10%<>。",
        "ult": "用繃帶纏住周圍所有敵人，造成<#a974ffff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80% 魔法強度<>的<#a974ffff>魔法傷害<>，<#ef5350ff>暈眩<><#ffb900ff>1.5秒<>並施加<#ef5350ff>詛咒<><#ffb900ff>3秒<>。"
      },
      "league_yasuo": {
        "name": "犽宿",
        "attack": "普攻造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻擊力<>的<#ff9028ff>物理傷害<>。被動 <#ff9028ff>浪人之道<>：<#ffb900ff>20%<>暴擊率，暴擊造成雙倍傷害。<#ff9028ff>風湧<>每<#ffb900ff>12秒<>充滿一次，充滿後下一次出手獲得<#e8d44dff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60% 攻擊力<>的<#e8d44dff>護盾<>，持續<#ffb900ff>2秒<>。",
        "skill": "向前突刺，對直線上的敵人造成<#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻擊力<>的<#ff9028ff>物理傷害<>，視為普攻，可以暴擊。命中後獲得一層<#ff9028ff>天寒地凍<>，滿<#ffb900ff>2<>層時下一次改為擊出旋風，<#ef5350ff>擊飛<>直線上的敵人<#ffb900ff>1秒<>。在<#ff9028ff>刃敵千軍<>衝刺中施放時改為圓形揮砍。",
        "skill2": "衝刺穿過一名敵人，造成<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60% 攻擊力<>的<#ff9028ff>物理傷害<>。<#ffb900ff>6秒<>內再次施放，傷害提高<#ffb900ff>25%<>，最多提高<#ffb900ff>50%<>。",
        "ult": "瞬間移動至一名受控（<#ef5350ff>擊飛<>、<#ef5350ff>暈眩<>、<#ef5350ff>禁錮<>等）的敵方英雄身邊，對附近所有受控的敵方英雄造成<#ff9028ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150% 攻擊力<>的<#ff9028ff>物理傷害<>並再<#ef5350ff>擊飛<><#ffb900ff>1秒<>。之後<#ffb900ff>10秒<>內無視目標<#ffb900ff>30%<><#ffdd8eff>物理防禦<>，<#ff9028ff>風湧<>立即回滿。"
      },
      "league_jinx": {
        "name": "吉茵珂絲",
        "attack": "<#ff9028ff>鬼靈精怪！<>：近處有敵人時用<#ff9028ff>砰砰<>，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻擊力<>的<#ff9028ff>物理傷害<>，每發加<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>15% 攻擊速度<>（至多<#ffb900ff>3<>層）；否則換<#ff9028ff>惡鯊<>，射程更遠，對目標及周圍敵人造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110% 攻擊力<>的傷害。<#ff9028ff>狂躁！<>：親手擊殺英雄後<#ffb900ff>6秒<>內<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>25% 攻擊速度<>，<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>100% 移動速度<>（逐漸回落）。",
        "skill": "蓄力<#ffb900ff>0.4秒<>後射出震盪波，對命中的第一個敵人造成<#ff9028ff>75<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120% 攻擊力<>的<#ff9028ff>物理傷害<>並<#ef5350ff>緩速<><#ffb900ff>25%<>，持續<#ffb900ff>2秒<>。",
        "skill2": "向敵方英雄腳下丟出<#ffb900ff>3<>顆咬咬手榴彈，<#ffb900ff>0.5秒<>後布好，最多留<#ffb900ff>5秒<>。敵方英雄踩上時手榴彈爆炸，<#ef5350ff>束縛<>範圍內的敵方英雄<#ffb900ff>1.5秒<>並造成<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 攻擊力<>的<#ff9028ff>物理傷害<>，隨後手榴彈消失。",
        "ult": "發射一枚飛越全圖的火箭，穿過小兵和野怪，命中第一個敵方英雄後爆炸，對周圍敵人造成<#ff9028ff>175<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90% 攻擊力<> + <#ff9028ff>10% 目標最大生命值<>的<#ff9028ff>物理傷害<>。"
      }
    },
