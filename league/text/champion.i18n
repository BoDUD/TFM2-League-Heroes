  "ko": {
    "description": {
      "league_garen": {
        "name": "가렌",
        "attack": "기본 공격은 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> <#ff9028ff>물리 피해<>를 줍니다.",
        "skill": "<#ff9028ff>결정타<>: 가렌이 <#ffb900ff>1.5초<> 동안 <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>이동 속도가 35%<> 증가합니다. <#ffb900ff>4.5초<> 안의 다음 기본 공격은 도약 강타가 되어 <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 150%<> <#ff9028ff>물리 피해<>를 주고 대상을 <#ffb900ff>1.5초<> 동안 <#ef5350ff>침묵<>시킵니다. 또한 <#ff9028ff>용기<>를 얻어 <#ffb900ff>2초<> 동안 받는 피해가 <#ffb900ff>30%<> 감소하고 강인함이 <#ffb900ff>60%<> 증가하며, <#e8d44dff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 50%<>의 <#e8d44dff>보호막<>을 얻습니다.",
        "skill2": "<#ff9028ff>심판<>: 가렌이 <#ffb900ff>3초<> 동안 검을 휘두르며 회전하고, 회전하며 대상을 쫓아갑니다. <#ffb900ff>7<>번의 회전마다 주변 적에게 <#ff9028ff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 55%<> <#ff9028ff>물리 피해<>를 주고(쫓는 대상은 <#ffb900ff>25%<> 추가), <#ffb900ff>7<>번째 회전은 <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>방어력<>을 <#ffb900ff>6초<> 동안 <#ffb900ff>25%<> 낮춥니다. 기본 지속 효과 <#ff9028ff>인내<>: 가렌은 <#6aff55ff>체력 재생<>이 매우 높습니다.",
        "ult": "<#ff9028ff>데마시아의 정의<>: 대상 적 챔피언에게 거대한 검을 내리꽂아 <#f5f5f5ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 120%<> + <#f5f5f5ff>대상 최대 체력의 12%<> <#f5f5f5ff>고정 피해<>를 줍니다."
      },
      "league_ashe": {
        "name": "애쉬",
        "attack": "기본 공격으로 서리 화살을 쏘아 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> <#ff9028ff>물리 피해<>를 입힙니다. 기본 지속 효과 <#ff9028ff>서리 화살<>: 기본 공격이 대상을 <#ffb900ff>1초<> 동안 <#ffb900ff>20%<> <#ef5350ff>둔화<>시킵니다.",
        "skill": "<#ff9028ff>궁사의 집중<>: 애쉬가 <#ffb900ff>4초<> 동안 <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>공격 속도가 30%<> 증가합니다. 그동안 기본 공격이 연사로 바뀌어 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 130%<> <#ff9028ff>물리 피해<>를 입히고 대상을 <#ffb900ff>30%<> <#ef5350ff>둔화<>시킵니다.",
        "skill2": "<#ff9028ff>일제 사격<>: 전방 부채꼴로 서리 화살 <#ffb900ff>9<>발을 쏩니다. 부채꼴 안의 적마다 <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> <#ff9028ff>물리 피해<>를 입히고(적마다 한 번만 적중) <#ffb900ff>1.5초<> 동안 <#ffb900ff>25%<> <#ef5350ff>둔화<>시킵니다.",
        "ult": "<#ff9028ff>마법의 수정화살<>: 멀리 날아가는 수정 화살을 쏘아 처음 맞은 적 챔피언에게 <#ff9028ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> <#ff9028ff>물리 피해<>를 입히고 <#ffb900ff>1.75초<> 동안 <#ef5350ff>기절<>시킵니다. 화살이 멈춘 곳에서 터져 주변 적에게 <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 50%<> <#ff9028ff>물리 피해<>를 입히고 <#ffb900ff>2초<> 동안 <#ffb900ff>50%<> <#ef5350ff>둔화<>시킵니다."
      },
      "league_lux": {
        "name": "럭스",
        "attack": "기본 공격으로 지팡이에서 빛의 탄환을 쏘아 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> <#ff9028ff>물리 피해<>를 입힙니다. 기본 지속 효과 <#ff9028ff>광채<>: 스킬이 적에게 적중한 뒤 <#ffb900ff>5초<> 안에 하는 다음 기본 공격이 빛을 폭발시켜 <#a974ffff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 35%<> <#a974ffff>추가 마법 피해<>를 입힙니다.",
        "skill": "<#ff9028ff>빛의 속박<>: 빛의 구체를 발사해 경로 위의 모든 적에게 <#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 75%<> <#a974ffff>마법 피해<>를 입히고 <#ffb900ff>1.5초<> 동안 <#ef5350ff>속박<>합니다. 동시에 <#ff9028ff>프리즘 보호막<>을 사용해 럭스와 주변 아군 챔피언이 <#ffb900ff>2.5초<> 동안 <#e8d44dff>55<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 40%<> <#e8d44dff>보호막<>을 얻습니다.",
        "skill2": "<#ff9028ff>광휘의 특이점<>: 빛의 구체를 던져 떨어진 자리에 빛의 장을 만들고, 장 안의 적을 <#ffb900ff>20%<> <#ef5350ff>둔화<>시킵니다. <#ffb900ff>1초<> 뒤 폭발하여 장 안의 적에게 <#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 80%<> <#a974ffff>마법 피해<>를 입힙니다.",
        "ult": "<#ff9028ff>최후의 섬광<>: 럭스가 공중으로 떠올라 빛을 모은 뒤 <#ffb900ff>0.5초<> 후 대상 방향으로 거대한 레이저를 발사해 직선 위의 모든 적에게 <#a974ffff>250<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 115%<> <#a974ffff>마법 피해<>를 입힙니다."
      },
      "league_leesin": {
        "name": "리 신",
        "attack": "기본 공격으로 주먹을 날려 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> <#ff9028ff>물리 피해<>를 입힙니다. 기본 지속 효과 <#ff9028ff>질풍격<>: 스킬을 사용하면 <#ffb900ff>3초<> 안에 하는 다음 <#ffb900ff>2<>번의 기본 공격이 <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>공격 속도 40%<>를 얻습니다.",
        "skill": "<#ff9028ff>음파<>: 음파를 발사해 처음 맞은 적에게 <#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 90%<> <#ff9028ff>물리 피해<>를 입히고 표식을 남깁니다. <#ff9028ff>공명의 일격<>: <#ffb900ff>0.2초<> 뒤 리 신이 표식이 남은 적에게 날아차기로 돌격해 <#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> <#ff9028ff>물리 피해<>를 입힙니다.",
        "skill2": "<#ff9028ff>폭풍<>: 리 신이 뛰어올라 바닥을 내리쳐 주변 적에게 <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 80%<> <#ff9028ff>물리 피해<>를 입힙니다. <#ff9028ff>무력화<>: 맞은 적은 <#ffb900ff>2초<> 동안 <#ffb900ff>40%<> <#ef5350ff>둔화<>됩니다. 동시에 <#ff9028ff>방호<>를 사용해 리 신과 주변 아군 챔피언이 <#ffb900ff>2초<> 동안 <#e8d44dff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 60%<> <#e8d44dff>보호막<>을 얻고, <#ff9028ff>강철의 의지<>로 리 신이 <#ffb900ff>3초<> 동안 <#6aff55ff>20% 생명력 흡수<>를 얻습니다.",
        "ult": "<#ff9028ff>용의 분노<>: 강력한 돌려차기로 대상 챔피언에게 <#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 130%<> <#ff9028ff>물리 피해<>를 입히고 <#ef5350ff>뒤로 밀어냅니다<>. 날아간 대상과 부딪힌 적은 <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 80%<> <#ff9028ff>물리 피해<>를 입고 <#ffb900ff>0.75초<> 동안 <#ef5350ff>공중에 떠오릅니다<>."
      },
      "league_soraka": {
        "name": "소라카",
        "attack": "기본 공격으로 지팡이에서 별빛 탄환을 쏘아 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> <#ff9028ff>물리 피해<>를 입힙니다.",
        "skill": "<#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 50%<> <#a974ffff>마법 피해<>를 입히고 <#ef5350ff>30% 둔화<>시킵니다. 적 챔피언 적중 시 <#ff9028ff>별의 가호<>: <#ffb900ff>2.5초<> 동안 <#6aff55ff>체력 75<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 30%<> 회복, 이동 속도 20% 증가. <#ffb900ff>16초<>에 한 번 <#ff9028ff>별의 균형<>: 범위 안의 적을 <#ef5350ff>침묵<>시키고 <#ffb900ff>1.5초<> 뒤에도 남은 적은 <#ef5350ff>1초 속박<>되며 <#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 30%<> <#a974ffff>마법 피해<>를 입습니다.",
        "skill2": "<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>최대 체력의 6%<>를 소모해(죽지 않음) 다른 아군 챔피언 하나의 <#6aff55ff>체력을 200<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 50%<> 회복시킵니다. <#ff9028ff>별의 가호<> 중에는 체력 소모 없음, 대상도 <#ff9028ff>별의 가호<> 획득. 기본 지속 효과 <#ff9028ff>구원<>: 사용 후 <#ffb900ff>2초<> 동안 <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>이동 속도 30%<> 증가.",
        "ult": "<#ff9028ff>기원<>: 거리와 관계없이 모든 아군 챔피언(소라카 포함)의 <#6aff55ff>체력을 220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 60%<>만큼 회복시킵니다."
      },
      "league_darius": {
        "name": "다리우스",
        "attack": "기본 공격으로 도끼를 내리찍어 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> <#ff9028ff>물리 피해<>를 입힙니다. 기본 지속 효과 <#ff9028ff>과다출혈<>: 기본 공격과 <#ff9028ff>학살<>에 맞은 적은 <#ffb900ff>5초<> 동안 출혈되어 총 <#ff9028ff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 20%<> <#ff9028ff>물리 피해<>를 입으며 중첩됩니다. <#ffb900ff>5초<> 안에 <#ffb900ff>5<>번 적중시키면 <#ff9028ff>녹서스의 힘<>을 얻어 <#ffb900ff>5초<> 동안 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력<>이 <#ffb900ff>40%<> 증가합니다.",
        "skill": "<#ff9028ff>학살<>: 다리우스가 도끼를 들어 올렸다가 한 바퀴 휘둘러 주변 적에게 <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 110%<> <#ff9028ff>물리 피해<>를 입히고 <#ff9028ff>과다출혈<>을 적용합니다. 적 챔피언을 맞힐 때마다 <#6aff55ff>체력<>을 <#6aff55ff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 30%<> 회복합니다.",
        "skill2": "<#ff9028ff>포획<>: 다리우스가 도끼 갈고리로 전방 부채꼴 범위를 휩쓸어 그 안의 적을 모두 자신에게 <#ef5350ff>끌어당깁니다<>. 이후 <#ffb900ff>4초<> 안에 하는 다음 기본 공격은 <#ff9028ff>마비의 일격<>이 되어 <#ff9028ff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 150%<> <#ff9028ff>물리 피해<>를 입히고 <#ffb900ff>1초<> 동안 <#ffb900ff>90%<> <#ef5350ff>둔화<>시킵니다.",
