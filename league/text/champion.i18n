  "ja": {
    "description": {
      "league_garen": {
        "name": "ガレン",
        "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "skill": "<#ff9028ff>断固たる一撃<>：<#ffb900ff>1.5秒<>間<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移動速度が35%<>増加する。<#ffb900ff>4.5秒<>以内の次の通常攻撃は跳躍斬りになり、<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の150%<>の<#ff9028ff>物理ダメージ<>を与え、<#ffb900ff>1.5秒<>間<#ef5350ff>サイレンス<>にする。<#ff9028ff>勇気<>：<#ffb900ff>2秒<>間受けるダメージが<#ffb900ff>30%<>減少し、行動妨害耐性が<#ffb900ff>60%<>増加し、<#e8d44dff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の50%<>の<#e8d44dff>シールド<>を得る。",
        "skill2": "<#ff9028ff>審判<>：ガレンは<#ffb900ff>3秒<>間剣を振り回して回転し、回転しながら対象を追いかける。<#ffb900ff>7<>回の回転ごとに周囲の敵に<#ff9028ff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の55%<>の<#ff9028ff>物理ダメージ<>を与え（追っている敵には<#ffb900ff>25%<>増し）、<#ffb900ff>7<>回目の回転は<i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>物理防御<>を<#ffb900ff>6秒<>間<#ffb900ff>25%<>低下させる。自動効果 <#ff9028ff>忍耐<>：ガレンは非常に高い<#6aff55ff>体力自動回復<>を持つ。",
        "ult": "<#ff9028ff>デマーシアの正義<>：対象の敵チャンピオンに巨大な剣を落とし、<#f5f5f5ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の120%<> + <#f5f5f5ff>対象の最大体力の12%<>の<#f5f5f5ff>確定ダメージ<>を与える。"
      },
      "league_ashe": {
        "name": "アッシュ",
        "attack": "通常攻撃は氷の矢を放ち、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与える。パッシブ <#ff9028ff>フロストショット<>：通常攻撃は対象を<#ffb900ff>1秒<>間<#ffb900ff>20%<><#ef5350ff>スロウ<>にする。",
        "skill": "<#ff9028ff>レンジャーフォーカス<>：アッシュは<#ffb900ff>4秒<>間<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻撃速度が30%<>増加する。その間、通常攻撃は連射になり、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の130%<>の<#ff9028ff>物理ダメージ<>を与えて対象を<#ffb900ff>30%<><#ef5350ff>スロウ<>にする。",
        "skill2": "<#ff9028ff>ボレー<>：前方に扇状に氷の矢を<#ffb900ff>9<>本放つ。範囲内の敵それぞれに<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与え（1体につき1回まで）、<#ffb900ff>1.5秒<>間<#ffb900ff>25%<><#ef5350ff>スロウ<>にする。",
        "ult": "<#ff9028ff>エンチャント クリスタルアロー<>：遠くまで飛ぶ水晶の矢を放ち、最初に当たった敵チャンピオンに<#ff9028ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与えて<#ffb900ff>1.75秒<>間<#ef5350ff>スタン<>させる。矢は止まった場所で砕け、周囲の敵に<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の50%<>の<#ff9028ff>物理ダメージ<>を与えて<#ffb900ff>2秒<>間<#ffb900ff>50%<><#ef5350ff>スロウ<>にする。"
      },
      "league_lux": {
        "name": "ラックス",
        "attack": "通常攻撃は杖から光弾を放ち、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与える。パッシブ <#ff9028ff>イルミネーション<>：スキルが敵に命中してから<#ffb900ff>5秒<>以内の次の通常攻撃が光を炸裂させ、<#a974ffff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の35%<>の<#a974ffff>追加魔法ダメージ<>を与える。",
        "skill": "<#ff9028ff>ライトバインディング<>：光の球を放ち、通過した敵すべてに<#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の75%<>の<#a974ffff>魔法ダメージ<>を与えて<#ffb900ff>1.5秒<>間<#ef5350ff>スネア<>状態にする。同時に<#ff9028ff>プリズムバリア<>を発動し、ラックスと周囲の味方チャンピオンが<#ffb900ff>2.5秒<>間<#e8d44dff>55<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の40%<>の<#e8d44dff>シールド<>を得る。",
        "skill2": "<#ff9028ff>ルーセントシンギュラリティ<>：光の球を投げ、着弾地点に光のフィールドを作り、内部の敵を<#ffb900ff>20%<><#ef5350ff>スロウ<>にする。<#ffb900ff>1秒<>後に炸裂し、フィールド内の敵に<#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の80%<>の<#a974ffff>魔法ダメージ<>を与える。",
        "ult": "<#ff9028ff>ファイナルスパーク<>：ラックスが宙に浮かんで光を集め、<#ffb900ff>0.5秒<>後に対象の方向へ巨大なレーザーを放ち、直線上のすべての敵に<#a974ffff>250<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の115%<>の<#a974ffff>魔法ダメージ<>を与える。"
      },
      "league_leesin": {
        "name": "リー・シン",
        "attack": "通常攻撃は拳で殴り、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与える。パッシブ <#ff9028ff>練気<>：スキル使用後、<#ffb900ff>3秒<>以内の次の通常攻撃<#ffb900ff>2<>回の<i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>攻撃速度が40%<>増加する。<#ff9028ff>守りの型<>：味方が行動妨害を受けるか敵に詰め寄られると、その味方へ突進し、両者が<#ffb900ff>2秒<>間<#e8d44dff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の80%<>の<#e8d44dff>シールド<>を得る（<#ffb900ff>12秒<>毎）。",
        "skill": "<#ff9028ff>響掌<>：音波を放ち、最初に当たった敵に<#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の90%<>の<#ff9028ff>物理ダメージ<>を与えて印を残す。<#ff9028ff>共鳴撃<>：<#ffb900ff>0.2秒<>後、印の付いた敵に飛び蹴りで素早く接近し、<#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "skill2": "<#ff9028ff>破風<>：跳び上がって地面を強打し、周囲の敵に<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の80%<>の<#ff9028ff>物理ダメージ<>を与える。<#ff9028ff>縛脚<>：命中した敵を<#ffb900ff>2秒<>間<#ffb900ff>40%<>の<#ef5350ff>スロウ<>にする。<#ff9028ff>鉄の意志<>で<#ffb900ff>3秒<>間<#6aff55ff>20%のライフスティール<>を得る。",
        "ult": "<#ff9028ff>龍の怒り<>：対象の背後に敵チャンピオンがいれば正面から蹴り込み、いなければ背後に回って味方の方へ回し蹴り。<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の130%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>ノックバック<>。蹴り飛ばされた対象と衝突した敵は<#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の80%<>の<#ff9028ff>物理ダメージ<>を受け、<#ffb900ff>0.75秒<>間<#ef5350ff>ノックアップ<>。"
      },
      "league_soraka": {
        "name": "ソラカ",
        "attack": "通常攻撃は杖から星の光弾を放ち、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "skill": "<#a974ffff>70<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の50%<>の<#a974ffff>魔法ダメージ<>と<#ef5350ff>30%スロウ<>を与える。敵チャンピオンに命中すると<#ff9028ff>「再生」<>：<#ffb900ff>2.5秒<>で<#6aff55ff>体力を75<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の30%<>回復し移動速度20%増加。<#ffb900ff>16秒<>に1回<#ff9028ff>星の静寂<>を伴う：範囲内の敵を<#ef5350ff>サイレンス<>にし、<#ffb900ff>1.5秒<>後も残った敵を<#ef5350ff>1秒スネア<>にして<#a974ffff>40<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の30%<>の<#a974ffff>魔法ダメージ<>を与える。",
        "skill2": "<i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>最大体力の6%<>を消費し（倒れることはない）、自分以外の味方チャンピオン1体の<#6aff55ff>体力を200<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の50%<>回復する。<#ff9028ff>「再生」<>中は体力を消費せず、対象にも<#ff9028ff>「再生」<>を付与。パッシブ<#ff9028ff>救済の足音<>：発動後<#ffb900ff>2秒<>間<i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>移動速度が30%<>増加。",
        "ult": "<#ff9028ff>星に願いを<>：距離に関係なく、すべての味方チャンピオン（ソラカを含む）の<#6aff55ff>体力を220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の60%<>回復する。"
      },
      "league_darius": {
        "name": "ダリウス",
        "attack": "通常攻撃は斧を振り下ろし、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与える。パッシブ <#ff9028ff>大出血<>：通常攻撃と<#ff9028ff>皆殺しの斧<>が命中した敵を<#ffb900ff>5秒<>間出血させ、合計<#ff9028ff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の20%<>の<#ff9028ff>物理ダメージ<>を与える（重複可）。<#ffb900ff>5秒<>以内に敵チャンピオンに<#ffb900ff>5<>回命中させると<#ff9028ff>紅血の激昂<>を得て、<#ffb900ff>5秒<>間<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力<>が<#ffb900ff>40%<>増加する。",
        "skill": "<#ff9028ff>皆殺しの斧<>：斧を構えてから一回転させ、周囲の敵に<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の110%<>の<#ff9028ff>物理ダメージ<>を与えて<#ff9028ff>大出血<>を付与する。敵チャンピオン1体に命中するごとに<#6aff55ff>体力<>を<#6aff55ff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の30%<>回復する。",
        "skill2": "<#ff9028ff>捕縛<>：斧の鉤で前方の扇形範囲を薙ぎ払い、範囲内の敵をすべて自分の元へ<#ef5350ff>引き寄せ<>、<#ffb900ff>1秒<>間<#ffb900ff>40%<>の<#ef5350ff>スロウ<>にする。その後<#ffb900ff>4秒<>以内の次の通常攻撃が<#ff9028ff>脚削ぎ<>になり、<#ff9028ff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の150%<>の<#ff9028ff>物理ダメージ<>を与えて<#ffb900ff>1秒<>間<#ffb900ff>90%<>の<#ef5350ff>スロウ<>にする。",
        "ult": "<#ff9028ff>ノクサスギロチン<>：敵チャンピオンに飛びかかって強烈な一撃を加え、<#f5f5f5ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#f5f5f5ff>確定ダメージ<>を与える。直近<#ffb900ff>5秒<>間の敵チャンピオンへの命中1回ごとにダメージが<#ffb900ff>20%<>増加し、<#ff9028ff>紅血の激昂<>中はダメージが2倍になる。"
      },
      "league_amumu": {
        "name": "アムム",
        "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与える。パッシブ <#ff9028ff>呪いの手<>・<#ff9028ff>めそめそ<>：通常攻撃かスキルの後<#ffb900ff>4秒<>間泣き、毎秒周囲の敵に<#a974ffff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の10%<>の<#a974ffff>魔法ダメージ<>（チャンピオンには<#f5f5f5ff>最大体力の1%<>の<#f5f5f5ff>確定ダメージ<>も）を与えて<#ef5350ff>呪い<>を付与する：<#ef5350ff>受けるダメージ量が10%増加<>。",
        "skill": "包帯を投げる。包帯はミニオンとモンスターをすり抜け、最初に当たった敵チャンピオンに<#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の70%<>の<#a974ffff>魔法ダメージ<>を与えて<#ffb900ff>1秒<>間<#ef5350ff>スタン<>させ、アムムはその敵へ飛んでいく。",
        "skill2": "周囲の敵に<#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の50%<>の<#a974ffff>魔法ダメージ<>を与える。パッシブ：通常攻撃から受けるダメージが<#ffb900ff>10%<>減少する。",
        "ult": "周囲のすべての敵を包帯で縛り、<#a974ffff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の80%<>の<#a974ffff>魔法ダメージ<>を与えて<#ffb900ff>1.5秒<>間<#ef5350ff>スタン<>させ、<#ffb900ff>3秒<>間<#ef5350ff>呪い<>を付与する。"
      },
      "league_yasuo": {
        "name": "ヤスオ",
        "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与える。パッシブ <#ff9028ff>浪人道<>：クリティカル率<#ffb900ff>20%<>、クリティカルで2倍ダメージ。<#ff9028ff>波動<>は<#ffb900ff>15秒<>ごとに満タンになり、次の行動で<#ffb900ff>2秒<>間<#e8d44dff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の40%<>の<#e8d44dff>シールド<>を得る。",
        "skill": "前方に突きを放ち、直線上の敵に<#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与える。通常攻撃扱いでクリティカルが発生する。命中すると<#ff9028ff>つむじ風<>のスタックを得て、<#ffb900ff>2<>スタックで次の発動時に旋風を放ち、直線上の敵を<#ffb900ff>1秒<>間<#ef5350ff>ノックアップ<>させる。<#ff9028ff>風薙ぎ<>中は円状に斬る。",
