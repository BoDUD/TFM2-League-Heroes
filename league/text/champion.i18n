      "league_sion": {
        "name": "赛恩",
        "attack": "<#ff9028ff>灵魂熔炉<>被动：普攻每击杀一个单位，永久获得<#6aff55ff>6<>点最大生命值（阵亡后重新累积）。",
        "skill": "蓄力<#ffb900ff>0.67秒<>后向前砸地，直线上的敌人受到<#ff9028ff>140<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>180%<><#ff9028ff>物理伤害<>并<#ef5350ff>击飞0.83秒<>；蓄力时被控制会打断。",
        "skill2": "怒吼穿过小兵，造成<#a974ffff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#a974ffff>4%<><#a974ffff>魔法伤害<>，<#ef5350ff>减速40%<>，护甲降低20%。<#ff9028ff>灵魂熔炉<>：获得<#e8d44dff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#e8d44dff>100%<>护盾，<#ffb900ff>3秒<>后护盾仍在则爆炸，造成<#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#a974ffff>8%<><#a974ffff>魔法伤害<>。",
        "ult": "免疫控制冲向敌方英雄，撞到第一个英雄造成<#ff9028ff>200-400<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理伤害<>并<#ef5350ff>击飞0.75-1.58秒<>（冲得越远越强），周围敌人<#ef5350ff>减速40%<>。救被控的队友、团战、和队友一起追击时才冲。"
      },
      "league_kindred": {
        "name": "千珏",
        "attack": "<#ff9028ff>千珏之印<>：羊灵射箭。参与击杀被她攻击过的敌方英雄获得一层印记（阵亡清空）：射程+15、攻速+4%、<#ff9028ff>横生惧意<>+<#a974ffff>8魔法伤害<>。",
        "skill": "跃动一小段（被近身时向后），向附近最多<#ffb900ff>3名<>敌人各射一箭，造成<#ff8a65ff>45<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff8a65ff>65%<><#ff8a65ff>物理伤害<>，攻速+35%持续<#ffb900ff>4秒<>。在<#ff9028ff>狼灵狂热<>内冷却<#ffb900ff>4秒<>。",
        "skill2": "<#ff9028ff>横生惧意<>：标记敌人并<#ef5350ff>减速30%<>，此后第<#ffb900ff>3次<>攻击命中时狼灵扑咬被标记者，造成<#ff8a65ff>60<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff8a65ff>90%<><#ff8a65ff>物理伤害<>（英雄额外4%最大生命）。冷却时放<#ff9028ff>狼灵狂热<>：<#ffb900ff>8.5秒<>领域，狼灵每秒撕咬其中一个敌人，造成<#ff8a65ff>25<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff8a65ff>25%<><#ff8a65ff>物理伤害<>。",
        "ult": "友方英雄被控制且身边有敌方英雄，或持续交战中友方英雄（含自己）身边有2名以上敌方英雄时，祝福身边区域：<#ffb900ff>4秒<>内其中的友方英雄不会阵亡，结束时回复<#7dd87dff>150<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#7dd87dff>40%<>生命。"
      },
      "league_malzahar": {
        "name": "玛尔扎哈",
        "attack": "射出虚空弹。被动<#ff9028ff>虚空穿越<>：获得<#ffb900ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#ffb900ff>40%<>护盾，护盾存在时<#ef5350ff>免疫控制<>；护盾被打破后<#ffb900ff>12秒<>重新获得。",
        "skill": "<#ff9028ff>煞星幻象<>：<#ffb900ff>4秒<>内造成<#a974ffff>170<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<><#a974ffff>魔法伤害<>，目标死亡时跳到附近的敌人身上。<#ff9028ff>虚空虫群<>随之撕咬目标，每<#ffb900ff>0.5秒<>造成<#a974ffff>14<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>8%<><#a974ffff>魔法伤害<>。",
        "skill2": "在目标两侧打开虚空裂隙，裂隙合拢时对范围内的敌人造成<#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<><#a974ffff>魔法伤害<>并<#ef5350ff>沉默1.5秒<>。",
        "ult": "压制一名敌方英雄（优先煞星幻象的目标）：引导期间使其<#ef5350ff>眩晕<>，<#ffb900ff>2.5秒<>内造成<#a974ffff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<><#a974ffff>魔法伤害<>，脚下留下持续伤害的虚空区域。玛尔扎哈被控制时引导中断。"
