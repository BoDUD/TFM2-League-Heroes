  "en": {
    "description": {
      "league_garen": {
        "name": "Garen",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<>.",
        "skill": "<#ff9028ff>Decisive Strike<>: Garen gains <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>35% movement speed<> for <#ffb900ff>1.5s<>. His next basic attack within <#ffb900ff>4.5s<> becomes a leaping strike that deals <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150% AD<> <#ff9028ff>physical damage<> and <#ef5350ff>silences<> the target for <#ffb900ff>1.5s<>. He also gains <#ff9028ff>Courage<>: <#ffb900ff>30%<> damage reduction and <#ffb900ff>60%<> tenacity for <#ffb900ff>2s<>, plus a <#e8d44dff>shield<> of <#e8d44dff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50% AD<>.",
        "skill2": "<#ff9028ff>Judgment<>: Garen spins his sword for <#ffb900ff>3s<> and chases his target while spinning. Each of the <#ffb900ff>7<> spins deals <#ff9028ff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>55% AD<> <#ff9028ff>physical damage<> to nearby enemies, <#ffb900ff>25%<> more to the one he chases; the <#ffb900ff>7th<> spin lowers their <i#asset/base/ui/banpick/champion_stat_icon:armor_0><#ffdd8eff>armor<> by <#ffb900ff>25%<> for <#ffb900ff>6s<>. Passive <#ff9028ff>Perseverance<>: Garen has very high <#6aff55ff>health regeneration<>.",
        "ult": "<#ff9028ff>Demacian Justice<>: Calls a giant sword down on the target enemy champion, dealing <#f5f5f5ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120% AD<> + <#f5f5f5ff>12% of its max health<> <#f5f5f5ff>true damage<>."
      },
      "league_ashe": {
        "name": "Ashe",
        "attack": "Basic attacks fire frost arrows that deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<>. Passive <#ff9028ff>Frost Shot<>: basic attacks <#ef5350ff>slow<> the target by <#ffb900ff>20%<> for <#ffb900ff>1s<>.",
        "skill": "<#ff9028ff>Ranger's Focus<>: Ashe gains <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>30% attack speed<> for <#ffb900ff>4s<>. Meanwhile her basic attacks become a flurry that deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130% AD<> <#ff9028ff>physical damage<> and <#ef5350ff>slows<> the target by <#ffb900ff>30%<>.",
        "skill2": "<#ff9028ff>Volley<>: Fires <#ffb900ff>9<> frost arrows in a cone ahead, dealing <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<> to each enemy in the cone (once per enemy) and <#ef5350ff>slowing<> them by <#ffb900ff>25%<> for <#ffb900ff>1.5s<>.",
        "ult": "<#ff9028ff>Enchanted Crystal Arrow<>: Fires a far-flying crystal arrow that stops at the first enemy champion, dealing <#ff9028ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<> and <#ef5350ff>stunning<> it for <#ffb900ff>1.75s<>. The arrow bursts where it stops, dealing <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50% AD<> <#ff9028ff>physical damage<> to nearby enemies and <#ef5350ff>slowing<> them by <#ffb900ff>50%<> for <#ffb900ff>2s<>."
      },
      "league_lux": {
        "name": "Lux",
        "attack": "Basic attacks fire bolts of light from her wand that deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<>. Passive <#ff9028ff>Illumination<>: for <#ffb900ff>5s<> after her abilities hit an enemy, her next basic attack ignites the light for <#a974ffff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>35% Ability Power<> bonus <#a974ffff>magic damage<>.",
        "skill": "<#ff9028ff>Light Binding<>: Fires an orb of light that deals <#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>75% Ability Power<> <#a974ffff>magic damage<> to every enemy in its path and <#ef5350ff>roots<> them for <#ffb900ff>1.5s<>. Also casts <#ff9028ff>Prismatic Barrier<>: Lux and nearby allied champions gain a <#e8d44dff>55<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>40% Ability Power<> <#e8d44dff>shield<> for <#ffb900ff>2.5s<>.",
        "skill2": "<#ff9028ff>Lucent Singularity<>: Lobs an orb of light that lands as a glowing field, <#ef5350ff>slowing<> enemies inside by <#ffb900ff>20%<>. After <#ffb900ff>1s<> it detonates, dealing <#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80% Ability Power<> <#a974ffff>magic damage<> to enemies in the field.",
        "ult": "<#ff9028ff>Final Spark<>: Lux leaps up and gathers light, then after <#ffb900ff>0.5s<> fires a huge laser toward the target, dealing <#a974ffff>250<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>115% Ability Power<> <#a974ffff>magic damage<> to all enemies in the line."
      },
      "league_leesin": {
        "name": "Lee Sin",
        "attack": "Basic attacks are punches that deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<>. Passive <#ff9028ff>Flurry<>: after each ability, his next <#ffb900ff>2<> basic attacks within <#ffb900ff>3s<> gain <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>40% attack speed<>.",
        "skill": "<#ff9028ff>Sonic Wave<>: Sends out a wave of sound that deals <#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90% AD<> <#ff9028ff>physical damage<> to the first enemy hit and marks it. <#ff9028ff>Resonating Strike<>: <#ffb900ff>0.2s<> later Lee Sin flies at the marked enemy with a kick, dealing <#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<>.",
        "skill2": "<#ff9028ff>Tempest<>: Lee Sin leaps and smashes the ground, dealing <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80% AD<> <#ff9028ff>physical damage<> to nearby enemies; <#ff9028ff>Cripple<>: enemies hit are <#ef5350ff>slowed<> by <#ffb900ff>40%<> for <#ffb900ff>2s<>. Also casts <#ff9028ff>Safeguard<>: Lee Sin and nearby allied champions gain a <#e8d44dff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60% AD<> <#e8d44dff>shield<> for <#ffb900ff>2s<>, and <#ff9028ff>Iron Will<>: Lee Sin gains <#6aff55ff>20% life steal<> for <#ffb900ff>3s<>.",
        "ult": "<#ff9028ff>Dragon's Rage<>: A spinning jump kick deals <#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130% AD<> <#ff9028ff>physical damage<> to the target champion and <#ef5350ff>kicks it back<>. Enemies it crashes into take <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80% AD<> <#ff9028ff>physical damage<> and are <#ef5350ff>knocked up<> for <#ffb900ff>0.75s<>."
      },
      "league_soraka": {
        "name": "Soraka",
        "attack": "Basic attacks fire a bolt of starlight from her staff that deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<>.",
        "skill": "Deals <#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50% Ability Power<> <#a974ffff>magic damage<> and <#ef5350ff>slows<> by 30%. Hitting a champion grants <#ff9028ff>Rejuvenation<>: she heals <#6aff55ff>75<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30% Ability Power<> over <#ffb900ff>2.5s<> and gains 20% Move Speed. Once per <#ffb900ff>16s<> it adds <#ff9028ff>Equinox<>: <#ef5350ff>silences<> enemies inside; those still inside after <#ffb900ff>1.5s<> are <#ef5350ff>rooted<> for 1s and take <#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30% Ability Power<> <#a974ffff>magic damage<>.",
        "skill2": "Spends <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#6aff55ff>6% of her max health<> (never fatal) to heal another allied champion for <#6aff55ff>200<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50% Ability Power<>. With <#ff9028ff>Rejuvenation<> it costs no health and the target gains Rejuvenation too. Passive <#ff9028ff>Salvation<>: <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>30% Move Speed<> for <#ffb900ff>2s<> after casting.",
        "ult": "<#ff9028ff>Wish<>: Restores <#6aff55ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60% Ability Power<> <#6aff55ff>health<> to every allied champion on the map, Soraka included."
      },
      "league_darius": {
        "name": "Darius",
        "attack": "Basic attacks are axe chops that deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<>. Passive <#ff9028ff>Hemorrhage<>: enemies hit by basic attacks and <#ff9028ff>Decimate<> bleed for <#ffb900ff>5s<>, taking <#ff9028ff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>20% AD<> <#ff9028ff>physical damage<> in total; it stacks. After <#ffb900ff>5<> hits within <#ffb900ff>5s<> Darius gains <#ff9028ff>Noxian Might<>: <#ffb900ff>40%<> more <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>Attack Damage<> for <#ffb900ff>5s<>.",
        "skill": "<#ff9028ff>Decimate<>: Darius winds up and swings his axe in a full circle, dealing <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110% AD<> <#ff9028ff>physical damage<> to nearby enemies and applying <#ff9028ff>Hemorrhage<>. He heals <#6aff55ff>25<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30% AD<> for each enemy champion hit.",
        "skill2": "<#ff9028ff>Apprehend<>: Darius sweeps a cone in front of him with his axe's hook and <#ef5350ff>pulls<> every enemy in it to him. His next basic attack within <#ffb900ff>4s<> becomes <#ff9028ff>Crippling Strike<>: <#ff9028ff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150% AD<> <#ff9028ff>physical damage<> and a <#ffb900ff>90%<> <#ef5350ff>slow<> for <#ffb900ff>1s<>.",
        "ult": "<#ff9028ff>Noxian Guillotine<>: Darius leaps to an enemy champion and strikes a lethal blow, dealing <#f5f5f5ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#f5f5f5ff>true damage<>. Each hit he landed in the last <#ffb900ff>5s<> adds <#ffb900ff>20%<> damage; during <#ff9028ff>Noxian Might<> the damage is doubled."
      },
      "league_amumu": {
        "name": "Amumu",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<>. Passive <#ff9028ff>Cursed Touch<> and <#ff9028ff>Despair<>: after a basic attack or any ability Amumu cries for <#ffb900ff>4s<>, dealing <#a974ffff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>10% Ability Power<> <#a974ffff>magic damage<> to nearby enemies every second (champions also take <#f5f5f5ff>1% of their max health<> as <#f5f5f5ff>true damage<>) and <#ef5350ff>Cursing<> them: they <#ef5350ff>take 10% more damage<>.",
        "skill": "Throws a bandage that passes through minions and monsters and sticks to the first enemy champion, dealing <#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70% Ability Power<> <#a974ffff>magic damage<> and <#ef5350ff>stunning<> it for <#ffb900ff>1s<>; Amumu then pulls himself to it.",
        "skill2": "Deals <#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50% Ability Power<> <#a974ffff>magic damage<> to nearby enemies. Passive: Amumu takes <#ffb900ff>10%<> less damage from basic attacks.",
        "ult": "Entangles every nearby enemy in bandages, dealing <#a974ffff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80% Ability Power<> <#a974ffff>magic damage<>, <#ef5350ff>stunning<> them for <#ffb900ff>1.5s<> and <#ef5350ff>Cursing<> them for <#ffb900ff>3s<>."
      },
      "league_yasuo": {
        "name": "Yasuo",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<>. Passive <#ff9028ff>Way of the Wanderer<>: <#ffb900ff>20%<> critical strike chance; crits deal double damage. <#ff9028ff>Flow<> fills every <#ffb900ff>12s<>; when full, Yasuo's next attack or ability grants him a <#e8d44dff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60% AD<> <#e8d44dff>shield<> for <#ffb900ff>2s<>.",
        "skill": "Thrusts forward, dealing <#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<> to enemies in a line. It is treated as a basic attack and can critically strike. On hit Yasuo gains a stack of <#ff9028ff>Gathering Storm<>; at <#ffb900ff>2<> stacks the next cast fires a whirlwind that <#ef5350ff>knocks up<> enemies in a line for <#ffb900ff>1s<>. Cast during <#ff9028ff>Sweeping Blade<>, it strikes in a circle.",
        "skill2": "Dashes through an enemy, dealing <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60% AD<> <#ff9028ff>physical damage<>. Each cast within <#ffb900ff>6s<> of the last deals <#ffb900ff>25%<> more damage, up to <#ffb900ff>50%<>.",
        "ult": "Blinks to an enemy champion under crowd control (<#ef5350ff>knocked up<>, <#ef5350ff>stunned<>, <#ef5350ff>rooted<>...) and deals <#ff9028ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150% AD<> <#ff9028ff>physical damage<> to every crowd-controlled enemy champion nearby, keeping them <#ef5350ff>airborne<> for <#ffb900ff>1s<> more. For <#ffb900ff>10s<> after, Yasuo ignores <#ffb900ff>30%<> of their <#ffdd8eff>Armor<>, and his <#ff9028ff>Flow<> is refilled."
      },
      "league_jinx": {
        "name": "Jinx",
        "attack": "<#ff9028ff>Switcheroo!<>: with an enemy close, Jinx fires <#ff9028ff>Pow-Pow<>: <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<>, each shot granting <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>15% attack speed<> (up to <#ffb900ff>3<> times). Otherwise she fires <#ff9028ff>Fishbones<> from further away, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110% AD<> to the target and enemies around it. <#ff9028ff>Get Excited!<>: a champion kill grants <i#asset/base/ui/banpick/champion_stat_icon:attack_speed_0><#ceff99ff>25% attack speed<> and <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>100% move speed<> (fading) for <#ffb900ff>6s<>.",
        "skill": "After a <#ffb900ff>0.4s<> charge, Jinx fires a shock blast that deals <#ff9028ff>75<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120% AD<> <#ff9028ff>physical damage<> to the first enemy hit and <#ef5350ff>slows<> it by <#ffb900ff>25%<> for <#ffb900ff>2s<>.",
        "skill2": "Jinx tosses <#ffb900ff>3<> chompers at an enemy champion's feet. They arm after <#ffb900ff>0.5s<> and last up to <#ffb900ff>5s<>. When an enemy champion steps on them they explode, <#ef5350ff>rooting<> the enemy champions caught for <#ffb900ff>1.5s<> and dealing <#ff9028ff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<>; then the chompers are gone.",
        "ult": "Jinx fires a rocket across the map. It flies past minions and monsters and explodes on the first enemy champion, dealing <#ff9028ff>175<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90% AD<> + <#ff9028ff>10% of the target’s max health<> <#ff9028ff>physical damage<> to enemies around it."
      }
    },
