      "league_syndra": {
        "name": "シンドラ",
        "attack": "パッシブ <#ff9028ff>絶大なる魔力<>：<#ffb900ff>3<>レベルでQのチャンピオンへのダメージ+25%、<#ffb900ff>5<>レベルでWに<#ffffffff>20%確定ダメージ<>、<#ffb900ff>7<>レベルでE拡大、<#ffb900ff>9<>レベルでRが魔法防御無視。",
        "skill": "ダークスフィアが周囲の敵に<#a974ffff>62<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>52%<>の<#a974ffff>魔法ダメージ<>。スフィアは<#ffb900ff>6秒<>残る。",
        "skill2": "まず<#ff9028ff>ダークフォース<>でスフィアを敵チャンピオンに投げ<#a974ffff>55<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>55%<>の<#a974ffff>魔法ダメージ<>と<#ef5350ff>30%スロウ<>。続けて扇状に<#a974ffff>45<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<>の<#a974ffff>魔法ダメージ<>とノックバック、押されたスフィアが周囲の敵を<#ef5350ff>1.25秒スタン<>。",
        "ult": "敵チャンピオン1体に<#ffb900ff>3個+残りのスフィア<>（最大7個）を放ち、1個ごとに<#a974ffff>52<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>18%<>の<#a974ffff>魔法ダメージ<>。"
      },
      "league_viego": {
        "name": "ヴィエゴ",
        "attack": "<#ff9028ff>王の支配<>：ダメージを与えた敵チャンピオンが3秒以内に倒れると魂に憑依<#ffb900ff>10秒<>：<#ef5350ff>1秒無敵<>、<#ffb900ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ffb900ff>50%<>回復、攻撃力+20%・攻撃速度+30%・移動速度+15%、QとWのクールダウン半減。通常攻撃はチャンピオンに最大体力の2%を追加。",
        "skill": "前方へ突き、<#ff9028ff>50<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%<>のダメージ。当たったチャンピオンに<#ffb900ff>4秒<>の刻印：次の通常攻撃が2回斬り、<#ff9028ff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60%<>の追加ダメージと<#ffb900ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ffb900ff>30%<>回復。",
        "skill2": "<#ff9028ff>彷徨える苦悶<>：霧が立ちのぼり<#ffb900ff>5秒<>移動速度+30%・攻撃速度+40%、霧の中（2.5秒）では透明。続けて突進し亡霊を放ち、最初に当たった敵に<#ff9028ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%<>のダメージと<#ef5350ff>1.1秒スタン<>。",
        "ult": "味方が交戦中の敵チャンピオンへ跳び<#ef5350ff>99%スロウ<>、着地で貫き<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120%<>+最大体力の12%のダメージ、周囲の他の敵はノックバック。憑依を終える。"
      },
      "league_zeri": {
        "name": "ゼリ",
        "attack": "通常攻撃は<#ff9028ff>バーストファイア<>：最初の敵に7連射。パッシブ<#ff9028ff>生体バッテリー<>：<#ffb900ff>5<>回の攻撃で充電、次の攻撃はチャージ弾で<#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>100%<>の<#a974ffff>魔法ダメージ<>と<#ef5350ff>スロウ<>、チャンピオンには<#ffffffff>最大体力4%の確定ダメージ<>、自身にシールドと移動速度。",
        "skill": "電気パルスが最初の敵に<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>35%スロウ<>。ミニオンかモンスターに当たるとそこから長いレーザーになり、後ろの敵全員に命中。",
        "skill2": "短くダッシュ（敵が近いと後ろへ）、その後<#ffb900ff>5秒<>バーストファイアが貫通：後ろの敵に80%と<#a974ffff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>の<#a974ffff>魔法ダメージ<>。チャンピオン命中でCD短縮。",
        "ult": "周囲の敵に<#a974ffff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>100%<>の<#a974ffff>魔法ダメージ<>、<#ffb900ff>5秒<>オーバーチャージ：攻撃速度+30%、移動速度+20%（チャンピオン命中で累積・延長）、通常攻撃は敵間を連鎖する稲妻の3連射に。"
      },
      "league_nautilus": {
        "name": "ノーチラス",
        "attack": "<#ff9028ff>鉄の錨<>：敵チャンピオンへの通常攻撃で<#ef5350ff>0.83秒スネア<>し、<#a974ffff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>の<#a974ffff>魔法ダメージ<>を追加。その後<#ffb900ff>6秒<>は発動しない。",
        "skill": "錨を投げ、最初に当たった敵チャンピオンに<#a974ffff>75<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<>の<#a974ffff>魔法ダメージ<>、互いを引き寄せる。",
        "skill2": "<#ff9028ff>大海の激憤<>：<#9fd8ffff>110<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#9fd8ffff>60%<>の<#9fd8ffff>シールド<>、<#ffb900ff>6秒<>間通常攻撃が対象周囲の敵にも<#a974ffff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>20%<>。<#ff9028ff>粉砕水<>：周囲に3回の波、<#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<>の<#a974ffff>魔法ダメージ<>と<#ffb900ff>1.25秒<><#ef5350ff>40%スロウ<>。",
        "ult": "射程内の敵チャンピオンへ衝撃波：通り道の敵は<#ef5350ff>ノックアップ<>し<#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>、対象は<#a974ffff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>の<#a974ffff>魔法ダメージ<>、<#ef5350ff>1秒打ち上げ後0.75秒スタン<>。"
      },
      "league_gragas": {
        "name": "グラガス",
        "attack": "<#ff9028ff>ハッピーアワー<>：スキル使用時にひと口飲み、<#7dd87dff>55/85 + <i#asset/base/ui/banpick/champion_stat_icon:ap_0>20%<>回復（レベル3から後者）。その後<#ffb900ff>12秒<>は発動しない。",
        "skill": "タルを転がし、着地<#ffb900ff>0.75秒<>後に爆発。周囲の敵に<#a974ffff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<>の<#a974ffff>魔法ダメージ<>と<#ffb900ff>2秒<><#ef5350ff>40%スロウ<>。",
        "skill2": "敵に突進し最初に当たった敵で止まる：周囲の敵に<#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<>の<#a974ffff>魔法ダメージ<>と<#ef5350ff>1秒スタン<>、命中時CD一部回復。<#ff9028ff>飲みすぎ注意<>：続けて飲み、<#ffb900ff>2.5秒<>間被ダメージ20%軽減、次の通常攻撃が周囲の敵に<#a974ffff>55<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<>の<#a974ffff>魔法ダメージ<>、チャンピオンには最大体力の6%確定ダメージ。",
        "ult": "敵チャンピオンにタルを投げつけ、周囲の敵に<#a974ffff>240<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<>の<#a974ffff>魔法ダメージ<>を与え、<#ef5350ff>グラガスの方へ吹き飛ばす<>。"
      },
      "league_irelia": {
        "name": "イレリア",
        "attack": "パッシブ<#ff9028ff>アイオニアの熱情<>：瞬刃の命中、スキルのチャンピオン命中ごとに攻撃速度+11%（最大<#ffb900ff>4<>、<#ffb900ff>6秒<>）。最大時、通常攻撃が<#ff9028ff>12<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>20%<>の<#ff9028ff>物理ダメージ<>を追加。",
        "skill": "対象へダッシュし<#ff9028ff>38<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<>の<#ff9028ff>物理ダメージ<>、体力10 + <i#asset/base/ui/banpick/champion_stat_icon:ad_0>13%回復。対象が<#ff9028ff>マーク<>付きか倒れると即座に再ダッシュ（1回で最大<#ffb900ff>3<>回）。",
        "skill2": "2本の刃が合わさり間の敵に<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%<>の<#ff9028ff>物理ダメージ<>と<#ef5350ff>0.75秒スタン<>、チャンピオンに<#ff9028ff>マーク<>。CD中、近くでは<#ff9028ff>不屈の舞<>：通常攻撃のダメージ50%軽減後、<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>115%<>の<#ff9028ff>物理ダメージ<>。",
        "ult": "刃が最初のチャンピオンで炸裂、扇状の敵に<#ff9028ff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>85%<>の<#ff9028ff>物理ダメージ<>、<#ef5350ff>70%スロウと1秒武装解除<>、チャンピオンに<#ff9028ff>マーク<>。刃の壁が<#ffb900ff>2.5秒<>残り、内側の敵に40%スロウ。"
      },
      "league_kassadin": {
        "name": "カサディン",
        "attack": "<#ff9028ff>ヴォイドストーン<>：受ける魔法ダメージ約10%軽減。<#ff9028ff>ネザーブレード<>：通常攻撃に<#a974ffff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>10%<>の<#a974ffff>魔法ダメージ<>、<#ffb900ff>7秒<>ごとに1回<#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<>の<#a974ffff>魔法ダメージ<>追加。",
        "skill": "対象に球を放ち<#a974ffff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<>の<#a974ffff>魔法ダメージ<>、チャンピオンの動作を中断。自身に<#ffb900ff>1.5秒<>50 + <i#asset/base/ui/banpick/champion_stat_icon:ap_0>40%のシールド。",
        "skill2": "前方の扇形に波動を放ち<#a974ffff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<>の<#a974ffff>魔法ダメージ<>と<#ffb900ff>1秒<><#ef5350ff>50%スロウ<>。ヴォイドスフィアかリフトウォークを使うたびCD短縮。",
        "ult": "近くの敵チャンピオンの傍へ瞬間移動し、周囲の敵に<#a974ffff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50%<>の<#a974ffff>魔法ダメージ<>。<#ffb900ff>15秒<>以内の再使用でスタック（最大<#ffb900ff>3<>）、1つごとに<#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>10%<>の<#a974ffff>魔法ダメージ<>追加。"
      },
      "league_corki": {
        "name": "コーキ",
        "attack": "<#ff9028ff>ヘクステック榴散弾<>：通常攻撃ダメージの20%が<#ffffffff>確定ダメージ<>。<#ff9028ff>荷物便<>：開始時・復活後・<#ffb900ff>45秒<>ごとに次のワルキューレ機行が強化：離陸時に周囲のチャンピオンを<#ef5350ff>ノックバック<>し<#a974ffff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30%<>の<#a974ffff>魔法ダメージ<>、より遠く飛び炎が広く長く、移動速度30%増加。",
        "skill": "指定地点に閃光弾を投げ、範囲内の敵に<#a974ffff>95<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<>の<#a974ffff>魔法ダメージ<>と<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>55%<>の<#ff9028ff>物理ダメージ<>。",
        "skill2": "<#ff9028ff>ガトリングガン<>：<#ffb900ff>4秒<>間前方の扇状に掃射、毎回<#ff9028ff>9<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>16%<>の<#ff9028ff>物理<>と<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>9%魔法ダメージ<>、防御低下が累積。CD中に敵チャンピオンが接近すると<#ff9028ff>ワルキューレ機行<>：後方へ飛び炎を残し、<#ffb900ff>0.5秒<>ごとに<#a974ffff>15<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>12%<>の<#a974ffff>魔法ダメージ<>。",
        "ult": "ミサイルを<#ffb900ff>4発<>蓄える（<#ffb900ff>10秒<>ごとに1発）。最初に当たった敵で爆発し周囲に<#a974ffff>75<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>42%<>の<#a974ffff>魔法ダメージ<>と<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>52%<>の<#ff9028ff>物理ダメージ<>。3発目は大型：範囲拡大、ダメージ200%。"
      },
      "league_braum": {
        "name": "ブラウム",
        "attack": "<#ff9028ff>漢の拳<>：通常攻撃と冬の凍瘡がチャンピオンにスタック、<#ffb900ff>4<>で<#ef5350ff>1.25秒スタン<>と<#a974ffff>85<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<>の<#a974ffff>魔法ダメージ<>、その後<#ffb900ff>8秒<>スタックせず通常攻撃に<#a974ffff>12<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>10%<>の<#a974ffff>魔法ダメージ<>追加。",
        "skill": "盾から氷を放ち<#a974ffff>105<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<>+最大体力の2%の<#a974ffff>魔法ダメージ<>と<#ef5350ff>70%スロウ<>（<#ffb900ff>2秒<>で35%まで減衰）。",
        "skill2": "<#ffb900ff>3.5秒<>盾を構え被ダメージ50%軽減、60 + <i#asset/base/ui/banpick/champion_stat_icon:ap_0>40%のシールド、傍の味方チャンピオンも20%軽減。<#ff9028ff>ワシに任せとけ！<>：味方チャンピオンへ跳び、両者の物防と魔防+30（<#ffb900ff>3秒<>）。",
        "ult": "地面を叩き対象へ裂溝を走らせ<#a974ffff>180<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<>の<#a974ffff>魔法ダメージ<>と<#ef5350ff>0.6秒ノックアップ<>（最初のチャンピオン1.25秒）、裂溝は<#ffb900ff>4秒<><#ef5350ff>40%スロウ<>。"
      },
      "league_mordekaiser": {
        "name": "モルデカイザー",
        "attack": "<#ff9028ff>無窮の闇<>：通常攻撃に<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>40%魔法ダメージ<>追加。通常攻撃・Q・Eがチャンピオンに当たるとスタック、3スタックで移動速度3%増加、<#ffb900ff>0.5秒<>ごとに周囲の敵に<#a974ffff>4<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15%<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#a974ffff>1%<>の<#a974ffff>魔法ダメージ<>。",
        "skill": "前方の直線を鉄槌で叩き<#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>70%<>の<#a974ffff>魔法ダメージ<>、敵1体だけなら<#a974ffff>112<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>98%<>。",
        "skill2": "呪縛の手を放ち<#a974ffff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60%<>の<#a974ffff>魔法ダメージ<>、敵を<#ef5350ff>引き寄せる<>。CD中に敵が接近すると<#ff9028ff>不滅の鎧<>：<#7ee87eff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#7ee87eff>60%のシールド<>、残っていれば<#7ee87eff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#7ee87eff>40%<>回復。",
        "ult": "敵チャンピオンを<#ffb900ff>7秒<>呪う：攻撃力・魔力・物防・魔防・体力の10%を奪い、逃げると<#ef5350ff>引き戻す<>。その間に倒すと<#7ee87eff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#7ee87eff>50%<>回復。"
