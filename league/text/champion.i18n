      "league_sion": {
        "name": "賽恩",
        "attack": "<#ff9028ff>魂魄熔爐<>被動：普攻每擊殺一個單位，永久獲得<#6aff55ff>6<>點最大生命值（陣亡後重新累積）。",
        "skill": "蓄力<#ffb900ff>0.67秒<>後向前砸地，直線上的敵人受到<#ff9028ff>140<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>180%<><#ff9028ff>物理傷害<>並<#ef5350ff>擊飛0.83秒<>；蓄力時被控制會打斷。",
        "skill2": "怒吼穿過小兵，造成<#a974ffff>120<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#a974ffff>4%<><#a974ffff>魔法傷害<>，<#ef5350ff>緩速40%<>，護甲降低20%。<#ff9028ff>魂魄熔爐<>：獲得<#e8d44dff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#e8d44dff>100%<>護盾，<#ffb900ff>3秒<>後護盾仍在則爆炸，造成<#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:hp_0><#a974ffff>8%<><#a974ffff>魔法傷害<>。",
        "ult": "免疫控制衝向敵方英雄，撞到第一個英雄造成<#ff9028ff>200-400<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<><#ff9028ff>物理傷害<>並<#ef5350ff>擊飛0.75-1.58秒<>（衝得越遠越強），周圍敵人<#ef5350ff>緩速40%<>。救被控的隊友、團戰、和隊友一起追擊時才衝。"
      },
      "league_kindred": {
        "name": "鏡爪",
        "attack": "<#ff9028ff>鏡爪印記<>：射出箭矢。參與擊殺被她攻擊過的敵方英雄獲得一層印記（陣亡清空）：射程+15、攻速+4%、<#ff9028ff>恐懼蔓延<>+<#a974ffff>8魔法傷害<>。",
        "skill": "躍動一小段（被近身時向後），向附近最多<#ffb900ff>3名<>敵人各射一箭，造成<#ff8a65ff>45<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff8a65ff>65%<><#ff8a65ff>物理傷害<>，攻速+35%持續<#ffb900ff>4秒<>。在<#ff9028ff>魔狼狂熱<>內冷卻<#ffb900ff>4秒<>。",
        "skill2": "<#ff9028ff>恐懼蔓延<>：標記敵人並<#ef5350ff>緩速30%<>，此後第<#ffb900ff>3次<>攻擊命中時魔狼撲咬被標記者，造成<#ff8a65ff>60<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff8a65ff>90%<><#ff8a65ff>物理傷害<>（英雄額外4%最大生命）。冷卻時放<#ff9028ff>魔狼狂熱<>：<#ffb900ff>8.5秒<>領域，魔狼每秒撕咬其中一個敵人，造成<#ff8a65ff>25<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff8a65ff>25%<><#ff8a65ff>物理傷害<>。",
        "ult": "友方英雄被控制且身邊有敵方英雄，或持續交戰中友方英雄（含自己）身邊有2名以上敵方英雄時，祝福身邊區域：<#ffb900ff>4秒<>內其中的友方英雄不會陣亡，結束時回復<#7dd87dff>150<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#7dd87dff>40%<>生命。"
      },
      "league_malzahar": {
        "name": "馬爾札哈",
        "attack": "射出虛空彈。被動<#ff9028ff>虛空象限<>：獲得<#ffb900ff>90<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#ffb900ff>40%<>護盾，護盾存在時<#ef5350ff>免疫控場<>；護盾被打破後<#ffb900ff>12秒<>重新獲得。",
        "skill": "<#ff9028ff>煞星幻象<>：<#ffb900ff>4秒<>內造成<#a974ffff>170<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<><#a974ffff>魔法傷害<>，目標死亡時跳到附近的敵人身上。<#ff9028ff>召喚虛靈<>隨之撕咬目標，每<#ffb900ff>0.5秒<>造成<#a974ffff>14<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>8%<><#a974ffff>魔法傷害<>。",
        "skill2": "在目標兩側打開虛空裂隙，裂隙合攏時對範圍內的敵人造成<#a974ffff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>45%<><#a974ffff>魔法傷害<>並<#ef5350ff>沉默1.5秒<>。",
        "ult": "壓制一名敵方英雄（優先煞星幻象的目標）：引導期間使其<#ef5350ff>暈眩<>，<#ffb900ff>2.5秒<>內造成<#a974ffff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80%<><#a974ffff>魔法傷害<>，腳下留下持續傷害的虛空區域。馬爾札哈被控場時引導中斷。"
