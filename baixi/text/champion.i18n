  "en": {
    "description": {
      "baixi_dianjing": {
        "name": "Dianjing",
        "attack": "Lion headbutt for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> physical damage. <#ff9028ff>Drumbeat<>: every 3rd hit bites for +<#ff9028ff>39<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>59%<> and heals <#66bb6aff>64<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#66bb6aff>17%<>.",
        "skill": "Leaps onto target for <#ff9028ff>69<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>106%<> physical damage, <#ef5350ff>slows 30% (1.5s)<>, and heals <#66bb6aff>37<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#66bb6aff>27%<>.",
        "skill2": "Spins his lion cloak for <#ff9028ff>59<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>79%<> AoE physical damage and gains a <#e8d44dff>158<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#e8d44dff>36%<> shield (<#ffb900ff>3s<>).",
        "ult": "Roars with golden eyes: AoE <#ff9028ff>98<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>98%<> physical damage and <#ef5350ff>1s taunt<>; gains 29% DR and +39% AS for <#ffb900ff>5s<>."
      },
      "baixi_sangeng": {
        "name": "Sangeng",
        "attack": "Twin blades for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<> physical damage. <#ff9028ff>Shadow Follow<>: after a skill (<#ffb900ff>4s<>), next attack strikes twice for +<#ff9028ff>43<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>53%<>.",
        "skill": "Dashes through the target as a shadow, dealing <#ff9028ff>84<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>103%<> physical damage and <#ef5350ff>slowing 25% (1s)<>.",
        "skill2": "Slips behind a lit puppet screen: <#ffb900ff>2s stealth<> & +30% MS; first strike out deals +<#ff9028ff>64<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>82%<> physical damage.",
        "ult": "Snuffs the lamp and blinks behind target: invisible <#ffb900ff>0.6s<>, slashing 3 times for <#ff9028ff>63<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>73%<> each; 3rd hit <#ef5350ff>silences 1s<>."
      },
      "baixi_maiya": {
        "name": "Maiya",
        "attack": "Flings a sugar drop (<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>). <#ff9028ff>Sweet Spot<>: after a skill, next attack adds <#a974ffff>36<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>36%<> magic damage and <#ef5350ff>30% slow (1s)<>.",
        "skill": "Pours molten sugar for <#a974ffff>77<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>66%<> AoE magic damage, leaving a <#ffb900ff>2s<> hot puddle that burns and <#ef5350ff>slows 30%<>.",
        "skill2": "Whips a linear sugar thread hitting the first enemy for <#a974ffff>71<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>56%<> magic damage and <#ef5350ff>1.25s root<>.",
        "ult": "Spins <#ffb900ff>Dragon -> Phoenix -> Fish<>: Dragon line <#a974ffff>145<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>87%<> + <#ef5350ff>knockup<>; Phoenix <#a974ffff>124<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>76%<> + ally <#e8d44dff>108<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#e8d44dff>56%<> shield; Fish <#a974ffff>139<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>82%<> + <#ef5350ff>50% slow<>."
      },
      "baixi_huoshu": {
        "name": "Huoshu",
        "attack": "Fires a paper cracker (<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>). <#ff9028ff>Chain Crackers<>: every 4th shot pops twice, splashing <#ff9028ff>44<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>62%<> AoE physical damage.",
        "skill": "Launches 3 homing sky rockets, each dealing <#ff9028ff>34<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>45%<> physical damage.",
        "skill2": "Hops back and drops a spinner lasting <#ffb900ff>2s<>, dealing <#ff9028ff>27<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>31%<> every 0.5s and <#ef5350ff>slowing 30%<>.",
        "ult": "Ignites all tubes: rains fireworks for <#ffb900ff>2s<> (<#ff9028ff>31<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>37%<> every 0.25s) ending in a grand <#ff9028ff>115<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>108%<> burst."
      },
      "baixi_fumian": {
        "name": "Fumian",
        "attack": "Fan gust (<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>). <#ff9028ff>Opera Masks<>: each cast cycles <#ffb900ff>Red->Black->Gold<>: Red shields allies <#e8d44dff>66<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#e8d44dff>51%<>, Black adds <#ef5350ff>0.52s stun<>, Gold heals <#66bb6aff>53<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#66bb6aff>41%<>.",
        "skill": "Snaps open his fan in a cone for <#a974ffff>84<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>61%<> magic damage and <#ef5350ff>31% slow (1.5s)<>, triggering and cycling his mask.",
        "skill2": "Whips a silk sleeve, pulling the first enemy champion in for <#a974ffff>72<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>51%<> magic damage and <#ef5350ff>0.82s stun<>, cycling his mask.",
        "ult": "Flashes all 3 masks: enemies take <#a974ffff>98<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>73%<> + <#ef5350ff>1s stun<>; allies gain <#e8d44dff>129<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#e8d44dff>94%<> shield and <#66bb6aff>67<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#66bb6aff>51%<> heal."
      }
    },
