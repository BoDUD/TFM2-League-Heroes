  "ko": {
    "description": {
      "baixi_dianjing": {
        "name": "점정",
        "attack": "사자탈 박치기(<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>). <#ff9028ff>북장단<>: 3번째 공격마다 추가로 <#ff9028ff>39<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>59%<> 피해 및 <#66bb6aff>64<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#66bb6aff>17%<> 회복.",
        "skill": "대상에 도약해 <#ff9028ff>69<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>106%<> 물리 피해, <#ef5350ff>30% 둔화(1.5초)<>, <#66bb6aff>37<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#66bb6aff>27%<> 회복.",
        "skill2": "사자망토 회전으로 주위에 <#ff9028ff>59<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>79%<> 피해 및 <#e8d44dff>158<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#e8d44dff>36%<> 보호막(<#ffb900ff>3초<>).",
        "ult": "포효로 주위 적에게 <#ff9028ff>98<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>98%<> 피해와 <#ef5350ff>1초 도발<>. <#ffb900ff>5초<> 피해 29% 감소·공속 +39%."
      },
      "baixi_sangeng": {
        "name": "삼경",
        "attack": "쌍도 베기(<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>). <#ff9028ff>그림자 추격<>: 스킬 후 <#ffb900ff>4초<> 내 다음 공격이 그림자 추가타 <#ff9028ff>43<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>53%<>.",
        "skill": "그림자가 되어 관통 돌진, 경로 적에게 <#ff9028ff>84<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>103%<> 피해 및 <#ef5350ff>25% 둔화(1초)<>.",
        "skill2": "막 뒤로 물러나 <#ffb900ff>2초 은신<>·이속 +30%. 첫 공격에 <#ff9028ff>64<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>82%<> 추가 피해.",
        "ult": "등불을 끄고 적 뒤로 순간이동, <#ffb900ff>0.6초<> 은신 중 3연속 베기(회당 <#ff9028ff>63<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>73%<>), 마지막 타격 <#ef5350ff>1초 침묵<>."
      },
      "baixi_maiya": {
        "name": "맥아",
        "attack": "설탕 방울(<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>). <#ff9028ff>단맛<>: 스킬 후 다음 공격에 <#a974ffff>36<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>36%<> 마법 피해와 <#ef5350ff>30% 둔화(1초)<>.",
        "skill": "뜨거운 설탕으로 <#a974ffff>77<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>66%<> 마법 피해, <#ffb900ff>2초<> 웅덩이 지속 피해 및 <#ef5350ff>30% 둔화<>.",
        "skill2": "직선 설탕실로 첫 적에게 <#a974ffff>71<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>56%<> 마법 피해 및 <#ef5350ff>1.25초 속박<>.",
        "ult": "<#ffb900ff>용→봉황→물고기<> 순환: 용 직선 <#a974ffff>145<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>87%<><#ef5350ff>에어본<>, 봉황 <#a974ffff>124<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>76%<>+아군 보호막, 물고기 <#a974ffff>139<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>82%<><#ef5350ff>둔화<>."
      },
      "baixi_huoshu": {
        "name": "화수",
        "attack": "폭죽 발사(<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>). <#ff9028ff>연발 폭죽<>: 4번째 공격마다 2단 폭발로 주위에 <#ff9028ff>44<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>62%<> 범위 물리 피해.",
        "skill": "대상을 쫓는 로켓 3발을 연사, 발당 <#ff9028ff>34<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>45%<> 물리 피해.",
        "skill2": "뒤로 도약하며 <#ffb900ff>2초<>간 회전 폭죽을 남겨 0.5초마다 <#ff9028ff>27<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>31%<> 피해 및 <#ef5350ff>30% 둔화<>.",
        "ult": "불꽃을 쏘아 올려 <#ffb900ff>2초<>간 0.25초마다 <#ff9028ff>31<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>37%<> 폭격 후 마지막 대폭발 <#ff9028ff>115<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>108%<>."
      },
      "baixi_fumian": {
        "name": "불면",
        "attack": "부채바람(<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%<>). <#ff9028ff>가면<>: 스킬마다 <#ffb900ff>적→흑→금<> 전환: 적 아군 보호막, 흑 <#ef5350ff>+0.52초 기절<>, 금 아군 회복.",
        "skill": "부채를 펼쳐 전방에 <#a974ffff>84<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>61%<> 마법 피해 및 <#ef5350ff>31% 둔화(1.5초)<>, 가면 발동·전환.",
        "skill2": "긴 소매로 첫 적 챔피언을 끌어당겨 <#a974ffff>72<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>51%<> 피해와 <#ef5350ff>0.82초 기절<>, 가면 발동·전환.",
        "ult": "세 가면을 연달아 펼쳐 주위 적 <#a974ffff>98<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>73%<><#ef5350ff> 1초 기절<>, 아군 보호막 <#e8d44dff>129<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#e8d44dff>94%<> 및 회복 <#66bb6aff>67<>+<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#66bb6aff>51%<>."
      }
    },
